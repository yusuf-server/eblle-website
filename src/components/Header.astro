---

<!-- 1. Announcement Bar -->
<div class="announcement-bar">
  <div class="announcement-content">
    <span class="announcement-promo">GET $130 COUPONS + 50% OFF AIR SHIPPING</span>
    <span class="announcement-sep">•</span>
    <span class="countdown" id="headerCountdown">Ends in <span id="countdownTimer">84 D : 21 H : 25 M : 14 S</span></span>
  </div>
</div>

<!-- 2. Main Header -->
<header class="main-header">
  <div class="header-container">
    <div class="header-top">
      <button class="mobile-menu-toggle" id="mobile-menu-btn" aria-label="Open Menu" type="button">
        <i class="fa-solid fa-bars"></i>
      </button>

      <div class="header-brand">
        <a href={addLocalePrefix('/', currentLocale)}>
          <h1>E.B.Belle</h1>
        </a>
      </div>

      <div class="header-search">
        <div class="search-box">
          <div class="search-box-inner">
            <input
              type="text"
              id="desktop-search-input"
              placeholder="Search jewelry, collections..."
              autocomplete="off"
            />
            <button class="search-submit" type="button" aria-label="Search" id="desktop-search-btn">
              <i class="fa-solid fa-magnifying-glass"></i>
            </button>
          </div>

          <div class="search-dropdown" id="search-dropdown" style="display: none;">
            <div class="search-dropdown-content">
              <div class="search-loading" id="search-loading" style="display: none;">
                <div class="spinner-small"></div>
                <span>Searching...</span>
              </div>
              <div class="search-results" id="search-results"></div>
              <div class="search-categories" id="search-categories"></div>
              <div class="search-no-results" id="search-no-results" style="display: none;">
                <i class="fa-solid fa-search"></i>
                <p>No products found</p>
                <span>Try different keywords</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="header-actions">
        <button class="action-item mobile-search-btn" id="mobile-search-toggle" aria-label="Toggle Search" type="button">
          <i class="fa-solid fa-magnifying-glass"></i>
        </button>

        <!-- 语言与货币设置（桌面端 Hover 展开弹出卡片） -->
        <div class="settings-dropdown-wrapper">
          <button class="action-item desktop-only settings-trigger-btn" id="desktopCurrencyLangBtn" title="Region & Language" type="button">
            <i class="fa-solid fa-globe"></i>
            <span id="currentSettingsLabel">USD / English</span>
            <i class="fa-solid fa-angle-down arrow-down"></i>
          </button>

          <!-- 桌面端 Your Website Settings 浮层弹窗 -->
          <div class="website-settings-card" id="desktopSettingsDropdown">
            <h3 class="settings-card-title">Your Website Settings</h3>

            <div class="settings-field-group">
              <label class="settings-label" for="desktopLangSelect">Language:</label>
              <div class="custom-select-wrap">
                <select id="desktopLangSelect" class="settings-select">
                  <option value="en" selected>English</option>
                  <option value="fr">Français (French)</option>
                  <option value="de">Deutsch (German)</option>
                  <option value="es">Español (Spanish)</option>
                </select>
                <i class="fa-solid fa-chevron-down select-arrow"></i>
              </div>
            </div>

            <div class="settings-field-group">
              <label class="settings-label" for="desktopCurrencySelect">Currency:</label>
              <div class="custom-select-wrap">
                <select id="desktopCurrencySelect" class="settings-select">
                  <option value="USD" selected>USD (US$)</option>
                  <option value="EUR">EUR (€)</option>
                  <option value="GBP">GBP (£)</option>
                  <option value="CAD">CAD (CA$)</option>
                </select>
                <i class="fa-solid fa-chevron-down select-arrow"></i>
              </div>
            </div>

            <button type="button" class="settings-confirm-btn" id="desktopConfirmSettingsBtn">Confirm</button>
          </div>
        </div>

        <div class="account-wrapper">
          <button class="action-item desktop-only" id="desktopAccountBtn" title="Account" type="button">
            <i class="fa-regular fa-user"></i>
            <span id="desktopAccountText">Login/Register</span>
          </button>

          <div class="user-menu-dropdown" id="userMenuDropdown">
            <a href={addLocalePrefix('/account', currentLocale)} class="user-menu-item">
              <i class="fa-regular fa-user"></i>
              <span>My Account</span>
            </a>
            <a href={addLocalePrefix('/account?tab=orders', currentLocale)} class="user-menu-item">
              <i class="fa-solid fa-box"></i>
              <span>Orders</span>
            </a>
            <a href={addLocalePrefix('/account?tab=wishlist', currentLocale)} class="user-menu-item">
              <i class="fa-regular fa-heart"></i>
              <span>Wishlist</span>
            </a>
            <button class="user-menu-item" onclick="handleLogout()" type="button">
              <i class="fa-solid fa-arrow-right-from-bracket"></i>
              <span>Logout</span>
            </button>
          </div>
        </div>

        <button class="action-item cart-btn" title="Shopping Bag" type="button" onclick="window.toggleCart?.(true)">
          <div class="cart-icon-wrapper">
            <i class="fa-solid fa-cart-shopping"></i>
            <span class="cart-badge">0</span>
          </div>
          <span class="desktop-only">Cart</span>
        </button>
      </div>
    </div>

    <div class="mobile-search-drawer" id="mobile-search-drawer">
      <div class="mobile-search-box-wrapper">
        <div class="mobile-search-box">
          <input
            type="text"
            id="mobile-search-input"
            placeholder="Search jewelry, collections..."
            autocomplete="off"
          />
          <button type="button" aria-label="Search" id="mobile-search-submit">
            <i class="fa-solid fa-magnifying-glass"></i>
          </button>
        </div>

        <div class="search-dropdown mobile-search-dropdown" id="mobile-search-dropdown" style="display: none;">
          <div class="search-dropdown-content">
            <div class="search-loading" id="mobile-search-loading" style="display: none;">
              <div class="spinner-small"></div>
              <span>Searching...</span>
            </div>
            <div class="search-results" id="mobile-search-results"></div>
            <div class="search-categories" id="mobile-search-categories"></div>
            <div class="search-no-results" id="mobile-search-no-results" style="display: none;">
              <i class="fa-solid fa-search"></i>
              <p>No products found</p>
              <span>Try different keywords</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- 3. Desktop Bottom Navigation Bar -->
  <div class="header-nav-bar">
    <div class="header-container nav-container">
      <div class="all-categories-trigger" id="allCategoriesTrigger">
        <button class="categories-btn" type="button" aria-expanded="false">
          <i class="fa-solid fa-bars"></i>
          <span>
            <a href={addLocalePrefix('/shop', currentLocale)} onclick="event.stopPropagation();" style="text-decoration: none; color: inherit;">
              {t(currentLocale, 'nav.allCategories')}
            </a>
          </span>
          <i class="fa-solid fa-angle-down arrow-down"></i>
        </button>

        <div class="categories-unified-mega-dropdown" id="categoriesUnifiedDropdown">
          <!-- Column 1: 一级菜单列 -->
          <div class="mega-column col-level-1">
            <ul class="cat-list">
              {categoryMenu.map((l1, idx1) => (
                <li class={`cat-item level-1-item ${idx1 === 0 ? 'is-active' : ''}`} data-index={idx1}>
                  <a href={addLocalePrefix(`/shop?category=${l1.slug}`, currentLocale)} class="cat-link">
                    <span>{l1.name}</span>
                    {l1.children && l1.children.length > 0 && (
                      <i class="fa-solid fa-angle-right sub-arrow"></i>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <!-- Column 2: 二级菜单列 -->
          <div class="mega-column col-level-2" id="level2Column">
            {categoryMenu.map((l1, idx1) => (
              <div class={`sub-group-l2 ${idx1 === 0 ? 'is-active' : ''}`} id={`subGroupL2_${idx1}`}>
                {l1.children && l1.children.length > 0 ? (
                  <ul class="cat-list">
                    {l1.children.map((l2, idx2) => (
                      <li class={`cat-item level-2-item ${idx1 === 0 && idx2 === 0 ? 'is-active' : ''}`} data-parent={idx1} data-index={idx2}>
                        <a href={addLocalePrefix(`/shop?category=${l2.slug}`, currentLocale)} class="cat-link">
                          <span>{l2.name}</span>
                          {l2.children && l2.children.length > 0 && (
                            <i class="fa-solid fa-angle-right sub-arrow"></i>
                          )}
                        </a>
                      </li>
                    ))}
                  </ul>
                ) : null}
              </div>
            ))}
          </div>

          <!-- Column 3: 三级菜单列 -->
          <div class="mega-column col-level-3" id="level3Column">
            {categoryMenu.map((l1, idx1) =>
              l1.children.map((l2, idx2) =>
                l2.children && l2.children.length > 0 ? (
                  <div class={`sub-group-l3 ${idx1 === 0 && idx2 === 0 ? 'is-active' : ''}`} id={`subGroupL3_${idx1}_${idx2}`}>
                    <ul class="cat-list">
                      {l2.children.map((l3) => (
                        <li class="cat-item level-3-item">
                          <a href={addLocalePrefix(`/shop?category=${l3.slug}`, currentLocale)} class="cat-link">
                            <span>{l3.name}</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                ) : null
              )
            )}
          </div>
        </div>
      </div>

      <!-- Main Navigation Menu -->
      <nav class="main-nav">
        <div class="nav-item-dropdown-wrapper">
          <a href={addLocalePrefix('/shop?category=new-arrivals', currentLocale)} class="nav-main-link has-dropdown">
            <span>{t(currentLocale, 'nav.newArrival')}</span>
            <i class="fa-solid fa-angle-down nav-arrow"></i>
          </a>
          <div class="nav-simple-dropdown" id="desktopNewArrivalDropdown">
            <div class="nav-dropdown-header">
              <span class="dropdown-tag">LATEST DROPS</span>
              <span class="dropdown-note">Updated Weekly</span>
            </div>
            <ul class="nav-dropdown-list" id="newArrivalsListDesktop">
              <li>
                <a href={addLocalePrefix('/shop?category=new-arrivals', currentLocale)} class="nav-dropdown-link is-primary">
                  <span class="link-label">All New Arrivals</span>
                  <i class="fa-solid fa-arrow-right link-icon"></i>
                </a>
              </li>
              {newArrivalSubcategories.slice(1).map((item) => (
                <li>
                  <a href={addLocalePrefix(`/shop?category=${item.slug}`, currentLocale)} class="nav-dropdown-link">
                    <span class="link-label">{item.name}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <a href={addLocalePrefix('/best-sellers', currentLocale)}>{t(currentLocale, 'nav.bestSellers')}</a>
        <a href={addLocalePrefix('/factory', currentLocale)}>{t(currentLocale, 'nav.factory')}</a>
        <a href={addLocalePrefix('/about', currentLocale)}>{t(currentLocale, 'nav.aboutEbBelle')}</a>
        <a href={addLocalePrefix('/contact', currentLocale)}>{t(currentLocale, 'nav.contactUs')}</a>
        <a href={addLocalePrefix('/halloween', currentLocale)} class="halloween-special-link">
          <i class="fa-solid fa-fire halloween-flame"></i>
          <span class="halloween-text">Halloween</span>
        </a>
      </nav>

      <div class="nav-right">
        <a href={addLocalePrefix('/order-tracking', currentLocale)} class="tracking-link">
          <i class="fa-solid fa-truck-fast"></i>
          <span>{t(currentLocale, 'nav.orderTracking')}</span>
        </a>
      </div>
    </div>
  </div>
</header>

<!-- 4. Mobile Off-Canvas Drawer Menu & Backdrop -->
<div class="drawer-backdrop" id="drawer-backdrop"></div>
<aside class="mobile-drawer" id="mobile-drawer" aria-label="Mobile Navigation">
  <div class="drawer-header">
    <span class="drawer-title">{t(currentLocale, 'nav.menu')}</span>
    <button class="drawer-close" id="drawer-close" type="button" aria-label="Close Menu">
      <i class="fa-solid fa-xmark"></i>
    </button>
  </div>

  <div class="drawer-body">
    <!-- Categories 区域 -->
    <div class="drawer-section">
      <div class="drawer-section-title">
        <i class="fa-solid fa-layer-group"></i>
        <span>Categories</span>
      </div>
      <div class="drawer-links">
        {categoryMenu.map((l1) => (
          <a href={`/shop?category=${l1.slug}`}>{l1.name}</a>
        ))}
      </div>
    </div>

    <!-- Discover 区域 -->
    <div class="drawer-section">
      <div class="drawer-section-title">
        <i class="fa-solid fa-compass"></i>
        <span>Discover</span>
      </div>
      <div class="drawer-links">
        <div class="mobile-accordion-item" id="mobileNewArrivalAccordion">
          <div class="mobile-accordion-trigger" id="mobileNewArrivalToggle">
            <a href={addLocalePrefix('/shop?category=new-arrivals', currentLocale)} class="mobile-acc-title">{t(currentLocale, 'nav.newArrival')}</a>
            <button type="button" class="mobile-acc-arrow-btn" aria-label="Toggle subcategories">
              <i class="fa-solid fa-chevron-down mobile-acc-icon"></i>
            </button>
          </div>
          <div class="mobile-accordion-content" id="mobileNewArrivalContent">
            <div class="mobile-sublinks-grid" id="newArrivalsListMobile">
              <a href={addLocalePrefix('/shop?category=new-arrivals', currentLocale)} class="mobile-sublink is-primary-pill">
                <span>All New Arrivals</span>
