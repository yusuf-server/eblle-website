<script>
  // ============================================================
  // 客户端工具函数：多语言路径前缀处理
  // ============================================================
  const SUPPORTED_LOCALES = ['en', 'fr', 'de', 'es'];

  function getCurrentLocale(): string {
    const pathname = window.location.pathname;
    for (const locale of SUPPORTED_LOCALES) {
      if (pathname.startsWith(`/${locale}/`) || pathname === `/${locale}`) {
        return locale;
      }
    }
    return 'en';
  }

  function addLocalePrefix(url: string, locale?: string): string {
    const currentLocale = locale || getCurrentLocale();
    if (currentLocale === 'en') {
      return url;
    }
    // 如果URL已经有语言前缀，先移除
    let cleanUrl = url;
    for (const loc of SUPPORTED_LOCALES) {
      if (cleanUrl.startsWith(`/${loc}/`)) {
        cleanUrl = cleanUrl.substring(loc.length + 1);
        break;
      }
    }
    return `/${currentLocale}${cleanUrl}`;
  }

  // 1. 顶部公告栏实时倒计时驱动
  function initAnnouncementCountdown() {
    const timerEl = document.getElementById('countdownTimer');
    if (!timerEl) return;

    let totalSeconds = (84 * 86400) + (21 * 3600) + (25 * 60) + 14;

    function renderTime() {
      if (totalSeconds <= 0) {
        timerEl.textContent = '00 D : 00 H : 00 M : 00 S';
        return;
      }
      const days = Math.floor(totalSeconds / 86400);
      const hours = Math.floor((totalSeconds % 86400) / 3600);
      const minutes = Math.floor((totalSeconds % 3600) / 60);
      const seconds = totalSeconds % 60;

      const pad = (n: number) => String(n).padStart(2, '0');
      timerEl.textContent = `${days} D : ${pad(hours)} H : ${pad(minutes)} M : ${pad(seconds)} S`;
      totalSeconds--;
    }

    renderTime();
    setInterval(renderTime, 1000);
  }

  // 2. 检查用户登录状态
  async function checkAuthStatus() {
    try {
      const response = await fetch('/api/auth/me');
      const data = await response.json();

      if (data.authenticated && data.user) {
        updateHeaderForLoggedInUser(data.user);
      } else {
        updateHeaderForGuest();
      }
    } catch (error) {
      console.error('Check auth status error:', error);
      updateHeaderForGuest();
    }
  }

  function updateHeaderForLoggedInUser(user: any) {
    const desktopAccountBtn = document.getElementById('desktopAccountBtn');
    const desktopAccountText = document.getElementById('desktopAccountText');
    const userMenuDropdown = document.getElementById('userMenuDropdown');

    if (desktopAccountText) {
      desktopAccountText.textContent = user.firstName || 'Account';
    }

    if (userMenuDropdown) {
      userMenuDropdown.style.display = 'block';
    }

    if (desktopAccountBtn) {
      desktopAccountBtn.onclick = null;
      desktopAccountBtn.style.cursor = 'pointer';
    }

    localStorage.setItem('user', JSON.stringify(user));
  }

  function updateHeaderForGuest() {
    const desktopAccountText = document.getElementById('desktopAccountText');
    const desktopAccountBtn = document.getElementById('desktopAccountBtn');
    const userMenuDropdown = document.getElementById('userMenuDropdown');

    if (desktopAccountText) {
      desktopAccountText.textContent = 'Login/Register';
    }

    if (userMenuDropdown) {
      userMenuDropdown.style.display = 'none';
    }

    if (desktopAccountBtn) {
      desktopAccountBtn.onclick = function() {
        if (typeof (window as any).openAuthModal === 'function') {
          (window as any).openAuthModal('login');
        }
      };
    }

    localStorage.removeItem('user');
  }

  async function handleLogout() {
    try {
      const response = await fetch('/api/auth/logout', { method: 'POST' });
      const data = await response.json();

      if (data.success) {
        localStorage.removeItem('user');
        updateHeaderForGuest();
        window.location.reload();
      }
    } catch (error) {
      console.error('Logout error:', error);
      alert('Logout failed. Please try again.');
    }
  }

  window.addEventListener('userLoggedIn', (e: any) => {
    updateHeaderForLoggedInUser(e.detail);
  });

  (window as any).handleLogout = handleLogout;

  // 3. 搜索模块
  function initSearchModule(config: any) {
    const {
      inputEl,
      btnEl,
      dropdownEl,
      loadingEl,
      resultsEl,
      categoriesEl,
      noResultsEl
    } = config;

    if (!inputEl || !dropdownEl) return;

    let searchTimeout: any;
    let searchCache: Record<string, any> = {};

    function debounceSearch(query: string) {
      clearTimeout(searchTimeout);
      searchTimeout = setTimeout(() => {
        performSearch(query);
      }, 300);
    }

    async function performSearch(query: string) {
      if (!query || query.trim().length < 2) {
        hideDropdown();
        return;
      }

      const cleanQuery = query.trim();

      if (searchCache[cleanQuery]) {
        renderResults(searchCache[cleanQuery]);
        return;
      }

      showLoading();

      try {
        const apiUrl = `/api/search?q=${encodeURIComponent(cleanQuery)}&limit=8`;
        const response = await fetch(apiUrl);

        if (!response.ok) {
          throw new Error(`Search failed: ${response.status}`);
        }

        const data = await response.json();
        searchCache[cleanQuery] = data;
        renderResults(data);
      } catch (error) {
        console.error('Search error:', error);
        hideLoading();
        showNoResults();
      }
    }

    function renderResults(data: any) {
      hideLoading();
      const { products = [], categories = [], total = 0, query = '' } = data;

      if (products.length === 0 && categories.length === 0) {
        showNoResults();
        return;
      }

      if (products.length > 0) {
        resultsEl.innerHTML = products.map((product: any) => {
          const priceHtml = product.on_sale && product.sale_price ?
            `<div class="search-result-price on-sale">
              <span class="sale-price">$${parseFloat(product.sale_price).toFixed(2)}</span>
              <span class="regular-price">$${parseFloat(product.regular_price).toFixed(2)}</span>
            </div>` :
            `<div class="search-result-price">$${parseFloat(product.price).toFixed(2)}</div>`;

          return `
            <a href="${addLocalePrefix(`/product/${product.slug}`)}" class="search-result-item">
              <img
                src="${product.image || 'https://via.placeholder.com/80x80?text=No+Image'}"
                alt="${product.name}"
                class="search-result-image"
                onerror="this.src='https://via.placeholder.com/80x80?text=No+Image'"
              />
              <div class="search-result-info">
                <div class="search-result-name">${product.name}</div>
                ${priceHtml}
              </div>
            </a>
          `;
        }).join('');

        if (total > products.length) {
          resultsEl.innerHTML += `
            <a href="${addLocalePrefix(`/shop?q=${encodeURIComponent(query)}`)}" class="search-view-all">
              View all ${total} results <i class="fa-solid fa-arrow-right"></i>
            </a>
          `;
        }
      } else {
        resultsEl.innerHTML = '';
      }

      if (categories.length > 0) {
        categoriesEl.innerHTML = `
          <div class="search-categories-title">Related Categories</div>
          <div class="search-category-list">
            ${categories.map((cat: any) => `
              <a href="${addLocalePrefix(`/shop?category=${cat.slug}`)}" class="search-category-item">
                <i class="fa-solid fa-tag"></i>
                <span>${cat.name}</span>
                <span class="search-category-count">(${cat.count})</span>
              </a>
            `).join('')}
          </div>
        `;
        categoriesEl.style.display = 'block';
      } else {
        categoriesEl.style.display = 'none';
      }

      dropdownEl.style.display = 'block';
      noResultsEl.style.display = 'none';
    }

    function showLoading() {
      dropdownEl.style.display = 'block';
      loadingEl.style.display = 'flex';
      resultsEl.innerHTML = '';
      categoriesEl.style.display = 'none';
      noResultsEl.style.display = 'none';
    }

    function hideLoading() {
      loadingEl.style.display = 'none';
    }

    function showNoResults() {
      dropdownEl.style.display = 'block';
      resultsEl.innerHTML = '';
      categoriesEl.style.display = 'none';
      noResultsEl.style.display = 'flex';
    }

    function hideDropdown() {
      dropdownEl.style.display = 'none';
    }

    inputEl.addEventListener('input', (e: any) => {
      debounceSearch(e.target.value);
    });

    inputEl.addEventListener('focus', (e: any) => {
      const q = e.target.value.trim();
      if (q.length >= 2 && searchCache[q]) {
        renderResults(searchCache[q]);
      }
    });

    inputEl.addEventListener('keypress', (e: any) => {
      if (e.key === 'Enter') {
        const q = e.target.value.trim();
        if (q.length >= 2) {
          window.location.href = `/shop?q=${encodeURIComponent(q)}`;
        }
      }
    });

    if (btnEl) {
      btnEl.addEventListener('click', () => {
        const q = inputEl.value.trim();
        if (q.length >= 2) {
          window.location.href = `/shop?q=${encodeURIComponent(q)}`;
        }
      });
    }

    document.addEventListener('click', (e: any) => {
      if (!dropdownEl.contains(e.target) && !inputEl.contains(e.target)) {
        hideDropdown();
      }
    });
  }

  function initAllSearches() {
    initSearchModule({
      inputEl: document.getElementById('desktop-search-input'),
      btnEl: document.getElementById('desktop-search-btn'),
      dropdownEl: document.getElementById('search-dropdown'),
      loadingEl: document.getElementById('search-loading'),
      resultsEl: document.getElementById('search-results'),
      categoriesEl: document.getElementById('search-categories'),
      noResultsEl: document.getElementById('search-no-results')
    });

    initSearchModule({
      inputEl: document.getElementById('mobile-search-input'),
      btnEl: document.getElementById('mobile-search-submit'),
      dropdownEl: document.getElementById('mobile-search-dropdown'),
      loadingEl: document.getElementById('mobile-search-loading'),
      resultsEl: document.getElementById('mobile-search-results'),
      categoriesEl: document.getElementById('mobile-search-categories'),
      noResultsEl: document.getElementById('mobile-search-no-results')
    });

    const mobileSearchToggle = document.getElementById('mobile-search-toggle');
    const mobileSearchInput = document.getElementById('mobile-search-input');
    const mobileSearchDrawer = document.getElementById('mobile-search-drawer');
    const mobileDropdown = document.getElementById('mobile-search-dropdown');

    if (mobileSearchToggle && mobileSearchDrawer) {
      mobileSearchToggle.addEventListener('click', (e) => {
        e.stopPropagation();
        const isActive = mobileSearchDrawer.classList.toggle('active');

        if (isActive) {
          setTimeout(() => {
            mobileSearchInput?.focus();
          }, 200);
        } else {
          mobileSearchInput?.blur();
          if (mobileDropdown) mobileDropdown.style.display = 'none';
        }
      });
    }
  }

  // 4. 一体化三栏多级菜单控制器
  function initUnifiedMegaMenu() {
    const trigger = document.getElementById('allCategoriesTrigger');
    const dropdown = document.getElementById('categoriesUnifiedDropdown');
    const col2 = document.getElementById('level2Column');
    const col3 = document.getElementById('level3Column');

    if (!trigger || !dropdown || !col2 || !col3) return;

    const l1Items = dropdown.querySelectorAll('.level-1-item');
    const l2Items = dropdown.querySelectorAll('.level-2-item');

    function activateLevel1(idx: string | number) {
      l1Items.forEach((item) => item.classList.remove('is-active'));
      const activeL1 = dropdown.querySelector(`.level-1-item[data-index="${idx}"]`);
      if (activeL1) activeL1.classList.add('is-active');

      const allSubL2 = dropdown.querySelectorAll('.sub-group-l2');
      allSubL2.forEach((g) => g.classList.remove('is-active'));

      const targetL2 = document.getElementById(`subGroupL2_${idx}`);
      if (targetL2 && targetL2.querySelectorAll('.level-2-item').length > 0) {
        col2.classList.add('is-open');
        targetL2.classList.add('is-active');

        const firstL2Item = targetL2.querySelector('.level-2-item');
        if (firstL2Item) {
          const l2Idx = firstL2Item.getAttribute('data-index');
          activateLevel2(idx, l2Idx);
        } else {
          col3.classList.remove('is-open');
        }
      } else {
        col2.classList.remove('is-open');
        col3.classList.remove('is-open');
      }
    }

    function activateLevel2(parentIdx: string | number, subIdx: string | number | null) {
      if (subIdx === null) return;
      const currentL2Group = document.getElementById(`subGroupL2_${parentIdx}`);
      if (currentL2Group) {
        currentL2Group.querySelectorAll('.level-2-item').forEach((item) => item.classList.remove('is-active'));
        const activeL2 = currentL2Group.querySelector(`.level-2-item[data-index="${subIdx}"]`);
        if (activeL2) activeL2.classList.add('is-active');
      }

      const allSubL3 = dropdown.querySelectorAll('.sub-group-l3');
      allSubL3.forEach((g) => g.classList.remove('is-active'));

      const targetL3 = document.getElementById(`subGroupL3_${parentIdx}_${subIdx}`);
      if (targetL3 && targetL3.querySelectorAll('.level-3-item').length > 0) {
        col3.classList.add('is-open');
        targetL3.classList.add('is-active');
      } else {
        col3.classList.remove('is-open');
      }
    }

    l1Items.forEach((item) => {
      item.addEventListener('mouseenter', () => {
        const idx = item.getAttribute('data-index');
        if (idx !== null) activateLevel1(idx);
      });
    });

    l2Items.forEach((item) => {
      item.addEventListener('mouseenter', () => {
        const parentIdx = item.getAttribute('data-parent');
        const subIdx = item.getAttribute('data-index');
        if (parentIdx !== null && subIdx !== null) {
          activateLevel2(parentIdx, subIdx);
        }
      });
    });

    trigger.addEventListener('mouseenter', () => {
      activateLevel1(0);
    });
  }

  // 5. 动态同步 WooCommerce New Arrivals 子分类数据
  async function syncNewArrivalSubcategories() {
    try {
      const res = await fetch('/api/filters');
      if (!res.ok) return;
      const data = await res.json();

      if (data && data.newArrivals && data.newArrivals.length > 0) {
        let subCats: any[] = [];
        data.newArrivals.forEach((cat: any) => {
          if (cat.children && cat.children.length > 0) {
            subCats.push(...cat.children);
          }
        });

        if (subCats.length > 0) {
          subCats.sort((a, b) => {
            const extractDate = (name: string) => {
              const match = name.match(/(\d{4})\.(\d{1,2})/);
              if (match) return parseInt(match[1]) * 100 + parseInt(match[2]);
              return 0;
            };
            return extractDate(b.name) - extractDate(a.name);
          });

          const desktopListEl = document.getElementById('newArrivalsListDesktop');
          if (desktopListEl) {
            desktopListEl.innerHTML = `
              <li>
                <a href="${addLocalePrefix('/shop?category=new-arrivals')}" class="nav-dropdown-link is-primary">
                  <span class="link-label">All New Arrivals</span>
                  <i class="fa-solid fa-arrow-right link-icon"></i>
                </a>
              </li>
              ${subCats.map(c => `
                <li>
                  <a href="${addLocalePrefix(`/shop?category=${c.slug}`)}" class="nav-dropdown-link">
                    <span class="link-label">${c.name}</span>
                  </a>
                </li>
              `).join('')}
            `;
          }

          const mobileListEl = document.getElementById('newArrivalsListMobile');
          if (mobileListEl) {
            mobileListEl.innerHTML = `
              <a href="${addLocalePrefix('/shop?category=new-arrivals')}" class="mobile-sublink is-primary-pill">
                <span>All New Arrivals</span>
                <i class="fa-solid fa-arrow-right"></i>
              </a>
              ${subCats.map(c => `
                <a href="${addLocalePrefix(`/shop?category=${c.slug}`)}" class="mobile-sublink">${c.name}</a>
              `).join('')}
            `;
          }
        }
      }
    } catch (e) {
      console.warn('Sync new arrivals subcategories skipped:', e);
    }
  }

  // 6. Mobile Drawer 控制
  function initMobileDrawer() {
    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
    const drawerBackdrop = document.getElementById('drawer-backdrop');
    const mobileDrawer = document.getElementById('mobile-drawer');
    const drawerClose = document.getElementById('drawer-close');

    if (!mobileMenuBtn || !drawerBackdrop || !mobileDrawer) return;

    function openDrawer() {
      drawerBackdrop.classList.add('open');
      mobileDrawer.classList.add('open');
      document.body.style.overflow = 'hidden';
    }

    function closeDrawer() {
      drawerBackdrop.classList.remove('open');
      mobileDrawer.classList.remove('open');
      document.body.style.overflow = '';
    }

    mobileMenuBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      openDrawer();
    });

    if (drawerClose) {
      drawerClose.addEventListener('click', (e) => {
        e.stopPropagation();
        closeDrawer();
      });
    }

    drawerBackdrop.addEventListener('click', closeDrawer);
    mobileDrawer.addEventListener('click', (e) => {
      e.stopPropagation();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && mobileDrawer.classList.contains('open')) {
        closeDrawer();
      }
    });

    const newArrivalAccordion = document.getElementById('mobileNewArrivalAccordion');
    const newArrivalArrowBtn = newArrivalAccordion?.querySelector('.mobile-acc-arrow-btn');

    if (newArrivalAccordion && newArrivalArrowBtn) {
      newArrivalArrowBtn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        newArrivalAccordion.classList.toggle('is-expanded');
      });
    }
  }

  // 7. 语言与货币设置交互控制器（桌面端 + 移动端联动）
  function initWebsiteSettings() {
    const supportedLocales = ['en', 'fr', 'de', 'es'];

    // 从当前 URL 检测语言代码
    function getCurrentLangFromUrl() {
      const pathname = window.location.pathname;
      const firstSegment = pathname.split('/')[1];
      if (supportedLocales.includes(firstSegment)) {
        return firstSegment;
      }
      return 'en';
    }

    const currentLang = getCurrentLangFromUrl();
    const savedCurrency = localStorage.getItem('ebbelle_currency') || 'USD';

    // 语言展示名映射
    const langNames: Record<string, string> = {
      en: 'English',
      fr: 'Français',
      de: 'Deutsch',
      es: 'Español'
    };

    // 更新顶栏标签文本展示
    const currentLabelText = `${savedCurrency} / ${langNames[currentLang] || 'English'}`;
    const desktopLabel = document.getElementById('currentSettingsLabel');
    const mobileLabel = document.getElementById('mobileCurrentSettingsLabel');
    if (desktopLabel) desktopLabel.textContent = currentLabelText;
    if (mobileLabel) mobileLabel.textContent = currentLabelText;

    // 同步下拉框的默认选中值
    const desktopLangSelect = document.getElementById('desktopLangSelect') as HTMLSelectElement;
    const desktopCurrencySelect = document.getElementById('desktopCurrencySelect') as HTMLSelectElement;
    const mobileLangSelect = document.getElementById('mobileLangSelect') as HTMLSelectElement;
    const mobileCurrencySelect = document.getElementById('mobileCurrencySelect') as HTMLSelectElement;

    if (desktopLangSelect) desktopLangSelect.value = currentLang;
    if (desktopCurrencySelect) desktopCurrencySelect.value = savedCurrency;
    if (mobileLangSelect) mobileLangSelect.value = currentLang;
    if (mobileCurrencySelect) mobileCurrencySelect.value = savedCurrency;

    // 应用保存并重定向至新语言子目录
    function applySettings(targetLang: string, targetCurrency: string) {
      localStorage.setItem('ebbelle_currency', targetCurrency);

      // 派发全局货币切换事件
      window.dispatchEvent(new CustomEvent('currencyChanged', {
        detail: { currency: targetCurrency }
      }));

      const pathname = window.location.pathname;
      const search = window.location.search;
      const hash = window.location.hash;

      // 剔除旧的前缀路径
      let purePath = pathname;
      for (const loc of supportedLocales) {
        if (purePath.startsWith(`/${loc}/`)) {
          purePath = purePath.replace(`/${loc}`, '');
          break;
        } else if (purePath === `/${loc}`) {
          purePath = '/';
          break;
        }
      }

      // 计算重定向新路径
      let targetUrl = '';
      if (targetLang === 'en') {
        targetUrl = `${purePath}${search}${hash}`;
      } else {
        const prefix = `/${targetLang}`;
        targetUrl = purePath === '/' ? `${prefix}/` : `${prefix}${purePath}${search}${hash}`;
      }

      window.location.href = targetUrl;
    }

    // 桌面端 Confirm 按钮点击
    const desktopConfirmBtn = document.getElementById('desktopConfirmSettingsBtn');
    if (desktopConfirmBtn) {
      desktopConfirmBtn.addEventListener('click', () => {
        const langVal = desktopLangSelect ? desktopLangSelect.value : 'en';
        const currVal = desktopCurrencySelect ? desktopCurrencySelect.value : 'USD';
        applySettings(langVal, currVal);
      });
    }

    // 移动端折叠展开切换
    const mobileAccordion = document.getElementById('mobileSettingsAccordion');
    const mobileToggleBtn = document.getElementById('mobileSettingsToggleBtn');
    if (mobileAccordion && mobileToggleBtn) {
      mobileToggleBtn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        mobileAccordion.classList.toggle('is-open');
      });
    }

    // 移动端 Confirm 按钮点击
    const mobileConfirmBtn = document.getElementById('mobileConfirmSettingsBtn');
    if (mobileConfirmBtn) {
      mobileConfirmBtn.addEventListener('click', () => {
        const langVal = mobileLangSelect ? mobileLangSelect.value : 'en';
        const currVal = mobileCurrencySelect ? mobileCurrencySelect.value : 'USD';
        applySettings(langVal, currVal);
      });
    }
  }

  function initHeader() {
    initAnnouncementCountdown();
    checkAuthStatus();
    initAllSearches();
    initUnifiedMegaMenu();
    syncNewArrivalSubcategories();
    initMobileDrawer();
    initWebsiteSettings();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeader);
  } else {
    initHeader();
  }
</script>