// 2. New Arrivals 默认数据（带友好标题）
const newArrivalSubcategories = [
  { name: "All New Arrivals", slug: "new-arrivals" },
  { name: "2026.10.NEW", slug: "2026-10-new" },
  { name: "2026.9.NEW", slug: "2026-9-new" },
  { name: "2026.8.NEW", slug: "2026-8-new" },
