---
// Skeleton 骨架屏组件
---

<div id="skeleton-loader" class="skeleton-loader">
  <div class="skeleton-container">
    <!-- Header Skeleton -->
    <div class="skeleton-header">
      <div class="skeleton-topbar"></div>
      <div class="skeleton-main-header">
        <div class="skeleton-logo"></div>
        <div class="skeleton-search"></div>
        <div class="skeleton-actions">
          <div class="skeleton-action"></div>
          <div class="skeleton-action"></div>
        </div>
      </div>
      <div class="skeleton-nav">
        <div class="skeleton-nav-btn"></div>
        <div class="skeleton-nav-links">
          <div class="skeleton-nav-link"></div>
          <div class="skeleton-nav-link"></div>
          <div class="skeleton-nav-link"></div>
          <div class="skeleton-nav-link"></div>
        </div>
      </div>
    </div>

    <!-- Content Skeleton -->
    <div class="skeleton-content">
      <!-- Hero Section -->
      <div class="skeleton-hero">
        <div class="skeleton-hero-main"></div>
        <div class="skeleton-hero-side">
          <div class="skeleton-hero-card"></div>
          <div class="skeleton-hero-card"></div>
        </div>
      </div>

      <!-- Products Grid -->
      <div class="skeleton-products">
        <div class="skeleton-section-title"></div>
        <div class="skeleton-grid">
          {[...Array(8)].map(() => (
            <div class="skeleton-product-card">
              <div class="skeleton-product-image"></div>
              <div class="skeleton-product-info">
                <div class="skeleton-product-title"></div>
                <div class="skeleton-product-price"></div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Footer Skeleton -->
    <div class="skeleton-footer"></div>
  </div>
</div>

<style>
  .skeleton-loader {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: #fcf9f3;
    z-index: 9999;
    overflow-y: auto;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .skeleton-loader.hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .skeleton-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0;
  }

  /* Skeleton Animation */
  @keyframes shimmer {
    0% {
      background-position: -1000px 0;
    }
    100% {
      background-position: 1000px 0;
    }
  }

  .skeleton-element {
    background: linear-gradient(
      90deg,
      #f0f0f0 0%,
      #e0e0e0 20%,
      #f0f0f0 40%,
      #f0f0f0 100%
    );
    background-size: 1000px 100%;
    animation: shimmer 2s infinite linear;
    border-radius: 4px;
  }

  /* Header Skeleton */
  .skeleton-header {
    background: #fff;
  }

  .skeleton-topbar {
    height: 28px;
    background: #c62828;
  }

  .skeleton-main-header {
    display: flex;
    align-items: center;
    gap: 32px;
    padding: 16px 24px;
    border-bottom: 1px solid #e5e5e5;
  }

  .skeleton-logo {
    width: 120px;
    height: 32px;
    background: linear-gradient(90deg, #e0e0e0 0%, #f0f0f0 50%, #e0e0e0 100%);
    background-size: 200% 100%;
    animation: shimmer 2s infinite;
    border-radius: 4px;
  }

  .skeleton-search {
    flex: 1;
    max-width: 480px;
    height: 40px;
    background: linear-gradient(90deg, #f5f5f5 0%, #e8e8e8 50%, #f5f5f5 100%);
    background-size: 200% 100%;
    animation: shimmer 2s infinite;
    border-radius: 20px;
  }

  .skeleton-actions {
    display: flex;
    gap: 24px;
  }

  .skeleton-action {
    width: 80px;
    height: 20px;
    background: linear-gradient(90deg, #e0e0e0 0%, #f0f0f0 50%, #e0e0e0 100%);
    background-size: 200% 100%;
    animation: shimmer 2s infinite;
    border-radius: 4px;
  }

  .skeleton-nav {
    display: flex;
    align-items: center;
    gap: 24px;
    padding: 0 24px;
    border-bottom: 1px solid #e5e5e5;
  }

  .skeleton-nav-btn {
    width: 160px;
    height: 40px;
    background: linear-gradient(90deg, #d4a04d 0%, #e0b060 50%, #d4a04d 100%);
    background-size: 200% 100%;
    animation: shimmer 2s infinite;
  }

  .skeleton-nav-links {
    display: flex;
    gap: 32px;
    flex: 1;
  }

  .skeleton-nav-link {
    width: 100px;
    height: 16px;
    background: linear-gradient(90deg, #e0e0e0 0%, #f0f0f0 50%, #e0e0e0 100%);
    background-size: 200% 100%;
    animation: shimmer 2s infinite;
    border-radius: 4px;
  }

  /* Content Skeleton */
  .skeleton-content {
    padding: 24px;
  }

  /* Hero Skeleton */
  .skeleton-hero {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 16px;
    height: 500px;
    margin-bottom: 48px;
  }

  .skeleton-hero-main {
    background: linear-gradient(90deg, #e5e5e5 0%, #f0f0f0 50%, #e5e5e5 100%);
    background-size: 200% 100%;
    animation: shimmer 2s infinite;
    border-radius: 8px;
  }

  .skeleton-hero-side {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .skeleton-hero-card {
    flex: 1;
    background: linear-gradient(90deg, #e5e5e5 0%, #f0f0f0 50%, #e5e5e5 100%);
    background-size: 200% 100%;
    animation: shimmer 2s infinite;
    border-radius: 8px;
  }

  /* Products Skeleton */
  .skeleton-products {
    margin-bottom: 48px;
  }

  .skeleton-section-title {
    width: 200px;
    height: 28px;
    margin: 0 auto 32px;
    background: linear-gradient(90deg, #e0e0e0 0%, #f0f0f0 50%, #e0e0e0 100%);
    background-size: 200% 100%;
    animation: shimmer 2s infinite;
    border-radius: 4px;
  }

  .skeleton-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .skeleton-product-card {
    background: #fff;
    border: 1px solid #e5e5e5;
    border-radius: 8px;
    overflow: hidden;
  }

  .skeleton-product-image {
    width: 100%;
    aspect-ratio: 1;
    background: linear-gradient(90deg, #f0f0f0 0%, #e8e8e8 50%, #f0f0f0 100%);
    background-size: 200% 100%;
    animation: shimmer 2s infinite;
  }

  .skeleton-product-info {
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .skeleton-product-title {
    width: 100%;
    height: 16px;
    background: linear-gradient(90deg, #e0e0e0 0%, #f0f0f0 50%, #e0e0e0 100%);
    background-size: 200% 100%;
    animation: shimmer 2s infinite;
    border-radius: 4px;
  }

  .skeleton-product-price {
    width: 60%;
    height: 20px;
    background: linear-gradient(90deg, #e0e0e0 0%, #f0f0f0 50%, #e0e0e0 100%);
    background-size: 200% 100%;
    animation: shimmer 2s infinite;
    border-radius: 4px;
  }

  /* Footer Skeleton */
  .skeleton-footer {
    height: 400px;
    background: linear-gradient(90deg, #f5f5f5 0%, #e8e8e8 50%, #f5f5f5 100%);
    background-size: 200% 100%;
    animation: shimmer 2s infinite;
    border-top: 1px solid #e5e5e5;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .skeleton-hero {
      grid-template-columns: 1fr;
      height: auto;
    }
    .skeleton-hero-main {
      height: 400px;
    }
    .skeleton-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .skeleton-nav-links {
      display: none;
    }
    .skeleton-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Hide skeleton when page is loaded
  function hideSkeleton() {
    const skeleton = document.getElementById('skeleton-loader');
    if (skeleton) {
      // Wait a bit to ensure content is rendered
      setTimeout(() => {
        skeleton.classList.add('hidden');
        // Remove from DOM after transition
        setTimeout(() => {
          skeleton.remove();
        }, 300);
      }, 100);
    }
  }

  // Hide skeleton on page load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', hideSkeleton);
  } else {
    hideSkeleton();
  }

  // Also hide on window load (backup)
  window.addEventListener('load', hideSkeleton);
</script>
