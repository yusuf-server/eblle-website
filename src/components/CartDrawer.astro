---
// CartDrawer 组件
import { SUPPORTED_LOCALES, type SupportedLocale, addLocalePrefix } from '../lib/i18n/utils';
import { t } from '../lib/i18n/translations';

// 检测当前语言
const currentPath = Astro.url.pathname;
let currentLocale: SupportedLocale = 'en';
for (const locale of SUPPORTED_LOCALES) {
  if (currentPath.startsWith(`/${locale}/`) || currentPath === `/${locale}`) {
    currentLocale = locale as SupportedLocale;
    break;
  }
}
---

<!-- Cart Overlay -->
<div class="cart-overlay" id="cartOverlay"></div>

<!-- Cart Drawer -->
<aside class="cart-drawer" id="cartDrawer">
  <!-- Header -->
  <div class="cart-header">
    <h2>{t(currentLocale, 'cartDrawer.title')} <span class="cart-count">(0)</span></h2>
    <button class="close-btn" id="closeCart" aria-label="Close cart">
      <i class="fa-solid fa-xmark"></i>
    </button>
  </div>

  <!-- Scrollable Content -->
  <div class="cart-content">
    <!-- 动态激励进度条（圣诞期间自动切换为圣诞老人骑麋鹿送礼进度条 + 保留会员/新客提示；非活动期间还原日常免邮进度条） -->
    <div class="shipping-progress" id="drawerProgressBanner">
      <div class="progress-info">
        <p class="progress-text" id="progressText">{t(currentLocale, 'cartDrawer.freeShippingProgress').replace('$50.00', '$50.00')}</p>
        <p class="progress-percent">0%</p>
      </div>
      <div class="progress-bar">
        <div class="progress-fill" style="width: 0%;"></div>
      </div>
      <div class="progress-footer">
        <p class="progress-current">{t(currentLocale, 'cartDrawer.current')}: $0.00</p>
        <p class="progress-goal">{t(currentLocale, 'cartDrawer.goal')}: $50.00</p>
      </div>
    </div>

    <!-- Cart Items Container (动态渲染区) -->
    <div class="cart-items" id="cartItems"></div>
  </div>

  <!-- Footer / Checkout -->
  <div class="cart-footer">
    <div class="cart-summary">
      <div class="summary-row small">
        <span class="summary-label">{t(currentLocale, 'cartDrawer.shipping')}</span>
        <span class="summary-note" id="drawerShippingNote">{t(currentLocale, 'cartDrawer.calculatedNextStep')}</span>
      </div>
      <div class="summary-row main">
        <span class="summary-label-main">{t(currentLocale, 'cartDrawer.subtotal')}</span>
        <span class="summary-value" id="cartSubtotal">$0.00</span>
      </div>
    </div>
    <div class="cart-actions">
      <a href={addLocalePrefix('/cart', currentLocale)} class="btn-view-cart">{t(currentLocale, 'cartDrawer.viewCart')}</a>
    </div>
    <div class="trust-badge">
      <i class="fa-solid fa-lock"></i>
      <span>{t(currentLocale, 'cartDrawer.secureCheckout')}</span>
    </div>
  </div>
</aside>

<style is:global>
  /* 全局/外层安全锁 */
  *, *::before, *::after {
    box-sizing: border-box;
  }

  /* Cart Overlay */
  .cart-overlay {
    position: fixed;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(4px);
    z-index: 999;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }
  .cart-overlay.active {
    opacity: 1;
    pointer-events: auto;
  }

  /* Cart Drawer 抽屉主体 */
  .cart-drawer {
    position: fixed;
    top: 0;
    right: 0;
    height: 100vh;
    width: 100%;
    max-width: 380px;
    background: #fbf9f6;
    box-shadow: -4px 0 24px rgba(0, 0, 0, 0.15);
    z-index: 1000;
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cart-drawer.active {
    transform: translateX(0);
  }

  /* Cart Header */
  .cart-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 20px;
    border-bottom: 1px solid #eee8df;
    background: #fbf9f6;
  }
  .cart-header h2 {
    font-size: 22px;
    font-weight: 500;
    font-family: 'Bodoni Moda', 'Didot', Georgia, serif;
    color: #111;
    margin: 0;
  }
  .cart-count {
    font-size: 15px;
    font-weight: 400;
    color: #777;
    margin-left: 4px;
  }
  .close-btn {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    cursor: pointer;
    font-size: 18px;
    color: #222;
    padding: 0;
    transition: color 0.2s;
  }
  .close-btn:hover {
    color: #a82424;
  }

  /* Cart Content */
  .cart-content {
    flex: 1;
    overflow-y: auto;
    padding: 16px;
    -webkit-overflow-scrolling: touch;
  }

  /* =========================================================
     日常 VIP 免邮进度条样式（非圣诞时段自动使用）
     ========================================================= */
  .shipping-progress {
    background: linear-gradient(135deg, #fffdf9 0%, #fbf5ea 100%);
    border: 1px solid #e2c99b;
    border-radius: 8px;
    padding: 14px 16px;
    margin-bottom: 14px;
    box-shadow: 0 4px 14px rgba(163, 130, 76, 0.08);
    transition: all 0.35s ease;
    position: relative;
    overflow: hidden;
  }
  .shipping-progress.unlocked {
    background: linear-gradient(135deg, #f3faf4 0%, #e6f5e8 100%);
    border-color: #81c784;
    box-shadow: 0 4px 16px rgba(46, 125, 50, 0.14);
    animation: drawerCelebratePulse 0.6s ease;
  }
  @keyframes drawerCelebratePulse {
    0% { transform: scale(1); }
    40% { transform: scale(1.018); }
    100% { transform: scale(1); }
  }
  .progress-info {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
  }
  .progress-text {
    font-size: 11.5px;
    color: #222;
    margin: 0;
    line-height: 1.35;
  }
  .highlight {
    color: #9e6d28;
    font-weight: 800;
  }
  .progress-percent {
    font-size: 11px;
    font-weight: 700;
    color: #8a6218;
    background: #ffffff;
    border: 1px solid rgba(163, 130, 76, 0.3);
    padding: 2px 7px;
    border-radius: 12px;
    margin: 0;
    flex-shrink: 0;
  }
  .shipping-progress.unlocked .progress-percent {
    color: #2e7d32;
    border-color: rgba(46, 125, 50, 0.3);
  }
  .progress-bar {
    width: 100%;
    height: 7px;
    background: #eadfce;
    border-radius: 99px;
    overflow: hidden;
    margin-bottom: 8px;
    position: relative;
  }
  .progress-fill {
    height: 100%;
    background: linear-gradient(90deg, #d4af67 0%, #b07d2b 50%, #e2b878 100%);
    background-size: 200% 100%;
    border-radius: 99px;
    transition: width 0.55s cubic-bezier(0.34, 1.56, 0.64, 1);
    position: relative;
    animation: drawerGoldFlow 2.4s linear infinite;
  }
  .progress-fill::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: linear-gradient(
      -45deg,
      rgba(255, 255, 255, 0.32) 25%,
      transparent 25%,
      transparent 50%,
      rgba(255, 255, 255, 0.32) 50%,
      rgba(255, 255, 255, 0.32) 75%,
      transparent 75%,
      transparent
    );
    background-size: 20px 20px;
    animation: drawerStripeMove 1.1s linear infinite;
  }
  .shipping-progress.unlocked .progress-fill {
    background: linear-gradient(90deg, #43a047 0%, #2e7d32 50%, #66bb6a 100%);
    background-size: 200% 100%;
  }
  @keyframes drawerGoldFlow {
    0% { background-position: 0% 50%; }
    100% { background-position: 200% 50%; }
  }
  @keyframes drawerStripeMove {
    0% { background-position: 0 0; }
    100% { background-position: 20px 0; }
  }
  .progress-footer {
    display: flex;
    justify-content: space-between;
    font-size: 10px;
    font-weight: 600;
    color: #777;
    letter-spacing: 0.03em;
  }
  .progress-current,
  .progress-goal {
    margin: 0;
  }

  /* =========================================================
     抽屉圣诞主题（圣诞红金松绿 + 圣诞老人骑麋鹿送礼动画 + 会员/新客提示）
     ========================================================= */
  .shipping-progress.is-xmas-drawer {
    background: linear-gradient(145deg, #fff8f0 0%, #ffefed 55%, #fff6ea 100%);
    border: 1.5px solid #961820;
    border-radius: 10px;
    padding: 13px 14px;
    box-shadow: 0 6px 18px rgba(150, 24, 32, 0.12), inset 0 1px 0 rgba(255, 255, 255, 0.85);
  }
  .xmas-dw-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
    padding-bottom: 7px;
    margin-bottom: 8px;
    border-bottom: 1px dashed rgba(150, 24, 32, 0.28);
  }
  .xmas-dw-title {
    font-size: 10.5px;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #961820;
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
  .xmas-dw-badge {
    background: #234638;
    color: #ffdf9c;
    font-size: 9.5px;
    font-weight: 700;
    padding: 2px 7px;
    border-radius: 999px;
    white-space: nowrap;
  }
  .xmas-dw-goal {
    font-size: 12px;
    font-weight: 600;
    color: #1e1b14;
    line-height: 1.38;
    margin-bottom: 22px;
  }
  .xmas-dw-goal strong {
    color: #961820;
  }
  .xmas-dw-track-wrap {
    position: relative;
    width: 100%;
    padding-top: 2px;
    margin-bottom: 9px;
  }
  .xmas-dw-track {
    position: relative;
    width: 100%;
    height: 8px;
    background: #efe4d6;
    border-radius: 999px;
    overflow: hidden;
  }
  .xmas-dw-fill {
    height: 100%;
    border-radius: 999px;
    background-color: #961820;
    background-image: linear-gradient(
      45deg,
      rgba(255, 223, 156, 0.36) 25%,
      transparent 25%,
      transparent 50%,
      rgba(255, 223, 156, 0.36) 50%,
      rgba(255, 223, 156, 0.36) 75%,
      transparent 75%,
      transparent
    );
    background-size: 16px 16px;
    animation: drawerXmasCandy 1.2s linear infinite;
    transition: width 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .xmas-dw-fill.is-maxed {
    background-color: #234638;
  }
  @keyframes drawerXmasCandy {
    0% { background-position: 0 0; }
    100% { background-position: 16px 0; }
  }
  .xmas-dw-santa {
    position: absolute;
    top: -20px;
    transform: translateX(-50%);
    transition: left 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    pointer-events: none;
    z-index: 4;
    display: inline-flex;
    align-items: center;
    gap: 1px;
    background: #ffffff;
    border: 1.5px solid #961820;
    border-radius: 999px;
    padding: 1.5px 6px;
    box-shadow: 0 3px 8px rgba(150, 24, 32, 0.22);
    white-space: nowrap;
    animation: drawerSantaGallop 0.85s ease-in-out infinite;
  }
  .xmas-dw-santa .trail {
    font-size: 9px;
    color: #d49b35;
  }
  .xmas-dw-santa .emojis {
    font-size: 11.5px;
    line-height: 1;
    letter-spacing: -1px;
  }
  @keyframes drawerSantaGallop {
    0%, 100% { transform: translateX(-50%) translateY(0) rotate(-1.5deg); }
    50% { transform: translateX(-50%) translateY(-3px) rotate(1.5deg); }
  }

  .xmas-dw-tiers {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 5px;
    margin-bottom: 8px;
  }
  .xmas-dw-pill {
    text-align: center;
    font-size: 9.5px;
    font-weight: 600;
    padding: 3px 2px;
    border-radius: 4px;
    background: #ffffff;
    color: #7d6b66;
    border: 1px solid #e7d8c6;
  }
  .xmas-dw-pill.reached {
    background: #e7f3ed;
    color: #234638;
    border-color: #9bc7b2;
    font-weight: 700;
  }
  .xmas-dw-pill.current {
    background: #961820;
    color: #ffdf9c;
    border-color: #961820;
    font-weight: 700;
  }
  .xmas-dw-vip-note {
    background: rgba(255, 255, 255, 0.88);
    border: 1px dashed #d4af67;
    border-radius: 5px;
    padding: 6px 8px;
    font-size: 10.5px;
    color: #5f4c2c;
    line-height: 1.35;
  }
  .xmas-dw-vip-note i {
    color: #a3824c;
    margin-right: 3px;
  }

  /* =========================================================
     动态渲染穿透样式
     ========================================================= */
  .cart-items {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .cart-item {
    background: #ffffff !important;
    border: 1px solid #e8e2d8 !important;
    border-radius: 6px !important;
    padding: 14px !important;
    display: flex !important;
    gap: 14px !important;
    position: relative !important;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.02) !important;
  }

  .cart-item .item-image {
    width: 76px !important;
    height: 76px !important;
    border-radius: 4px !important;
    overflow: hidden !important;
    flex-shrink: 0 !important;
    background: #fbf9f6 !important;
    border: 1px solid #eee8df !important;
  }

  .cart-item .item-image img {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    display: block !important;
  }

  .cart-item .item-details {
    flex: 1 !important;
    display: flex !important;
    flex-direction: column !important;
    justify-content: space-between !important;
    min-width: 0 !important;
  }

  .cart-item .item-header {
    display: flex !important;
    justify-content: space-between !important;
    align-items: flex-start !important;
    gap: 8px !important;
    position: relative !important;
  }

  .cart-item .item-info {
    min-width: 0 !important;
    flex: 1 !important;
  }

  .cart-item .item-info h3 {
    font-size: 13px !important;
    font-weight: 600 !important;
    color: #111 !important;
    margin: 0 0 3px 0 !important;
    line-height: 1.35 !important;
    white-space: nowrap !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
  }

  .cart-item .item-meta {
    font-size: 11px !important;
    color: #777 !important;
    margin: 0 0 4px 0 !important;
    line-height: 1.2 !important;
    white-space: nowrap !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
  }

  .cart-item .item-price {
    font-size: 13px !important;
    font-weight: 700 !important;
    color: #8a6218 !important;
    margin: 0 !important;
  }

  .cart-item .delete-btn {
    width: 22px !important;
    height: 22px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    background: transparent !important;
    border: none !important;
    cursor: pointer !important;
    color: #999 !important;
    font-size: 13px !important;
    padding: 0 !important;
    flex-shrink: 0 !important;
    transition: color 0.2s !important;
  }

  .cart-item .delete-btn:hover {
    color: #c52424 !important;
  }

  .cart-item .item-footer {
    display: flex !important;
    justify-content: space-between !important;
    align-items: center !important;
    margin-top: 10px !important;
  }

  .cart-item .item-quantity {
    display: inline-flex !important;
    align-items: center !important;
    border: 1px solid #ddd8ce !important;
    border-radius: 3px !important;
    background: #fcfbf8 !important;
    height: 28px !important;
    padding: 0 4px !important;
  }

  .cart-item .qty-btn {
    background: transparent !important;
    border: none !important;
    font-size: 12px !important;
    color: #333 !important;
    cursor: pointer !important;
    width: 22px !important;
    height: 100% !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    padding: 0 !important;
  }

  .cart-item .qty-value {
    font-size: 12px !important;
    font-weight: 600 !important;
    color: #111 !important;
    min-width: 18px !important;
    text-align: center !important;
  }

  .cart-item .item-total {
    font-size: 13.5px !important;
    font-weight: 700 !important;
    color: #111 !important;
    margin: 0 !important;
  }

  /* Cart Footer */
  .cart-footer {
    border-top: 1px solid #eee8df;
    padding: 16px 20px;
    padding-bottom: calc(16px + env(safe-area-inset-bottom));
    background: #fbf9f6;
  }
  .cart-summary {
    margin-bottom: 14px;
  }
  .summary-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
  }
  .summary-row.small {
    font-size: 11.5px;
    color: #777;
  }
  .summary-row.main {
    padding-top: 10px;
    border-top: 1px dashed #e2ded5;
    margin-top: 8px;
    margin-bottom: 0;
  }
  .summary-label {
    color: #777;
  }
  .summary-note {
    color: #8a6218;
    font-style: italic;
    font-size: 10.5px;
  }
  .summary-label-main {
    font-size: 15px;
    font-weight: 600;
    color: #111;
  }
  .summary-value {
    font-size: 18px;
    font-weight: 700;
    color: #111;
  }
  .cart-actions {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 12px;
  }
  .btn-view-cart {
    width: 100%;
    background: #111111;
    color: #ffffff;
    border: 1px solid #111111;
    border-radius: 3px;
    padding: 13px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.8px;
    cursor: pointer;
    transition: all 0.2s;
    display: block;
    text-align: center;
    text-decoration: none;
  }
  .btn-view-cart:hover {
    background: #2b2b2b;
  }
  .trust-badge {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    font-size: 10px;
    font-weight: 600;
    color: #777;
    letter-spacing: 0.5px;
  }
  .trust-badge i {
    font-size: 11px;
    color: #555;
  }

  @media (max-width: 480px) {
    .cart-drawer {
      max-width: 100%;
    }
  }
</style>

<script is:inline>
  // ============================================================
  // 客户端多语言工具函数
  // ============================================================
  const SUPPORTED_LOCALES = ['en', 'fr', 'de', 'es'];

  const TRANSLATIONS = {
    en: {
      emptyCart: 'Your cart is currently empty',
      continueShopping: 'CONTINUE SHOPPING',
      freeShippingProgress: "You're <span class=\"highlight\">{{amount}}</span> away from <strong>FREE SHIPPING!</strong>",
      freeShippingAchieved: '<strong>Congratulations! You\'ve unlocked FREE SHIPPING!</strong>',
      current: 'CURRENT'
    },
    fr: {
      itemsInBag: 'articles dans votre panier',
      emptyCart: 'Votre panier est actuellement vide',
      continueShopping: 'CONTINUER VOS ACHATS',
      freeShippingProgress: "Il vous reste <span class=\"highlight\">{{amount}}</span> pour bénéficier de la <strong>LIVRAISON GRATUITE!</strong>",
      freeShippingAchieved: '<strong>Félicitations! Vous avez débloqué la LIVRAISON GRATUITE!</strong>',
      current: 'ACTUEL'
    },
    de: {
      emptyCart: 'Ihr Warenkorb ist derzeit leer',
      continueShopping: 'WEITER EINKAUFEN',
      freeShippingProgress: "Sie sind <span class=\"highlight\">{{amount}}</span> von <strong>KOSTENLOSEM VERSAND!</strong> entfernt",
      freeShippingAchieved: '<strong>Glückwunsch! Sie haben KOSTENLOSEN VERSAND freigeschaltet!</strong>',
      current: 'AKTUELL'
    },
    es: {
      emptyCart: 'Su carrito está actualmente vacío',
      continueShopping: 'CONTINUAR COMPRANDO',
      freeShippingProgress: "Está a <span class=\"highlight\">{{amount}}</span> de <strong>¡ENVÍO GRATIS!</strong>",
      freeShippingAchieved: '<strong>¡Felicitaciones! ¡Ha desbloqueado ENVÍO GRATIS!</strong>',
      current: 'ACTUAL'
    }
  };

  function t(key) {
    const locale = getCurrentLocale();
    return TRANSLATIONS[locale]?.[key] || TRANSLATIONS.en[key] || key;
  }

  function getCurrentLocale() {
    const pathname = window.location.pathname;
    for (const locale of SUPPORTED_LOCALES) {
      if (pathname.startsWith(`/${locale}/`) || pathname === `/${locale}`) {
        return locale;
      }
    }
    return 'en';
  }

  function addLocalePrefix(url) {
    const currentLocale = getCurrentLocale();
    if (currentLocale === 'en') {
      return url;
    }
    let cleanUrl = url;
    for (const loc of SUPPORTED_LOCALES) {
      if (cleanUrl.startsWith(`/${loc}/`)) {
        cleanUrl = cleanUrl.substring(loc.length + 1);
        break;
      }
    }
    return `/${currentLocale}${cleanUrl}`;
  }

  const CURRENCY_SYMBOLS = { USD: '$', EUR: '€', GBP: '£', CAD: 'C$' };
  const CURRENCY_RATES = { USD: 1.0, EUR: 0.92, GBP: 0.79, CAD: 1.36 };

  function getCurrentCurrency() {
    return localStorage.getItem('ebbelle_currency') || 'USD';
  }
  function getCurrencySymbol(currency) {
    return CURRENCY_SYMBOLS[currency || getCurrentCurrency()] || '$';
  }
  function convertPrice(priceUSD, targetCurrency) {
    const currency = targetCurrency || getCurrentCurrency();
    const rate = CURRENCY_RATES[currency] || 1.0;
    return priceUSD * rate;
  }
  function formatPrice(priceUSD, targetCurrency) {
    const currency = targetCurrency || getCurrentCurrency();
    const converted = convertPrice(priceUSD, currency);
    const symbol = getCurrencySymbol(currency);
    const formatted = converted.toFixed(2);
    return currency === 'EUR' ? `${formatted}${symbol}` : `${symbol}${formatted}`;
  }

  function getCart() {
    try {
      const cart = localStorage.getItem('ebbelle_cart');
      return cart ? JSON.parse(cart) : [];
    } catch (e) {
      return [];
    }
  }

  function saveCart(cart) {
    try {
      localStorage.setItem('ebbelle_cart', JSON.stringify(cart));
      window.dispatchEvent(new CustomEvent('cartUpdated', { detail: { cart } }));
    } catch (e) {}
  }

  // 圣诞大促状态与本地阶梯核算（与后端插件保持一致）
  window.__ebXmasPromoActive = false;
  window.__ebIsNewCustomer = true;

  function computeDrawerXmasBogo(cart) {
    const unitPrices = [];
    cart.forEach(item => {
      const p = Math.max(0, parseFloat(item.price) || 0);
      const q = Math.max(0, parseInt(item.quantity, 10) || 0);
      for (let i = 0; i < q; i++) unitPrices.push(p);
    });
    unitPrices.sort((a, b) => b - a);
    const totalQty = unitPrices.length;

    let freeCount = 0;
    let tierLabel = '';
    if (totalQty >= 8) {
      freeCount = 3;
      tierLabel = 'Buy 5 Get 3 Free';
    } else if (totalQty >= 5) {
      freeCount = 2;
      tierLabel = 'Buy 3 Get 2 Free';
    } else if (totalQty >= 2) {
      freeCount = 1;
      tierLabel = 'Buy 2 Get 1 Free';
    }

    const freeSlice = freeCount > 0 ? unitPrices.slice(-freeCount) : [];
    const discount = parseFloat(freeSlice.reduce((s, v) => s + v, 0).toFixed(2));
    return {
      total_qty: totalQty,
      eligible: totalQty >= 2,
      tier_label: tierLabel,
      xmas_discount: discount
    };
  }

  function renderDrawerProgressBanner(cart, subtotal) {
    const banner = document.getElementById('drawerProgressBanner');
    if (!banner) return;

    const freeShippingThreshold = window.__ebFreeShippingThreshold || 25;
    const remaining = Math.max(0, freeShippingThreshold - subtotal);
    const vipUnlocked = remaining <= 0 && subtotal > 0;

    // 1. 圣诞活动已开启且在活动周期内 -> 圣诞红金高定 + 圣诞老人骑麋鹿送礼动画 + 保留会员/新客提示
    if (window.__ebXmasPromoActive) {
      const xmasCalc = computeDrawerXmasBogo(cart);
      const qty = xmasCalc.total_qty;
      const isMaxed = qty >= 8;

      let nextTarget = 2;
      let nextTierName = 'Buy 2 Get 1 Free';
      if (qty >= 8) {
        nextTarget = 8;
        nextTierName = 'Buy 5 Get 3 Free';
      } else if (qty >= 5) {
        nextTarget = 8;
        nextTierName = 'Buy 5 Get 3 Free';
      } else if (qty >= 2) {
        nextTarget = 5;
        nextTierName = 'Buy 3 Get 2 Free';
      }

      const rawPct = isMaxed ? 100 : Math.min(100, Math.round((qty / nextTarget) * 100));
      const riderLeft = Math.min(88, Math.max(12, rawPct));
      const needMore = Math.max(0, nextTarget - qty);

      let goalText = '';
      if (qty === 0) {
        goalText = `Add 2 items anywhere to unlock <strong>Buy 2 Get 1 Free</strong>!`;
      } else if (isMaxed) {
        goalText = `🎉 <strong>Buy 5 Get 3 Free</strong> Unlocked! (Save ${formatPrice(xmasCalc.xmas_discount)})`;
      } else if (qty >= 2) {
        goalText = `🎄 <strong>${xmasCalc.tier_label}</strong> active! Add <strong>${needMore} more</strong> for <strong>${nextTierName}</strong>`;
      } else {
        goalText = `Add <strong>1 more item</strong> to unlock <strong>Buy 2 Get 1 Free</strong>!`;
      }

      const p1 = qty >= 2 ? (qty < 5 ? 'xmas-dw-pill current' : 'xmas-dw-pill reached') : 'xmas-dw-pill';
      const p2 = qty >= 5 ? (qty < 8 ? 'xmas-dw-pill current' : 'xmas-dw-pill reached') : 'xmas-dw-pill';
      const p3 = qty >= 8 ? 'xmas-dw-pill current' : 'xmas-dw-pill';

      const vipTip = window.__ebIsNewCustomer
        ? `New Guest: <strong>15% OFF</strong> &amp; Free Ship over ${formatPrice(freeShippingThreshold)} also available at checkout`
        : `VIP Benefit: Free Ship over ${formatPrice(freeShippingThreshold)} &amp; $200 Bundle also available at checkout`;

      banner.className = 'shipping-progress is-xmas-drawer';
      banner.innerHTML = `
        <div class="xmas-dw-header">
          <span class="xmas-dw-title"><i class="fa-solid fa-sleigh"></i> Christmas Mix &amp; Match</span>
          <span class="xmas-dw-badge">${qty} / ${nextTarget} Items</span>
        </div>
        <div class="xmas-dw-goal">${goalText}</div>
        <div class="xmas-dw-track-wrap">
          <div class="xmas-dw-santa" style="left: ${riderLeft}%;">
            <span class="trail">✨</span>
            <span class="emojis">🎁🛷🎅🦌</span>
          </div>
          <div class="xmas-dw-track">
            <div class="xmas-dw-fill ${isMaxed ? 'is-maxed' : ''}" style="width: ${rawPct}%;"></div>
          </div>
        </div>
        <div class="xmas-dw-tiers">
          <div class="${p1}">2+: Buy 2 Get 1</div>
          <div class="${p2}">5+: Buy 3 Get 2</div>
          <div class="${p3}">8+: Buy 5 Get 3</div>
        </div>
        <div class="xmas-dw-vip-note">
          <i class="fa-solid fa-crown"></i> ${vipTip}
        </div>
      `;
      return;
    }

    // 2. 非圣诞活动时段 -> 恢复日常黑金 VIP 免邮进度条
    const progress = Math.min(100, (subtotal / freeShippingThreshold) * 100);
    const msgHtml = remaining > 0
      ? t('freeShippingProgress').replace('{{amount}}', formatPrice(remaining))
      : t('freeShippingAchieved');

    banner.className = `shipping-progress${vipUnlocked ? ' unlocked' : ''}`;
    banner.innerHTML = `
      <div class="progress-info">
        <p class="progress-text" id="progressText">${msgHtml}</p>
        <p class="progress-percent">${Math.round(progress)}%</p>
      </div>
      <div class="progress-bar">
        <div class="progress-fill" style="width: ${progress}%;"></div>
      </div>
      <div class="progress-footer">
        <p class="progress-current">${t('current')}: ${formatPrice(subtotal)}</p>
        <p class="progress-goal">GOAL: ${formatPrice(freeShippingThreshold)}</p>
      </div>
    `;
  }

  // 渲染购物车商品
  function renderCartItems() {
    const cart = getCart();
    const cartItemsContainer = document.getElementById('cartItems');
    const cartCountSpan = document.querySelector('.cart-count');
    const cartSubtotal = document.getElementById('cartSubtotal');

    if (!cartItemsContainer) return;

    const totalItems = cart.reduce((sum, item) => sum + item.quantity, 0);
    if (cartCountSpan) {
      cartCountSpan.textContent = `(${totalItems})`;
    }

    const headerBadge = document.querySelector('.cart-badge');
    if (headerBadge) {
      headerBadge.textContent = totalItems;
      headerBadge.style.display = totalItems > 0 ? 'flex' : 'none';
    }

    const bottomBadge = document.querySelector('.bottom-cart-badge');
    if (bottomBadge) {
      bottomBadge.textContent = totalItems;
      bottomBadge.style.display = totalItems > 0 ? 'flex' : 'none';
    }

    const subtotal = cart.reduce((sum, item) => {
      const price = parseFloat(item.price) || 0;
      return sum + (price * item.quantity);
    }, 0);

    if (cartSubtotal) {
      cartSubtotal.textContent = formatPrice(subtotal);
    }

    renderDrawerProgressBanner(cart, subtotal);

    if (cart.length === 0) {
      cartItemsContainer.innerHTML = `
        <div style="text-align: center; padding: 48px 20px; color: #999;">
          <i class="fa-solid fa-cart-shopping" style="font-size: 40px; margin-bottom: 14px; opacity: 0.3;"></i>
          <p style="font-size: 14px; color: #666; margin: 0 0 16px 0;">${t('emptyCart')}</p>
          <a href="${addLocalePrefix('/shop')}" style="display: inline-block; padding: 9px 20px; background: #111; color: #fff; text-decoration: none; border-radius: 2px; font-size: 11.5px; font-weight: 700; letter-spacing: 0.5px;">${t('continueShopping')}</a>
        </div>
      `;
      return;
    }

    cartItemsContainer.innerHTML = cart.map(item => {
      const itemPrice = parseFloat(item.price);
      const itemTotal = itemPrice * item.quantity;
      const itemWeight = parseFloat(item.weight) || 0;
      const totalWeight = itemWeight * item.quantity;
      const cleanCartItemId = String(item.cartItemId || '').trim().replace(/[\s\n\r]+/g, '_');

      let variantsText = '';
      if (item.selectedVariants) {
        variantsText = Object.entries(item.selectedVariants)
          .filter(([_, value]) => value)
          .map(([key, value]) => `${key.charAt(0).toUpperCase() + key.slice(1)}: ${String(value).trim()}`)
          .join(' / ');
      }

      const weightText = itemWeight > 0 ? ` • ${totalWeight.toFixed(3)}kg` : '';

      return `
        <div class="cart-item" data-cart-item-id="${cleanCartItemId}">
          <div class="item-image">
            <img src="${item.image}" alt="${item.name}">
          </div>
          <div class="item-details">
            <div class="item-header">
              <div class="item-info">
                <h3>${item.name}</h3>
                ${variantsText ? `<p class="item-meta">${variantsText}${weightText}</p>` : (weightText ? `<p class="item-meta">${weightText.substring(3)}</p>` : '')}
                <p class="item-price">${formatPrice(itemPrice)}</p>
              </div>
              <button type="button" class="delete-btn" data-action="delete" title="Remove item">
                <i class="fa-regular fa-trash-can"></i>
              </button>
            </div>
            <div class="item-footer">
              <div class="item-quantity">
                <button type="button" class="qty-btn" data-action="decrease">-</button>
                <span class="qty-value">${item.quantity}</span>
                <button type="button" class="qty-btn" data-action="increase">+</button>
              </div>
              <p class="item-total">${formatPrice(itemTotal)}</p>
            </div>
          </div>
        </div>
      `;
    }).join('');
  }

  function updateCartQuantity(cartItemId, newQuantity) {
    if (newQuantity < 1) return;
    const cart = getCart();
    const cleanInputId = String(cartItemId).trim().replace(/[\s\n\r]+/g, '_');

    const item = cart.find(i => {
      const cleanItemId = String(i.cartItemId || '').trim().replace(/[\s\n\r]+/g, '_');
      return cleanItemId === cleanInputId;
    });

    if (item) {
      item.quantity = newQuantity;

      const basePrice = parseFloat(item.basePrice || item.price);
      let finalPrice = basePrice;
      if (newQuantity >= 100) {
        finalPrice = basePrice * 0.90;
      } else if (newQuantity >= 50) {
        finalPrice = basePrice * 0.94;
      } else if (newQuantity >= 10) {
        finalPrice = basePrice * 0.97;
      }
      item.price = finalPrice.toFixed(2);

      saveCart(cart);
      const cartItem = document.querySelector(`[data-cart-item-id="${cleanInputId}"]`);
      if (cartItem) {
        const qtyValue = cartItem.querySelector('.qty-value');
        const itemTotal = cartItem.querySelector('.item-total');
        if (qtyValue) qtyValue.textContent = newQuantity;
        if (itemTotal) {
          itemTotal.textContent = formatPrice(finalPrice * newQuantity);
        }
      }
      updateCartSummary();
    }
  }

  function updateCartSummary() {
    const cart = getCart();
    const totalItems = cart.reduce((sum, item) => sum + item.quantity, 0);
    const cartCountSpan = document.querySelector('.cart-count');
    if (cartCountSpan) {
      cartCountSpan.textContent = `(${totalItems})`;
    }

    const headerBadge = document.querySelector('.cart-badge');
    if (headerBadge) {
      headerBadge.textContent = totalItems;
      headerBadge.style.display = totalItems > 0 ? 'flex' : 'none';
    }

    const bottomBadge = document.querySelector('.bottom-cart-badge');
    if (bottomBadge) {
      bottomBadge.textContent = totalItems;
      bottomBadge.style.display = totalItems > 0 ? 'flex' : 'none';
    }

    const subtotal = cart.reduce((sum, item) => {
      const price = parseFloat(item.price) || 0;
      return sum + (price * item.quantity);
    }, 0);

    const cartTotal = document.getElementById('cartSubtotal');
    if (cartTotal) {
      cartTotal.textContent = formatPrice(subtotal);
    }

    renderDrawerProgressBanner(cart, subtotal);
  }

  function removeCartItem(cartItemId) {
    const cleanInputId = String(cartItemId).trim().replace(/[\s\n\r]+/g, '_');
    const cartItem = document.querySelector(`[data-cart-item-id="${cleanInputId}"]`);

    if (cartItem) {
      let cart = getCart();
      cart = cart.filter(i => {
        const cleanItemId = String(i.cartItemId || '').trim().replace(/[\s\n\r]+/g, '_');
        return cleanItemId !== cleanInputId;
      });
      saveCart(cart);

      cartItem.style.transition = 'transform 0.3s ease-out, opacity 0.3s ease-out';
      cartItem.style.transform = 'translateX(-100%)';
      cartItem.style.opacity = '0';

      setTimeout(() => {
        cartItem.remove();
        const remainingCart = getCart();
        if (remainingCart.length === 0) {
          renderCartItems();
        } else {
          updateCartSummary();
        }
      }, 300);
    } else {
      let cart = getCart();
      cart = cart.filter(i => {
        const cleanItemId = String(i.cartItemId || '').trim().replace(/[\s\n\r]+/g, '_');
        return cleanItemId !== cleanInputId;
      });
      saveCart(cart);
      renderCartItems();
    }
  }

  function toggleCart(isOpen) {
    const overlay = document.getElementById('cartOverlay');
    const drawer = document.getElementById('cartDrawer');

    if (isOpen) {
      overlay?.classList.add('active');
      drawer?.classList.add('active');
      document.body.style.overflow = 'hidden';
      renderCartItems();
    } else {
      overlay?.classList.remove('active');
      drawer?.classList.remove('active');
      document.body.style.overflow = '';
    }
  }

  document.getElementById('cartOverlay')?.addEventListener('click', () => toggleCart(false));
  document.getElementById('closeCart')?.addEventListener('click', () => toggleCart(false));

  document.getElementById('cartItems')?.addEventListener('click', (e) => {
    const button = e.target.closest('button');
    if (!button) return;

    const cartItem = button.closest('.cart-item');
    if (!cartItem) return;

    const cartItemId = cartItem.dataset.cartItemId;
    const action = button.dataset.action;

    if (action === 'delete') {
      removeCartItem(cartItemId);
    } else if (action === 'increase') {
      const qtyValue = cartItem.querySelector('.qty-value');
      const currentQty = parseInt(qtyValue?.textContent || 0);
      updateCartQuantity(cartItemId, currentQty + 1);
    } else if (action === 'decrease') {
      const qtyValue = cartItem.querySelector('.qty-value');
      const currentQty = parseInt(qtyValue?.textContent || 0);
      if (currentQty > 1) {
        updateCartQuantity(cartItemId, currentQty - 1);
      } else {
        removeCartItem(cartItemId);
      }
    }
  });

  // 同步后台圣诞活动开关（含开始/结束时间）与当前用户免邮门槛
  window.__ebFreeShippingThreshold = 25;
  async function syncDynamicFreeShippingThreshold() {
    try {
      // 1. 并行查询登录状态与圣诞大促开关状态
      const [meRes, xmasStatusRes] = await Promise.all([
        fetch('/api/auth/me').catch(() => null),
        fetch('https://api.ebbellejewelry.com/wp-json/ebbelle/v1/christmas/status').catch(() => null)
      ]);

      if (xmasStatusRes && xmasStatusRes.ok) {
        const xData = await xmasStatusRes.json();
        window.__ebXmasPromoActive = Boolean(xData && xData.promo_active);
      }

      if (meRes && meRes.ok) {
        const meData = await meRes.json();
        if (meData && meData.authenticated && meData.user && meData.user.email) {
          const calcRes = await fetch('/api/woocommerce/calculate', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              email: meData.user.email,
              subtotal: 10,
              country: 'US'
            })
          });
          const calcData = await calcRes.json();
          if (calcData && calcData.success) {
            window.__ebIsNewCustomer = typeof calcData.is_new_customer === 'boolean' ? calcData.is_new_customer : true;
            if (typeof calcData.xmas_promo_active === 'boolean') {
              window.__ebXmasPromoActive = calcData.xmas_promo_active;
            }
            if (typeof calcData.free_shipping_min === 'number' && calcData.free_shipping_min > 0) {
              window.__ebFreeShippingThreshold = calcData.free_shipping_min;
            } else {
              window.__ebFreeShippingThreshold = window.__ebIsNewCustomer ? 25 : 50;
            }
          }
        }
      }

      renderCartItems();
    } catch (e) {}
  }

  window.addEventListener('cartUpdated', renderCartItems);
  document.addEventListener('DOMContentLoaded', () => {
    renderCartItems();
    syncDynamicFreeShippingThreshold();
  });

  window.addEventListener('currencyChanged', () => {
    renderCartItems();
  });

  window.toggleCart = toggleCart;
  window.updateCartQuantity = updateCartQuantity;
  window.removeCartItem = removeCartItem;
</script>