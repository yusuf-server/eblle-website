      background: #fff;
      border-top: 1px solid #ddd8ce;
      border-bottom: 1px solid #ddd8ce;
    }
    .flash-header {
      padding: 0 16px;
      margin-bottom: 12px;
    }
    .flash-header h2 {
      font-size: 16px;
      font-weight: 500;
      letter-spacing: 0.05em;
    }
    .countdown-timer {
      font-size: 10px;
      gap: 2px;
    }
    .timer-box {
      min-width: 24px;
      height: 24px;
      font-size: 10px;
      padding: 4px;
    }
    .view-all-link {
      font-size: 12px;
    }

    /* Product Grid - Horizontal Scroll */
    .product-grid-6 {
      display: flex;
      gap: 12px;
      padding: 0 16px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      -ms-overflow-style: none;
      grid-template-columns: none;
    }
    .product-grid-6::-webkit-scrollbar {
      display: none;
    }
    .product-card {
      flex: 0 0 144px;
      width: 144px;
      scroll-snap-align: start;
