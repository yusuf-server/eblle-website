---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/CartDrawer.astro';
import AuthModal from '../components/AuthModal.astro';
import ProductSkeleton from '../components/ProductSkeleton.astro';
import OptimizedImage from '../components/OptimizedImage.astro';
import { getCategories } from '../lib/woocommerce';
import { getProductsWithPrices } from '../lib/productCache';
import { getHomepageData, parseACFLink, parseACFImage } from '../lib/wordpress';
import { optimizeACFImage } from '../lib/imageOptimizer';

// 获取首页动态数据
const heroData = await getHomepageData();

// 解析 Hero Main Banner 数据（带默认值回退）
// 注意：根据实际 API 返回的扁平结构进行调整
const mainBanner = heroData ? {
  image: parseACFImage(heroData.main_image),
  title: heroData.main_title || 'Timeless Elegance',
  description: heroData.main_description || 'Discover our handcrafted collection of 316L Stainless Steel & PVD Gold jewelry.',
  buttonText: heroData.button_text || 'Shop Now',
  buttonLink: parseACFLink(heroData.button_link),
} : {
  // 默认值
  image: {
    url: 'https://images.unsplash.com/photo-1515562141207-7a88fb7ce338?w=1200&q=80',
    alt: 'Main Jewelry Collection',
  },
  title: 'Timeless Elegance',
  description: 'Discover our handcrafted collection of 316L Stainless Steel & PVD Gold jewelry.',
  buttonText: 'Shop Now',
  buttonLink: { url: '/shop', title: 'Shop Now', target: '' },
};

// 解析 Mid Card 1 数据
const midCard1 = heroData ? {
  image: parseACFImage(heroData.mid1_image),
  label: heroData.mid1_label || 'Explore',
  title: heroData.mid1_title || 'New Collections',
  link: parseACFLink(heroData.mid1_link),
} : {
  // 默认值
  image: {
    url: 'https://images.unsplash.com/photo-1539571696357-5a69c17a67c6?w=500&q=80',
    alt: 'New Collections',
  },
  label: 'Explore',
  title: 'New Collections',
  link: { url: '/shop', title: '', target: '' },
};

// 解析 Mid Card 2 数据
const midCard2 = heroData ? {
  image: parseACFImage(heroData.mid2_image),
  label: heroData.mid2_label || 'Trending',
  title: heroData.mid2_title || 'Now Collections',
  link: parseACFLink(heroData.mid2_link),
} : {
  // 默认值
  image: {
    url: 'https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?w=500&q=80',
    alt: 'Trending',
  },
  label: 'Trending',
  title: 'Now Collections',
  link: { url: '/shop', title: '', target: '' },
};

// 解析移动端 Hero Banner 数据
const mobileHeroBanner = heroData ? {
  image: parseACFImage(heroData.mobile_hero_image),
  subtitle: heroData.mobile_hero_subtitle || 'Collection 2026',
  title: heroData.mobile_hero_title || 'Timeless Elegance',
  description: heroData.mobile_hero_description || '316L Stainless Steel & PVD Gold.',
  buttonText: heroData.mobile_hero_button_text || 'Shop Now',
  buttonLink: parseACFLink(heroData.mobile_hero_button_link),
} : {
  // 默认值
  image: {
    url: 'https://images.unsplash.com/photo-1515562141207-7a88fb7ce338?w=800&q=80',
    alt: 'Hero',
  },
  subtitle: 'Collection 2026',
  title: 'Timeless Elegance',
  description: '316L Stainless Steel & PVD Gold.',
  buttonText: 'Shop Now',
  buttonLink: { url: '/shop', title: '', target: '' },
};

// 解析移动端 Sub Card 1
const mobileSubCard1 = heroData ? {
  image: parseACFImage(heroData.mobile_sub1_image),
  tag: heroData.mobile_sub1_tag || 'Explore',
  title: heroData.mobile_sub1_title || 'New Collections',
  link: parseACFLink(heroData.mobile_sub1_link),
} : {
  // 默认值
  image: {
    url: 'https://images.unsplash.com/photo-1539571696357-5a69c17a67c6?w=500&q=80',
    alt: 'New Collections',
  },
  tag: 'Explore',
  title: 'New Collections',
  link: { url: '/shop', title: '', target: '' },
};

// 解析移动端 Sub Card 2
const mobileSubCard2 = heroData ? {
  image: parseACFImage(heroData.mobile_sub2_image),
  tag: heroData.mobile_sub2_tag || 'Trending',
  title: heroData.mobile_sub2_title || 'Now Collections',
  link: parseACFLink(heroData.mobile_sub2_link),
} : {
  // 默认值
  image: {
    url: 'https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?w=500&q=80',
    alt: 'Trending',
  },
  tag: 'Trending',
  title: 'Now Collections',
  link: { url: '/shop', title: '', target: '' },
};

// 解析 New Arrivals Section 数据
const newArrivalsTitle = heroData?.new_arrivals_title || 'NEW ARRIVALS / WATERPROOF';
const newArrivalsColumns = heroData?.new_arrivals_columns || [];
const mobileArrivalsColumns = heroData?.mobile_arrivals_columns || [];

// 解析 Campaign Section 数据
const campaignTitle = heroData?.campaign_title || 'CAMPAIGN ZONE';
const campaignCards = heroData?.campaign_cards || [];
const useSameCampaignData = heroData?.mobile_campaign_cards !== false; // 默认为 true

// 解析 Reviews Section 数据
const reviewsTitle = heroData?.reviews_title || 'What Our Clients Say';
const reviewImages = heroData?.review_images || [];
const autoplayEnabled = heroData?.autoplay_enabled !== false; // 默认为 true
const autoplayInterval = heroData?.autoplay_interval || 5;
const mobileUseSameImages = heroData?.mobile_use_same_images !== false; // 默认为 true

// 调试：查看 reviews 数据
console.log('=== Reviews Debug ===');
console.log('reviewImages length:', reviewImages.length);
console.log('reviewImages:', JSON.stringify(reviewImages, null, 2));

// 获取 Instagram 帖子
const INSTAGRAM_ACCESS_TOKEN = 'IGAAHKoYxeZA3JBZAGI5eVltcy1zSzRPWEJfVXJMWnZAMU25DWkI5eEh0clViQjF0THJ6a20wSWdaM1hQRlp0ZAFVvSE9ScC1KT3VFUzU4T3ZAXbzZAGOFlYbkZAweFA4Ul90MVlBU3Jza3NZATjhDdldIOWYyUXVn';
const INSTAGRAM_API_URL = `https://graph.instagram.com/me/media?fields=id,caption,media_type,media_url,thumbnail_url,permalink&access_token=${INSTAGRAM_ACCESS_TOKEN}&limit=4`;

let instagramPosts = [];
try {
  const response = await fetch(INSTAGRAM_API_URL);
  const data = await response.json();

  if (data.data) {
    instagramPosts = data.data.map((post) => ({
      id: post.id,
      caption: post.caption || '',
      media_type: post.media_type, // IMAGE, VIDEO, CAROUSEL_ALBUM
      media_url: post.media_url, // 图片或视频的 URL
      thumbnail_url: post.thumbnail_url || post.media_url, // 视频缩略图
      permalink: post.permalink,
      is_video: post.media_type === 'VIDEO'
    }));
  }

  console.log('=== Instagram Posts Debug ===');
  console.log('Posts loaded:', instagramPosts.length);
  console.log('First post:', instagramPosts[0]);
} catch (error) {
  console.error('Failed to fetch Instagram posts:', error);
}

// 解析 FAQ Gallery Section 数据
const faqSectionTitle = heroData?.faq_section_title || 'E.B.Belle: 316L Stainless Steel & PVD Plating Excellence';
const galleryImages = heroData?.gallery_images || [];
const faqItems = heroData?.faq_items || [];
const mobileFaqTitle = heroData?.mobile_faq_title || 'E.B.Belle: 316L Stainless Steel Excellence';
const mobileUseSameFaqData = heroData?.mobile_use_same_data !== false; // 默认为 true

// 调试：查看 FAQ 数据
console.log('=== FAQ Gallery Debug ===');
console.log('galleryImages length:', galleryImages.length);
console.log('faqItems length:', faqItems.length);

// 调试：查看 campaign 数据结构
console.log('=== Campaign Cards Debug ===');
console.log('campaignCards length:', campaignCards.length);
if (campaignCards.length > 0) {
  console.log('First card:', JSON.stringify(campaignCards[0], null, 2));
}

// 调试：查看 mobile arrivals 数据
console.log('=== Mobile Arrivals Debug ===');
console.log('mobileArrivalsColumns length:', mobileArrivalsColumns.length);
if (mobileArrivalsColumns.length > 0) {
  console.log('First mobile column:', JSON.stringify(mobileArrivalsColumns[0], null, 2));
}

// 获取产品数据 - 使用优化的缓存系统
let flashSaleProducts = [];
try {
  console.log('正在获取 enamel-cuff-bangles 分类的产品...');
  flashSaleProducts = await getProductsWithPrices({
    per_page: 6,
    category: 942, // enamel-cuff-bangles
    orderby: 'date',
    order: 'desc'
  });
  console.log(`✓ 成功获取 ${flashSaleProducts.length} 个产品`);
} catch (error) {
  console.error('获取Flash Sale产品失败:', error);
}

const categories = await getCategories({ per_page: 10 });

// 静态产品数据（用于展示）
const staticProducts = [
  {
    name: 'Gold Fam Gold Earrings & Pearl',
    image: 'https://images.unsplash.com/photo-1630019852942-f89202989a59?w=300&q=80',
    price: '11.50',
    oldPrice: '29.90',
    discount: 32
  },
  {
    name: 'Gold Sam Bracelet Stainless...',
    image: 'https://images.unsplash.com/photo-1611591475806-03c09b0b4b2c?w=300&q=80',
    price: '15.50',
    oldPrice: '28.00',
    discount: 50
  },
  {
    name: 'Gold Fam Bracelet Special...',
    image: 'https://images.unsplash.com/photo-1600003014755-ba31aa59c4b6?w=300&q=80',
    price: '11.00',
    oldPrice: '16.00',
    discount: 50
  },
  {
    name: 'Gold Stud Earrings With Dr...',
    image: 'https://images.unsplash.com/photo-1535632066927-ab7c9ab60908?w=300&q=80',
    price: '14.00',
    oldPrice: '10.00',
    discount: 50
  },
  {
    name: 'Gold Stainless Gold Bot...',
    image: 'https://images.unsplash.com/photo-1617038220319-276d3cfab638?w=300&q=80',
    price: '17.00',
    oldPrice: '19.00',
    discount: 50
  },
  {
    name: 'Gold Bracelet Sound Set...',
    image: 'https://images.unsplash.com/photo-1598560917505-59a3ad559071?w=300&q=80',
    price: '21.00',
    oldPrice: '11.00',
    discount: 50
  }
];
---

<Layout title="E.B.Belle - Jewelry Store">
  <!-- 预加载关键图片（优化后的版本） -->
  <link rel="preload" as="image" href={mainBanner.image.url || mainBanner.image.src} slot="head" />
  {mobileHeroBanner.image.url && (
    <link rel="preload" as="image" href={mobileHeroBanner.image.url} slot="head" media="(max-width: 768px)" />
  )}

  <Header />

  <!-- 4. HERO SECTION -->
  <section class="hero-section">
    <div class="container">
      <div class="hero-grid">
        <!-- Main Large Banner -->
        <div class="hero-main-card">
          <OptimizedImage
            src={mainBanner.image.url || mainBanner.image.src}
            alt={mainBanner.image.alt || 'Main Jewelry Collection'}
            width={mainBanner.image.width || 1200}
            height={mainBanner.image.height || 600}
            srcset={mainBanner.image.srcset}
            webp={mainBanner.image.webp}
            priority={true}
            loading="eager"
            class="hero-banner-img"
          />
          <div class="hero-overlay">
            <h2 class="serif-title">{mainBanner.title}</h2>
            <p>{mainBanner.description}</p>
            <a
              href={mainBanner.buttonLink.url}
              class="btn-shop-now"
              target={mainBanner.buttonLink.target}
            >
              {mainBanner.buttonText}
            </a>
          </div>
        </div>

        <!-- Mid Sub Banners -->
        <div class="hero-mid-card">
          <a
            href={midCard1.link.url}
            class="mid-sub-card"
            target={midCard1.link.target}
          >
            <OptimizedImage
              src={midCard1.image.url || midCard1.image.src}
              alt={midCard1.image.alt || 'New Collections'}
              width={midCard1.image.width || 500}
              height={midCard1.image.height || 500}
              srcset={midCard1.image.srcset}
              webp={midCard1.image.webp}
              priority={true}
              loading="eager"
              class="mid-card-img"
            />
            <div class="mid-card-overlay">
              <span>{midCard1.label}</span>
              <h3>{midCard1.title}</h3>
            </div>
          </a>
          <a
            href={midCard2.link.url}
            class="mid-sub-card"
            target={midCard2.link.target}
          >
            <OptimizedImage
              src={midCard2.image.url || midCard2.image.src}
              alt={midCard2.image.alt || 'Trending Now'}
              width={midCard2.image.width || 500}
              height={midCard2.image.height || 500}
              srcset={midCard2.image.srcset}
              webp={midCard2.image.webp}
              priority={true}
              loading="eager"
              class="mid-card-img"
            />
            <div class="mid-card-overlay">
              <span>{midCard2.label}</span>
              <h3>{midCard2.title}</h3>
            </div>
          </a>
        </div>

        <!-- Right Side Login & Coupon -->
        <div class="hero-right-card">
          <!-- 未登录状态 -->
          <div class="user-auth-box" id="authBoxGuest">
            <div class="avatar-icon">
              <i class="fa-regular fa-user"></i>
            </div>
            <p>Hello, Welcome to E.B.Belle</p>
            <div class="auth-btns">
              <button type="button" class="btn-login" onclick="openAuthModal('login')">Login</button>
              <button type="button" class="btn-reg" onclick="openAuthModal('register')">Register</button>
            </div>
          </div>

          <!-- 已登录状态 -->
          <div class="user-auth-box user-auth-logged-in" id="authBoxLoggedIn" style="display: none;">
            <div class="avatar-icon logged-in">
              <i class="fa-solid fa-user"></i>
            </div>
            <p class="welcome-text" id="welcomeText">Hello <strong id="userName">User</strong>, welcome to E.B.Belle</p>
            <div class="auth-btns-logged">
              <button type="button" class="btn-account" onclick="window.location.href='/account'">
                <i class="fa-solid fa-user-gear"></i>
                <span>Account</span>
              </button>
              <button type="button" class="btn-logout" onclick="handleLogout()">
                <i class="fa-solid fa-arrow-right-from-bracket"></i>
                <span>Logout</span>
              </button>
            </div>
          </div>

          <div class="coupon-box">
            <div class="vip-badge">VIP</div>
            <span class="badge">NEW USER BENEFITS</span>
            <h3>$130 Value</h3>
            <span class="coupon-subtitle">EXCLUSIVE COUPONS</span>
            <a href="#" class="btn-coupon">New User Deal</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. FLASH SALES -->
  <section class="flash-sales-section">
    <div class="container">
      <div class="section-header-row">
        <div class="flash-title-area">
          <h2 class="section-title">FLASH SALES</h2>
          <div class="countdown-timer">
            <span class="time-block">00</span>
            <span class="time-separator">:</span>
            <span class="time-block">07</span>
            <span class="time-separator">:</span>
            <span class="time-block">21</span>
          </div>
        </div>
        <a href="#" class="view-more">View More <i class="fa-solid fa-chevron-right"></i></a>
      </div>
      <div class="product-grid-6">
        {flashSaleProducts.length > 0 ? (
          flashSaleProducts.map((product) => {
            // 计算折扣百分比
            const hasDiscount = product.regular_price && product.price && parseFloat(product.regular_price) > parseFloat(product.price);
            const discountPercent = hasDiscount
              ? Math.round(((parseFloat(product.regular_price) - parseFloat(product.price)) / parseFloat(product.regular_price)) * 100)
              : 0;

            return (
              <div class="product-card">
                <a href={`/product/${product.slug}`}>
                  <div class="product-img-wrap">
                    {hasDiscount && (
                      <span class="product-badge discount-badge">
                        -{discountPercent}%
                      </span>
                    )}
                    <img
                      src={product.images[0]?.src || 'https://images.unsplash.com/photo-1515562141207-7a88fb7ce338?w=300&q=80'}
                      alt={product.name}
                      loading="lazy"
                    />
                  </div>
                  <div class="product-info">
                    <h3 class="product-name">{product.name}</h3>
                    <div class="price-wrap">
                      <span class="current-price">${product.price}</span>
                      {hasDiscount && (
                        <span class="old-price">${product.regular_price}</span>
                      )}
                    </div>
                  </div>
                </a>
              </div>
            );
          })
        ) : (
          <ProductSkeleton count={6} columns={6} />
        )}
      </div>
    </div>
  </section>

  <!-- 6. TRUST BADGES -->
  <section class="trust-badges">
    <div class="container">
      <div class="trust-grid">
        <div class="trust-item">
          <i class="fa-solid fa-plane-departure"></i>
          <h5>WORLDWIDE SHIPPING</h5>
          <p>Fast delivery to your door</p>
        </div>
        <div class="trust-item">
          <i class="fa-regular fa-gem"></i>
          <h5>SKIN-FRIENDLY</h5>
          <p>Hypoallergenic Waterproof Jewelry</p>
        </div>
        <div class="trust-item">
          <i class="fa-solid fa-industry"></i>
          <h5>FACTORY DIRECT SUPPLY</h5>
          <p>Competitive pricing No MOQ</p>
        </div>
        <div class="trust-item">
          <i class="fa-solid fa-headset"></i>
          <h5>DEDICATED ACCOUNT</h5>
          <p>Professional service manager</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. NEW ARRIVALS / WATERPROOF -->
  <section class="new-arrivals-section">
    <div class="container">
      <h2 class="arrivals-title">{newArrivalsTitle}</h2>
      <div class="arrivals-grid">
        {newArrivalsColumns.length > 0 ? (
          newArrivalsColumns.map((column) => (
            <div class="arrivals-column">
              <h3 class="column-title">{column.column_title}</h3>

              {column.product_groups?.map((group) => {
                const groupLink = parseACFLink(group.group_link);
                const GroupWrapper = groupLink.url ? 'a' : 'div';

                return (
                  <GroupWrapper
                    href={groupLink.url || undefined}
                    target={groupLink.target || undefined}
                    class="product-group"
                  >
                    <div class="group-images">
                      <div class="images-row">
                        <OptimizedImage
                          src={group.large_image}
                          alt={group.group_name}
                          width={400}
                          height={400}
                          loading="lazy"
                          class="large-img"
                        />
                        <div class="small-imgs">
                          {group.small_images?.map((smallImg) => (
                            <OptimizedImage
                              src={smallImg.image}
                              alt=""
                              width={200}
                              height={200}
                              loading="lazy"
                            />
                          ))}
                        </div>
                      </div>
                    </div>
                    <p class="group-name">{group.group_name}</p>
                    <p class="group-count">{group.group_count}</p>
                  </GroupWrapper>
                );
              })}

              {column.quick_links && column.quick_links.length > 0 && (
                <div class="quick-links">
                  {column.quick_links.map((link) => {
                    const linkUrl = parseACFLink(link.link_url);
                    return (
                      <a href={linkUrl.url} target={linkUrl.target}>
                        {link.link_text}
                      </a>
                    );
                  })}
                </div>
              )}

              {column.view_more_link?.text && (
                <a
                  href={parseACFLink(column.view_more_link.url).url}
                  class="view-more-link"
                  target={parseACFLink(column.view_more_link.url).target}
                >
                  {column.view_more_link.text} →
                </a>
              )}
            </div>
          ))
        ) : (
          // 默认内容（如果没有配置）
          <>
            <div class="arrivals-column">
              <h3 class="column-title">8.1st - 8.7th</h3>
              <div class="product-group">
                <div class="group-images">
                  <div class="images-row">
                    <OptimizedImage
                      src="https://images.unsplash.com/photo-1515562141207-7a88fb7ce338?w=400&q=80"
                      alt="Halloween"
                      width={400}
                      height={400}
                      loading="lazy"
                      class="large-img"
                    />
                    <div class="small-imgs">
                      <OptimizedImage
                        src="https://images.unsplash.com/photo-1611591475806-03c09b0b4b2c?w=200&q=80"
                        alt=""
                        width={200}
                        height={200}
                        loading="lazy"
                      />
                      <OptimizedImage
                        src="https://images.unsplash.com/photo-1600003014755-ba31aa59c4b6?w=200&q=80"
                        alt=""
                        width={200}
                        height={200}
                        loading="lazy"
                      />
                      <OptimizedImage
                        src="https://images.unsplash.com/photo-1535632066927-ab7c9ab60908?w=200&q=80"
                        alt=""
                        width={200}
                        height={200}
                        loading="lazy"
                      />
                      <OptimizedImage
                        src="https://images.unsplash.com/photo-1617038220319-276d3cfab638?w=200&q=80"
                        alt=""
                        width={200}
                        height={200}
                        loading="lazy"
                      />
                    </div>
                  </div>
                </div>
                <p class="group-name">Halloween</p>
                <p class="group-count">10k+ Products</p>
              </div>
            </div>
          </>
        )}
      </div>
    </div>
  </section>

  <!-- 8. SHOP BY CATEGORY -->
  <section class="shop-by-cat-section">
    <div class="container">
      <h3 class="serif-title">Shop by Category</h3>
      <div class="cat-icon-row">
        <div class="cat-icon-item">
          <div class="cat-icon-circle"><i class="fa-regular fa-circle-dot"></i></div>
          <span>Rings</span>
        </div>
        <div class="cat-icon-item">
          <div class="cat-icon-circle"><i class="fa-solid fa-link"></i></div>
          <span>Bracelets</span>
        </div>
        <div class="cat-icon-item">
          <div class="cat-icon-circle"><i class="fa-regular fa-gem"></i></div>
          <span>Necklaces</span>
        </div>
        <div class="cat-icon-item">
          <div class="cat-icon-circle"><i class="fa-solid fa-ring"></i></div>
          <span>Anklets</span>
        </div>
        <div class="cat-icon-item">
          <div class="cat-icon-circle"><i class="fa-solid fa-shield-halved"></i></div>
          <span>Body Chains</span>
        </div>
        <div class="cat-icon-item">
          <div class="cat-icon-circle"><i class="fa-regular fa-snowflake"></i></div>
          <span>Earrings</span>
        </div>
        <div class="cat-icon-item">
          <div class="cat-icon-circle"><i class="fa-solid fa-ellipsis"></i></div>
          <span>More</span>
