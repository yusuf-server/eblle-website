<script define:vars={{ autoplayEnabled, autoplayInterval }}>
// Reviews Slider - 桌面端（显示3张，每次滑动1张）
function initReviewsSlider() {
  const slider = document.querySelector('.reviews-slider');
  if (!slider) return;

  const track = slider.querySelector('.reviews-track');
  const slides = slider.querySelectorAll('.review-slide');
  const prevBtn = slider.querySelector('.slider-prev');
  const nextBtn = slider.querySelector('.slider-next');

  if (slides.length <= 3) {
    // 如果图片数量 <= 3，隐藏按钮，不需要滑动
    prevBtn?.style.setProperty('display', 'none');
    nextBtn?.style.setProperty('display', 'none');
    return;
  }

  let currentIndex = 0;
  let autoplayTimer = null;
  const slidesToShow = 3;
  const maxIndex = slides.length - slidesToShow;

  function updateSlider() {
    const slideWidth = slides[0].offsetWidth;
    const gap = 16; // CSS gap
    const offset = -(currentIndex * (slideWidth + gap));
    track.style.transform = `translateX(${offset}px)`;

    // 禁用按钮在边界
    prevBtn.disabled = currentIndex === 0;
    nextBtn.disabled = currentIndex >= maxIndex;

    prevBtn.style.opacity = currentIndex === 0 ? '0.5' : '1';
    nextBtn.style.opacity = currentIndex >= maxIndex ? '0.5' : '1';
  }

  function nextSlide() {
    if (currentIndex < maxIndex) {
      currentIndex++;
      updateSlider();
    } else {
      // 循环到开头
      currentIndex = 0;
      updateSlider();
    }
  }

  function prevSlide() {
    if (currentIndex > 0) {
      currentIndex--;
      updateSlider();
    }
  }

  function startAutoplay() {
    if (autoplayEnabled) {
      autoplayTimer = setInterval(nextSlide, autoplayInterval * 1000);
    }
  }

  function stopAutoplay() {
    if (autoplayTimer) {
      clearInterval(autoplayTimer);
      autoplayTimer = null;
    }
  }

  prevBtn?.addEventListener('click', () => {
    stopAutoplay();
    prevSlide();
    startAutoplay();
  });

  nextBtn?.addEventListener('click', () => {
    stopAutoplay();
    nextSlide();
    startAutoplay();
  });

  // 初始化
  updateSlider();
  startAutoplay();
}

// Reviews Slider - 移动端（无缝无限循环 + 手势支持）
function initMobileReviewsSlider() {
  const slider = document.querySelector('.mobile-reviews-slider');
  if (!slider) return;

  const track = slider.querySelector('.mobile-reviews-track');
  const originalSlides = Array.from(slider.querySelectorAll('.mobile-review-slide'));
  const prevBtn = slider.querySelector('.mobile-slider-prev');
  const nextBtn = slider.querySelector('.mobile-slider-next');

  if (originalSlides.length <= 1) return;

  // 克隆首尾图片实现无缝循环
  const firstClone = originalSlides[0].cloneNode(true);
  const lastClone = originalSlides[originalSlides.length - 1].cloneNode(true);

  track.appendChild(firstClone);
  track.insertBefore(lastClone, originalSlides[0]);

  const slides = track.querySelectorAll('.mobile-review-slide');
  let currentIndex = 1; // 从第一个真实slide开始（因为前面有一个克隆）
  let autoplayTimer = null;
  let startX = 0;
  let currentX = 0;
  let isDragging = false;

  function updateSlider(animate = true) {
    if (animate) {
      track.style.transition = 'transform 0.5s ease-in-out';
    } else {
      track.style.transition = 'none';
    }
    const slideWidth = slides[0].offsetWidth;
    const offset = -currentIndex * slideWidth;
    track.style.transform = `translateX(${offset}px)`;
  }

  function handleTransitionEnd() {
    const slideWidth = slides[0].offsetWidth;
    // 无缝循环：到达克隆位置时立即跳转到真实位置
    if (currentIndex === 0) {
      track.style.transition = 'none';
      currentIndex = originalSlides.length;
      track.style.transform = `translateX(${-currentIndex * slideWidth}px)`;
    } else if (currentIndex === slides.length - 1) {
      track.style.transition = 'none';
      currentIndex = 1;
      track.style.transform = `translateX(${-currentIndex * slideWidth}px)`;
    }
  }

  track.addEventListener('transitionend', handleTransitionEnd);

  function nextSlide() {
    currentIndex++;
    updateSlider();
  }

  function prevSlide() {
    currentIndex--;
    updateSlider();
  }

  function startAutoplay() {
    if (autoplayEnabled) {
      autoplayTimer = setInterval(nextSlide, autoplayInterval * 1000);
    }
  }

  function stopAutoplay() {
    if (autoplayTimer) {
      clearInterval(autoplayTimer);
      autoplayTimer = null;
    }
  }

  // 触摸事件
  track.addEventListener('touchstart', (e) => {
    startX = e.touches[0].clientX;
    currentX = startX;
    isDragging = true;
    stopAutoplay();
    track.style.transition = 'none';
  });

  track.addEventListener('touchmove', (e) => {
    if (!isDragging) return;
    currentX = e.touches[0].clientX;
    const diff = currentX - startX;
    const slideWidth = slides[0].offsetWidth;
    const offset = -currentIndex * slideWidth + diff;
    track.style.transform = `translateX(${offset}px)`;
  });

  track.addEventListener('touchend', () => {
    if (!isDragging) return;
    isDragging = false;
    const diff = currentX - startX;
    const threshold = track.offsetWidth * 0.2;

    if (Math.abs(diff) > threshold) {
      if (diff > 0) {
        prevSlide();
      } else {
        nextSlide();
      }
    } else {
      updateSlider();
    }
    startAutoplay();
  });

  // 鼠标事件
  track.addEventListener('mousedown', (e) => {
    startX = e.clientX;
    currentX = startX;
    isDragging = true;
    stopAutoplay();
    track.style.transition = 'none';
    e.preventDefault();
  });

  track.addEventListener('mousemove', (e) => {
    if (!isDragging) return;
    currentX = e.clientX;
    const diff = currentX - startX;
    const slideWidth = slides[0].offsetWidth;
    const offset = -currentIndex * slideWidth + diff;
    track.style.transform = `translateX(${offset}px)`;
  });

  track.addEventListener('mouseup', () => {
    if (!isDragging) return;
    isDragging = false;
    const diff = currentX - startX;
    const threshold = track.offsetWidth * 0.2;

    if (Math.abs(diff) > threshold) {
      if (diff > 0) {
        prevSlide();
      } else {
        nextSlide();
      }
    } else {
      updateSlider();
    }
    startAutoplay();
  });

  track.addEventListener('mouseleave', () => {
    if (isDragging) {
      isDragging = false;
      updateSlider();
      startAutoplay();
    }
  });

  prevBtn?.addEventListener('click', () => {
    stopAutoplay();
    prevSlide();
    startAutoplay();
  });

  nextBtn?.addEventListener('click', () => {
    stopAutoplay();
    nextSlide();
    startAutoplay();
  });

  // 初始化
  updateSlider(false);
  startAutoplay();
}

// 页面加载后初始化
document.addEventListener('DOMContentLoaded', () => {
  initReviewsSlider();
  initMobileReviewsSlider();

  // Instagram 视频播放功能
  document.querySelectorAll('.play-btn, .instagram-play-icon').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();

      // 找到对应的视频元素
      const container = btn.closest('.feed-img-box, .instagram-image');
      const video = container.querySelector('video');

      if (video) {
        // 隐藏播放按钮
        btn.style.display = 'none';

        // 播放视频
        video.controls = true;
        video.play();

        // 视频暂停时重新显示播放按钮
        video.addEventListener('pause', () => {
          if (video.currentTime < video.duration) {
            btn.style.display = 'flex';
            video.controls = false;
          }
        });

        // 视频结束时重新显示播放按钮
        video.addEventListener('ended', () => {
          btn.style.display = 'flex';
          video.controls = false;
          video.currentTime = 0;
        });
      }
    });
  });

  // 桌面端 FAQ 手风琴
  document.querySelectorAll('.faq-gallery-section .accordion-header').forEach((header) => {
    header.addEventListener('click', () => {
      const item = header.parentElement;
      const body = item.querySelector('.accordion-body');
      const isActive = item.classList.contains('active');

      if (isActive) {
        // 收起
        body.style.maxHeight = body.scrollHeight + 'px';
        requestAnimationFrame(() => {
          body.style.maxHeight = '0';
        });
        item.classList.remove('active');
      } else {
        // 展开
        item.classList.add('active');
        body.style.maxHeight = body.scrollHeight + 'px';

        // 动画结束后移除固定高度，允许内容自适应
        body.addEventListener('transitionend', function handler() {
          if (item.classList.contains('active')) {
            body.style.maxHeight = 'none';
          }
          body.removeEventListener('transitionend', handler);
        });
      }
    });
  });

  // 移动端 FAQ 手风琴（使用 onclick 属性已经处理）

  // ============================================
  // 用户登录状态检测与切换
  // ============================================
  function checkUserLoginStatus() {
    const authBoxGuest = document.getElementById('authBoxGuest');
    const authBoxLoggedIn = document.getElementById('authBoxLoggedIn');
    const userNameEl = document.getElementById('userName');

    // 从 localStorage 读取用户信息
    const userDataStr = localStorage.getItem('user');

    if (userDataStr) {
      try {
        const userData = JSON.parse(userDataStr);

        // 显示已登录状态
        if (authBoxGuest) authBoxGuest.style.display = 'none';
        if (authBoxLoggedIn) authBoxLoggedIn.style.display = 'block';

        // 设置用户名显示
        if (userNameEl && userData.firstName) {
          userNameEl.textContent = userData.firstName;
        } else if (userNameEl && userData.email) {
          // 如果没有名字，显示邮箱前缀
          const emailPrefix = userData.email.split('@')[0];
          userNameEl.textContent = emailPrefix;
        }
      } catch (error) {
        console.error('Failed to parse user data:', error);
        // 解析失败，显示未登录状态
        if (authBoxGuest) authBoxGuest.style.display = 'block';
        if (authBoxLoggedIn) authBoxLoggedIn.style.display = 'none';
      }
    } else {
      // 未登录，显示登录/注册按钮
      if (authBoxGuest) authBoxGuest.style.display = 'block';
      if (authBoxLoggedIn) authBoxLoggedIn.style.display = 'none';
    }
  }

  // 注销处理函数
  window.handleLogout = function() {
    // 确认注销
    if (confirm('Are you sure you want to logout?')) {
      // 清除用户数据
      localStorage.removeItem('user');

      // 触发自定义事件通知其他组件
      window.dispatchEvent(new CustomEvent('userLoggedOut'));

      // 刷新页面
      window.location.reload();
    }
  };

  // 监听登录事件
  window.addEventListener('userLoggedIn', function(event) {
    console.log('User logged in:', event.detail);
    checkUserLoginStatus();
  });

  // 页面加载时检查登录状态
  checkUserLoginStatus();
});
</script>
