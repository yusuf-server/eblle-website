    .discount-badge {
      font-size: 9px;
      padding: 2px 6px;
      top: 6px;
      left: 6px;
    }
    .product-info {
      padding: 10px;
    }
    .product-name {
      font-size: 11px;
      line-height: 1.3;
    }
    .product-price {
      font-size: 12px;
    }
    .product-old-price {
      font-size: 10px;
    }

    /* Trust Badges - 2x2 Grid */
    .trust-badges {
      padding: 12px 16px;
      background: #f7f4ee;
      border: 1px solid #ddd8ce;
      border-left: none;
      border-right: none;
      margin: 0;
