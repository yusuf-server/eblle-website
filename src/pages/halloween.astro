---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getProduct } from '../lib/woocommerce';

// ========================================
// ACF 数据获取逻辑
// ========================================

// 从 WordPress ACF API 获取页面字段
async function getACFFields() {
  try {
    const WC_STORE_URL = import.meta.env.WC_STORE_URL || '';
    const response = await fetch(`${WC_STORE_URL}/wp-json/wp/v2/pages?slug=halloween`);
    const pages = await response.json();

    if (!pages || pages.length === 0) {
      console.warn('未找到页面 "活动专区"，使用默认数据');
      return null;
    }

    const page = pages[0];
    return page.acf || null;
  } catch (error) {
    console.error('获取 ACF 数据失败:', error);
    return null;
  }
}

// 从产品 ID 获取 WooCommerce 产品数据
async function getProductData(productId: number | null) {
  if (!productId) return null;
  try {
    const product = await getProduct(productId);
    return product;
  } catch (error) {
    console.error(`获取产品 ${productId} 失败:`, error);
    return null;
  }
}

// 获取 ACF 数据
const acfData = await getACFFields();

// ========================================
// 数据层配置（ACF 数据 + Fallback 默认值）
// ========================================

const announcementData = {
  text: acfData?.announcement_text || 'HALLOWEEN MAGIC IS HERE • VELVET POUCH ON $300+ • CODE: NOCTURNE15',
  code: acfData?.announcement_code || 'NOCTURNE15'
};

const heroData = {
  badge: acfData?.hero_badge || 'Nocturne Édition • October 2026',
  title: acfData?.hero_title_main || 'Halloween',
  titleItalic: acfData?.hero_title_italic || 'Jewelry',
  titleEnd: acfData?.hero_title_end || 'Edit',
  description: acfData?.hero_desc || 'A little dark. A little daring. Made to shine. Discover fine heirloom gold, deep obsidian serpent motifs, and diamond starburst talismans crafted for nocturnal glamour.',
  primaryButton: {
    text: acfData?.hero_btn_primary_text || 'Shop The Collection',
    link: acfData?.hero_btn_primary_url || '#vault-favorites'
  },
  secondaryButton: {
    text: acfData?.hero_btn_secondary_text || 'Explore Editorial',
    link: acfData?.hero_btn_secondary_url || '#atelier-manifesto'
  },
  valuePillars: acfData?.hero_pillars || [
    { title: '18K Gold', subtitle: 'Recycled Solid Gold' },
    { title: 'REACH CERTIFIED', subtitle: 'Conflict-Free Pavé' },
    { title: '48 HRS', subtitle: 'Vault Reserve' }
  ],
  heroImage: acfData?.hero_image || 'https://lh3.googleusercontent.com/aida-public/AB6AXuBOIISihhg43B-qyenK6ep4LY75g_sJHlsWYufPQcSO_PgFudufFmhRDp2NnPe0nmdZ6r_x8KwEYgocFjWrh0NzWrBtNL9masvHFYgFUro99nt-oyatcFc69315_0naNwLRfs7yb9oq9V_Qu_ZE9dg5TeS0Jq7H6PfIHf-iDMe8cA6UNklRHjBQtlKqpkvgkGdCvjARXqhVe5BzQfORzdAcoKb8hPSEKqD36m9oYHXDOyeV266RM48S0Q',
  productPin: {
    top: acfData?.hero_product_pin?.top || '36%',
    right: acfData?.hero_product_pin?.right || '32%',
    category: acfData?.hero_product_pin?.category || 'Ear Architecture',
    name: acfData?.hero_product_pin?.custom_name || 'Starburst Drop Earrings',
    price: acfData?.hero_product_pin?.custom_price_text || '$245 • Diamond Pavé'
  },
  featuredCard: {
    title: acfData?.hero_featured_pill?.title || 'Featured Muse: Nocturne Talisman Suite',
    subtitle: acfData?.hero_featured_pill?.subtitle || 'Limited allocation of 80 bespoke Paris-crafted sets',
    link: acfData?.hero_featured_pill?.link || '#vault-favorites'
  }
};

// Mood Categories Section
const moodData = {
  kicker: acfData?.mood_section_kicker || 'Curated Expressions',
  title: acfData?.mood_section_title || 'Find Your Halloween Mood',
  description: acfData?.mood_section_desc || 'Whether you invoke candlelit mystery, ethereal witchcraft, playful serpent wit, or pure diamond radiance.',
  cards: acfData?.mood_cards || [
    {
      badge: 'Mood 01',
      badge_color: 'secondary',
      title: 'Dark & Mysterious',
      desc: 'Obsidian talismans for late-night allure',
      image: 'https://lh3.googleusercontent.com/aida-public/AB6AXuA-iU76-and114rbnt_POz4_sDjWTAYInZzLj5ICzFD9Rcm0BPswbPmMURI2zqVTm4EdceVZt8pXDRQboY4YlFAH5s9-x6sI8ScYouSb7BS97_uG_LruFIpwlNnycieHpiRD09J-ABL5B2lTiZWgsH_wnVkVQIxtWHUVasBGNGlqvXrPIOHxKW4BhnbMGhMJxKbgvAK-7B9FiF0mMsz6qFQk_FWqOdkVpskMyEQYztnJE1YPAlN1mY79g',
      link: '#vault-favorites'
    },
    {
      badge: 'Mood 02',
      badge_color: 'tertiary',
      title: 'Ethereal Witchcraft',
      desc: 'Moon crescents and selenite shimmer',
      image: 'https://lh3.googleusercontent.com/aida-public/AB6AXuC_Ow_t2rtWN8EX0kHSngC9bRx2HYP7C9F3wH1Q7ViV_JDKn16LXDJOQrSLp8r1-dqEzwqLT3p5HqXrCz7MmpYx9q4bYK_Q1zHdZWLxjxeaKbdUbG42vBJXh04BIdDj0pG9R_7qmOE6v25_I1TUjp4ULT1z7eLF1Gj-I0UUqX7hGBp-CzZ2ym3eWV6aKSk0KhGk6Tgi6q-cSSmL4K_1jtjRqcFXuSW5yYwMlG4aV52LcvR7JBg_4w',
      link: '#vault-favorites'
    },
    {
      badge: 'Mood 03',
      badge_color: 'primary',
      title: 'Playful Serpent',
      desc: 'Bold gold coils with winking ruby eyes',
      image: 'https://lh3.googleusercontent.com/aida-public/AB6AXuDkNaLxlG0JY3PK0N8Yby5S5oD5rW92nBT7gcrjPiC7f6ZK7VqGH3uFP8hBuiGnqLPXnIQlzT3F7yd4Zj5i7K0HqXm5LxPdT8QNqZ1xV8XqVhZqNnBKL1rM3pO7cLT2F5gxGhBqO8pT9qXhVdLx5T0NqPgLzQhBxT7gNdR5pXnOqL9TfHqX3dLgZ1VhT8pNqLxKfGhBqZ5Td',
      link: '#vault-favorites'
    },
    {
      badge: 'Mood 04',
      badge_color: 'primary',
      title: 'Diamond Radiance',
      desc: 'Celestial brilliance meets midnight sky',
      image: 'https://lh3.googleusercontent.com/aida-public/AB6AXuBZqK3LxT8pNhV5gGhBdO7rW92nBT7gcrjPiC7f6ZK7VqGH3uFP8hBuiGnqLPXnIQlzT3F7yd4Zj5i7K0HqXm5LxPdT8QNqZ1xV8XqVhZqNnBKL1rM3pO7cLT2F5gxGhBqO8pT9qXhVdLx5T0NqPgLzQhBxT7gNdR5pXnOqL9TfHqX3dLgZ1VhT8pNqLxKfGhBqZ5TdLxGhVn',
      link: '#vault-favorites'
    }
  ]
};

// Favorites/Products Section - 需要处理 WooCommerce 产品
const favoritesData = {
  kicker: acfData?.favorites_kicker || 'Heirloom Talismans',
  title: acfData?.favorites_title || 'Halloween Favorites',
  description: acfData?.favorites_desc || 'Fine pieces made for every secret bit of magic. Individually numbered and hallmarked in our Parisian atelier.',
  products: [] as any[] // 将在下方异步填充
};

// 异步获取 Favorites 产品数据
if (acfData?.favorite_products && Array.isArray(acfData.favorite_products)) {
  for (const item of acfData.favorite_products) {
    if (item.product) {
      const product = await getProductData(item.product);
      if (product) {
        favoritesData.products.push({
          id: product.id,
          name: product.name,
          image: product.images?.[0]?.src || '',
          price: product.price,
          regular_price: product.regular_price,
          on_sale: product.on_sale,
          category: product.categories?.[0]?.name || '',
          badge_text: item.badge_text || '',
          badge_style: item.badge_style || 'primary',
          subtitle: item.subtitle_override || product.short_description || ''
        });
      }
    }
  }
}

// Manifesto Section
const manifestoData = {
  kicker: acfData?.manifesto_kicker || 'Autumn Atelier Manifesto',
  title: acfData?.manifesto_title || 'Dress a Little Darker.',
  description: acfData?.manifesto_desc || 'Your everyday fine jewelry, infused with an alluring Halloween twist. Transition effortlessly from twilight gatherings to everyday heirloom luxury with tactile obsidian accents and radiant gold silhouettes.',
  buttonText: acfData?.manifesto_btn_text || 'Shop The Editorial →',
  buttonLink: acfData?.manifesto_btn_link || '#vault-favorites',
  image: acfData?.manifesto_image || 'https://lh3.googleusercontent.com/aida-public/placeholder-manifesto.jpg',
  imageTag: acfData?.manifesto_image_tag || 'Place Vendôme Workshop'
};

// Oracle Section - 需要处理 WooCommerce 产品
const oracleData = {
  kicker: acfData?.oracle_kicker || 'Talisman Oracle',
  title: acfData?.oracle_title || 'Pick Your Halloween Energy',
  description: acfData?.oracle_desc || 'Select your nocturnal vibe to reveal your bespoke talisman recommendation attuned to your spirit.',
  items: [] as any[]
};

// 异步获取 Oracle 产品数据
if (acfData?.oracle_items && Array.isArray(acfData.oracle_items)) {
  for (const item of acfData.oracle_items) {
    if (item.product) {
      const product = await getProductData(item.product);
      if (product) {
        oracleData.items.push({
          vibe_key: item.vibe_key,
          chip_label: item.chip_label,
          tag: item.alignment_text,
          quote: item.quote,
          title: product.name,
          desc: item.custom_desc || product.short_description || '',
          price: `$${product.price}`,
          img: product.images?.[0]?.src || ''
        });
      }
    }
  }
}

// 如果没有 ACF 数据，使用默认 Oracle 数据
if (oracleData.items.length === 0) {
  oracleData.items = [
    {
      vibe_key: 'serpent',
      chip_label: 'Serpent',
      tag: 'ALIGNMENT: REBIRTH & INTUITION',
      quote: 'Seductive, commanding, and sovereign as midnight shadow. You shed old skins and rise into power.',
      title: 'The Ouroboros Serpent Band',
      desc: 'Hand-poured Italian Black Enamel & Pavé Brilliants',
      price: '$320',
      img: 'https://lh3.googleusercontent.com/aida-public/placeholder-serpent.jpg'
    },
    {
      vibe_key: 'lunar',
      chip_label: 'Lunar',
      tag: 'ALIGNMENT: GUARDIAN & MYSTERY',
      quote: 'Soft, watchful, and eternally luminous. You guard secrets beneath silver light.',
      title: 'The Crescent Moon Pendant',
      desc: '18K White Gold & Mother of Pearl Inlay',
      price: '$285',
      img: 'https://lh3.googleusercontent.com/aida-public/placeholder-lunar.jpg'
    },
    {
      vibe_key: 'astral',
      chip_label: 'Astral',
      tag: 'ALIGNMENT: BRILLIANCE & AMBITION',
      quote: 'Bold, radiant, and impossibly bright. You claim the spotlight as your birthright.',
      title: 'The Starburst Diamond Ring',
      desc: 'Pavé Diamond Halo & Solid 18K Gold',
      price: '$410',
      img: 'https://lh3.googleusercontent.com/aida-public/placeholder-astral.jpg'
    }
  ];
}

// Privilege Section
const privilegeData = {
  label: acfData?.privilege_label || 'Seasonal Privilege',
  badge: acfData?.privilege_badge || 'ENDS MIDNIGHT OCT 31',
  title: acfData?.privilege_title || 'A Little Halloween Magic',
  description: acfData?.privilege_desc || 'Receive a complimentary hand-stitched Nocturne velvet jewelry pouch and 15% off orders above $300 with code: NOCTURNE15',
  code: acfData?.privilege_code || 'NOCTURNE15',
  buttonText: acfData?.privilege_btn_text || 'Claim Offer & Shop'
};

// Bottom CTA Section
const ctaData = {
  kicker: acfData?.cta_kicker || 'Embrace The Nocturne',
  title: acfData?.cta_title || 'Ready to Add a Little Magic?',
  description: acfData?.cta_desc || 'Discover fine jewelry made for every mood, every night, and every celebration. Sealed with heirloom precision and certified Parisian hallmarking.',
  buttonText: acfData?.cta_btn_text || 'Shop The Collection',
  buttonLink: acfData?.cta_btn_url || '#vault-favorites'
};
---

<Layout title="Halloween Jewelry Edit - E.B.Belle">
  <!-- 引入品牌专属字体与稳定的 FontAwesome 图标库 -->
  <link rel="preconnect" href="https://fonts.googleapis.com" slot="head" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin slot="head" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400;1,600&family=Syne:wght@500;600;700&display=swap" rel="stylesheet" slot="head" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" slot="head" />

  <!-- 加载 Tailwind 引擎与专属 Nocturne 调色盘 -->
  <script is:inline src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <script is:inline>
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            "primary": "#f2ca50",
            "primary-fixed": "#ffe088",
            "secondary": "#ffb59a",
            "secondary-container": "#c04402",
            "on-secondary-container": "#ffece6",
            "tertiary": "#f0bef5",
            "surface": "#131314",
            "surface-container": "#201f20",
            "surface-container-low": "#1c1b1c",
            "surface-container-high": "#2a2a2b",
            "surface-container-highest": "#353436",
            "surface-container-lowest": "#0e0e0f",
            "outline": "#99907c",
            "outline-variant": "#4d4635",
            "on-surface": "#e5e2e3",
            "on-surface-variant": "#d0c5af",
            "on-primary": "#3c2f00"
          },
          fontFamily: {
            "headline-lg": ["Playfair Display", "serif"],
            "headline-sm": ["Playfair Display", "serif"],
            "editorial-italic": ["Playfair Display", "serif"],
            "label-caps": ["Syne", "sans-serif"],
            "label-numeric": ["Syne", "sans-serif"],
            "body-lg": ["Inter", "sans-serif"],
            "body-md": ["Inter", "sans-serif"],
            "body-sm": ["Inter", "sans-serif"]
          }
        }
      }
    };
  </script>

  <!-- 引入站内自带的暗色 Header -->
  <Header isDark={true} />

  <main class="halloween-campaign-page w-full flex flex-col bg-surface font-body-md text-on-surface pb-16 lg:pb-24">
    <!-- 1. 活动公告悬浮顶条 -->
    <div class="w-full bg-secondary-container text-on-secondary-container px-4 py-2.5 flex items-center justify-center gap-2 text-center shadow-md">
      <i class="fa-solid fa-wand-magic-sparkles text-[14px] animate-pulse"></i>
      <p class="font-label-caps text-[10px] lg:text-[11px] tracking-widest uppercase font-semibold leading-tight">
        {announcementData.text}
      </p>
    </div>

    <!-- 2. HERO SECTION -->
    <section class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-16 pt-8 pb-12 lg:py-16 w-full">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        <!-- Hero Left Info -->
        <div class="lg:col-span-5 flex flex-col justify-center">
          <div class="inline-flex items-center gap-2 px-3 py-1 bg-surface-container rounded-full w-fit mb-3 lg:mb-4">
            <span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"></span>
            <span class="font-label-caps text-[10px] lg:text-[11px] text-primary tracking-[0.2em] uppercase">{heroData.badge}</span>
          </div>

          <h1 class="font-headline-lg text-3xl sm:text-4xl lg:text-6xl text-on-surface tracking-tight leading-[1.12] mb-3 lg:mb-4">
            {heroData.title} <br class="hidden sm:inline" />
            <span class="font-editorial-italic italic font-normal text-primary">{heroData.titleItalic}</span> {heroData.titleEnd}
          </h1>

          <p class="font-body-md lg:font-body-lg text-sm lg:text-base text-on-surface-variant font-light max-w-md mb-6 leading-relaxed">
            {heroData.description}
          </p>

          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 lg:gap-4 mb-6 lg:mb-8">
            <a href={heroData.primaryButton.link} class="px-8 py-3.5 bg-primary text-on-primary font-label-caps text-xs uppercase tracking-widest text-center shadow-[0_0_24px_rgba(242,202,80,0.25)] hover:bg-primary-fixed transition-all duration-300 font-semibold flex items-center justify-center gap-2.5">
              <i class="fa-solid fa-bag-shopping text-[15px]"></i>
              <span>{heroData.primaryButton.text}</span>
            </a>
            <a href={heroData.secondaryButton.link} class="px-7 py-3.5 bg-surface-container-low text-on-surface font-label-caps text-xs uppercase tracking-widest text-center hover:bg-surface-container-high transition-all flex items-center justify-center gap-2.5 group">
              <span>{heroData.secondaryButton.text}</span>
              <i class="fa-solid fa-arrow-right text-[13px] text-primary group-hover:translate-x-1 transition-transform"></i>
            </a>
          </div>

          <!-- Value Pillars -->
          <div class="grid grid-cols-3 gap-2 p-3 bg-surface-container-low rounded-lg border border-white/5 text-center">
            {heroData.valuePillars.map((pillar) => (
              <div>
                <span class="font-label-numeric text-primary text-[11px] lg:text-sm font-semibold block">{pillar.title}</span>
                <span class="text-[9.5px] lg:text-xs text-outline leading-tight block mt-0.5">{pillar.subtitle}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Hero Right Visual Card -->
        <div class="lg:col-span-7 relative w-full">
          <div class="relative rounded-2xl overflow-hidden bg-surface-container-lowest shadow-2xl group border border-white/5 aspect-[4/5] sm:aspect-[4/3] lg:aspect-auto lg:h-[560px]">
            <img class="w-full h-full object-cover object-center transition-transform duration-700 group-hover:scale-[1.02]" src={heroData.heroImage} alt="Nocturne Muse" />
            <div class="absolute inset-0 bg-gradient-to-t from-surface-container-lowest via-surface-container-lowest/30 lg:via-transparent to-transparent pointer-events-none"></div>

            <!-- 桌面端微交互光点 (Muse Pin) -->
            <div class="hidden lg:block absolute top-[36%] right-[32%] group/pin cursor-pointer z-20">
              <span class="relative flex h-5 w-5 items-center justify-center">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"></span>
                <span class="relative inline-flex rounded-full h-3 w-3 bg-primary shadow-[0_0_12px_#d4af37]"></span>
              </span>
              <div class="opacity-0 group-hover/pin:opacity-100 pointer-events-none group-hover/pin:pointer-events-auto absolute -top-12 right-6 transition-all duration-300 w-56 p-3 bg-surface-container-high/95 backdrop-blur-md rounded shadow-xl">
                <span class="font-label-caps text-[10px] text-primary block uppercase tracking-wider">{heroData.productPin.category}</span>
                <span class="font-headline-sm text-sm text-on-surface font-semibold block">{heroData.productPin.name}</span>
                <span class="font-label-numeric text-xs text-on-surface-variant block mt-0.5">{heroData.productPin.price}</span>
              </div>
            </div>

            <!-- 底部悬浮卡片 -->
            <div class="absolute bottom-3 left-3 right-3 sm:bottom-4 sm:left-4 sm:right-4 p-3.5 sm:p-4 bg-surface-container-lowest/85 backdrop-blur-md rounded-xl flex items-center justify-between border border-white/10">
              <div class="flex items-center gap-2.5">
                <i class="fa-solid fa-star text-primary text-[16px]"></i>
                <div>
                  <span class="font-label-caps text-[10px] sm:text-xs uppercase text-on-surface tracking-wider block">{heroData.featuredCard.title}</span>
                  <span class="text-[10px] sm:text-xs text-outline leading-tight">{heroData.featuredCard.subtitle}</span>
                </div>
              </div>
              <a href={heroData.featuredCard.link} class="font-label-caps text-[10px] sm:text-xs uppercase text-primary hover:text-on-surface transition-colors flex items-center gap-1 font-semibold whitespace-nowrap pl-2">View Look →</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. FIND YOUR HALLOWEEN MOOD (4 氛围专区) -->
    <section class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-16 py-10 lg:py-14 w-full">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-6 lg:mb-8">
        <div>
          <span class="font-label-caps text-xs uppercase text-primary tracking-[0.25em] block mb-1 font-semibold">{moodData.kicker}</span>
          <h2 class="font-headline-lg text-2xl sm:text-3xl lg:text-4xl text-on-surface">{moodData.title}</h2>
        </div>
        <p class="font-body-md text-xs sm:text-sm text-on-surface-variant max-w-md mt-2 md:mt-0 leading-relaxed">
          {moodData.description}
        </p>
      </div>

      <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-6">
        {moodData.cards.map((card: any, index: number) => {
          const badgeColorClass = card.badge_color === 'secondary' ? 'text-secondary' :
                                   card.badge_color === 'tertiary' ? 'text-tertiary' :
                                   'text-primary';
          return (
            <div class="group relative rounded-xl overflow-hidden bg-surface-container-low flex flex-col justify-between p-3.5 sm:p-5 border border-white/5 hover:border-amber-400/30 transition-all duration-300">
              <div class="h-28 sm:h-44 w-full overflow-hidden relative rounded-lg mb-3">
                <img class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" src={card.image} alt={card.title} />
                <div class="absolute inset-0 bg-gradient-to-t from-surface-container-low via-transparent to-transparent"></div>
                <span class={`absolute top-2 left-2 bg-surface-container-lowest/80 backdrop-blur px-2 py-0.5 rounded ${badgeColorClass} font-label-caps text-[9px] uppercase font-semibold`}>{card.badge}</span>
              </div>
              <div class="flex flex-col flex-1 justify-between">
                <div>
                  <h3 class="font-headline-sm text-sm sm:text-lg text-on-surface mb-1 font-semibold leading-snug">{card.title}</h3>
                  <p class="text-[11px] sm:text-xs text-on-surface-variant leading-relaxed line-clamp-2">{card.desc}</p>
                </div>
                <a href={card.link} class="mt-3 inline-flex items-center gap-1 font-label-caps text-[10px] sm:text-xs uppercase text-primary tracking-wider group-hover:gap-2 transition-all font-semibold">
                  <span>Explore Edit</span>
