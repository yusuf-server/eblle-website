---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getProduct } from '../lib/woocommerce';

// ========================================
// ACF 数据获取逻辑
// ========================================

// 从 WordPress ACF API 获取页面字段
async function getACFFields() {
  try {
    const WC_STORE_URL = import.meta.env.WC_STORE_URL || '';
    const response = await fetch(`${WC_STORE_URL}/wp-json/wp/v2/pages?slug=halloween`);
    const pages = await response.json();

    if (!pages || pages.length === 0) {
      console.warn('未找到页面 "活动专区"，使用默认数据');
      return null;
    }

    const page = pages[0];
    return page.acf || null;
  } catch (error) {
    console.error('获取 ACF 数据失败:', error);
    return null;
  }
}

// 从产品 ID 获取 WooCommerce 产品数据
async function getProductData(productId: number | null) {
  if (!productId) return null;
  try {
    const product = await getProduct(productId);
    return product;
  } catch (error) {
    console.error(`获取产品 ${productId} 失败:`, error);
    return null;
  }
}

// 获取 ACF 数据
const acfData = await getACFFields();

// ========================================
// 数据层配置（ACF 数据 + Fallback 默认值）
// ========================================

const announcementData = {
  text: acfData?.announcement_text || 'HALLOWEEN MAGIC IS HERE • VELVET POUCH ON $300+ • CODE: NOCTURNE15',
  code: acfData?.announcement_code || 'NOCTURNE15'
};

const heroData = {
  badge: acfData?.hero_badge || 'Nocturne Édition • October 2026',
  title: acfData?.hero_title_main || 'Halloween',
  titleItalic: acfData?.hero_title_italic || 'Jewelry',
  titleEnd: acfData?.hero_title_end || 'Edit',
  description: acfData?.hero_desc || 'A little dark. A little daring. Made to shine. Discover fine heirloom gold, deep obsidian serpent motifs, and diamond starburst talismans crafted for nocturnal glamour.',
  primaryButton: {
    text: acfData?.hero_btn_primary_text || 'Shop The Collection',
    link: acfData?.hero_btn_primary_url || '#vault-favorites'
  },
  secondaryButton: {
    text: acfData?.hero_btn_secondary_text || 'Explore Editorial',
    link: acfData?.hero_btn_secondary_url || '#atelier-manifesto'
  },
  valuePillars: acfData?.hero_pillars || [
    { title: '18K Gold', subtitle: 'Recycled Solid Gold' },
    { title: 'REACH CERTIFIED', subtitle: 'Conflict-Free Pavé' },
    { title: '48 HRS', subtitle: 'Vault Reserve' }
  ],
  heroImage: acfData?.hero_image || 'https://lh3.googleusercontent.com/aida-public/AB6AXuBOIISihhg43B-qyenK6ep4LY75g_sJHlsWYufPQcSO_PgFudufFmhRDp2NnPe0nmdZ6r_x8KwEYgocFjWrh0NzWrBtNL9masvHFYgFUro99nt-oyatcFc69315_0naNwLRfs7yb9oq9V_Qu_ZE9dg5TeS0Jq7H6PfIHf-iDMe8cA6UNklRHjBQtlKqpkvgkGdCvjARXqhVe5BzQfORzdAcoKb8hPSEKqD36m9oYHXDOyeV266RM48S0Q',
  productPin: {
    top: acfData?.hero_product_pin?.top || '36%',
    right: acfData?.hero_product_pin?.right || '32%',
    category: acfData?.hero_product_pin?.category || 'Ear Architecture',
    name: acfData?.hero_product_pin?.custom_name || 'Starburst Drop Earrings',
    price: acfData?.hero_product_pin?.custom_price_text || '$245 • Diamond Pavé'
