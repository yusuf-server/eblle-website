      desc: 'Bold gold coils with winking ruby eyes',
      image: 'https://images.unsplash.com/photo-1535632066927-ab7c9ab60908?w=500&q=80',
      link: '#vault-favorites'
    },
    {
      badge: 'Mood 04',
      badge_color: 'primary',
      title: 'Diamond Radiance',
      desc: 'Celestial brilliance meets midnight sky',
      image: 'https://images.unsplash.com/photo-1617038220319-276d3cfab638?w=500&q=80',
      link: '#vault-favorites'
    }
  ]
};

// Favorites/Products Section
const favoritesData = {
  kicker: acfData?.favorites_kicker || 'Heirloom Talismans',
  title: acfData?.favorites_title || 'Halloween Favorites',
  description: acfData?.favorites_desc || 'Fine pieces made for every secret bit of magic. Individually numbered and hallmarked in our atelier.',
  products: [] as any[]
};

// 异步获取 Favorites 产品数据（Wordpress 后台增删产品时自动同步）
if (acfData?.favorite_products && Array.isArray(acfData.favorite_products)) {
  for (const item of acfData.favorite_products) {
    if (item.product) {
      const product = await getProductData(item.product);
      if (product) {
        favoritesData.products.push({
          id: product.id,
          name: product.name,
          image: product.images?.[0]?.src || '',
          price: product.price,
          regular_price: product.regular_price,
          on_sale: product.on_sale,
          category: product.categories?.[0]?.name || '',
          badge_text: item.badge_text || '',
          badge_style: item.badge_style || 'primary',
          subtitle: item.subtitle_override || product.short_description || ''
        });
      }
    }
  }
}

// Fallback 8 个精选商品（保证无 ACF 配置或初期展示时也是完美的 2 行 8 个）
const fallbackFavorites = [
  { id: 'fb-1', name: 'The Ouroboros Serpent Ring', price: '320', regular_price: '380', on_sale: true, category: '18K Gold • Onyx', badge_text: 'Bestseller', image: 'https://images.unsplash.com/photo-1605100804763-247f67b3557e?w=500&q=80' },
  { id: 'fb-2', name: 'Midnight Crescent Pendant', price: '285', regular_price: '', on_sale: false, category: '14K Gold • Pearl', badge_text: 'New', image: 'https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?w=500&q=80' },
  { id: 'fb-3', name: 'Nocturne Starburst Ring', price: '410', regular_price: '460', on_sale: true, category: 'Pavé Diamond', badge_text: 'Limited', image: 'https://images.unsplash.com/photo-1600003014755-ba31aa59c4b6?w=500&q=80' },
  { id: 'fb-4', name: 'Gothic Serpent Drop Earrings', price: '245', regular_price: '', on_sale: false, category: 'Solid Gold', badge_text: '', image: 'https://images.unsplash.com/photo-1611591475806-03c09b0b4b2c?w=500&q=80' },
  { id: 'fb-5', name: 'Celestial Witchcraft Bangle', price: '360', regular_price: '420', on_sale: true, category: '18K Gold Plated', badge_text: 'Hot', image: 'https://images.unsplash.com/photo-1535632066927-ab7c9ab60908?w=500&q=80' },
  { id: 'fb-6', name: 'Obsidian Talisman Choker', price: '195', regular_price: '', on_sale: false, category: 'Black Enamel', badge_text: '', image: 'https://images.unsplash.com/photo-1617038220319-276d3cfab638?w=500&q=80' },
  { id: 'fb-7', name: 'Solitary Moonstone Studs', price: '160', regular_price: '190', on_sale: true, category: 'Natural Gem', badge_text: 'Sale', image: 'https://images.unsplash.com/photo-1588850561407-ed78c282e89b?w=500&q=80' },
  { id: 'fb-8', name: 'Shadow Pavé Diamond Band', price: '480', regular_price: '', on_sale: false, category: 'Heirloom Series', badge_text: 'Bespoke', image: 'https://images.unsplash.com/photo-1605100804763-247f67b3557e?w=500&q=80' }
];

// Manifesto Section
const manifestoData = {
  kicker: acfData?.manifesto_kicker || 'Autumn Atelier Manifesto',
  title: acfData?.manifesto_title || 'Dress a Little Darker.',
  description: acfData?.manifesto_desc || 'Your everyday fine jewelry, infused with an alluring Halloween twist. Transition effortlessly from twilight gatherings to everyday heirloom luxury with tactile obsidian accents and radiant gold silhouettes.',
  buttonText: acfData?.manifesto_btn_text || 'Shop The Editorial →',
  buttonLink: acfData?.manifesto_btn_link || '#vault-favorites',
  image: acfData?.manifesto_image || 'https://images.unsplash.com/photo-1515562141207-7a88fb7ce338?w=800&q=80',
  imageTag: acfData?.manifesto_image_tag || 'Place Vendôme Workshop'
};

// Oracle Section
const oracleData = {
  kicker: acfData?.oracle_kicker || 'Talisman Oracle',
  title: acfData?.oracle_title || 'Pick Your Halloween Energy',
  description: acfData?.oracle_desc || 'Select your nocturnal vibe to reveal your bespoke talisman recommendation attuned to your spirit.',
  items: [] as any[]
};

if (acfData?.oracle_items && Array.isArray(acfData.oracle_items)) {
  for (const item of acfData.oracle_items) {
    if (item.product) {
      const product = await getProductData(item.product);
      if (product) {
        oracleData.items.push({
          vibe_key: item.vibe_key,
          chip_label: item.chip_label,
          tag: item.alignment_text,
          quote: item.quote,
          title: product.name,
          desc: item.custom_desc || product.short_description || '',
          price: `$${product.price}`,
          img: product.images?.[0]?.src || ''
        });
      }
