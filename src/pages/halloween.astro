      desc: '18K White Gold & Mother of Pearl Inlay',
      price: '$285',
      img: 'https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?w=500&q=80'
    },
    {
      vibe_key: 'astral',
      chip_label: 'Astral',
      tag: 'ALIGNMENT: BRILLIANCE & AMBITION',
      quote: 'Bold, radiant, and impossibly bright. You claim the spotlight as your birthright.',
      title: 'The Starburst Diamond Ring',
      desc: 'Pavé Diamond Halo & Solid 18K Gold',
      price: '$410',
      img: 'https://images.unsplash.com/photo-1600003014755-ba31aa59c4b6?w=500&q=80'
