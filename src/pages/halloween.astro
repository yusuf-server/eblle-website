// Privilege Section
const privilegeData = {
  label: acfData?.privilege_label || 'Seasonal Privilege',
  badge: acfData?.privilege_badge || 'ENDS MIDNIGHT OCT 31',
  title: acfData?.privilege_title || 'A Little Halloween Magic',
  description: acfData?.privilege_desc || 'Receive a complimentary hand-stitched Nocturne velvet jewelry pouch and 15% off orders above $300 with code: NOCTURNE15',
  code: acfData?.privilege_code || 'NOCTURNE15',
  buttonText: acfData?.privilege_btn_text || 'Claim Offer & Shop'
};

// Bottom CTA Section
const ctaData = {
  kicker: acfData?.cta_kicker || 'Embrace The Nocturne',
  title: acfData?.cta_title || 'Ready to Add a Little Magic?',
  description: acfData?.cta_desc || 'Discover fine jewelry made for every mood, every night, and every celebration. Sealed with heirloom precision and certified Parisian hallmarking.',
  buttonText: acfData?.cta_btn_text || 'Shop The Collection',
  buttonLink: acfData?.cta_btn_url || '#vault-favorites'
};
---

<Layout title="Halloween Jewelry Edit - E.B.Belle">
  <link rel="preconnect" href="https://fonts.googleapis.com" slot="head" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin slot="head" />
  <link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,wght@0,400;0,500;0,600;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Syne:wght@500;600;700&display=swap" rel="stylesheet" slot="head" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" slot="head" />

  <script is:inline src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <script is:inline>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            "gold-accent": "#b8860b",
            "gold-light": "#fdfbf7",
            "gold-border": "#e8e1d5",
          },
          fontFamily: {
            "headline-lg": ["Bodoni Moda", "serif"],
            "headline-sm": ["Bodoni Moda", "serif"],
            "editorial-italic": ["Bodoni Moda", "serif"],
            "label-caps": ["Syne", "sans-serif"],
            "label-numeric": ["Plus Jakarta Sans", "sans-serif"],
            "body-lg": ["Plus Jakarta Sans", "sans-serif"],
            "body-md": ["Plus Jakarta Sans", "sans-serif"],
            "body-sm": ["Plus Jakarta Sans", "sans-serif"]
          }
        }
      }
    };
  </script>

  <!-- 使用全站标准亮白模式 Header -->
  <Header />

  <!-- 主容器全面转为纯白背景，文字为高对比深黑色 -->
  <main class="halloween-campaign-page w-full flex flex-col bg-white font-body-md text-stone-900 pb-16 lg:pb-24">
    <!-- 1. 活动公告顶条 -->
    <div class="w-full bg-stone-900 text-gold-accent px-4 py-2.5 flex items-center justify-center gap-2 text-center shadow-sm">
      <i class="fa-solid fa-wand-magic-sparkles text-[13px] animate-pulse"></i>
      <p class="font-label-caps text-[10px] lg:text-[11px] tracking-widest uppercase font-semibold leading-tight text-white">
        {announcementData.text}
      </p>
    </div>

    <!-- 2. HERO SECTION -->
    <section class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-16 pt-8 pb-12 lg:py-16 w-full">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        <!-- Hero Left Info -->
        <div class="lg:col-span-5 flex flex-col justify-center">
          <div class="inline-flex items-center gap-2 px-3 py-1 bg-stone-100 rounded-full w-fit mb-3 lg:mb-4 border border-stone-200">
            <span class="w-1.5 h-1.5 rounded-full bg-gold-accent animate-pulse"></span>
            <span class="font-label-caps text-[10px] lg:text-[11px] text-stone-800 tracking-[0.2em] uppercase font-bold">{heroData.badge}</span>
          </div>

          <h1 class="font-headline-lg text-3xl sm:text-4xl lg:text-6xl text-stone-900 tracking-tight leading-[1.12] mb-3 lg:mb-4">
            {heroData.title} <br class="hidden sm:inline" />
            <span class="font-editorial-italic italic font-normal text-gold-accent">{heroData.titleItalic}</span> {heroData.titleEnd}
          </h1>

          <p class="font-body-md lg:font-body-lg text-sm lg:text-base text-stone-600 font-normal max-w-md mb-6 leading-relaxed">
            {heroData.description}
          </p>

          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 lg:gap-4 mb-6 lg:mb-8">
            <a href={heroData.primaryButton.link} class="px-8 py-3.5 bg-stone-900 text-white font-label-caps text-xs uppercase tracking-widest text-center shadow-md hover:bg-gold-accent transition-all duration-300 font-semibold flex items-center justify-center gap-2.5">
              <i class="fa-solid fa-bag-shopping text-[15px]"></i>
              <span>{heroData.primaryButton.text}</span>
            </a>
            <a href={heroData.secondaryButton.link} class="px-7 py-3.5 bg-stone-100 text-stone-900 font-label-caps text-xs uppercase tracking-widest text-center hover:bg-stone-200 transition-all flex items-center justify-center gap-2.5 group border border-stone-300">
              <span>{heroData.secondaryButton.text}</span>
              <i class="fa-solid fa-arrow-right text-[13px] text-gold-accent group-hover:translate-x-1 transition-transform"></i>
            </a>
          </div>

          <!-- Value Pillars -->
          <div class="grid grid-cols-3 gap-2 p-3 bg-stone-50 rounded-lg border border-stone-200 text-center">
            {heroData.valuePillars.map((pillar) => (
              <div>
                <span class="font-label-numeric text-stone-900 text-[11px] lg:text-sm font-bold block">{pillar.title}</span>
                <span class="text-[9.5px] lg:text-xs text-stone-500 leading-tight block mt-0.5">{pillar.subtitle}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Hero Right Visual Card -->
        <div class="lg:col-span-7 relative w-full">
          <div class="relative rounded-2xl overflow-hidden bg-stone-100 shadow-xl group border border-stone-200 aspect-[4/5] sm:aspect-[4/3] lg:aspect-auto lg:h-[560px]">
            <img class="w-full h-full object-cover object-center transition-transform duration-700 group-hover:scale-[1.02]" src={heroData.heroImage} alt="Nocturne Muse" />
            <div class="absolute inset-0 bg-gradient-to-t from-stone-900/60 via-transparent to-transparent pointer-events-none"></div>

            <!-- 桌面端微交互光点 (Muse Pin) -->
            <div class="hidden lg:block absolute top-[36%] right-[32%] group/pin cursor-pointer z-20">
              <span class="relative flex h-5 w-5 items-center justify-center">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-gold-accent opacity-75"></span>
                <span class="relative inline-flex rounded-full h-3 w-3 bg-gold-accent shadow-[0_0_12px_#d4af37]"></span>
              </span>
              <div class="opacity-0 group-hover/pin:opacity-100 pointer-events-none group-hover/pin:pointer-events-auto absolute -top-12 right-6 transition-all duration-300 w-56 p-3 bg-white/95 backdrop-blur-md rounded shadow-xl border border-stone-200">
                <span class="font-label-caps text-[10px] text-gold-accent block uppercase tracking-wider font-bold">{heroData.productPin.category}</span>
                <span class="font-headline-sm text-sm text-stone-900 font-semibold block">{heroData.productPin.name}</span>
                <span class="font-label-numeric text-xs text-stone-600 block mt-0.5 font-medium">{heroData.productPin.price}</span>
              </div>
            </div>

            <!-- 底部悬浮卡片 -->
            <div class="absolute bottom-3 left-3 right-3 sm:bottom-4 sm:left-4 sm:right-4 p-3.5 sm:p-4 bg-white/90 backdrop-blur-md rounded-xl flex items-center justify-between border border-stone-200 shadow-lg">
              <div class="flex items-center gap-2.5">
                <i class="fa-solid fa-star text-gold-accent text-[16px]"></i>
                <div>
                  <span class="font-label-caps text-[10px] sm:text-xs uppercase text-stone-900 tracking-wider block font-bold">{heroData.featuredCard.title}</span>
                  <span class="text-[10px] sm:text-xs text-stone-500 leading-tight">{heroData.featuredCard.subtitle}</span>
                </div>
              </div>
              <a href={heroData.featuredCard.link} class="font-label-caps text-[10px] sm:text-xs uppercase text-stone-900 hover:text-gold-accent transition-colors flex items-center gap-1 font-bold whitespace-nowrap pl-2">View Look →</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. FIND YOUR HALLOWEEN MOOD (4 氛围专区) -->
    <section class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-16 py-10 lg:py-14 w-full">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-6 lg:mb-8">
        <div>
          <span class="font-label-caps text-xs uppercase text-gold-accent tracking-[0.25em] block mb-1 font-bold">{moodData.kicker}</span>
          <h2 class="font-headline-lg text-2xl sm:text-3xl lg:text-4xl text-stone-900 font-normal">{moodData.title}</h2>
        </div>
        <p class="font-body-md text-xs sm:text-sm text-stone-600 max-w-md mt-2 md:mt-0 leading-relaxed font-normal">
          {moodData.description}
        </p>
      </div>

      <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-6">
        {moodData.cards.map((card: any) => {
          return (
            <div class="group relative rounded-xl overflow-hidden bg-stone-50 flex flex-col justify-between p-3.5 sm:p-5 border border-stone-200 hover:border-gold-accent/60 transition-all duration-300 hover:shadow-md">
              <div class="h-28 sm:h-44 w-full overflow-hidden relative rounded-lg mb-3 bg-stone-200">
                <img class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" src={card.image} alt={card.title} />
                <span class="absolute top-2 left-2 bg-stone-900/80 backdrop-blur px-2 py-0.5 rounded text-white font-label-caps text-[9px] uppercase font-bold tracking-wider">{card.badge}</span>
              </div>
              <div class="flex flex-col flex-1 justify-between">
                <div>
                  <h3 class="font-headline-sm text-sm sm:text-lg text-stone-900 mb-1 font-semibold leading-snug">{card.title}</h3>
                  <p class="text-[11px] sm:text-xs text-stone-600 leading-relaxed line-clamp-2">{card.desc}</p>
                </div>
                <a href={card.link} class="mt-3 inline-flex items-center gap-1 font-label-caps text-[10px] sm:text-xs uppercase text-stone-900 hover:text-gold-accent tracking-wider group-hover:gap-2 transition-all font-bold">
                  <span>Explore Edit</span>
                  <i class="fa-solid fa-arrow-right text-[10px] text-gold-accent"></i>
                </a>
              </div>
            </div>
          );
        })}
      </div>
    </section>

    <!-- 4. HALLOWEEN FAVORITES (上下两行，总共8个产品) -->
    <section class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-16 py-10 lg:py-14 w-full" id="vault-favorites">
      <div class="text-center max-w-xl mx-auto mb-8 lg:mb-12">
        <span class="font-label-caps text-xs uppercase text-gold-accent tracking-[0.25em] block mb-1 font-bold">{favoritesData.kicker}</span>
        <h2 class="font-headline-lg text-2xl sm:text-3xl lg:text-4xl text-stone-900 mb-2 font-normal">{favoritesData.title}</h2>
        <p class="font-body-md text-xs sm:text-sm text-stone-600 font-normal">{favoritesData.description}</p>
      </div>

      <!-- 桌面端 4 列（共 2 行 8 个），移动端 2 列（共 4 行 8 个） -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-6">
        {(() => {
          // 优先取 ACF 产品，若不足 8 个则自动由 fallback 补足到 8 个
          const displayProducts = favoritesData.products.length >= 8
            ? favoritesData.products.slice(0, 8)
            : favoritesData.products.length > 0
              ? [...favoritesData.products, ...fallbackFavorites.slice(favoritesData.products.length, 8)]
              : fallbackFavorites.slice(0, 8);

          return displayProducts.map((product: any) => {
            const hasDiscount = product.on_sale && product.regular_price && parseFloat(product.regular_price) > parseFloat(product.price);

            return (
              <div class="product-item group flex flex-col bg-white rounded-xl p-2.5 sm:p-3 relative border border-stone-200 transition-all duration-300 hover:border-gold-accent hover:shadow-lg">
                <div class="relative w-full aspect-square sm:h-72 rounded-lg overflow-hidden bg-stone-100 flex items-center justify-center">
                  <img class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" src={product.image} alt={product.name} />
                  {product.badge_text && (
                    <span class="absolute top-2 left-2 px-1.5 py-0.5 bg-stone-900 text-white font-label-caps text-[8px] sm:text-[9px] uppercase tracking-wider font-bold rounded">
                      {product.badge_text}
                    </span>
                  )}
                  <button class="absolute top-2 right-2 w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-white/85 backdrop-blur-md text-stone-700 hover:text-red-600 flex items-center justify-center transition-transform hover:scale-110 shadow-sm">
                    <i class="fa-regular fa-heart text-[14px]"></i>
                  </button>
                </div>
                <div class="pt-3 pb-1 flex-1 flex flex-col justify-between">
                  <div>
                    <div class="flex items-center justify-between text-stone-500 text-[10px] sm:text-xs mb-1">
                      <span class="line-clamp-1">{product.subtitle || product.category}</span>
                      <span class="text-gold-accent font-bold">★ 4.9</span>
                    </div>
                    <h4 class="font-headline-sm text-xs sm:text-base text-stone-900 font-semibold mb-1 line-clamp-1">{product.name}</h4>
                  </div>
                  <div class="flex items-center justify-between mt-2 pt-2 border-t border-stone-100">
                    {hasDiscount ? (
                      <div class="flex items-baseline gap-1">
                        <span class="font-label-numeric text-xs sm:text-base text-stone-900 font-bold">${product.price}</span>
                        <span class="text-[9px] sm:text-xs text-stone-400 line-through">${product.regular_price}</span>
                      </div>
                    ) : (
                      <span class="font-label-numeric text-xs sm:text-base text-stone-900 font-bold">${product.price}</span>
                    )}
                    <button class="hw-add-btn px-2.5 sm:px-4 py-1.5 bg-stone-900 text-white text-[9px] sm:text-[11px] font-label-caps uppercase rounded transition-all hover:bg-gold-accent font-semibold active:scale-95 shadow-sm" data-product-id={product.id} data-product-name={product.name} data-product-price={product.price} data-product-image={product.image}>
                      Add to Bag
                    </button>
                  </div>
                </div>
              </div>
            );
          });
        })()}
      </div>
    </section>

    <!-- 5. AUTUMN ATELIER MANIFESTO (专题横幅) -->
    <section class="w-full py-12 lg:py-16 my-4 lg:my-8 bg-stone-50 border-y border-stone-200" id="atelier-manifesto">
      <div class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-16 flex flex-col lg:flex-row items-center justify-between gap-8 lg:gap-12">
