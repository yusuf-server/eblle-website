};

// Mood Categories Section
const moodData = {
  kicker: acfData?.mood_section_kicker || 'Curated Expressions',
  title: acfData?.mood_section_title || 'Find Your Halloween Mood',
  description: acfData?.mood_section_desc || 'Whether you invoke candlelit mystery, ethereal witchcraft, playful serpent wit, or pure diamond radiance.',
  cards: acfData?.mood_cards || [
    {
      badge: 'Mood 01',
      badge_color: 'secondary',
      title: 'Dark & Mysterious',
      desc: 'Obsidian talismans for late-night allure',
      image: 'https://images.unsplash.com/photo-1611591475806-03c09b0b4b2c?w=500&q=80',
      link: '#vault-favorites'
