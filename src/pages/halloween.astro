        <button type="button" class="px-8 py-3.5 bg-gold-accent text-white font-label-caps text-xs uppercase tracking-widest hover:bg-yellow-600 transition-colors font-semibold whitespace-nowrap rounded shadow-lg flex items-center justify-center gap-2.5" onclick={`navigator.clipboard?.writeText('${privilegeData.code}'); alert('Coupon ${privilegeData.code} copied to clipboard!');`}>
          <span>{privilegeData.buttonText}</span>
