    <!-- 8. BOTTOM CELESTIAL CTA (尾部号召区) -->
    <section class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-16 py-12 lg:py-16 text-center w-full">
      <span class="font-label-caps text-xs uppercase text-gold-accent tracking-[0.3em] block mb-2 font-bold">{ctaData.kicker}</span>
      <h2 class="font-headline-lg text-3xl sm:text-4xl lg:text-5xl text-stone-900 mb-3 font-normal">
        {ctaData.title}
      </h2>
      <p class="text-xs sm:text-base text-stone-600 mb-6 max-w-lg mx-auto leading-relaxed">
        {ctaData.description}
      </p>
      <a href={ctaData.buttonLink} class="inline-flex items-center justify-center gap-2.5 px-10 py-4 bg-stone-900 text-white font-label-caps text-xs uppercase tracking-widest hover:bg-gold-accent transition-all font-semibold shadow-md rounded">
