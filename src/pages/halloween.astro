  <!-- 引入站内自带的暗色 Footer -->
  <Footer isDark={true} />

  <!-- 交互脚本：占卜切换与加购联动 -->
  <script is:inline define:vars={{ oracleItems: oracleData.items }}>
    // 从服务器端传入的 Oracle 数据构建数据库
    const oracleDatabase = {};
    oracleItems.forEach(item => {
      oracleDatabase[item.vibe_key] = {
        tag: item.tag,
        quote: item.quote,
        title: item.title,
        desc: item.desc,
        price: item.price,
        img: item.img
      };
    });

    const chips = document.querySelectorAll('.oracle-chip-btn');
    const quoteText = document.getElementById('oracle-quote-text');
    const alignmentTag = document.getElementById('oracle-alignment-tag');
    const displayTitle = document.getElementById('oracle-display-title');
    const displayDesc = document.getElementById('oracle-display-desc');
    const displayPrice = document.getElementById('oracle-display-price');
    const displayImg = document.getElementById('oracle-display-img');
    const metaPrice = document.getElementById('oracle-meta-price');
    const actionBtn = document.getElementById('oracle-action-btn');

    chips.forEach(chip => {
      chip.addEventListener('click', () => {
        chips.forEach(c => {
          c.classList.remove('bg-primary', 'text-on-primary', 'font-bold', 'shadow-md');
          c.classList.add('bg-surface-container-high', 'text-on-surface');
        });
        chip.classList.add('bg-primary', 'text-on-primary', 'font-bold', 'shadow-md');
        chip.classList.remove('bg-surface-container-high', 'text-on-surface');

        const vibeKey = chip.getAttribute('data-vibe');
        const data = oracleDatabase[vibeKey];
        if (data && displayImg) {
          displayImg.style.opacity = '0';
          setTimeout(() => {
            if (alignmentTag) alignmentTag.textContent = data.tag;
            if (quoteText) quoteText.textContent = data.quote;
            if (displayTitle) displayTitle.textContent = data.title;
            if (displayDesc) displayDesc.textContent = data.desc;
            if (displayPrice) displayPrice.textContent = data.price;
            if (metaPrice) metaPrice.textContent = `${data.price} • Selected Talisman`;
            displayImg.src = data.img;
            displayImg.style.opacity = '1';
            if (actionBtn) {
              actionBtn.setAttribute('data-name', data.title);
              actionBtn.setAttribute('data-price', data.price.replace('$', ''));
            }
          }, 180);
        }
      });
    });

    // ========================================
    // Quick Order 功能集成（调用全局 shop.astro 的函数）
    // ========================================

    // 从 WooCommerce API 获取完整产品数据
    async function fetchFullProductData(productId) {
      try {
        const response = await fetch(`/api/product-detail?id=${productId}`);
        if (!response.ok) {
          throw new Error('Failed to fetch product');
        }
        return await response.json();
      } catch (error) {
        console.error('获取产品详情失败:', error);
        return null;
      }
    }

    // 绑定所有 Add to Bag 按钮
    document.querySelectorAll('.hw-add-btn').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        e.preventDefault();

        const productId = btn.getAttribute('data-product-id');
        const productName = btn.getAttribute('data-product-name');
        const productPrice = btn.getAttribute('data-product-price');
        const productImage = btn.getAttribute('data-product-image');

        console.log('Add to Bag clicked:', { productId, productName, productPrice });

        // 检查是否存在全局的 openQuickOrderWithData 函数（来自 shop.astro）
        if (typeof window.openQuickOrderWithData === 'function') {
          // 如果产品 ID 存在且不是 fallback，获取完整产品数据
          if (productId && !productId.startsWith('fallback') && !isNaN(parseInt(productId))) {
            btn.textContent = 'Loading...';
            btn.disabled = true;

            const fullProduct = await fetchFullProductData(productId);

            btn.textContent = 'Add to Bag';
            btn.disabled = false;

            if (fullProduct) {
              // 调用全局的 Quick Order 函数
              console.log('Opening Quick Order with full product data');
              window.openQuickOrderWithData(fullProduct);
            } else {
              // 如果获取失败，使用基本信息创建简单产品对象
              console.warn('Failed to fetch full product, using basic info');
              const simpleProduct = {
                id: productId,
                name: productName,
                price: productPrice,
                regular_price: productPrice,
                images: [{ src: productImage }],
                image: productImage,
                type: 'simple',
                stock_status: 'instock',
                short_description: ''
              };
              window.openQuickOrderWithData(simpleProduct);
            }
          } else {
            // Fallback 产品或无效 ID：创建简单的产品对象
            const simpleProduct = {
              id: productId || 'temp-' + Date.now(),
              name: productName,
              price: productPrice,
              regular_price: productPrice,
              images: [{ src: productImage }],
              image: productImage,
              type: 'simple',
              stock_status: 'instock',
              short_description: ''
            };
            console.log('Using fallback product data');
            window.openQuickOrderWithData(simpleProduct);
          }
        } else {
          // 如果没有全局函数，直接添加到购物车（fallback 行为）
          console.warn('openQuickOrderWithData 不存在，使用 fallback 行为');

          try {
            const currentCart = JSON.parse(localStorage.getItem('ebbelle_cart') || '[]');
            currentCart.push({
              cartItemId: Date.now().toString(),
              productId: productId,
              name: productName,
              price: parseFloat(productPrice).toFixed(2),
              quantity: 1,
              image: productImage,
              selectedVariants: {}
            });
            localStorage.setItem('ebbelle_cart', JSON.stringify(currentCart));
            window.dispatchEvent(new CustomEvent('cartUpdated', { detail: { cart: currentCart } }));

            // 打开购物车
            if (typeof window.toggleCart === 'function') {
              window.toggleCart(true);
            }

            // 按钮反馈
            const originalText = btn.textContent;
            btn.textContent = 'ADDED ✓';
            btn.classList.add('bg-primary', 'text-on-primary');
            setTimeout(() => {
              btn.textContent = originalText;
              btn.classList.remove('bg-primary', 'text-on-primary');
            }, 1200);
          } catch(err) {
            console.error('添加到购物车失败:', err);
          }
        }
      });
    });
  </script>
</Layout>

