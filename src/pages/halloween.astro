    <!-- 6. INTERACTIVE ORACLE (占卜互动区) -->
    <section class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-16 py-10 lg:py-14 w-full">
      <div class="bg-stone-50 rounded-2xl lg:rounded-3xl p-5 sm:p-8 lg:p-12 relative overflow-hidden border border-stone-200 shadow-sm">
        <div class="text-center lg:text-left mb-6 lg:mb-8">
          <div class="inline-flex items-center gap-2 text-gold-accent mb-1">
            <i class="fa-solid fa-wand-sparkles text-[15px]"></i>
            <span class="font-label-caps text-xs uppercase tracking-[0.25em] font-bold">{oracleData.kicker}</span>
          </div>
          <h2 class="font-headline-lg text-2xl sm:text-3xl text-stone-900 mb-2 font-normal">{oracleData.title}</h2>
          <p class="text-xs sm:text-sm text-stone-600 max-w-lg mx-auto lg:mx-0 font-normal">
            {oracleData.description}
          </p>
        </div>

        <!-- Energy Selector Chips -->
        <div class="flex items-center gap-2 mb-6 hw-chips-scroll overflow-x-auto pb-1" id="oracle-chips-bar">
          {oracleData.items.map((item: any, index: number) => (
            <button type="button" class={`oracle-chip-btn ${index === 0 ? 'active-chip bg-stone-900 text-white font-bold shadow-md' : 'bg-white text-stone-700 border border-stone-200 font-medium hover:border-stone-400'} px-4 py-2 rounded text-center font-label-caps text-[10px] tracking-wider uppercase transition-all whitespace-nowrap`} data-vibe={item.vibe_key}>
              {item.chip_label}
            </button>
          ))}
        </div>

        <!-- 占卜内容展示网格 -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-12 items-center">
          <div class="lg:col-span-6 flex flex-col">
            <div class="p-4 sm:p-5 bg-white rounded-xl mb-4 sm:mb-6 border-l-2 border-gold-accent border-stone-200 border shadow-sm">
              <p class="font-editorial-italic italic text-sm sm:text-base text-stone-800 mb-2 leading-relaxed" id="oracle-quote-text">
                {oracleData.items[0]?.quote || 'Select your energy to reveal your talisman'}
              </p>
              <span class="text-[11px] text-stone-500 block uppercase tracking-wider font-label-caps font-semibold" id="oracle-alignment-tag">
                {oracleData.items[0]?.tag || 'ALIGNMENT'}
              </span>
            </div>

            <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
              <button type="button" class="hw-add-btn px-8 py-3.5 bg-stone-900 text-white font-label-caps text-xs uppercase tracking-widest hover:bg-gold-accent transition-colors font-semibold active:scale-95 text-center shadow-md" id="oracle-action-btn" data-name={oracleData.items[0]?.title || 'Talisman'} data-price={(oracleData.items[0]?.price || '$0').replace('$', '')}>
                Reserve Energy Talisman
              </button>
              <span class="font-label-numeric text-stone-900 text-sm font-bold text-center sm:text-left" id="oracle-meta-price">
                {oracleData.items[0]?.price || '$0'} • Selected Talisman
              </span>
            </div>
          </div>

          <!-- 右侧卡片预览 -->
          <div class="lg:col-span-6 flex justify-center w-full">
            <div class="w-full max-w-md bg-white p-4 sm:p-5 rounded-2xl border border-stone-200 shadow-md">
              <div class="h-52 sm:h-64 rounded-xl overflow-hidden relative mb-3 bg-stone-100">
                <img id="oracle-display-img" class="w-full h-full object-cover transition-opacity duration-300" src={oracleData.items[0]?.img || ''} alt="Energy Talisman" />
              </div>
              <div class="flex items-center justify-between">
                <div>
                  <h4 class="font-headline-sm text-base sm:text-lg text-stone-900 font-semibold" id="oracle-display-title">{oracleData.items[0]?.title || 'Talisman'}</h4>
                  <span class="text-xs text-stone-500 block mt-0.5" id="oracle-display-desc">{oracleData.items[0]?.desc || ''}</span>
                </div>
                <span class="font-label-numeric text-lg sm:text-xl text-stone-900 font-bold pl-2" id="oracle-display-price">{oracleData.items[0]?.price || '$0'}</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 7. SEASONAL PRIVILEGE (专属特权卡) -->
    <section class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-16 py-6 lg:py-8 w-full">
      <div class="bg-gradient-to-br from-stone-900 via-stone-800 to-stone-900 text-white rounded-2xl p-6 sm:p-8 relative overflow-hidden border border-stone-300 flex flex-col md:flex-row items-stretch md:items-center justify-between gap-6 shadow-xl">
        <div class="space-y-1 sm:space-y-2">
          <div class="flex items-center justify-between sm:justify-start gap-3">
            <span class="font-label-caps text-[10px] text-gold-accent uppercase tracking-widest font-bold block">{privilegeData.label}</span>
