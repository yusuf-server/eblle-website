</style>

<script is:inline>
  // Tab 切换逻辑
  const navPills = document.querySelectorAll('.acc-nav-pill[data-tab]');
  const tabPanes = document.querySelectorAll('.acc-tab-pane');

  function changeTab(tabId) {
    if (!tabId) return;
    navPills.forEach(pill => {
      if (pill.getAttribute('data-tab') === tabId) {
        pill.classList.add('active');
      } else {
        pill.classList.remove('active');
      }
    });
    tabPanes.forEach(pane => {
      if (pane.id === tabId) {
        pane.classList.add('active');
      } else {
        pane.classList.remove('active');
      }
    });
  }

  navPills.forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      const target = btn.getAttribute('data-tab');
      changeTab(target);
    });
  });

  document.querySelectorAll('.acc-text-link[data-tab], .acc-mini-link[data-tab]').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      const target = btn.getAttribute('data-tab');
      changeTab(target);
    });
  });

  // 地址编辑表单展开/收起
  // Address编辑按钮事件
  const billingFormBlock = document.getElementById('billingFormBlock');
  const shippingFormBlock = document.getElementById('shippingFormBlock');

  document.getElementById('openEditBillingBtn')?.addEventListener('click', () => {
    if (billingFormBlock) billingFormBlock.style.display = 'block';
  });
  document.getElementById('closeBillingFormBtn')?.addEventListener('click', () => {
    if (billingFormBlock) billingFormBlock.style.display = 'none';
  });
  document.getElementById('cancelBillingFormBtn')?.addEventListener('click', () => {
    if (billingFormBlock) billingFormBlock.style.display = 'none';
  });

  document.getElementById('openEditShippingBtn')?.addEventListener('click', () => {
    if (shippingFormBlock) shippingFormBlock.style.display = 'block';
  });
  document.getElementById('closeShippingFormBtn')?.addEventListener('click', () => {
    if (shippingFormBlock) shippingFormBlock.style.display = 'none';
  });
  document.getElementById('cancelShippingFormBtn')?.addEventListener('click', () => {
    if (shippingFormBlock) shippingFormBlock.style.display = 'none';
  });

  // 页面加载时获取用户信息
  let currentUserId = null; // 存储用户ID

  async function loadUserInfo() {
    try {
      const response = await fetch('/api/auth/me');
      const data = await response.json();

      if (data.authenticated && data.user) {
        const user = data.user;
        currentUserId = user.id; // 保存用户ID

        // 更新侧边栏用户信息
        document.getElementById('sidebarUserName').textContent = `${user.firstName} ${user.lastName}`;
        document.getElementById('sidebarUserEmail').textContent = user.email;

        // 更新Welcome信息
        document.getElementById('welcomeUserName').textContent = user.firstName;

        // 填充Account Details表单
        document.getElementById('account_first_name').value = user.firstName || '';
        document.getElementById('account_last_name').value = user.lastName || '';
        document.getElementById('account_display_name').value = `${user.firstName} ${user.lastName}`;
        document.getElementById('account_email').value = user.email || '';

        // 加载并显示地址
        if (user.billing) {
          displayAddress('billing', user.billing);
          populateAddressForm('billing', user.billing);
        }
        if (user.shipping) {
          displayAddress('shipping', user.shipping);
          populateAddressForm('shipping', user.shipping);
        }

        // 更新Dashboard地址统计
        updateAddressMetric(user.billing, user.shipping);
      } else {
        // 未登录，重定向到首页
        window.location.href = '/';
      }
    } catch (error) {
      console.error('Load user info error:', error);
      window.location.href = '/';
    }
  }

  // 处理密码修改
  async function handlePasswordChange() {
    const currentPassword = document.getElementById('currentPassword').value;
    const newPassword = document.getElementById('newPassword').value;
    const confirmPassword = document.getElementById('confirmPassword').value;
    const messageEl = document.getElementById('passwordMessage');

    // 清除之前的消息
    messageEl.style.display = 'none';
    messageEl.className = 'acc-message';

    // 验证
    if (!currentPassword || !newPassword || !confirmPassword) {
      showMessage('Please fill in all password fields', 'error');
      return;
    }

    if (newPassword.length < 8) {
      showMessage('New password must be at least 8 characters', 'error');
      return;
    }

    if (newPassword !== confirmPassword) {
      showMessage('New passwords do not match', 'error');
      return;
    }

    if (currentPassword === newPassword) {
      showMessage('New password must be different from current password', 'error');
      return;
    }

    // 显示加载状态
    const submitBtn = document.getElementById('savePasswordBtn');
    const originalText = submitBtn.textContent;
    submitBtn.disabled = true;
    submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Saving...';
    submitBtn.style.opacity = '0.7';

    try {
      // 首先验证当前密码
      const userEmail = document.getElementById('sidebarUserEmail').textContent;

      const validateResponse = await fetch('/api/auth/login', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          email: userEmail,
          password: currentPassword,
          rememberMe: false
        }),
      });

      if (!validateResponse.ok) {
        showMessage('Current password is incorrect', 'error');
        submitBtn.disabled = false;
        submitBtn.innerHTML = originalText;
        submitBtn.style.opacity = '1';
        return;
      }

      // 当前密码正确，调用修改密码API
      if (!currentUserId) {
        showMessage('Session expired. Please log in again.', 'error');
        submitBtn.disabled = false;
        submitBtn.innerHTML = originalText;
        submitBtn.style.opacity = '1';
        return;
      }

      const changeResponse = await fetch('/api/auth/change-password', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          user_id: currentUserId,
          new_password: newPassword,
        }),
      });

      const data = await changeResponse.json();

      if (data.success) {
        showMessage('Password updated successfully! Please use your new password next time you log in.', 'success');

        // 清空表单
        document.getElementById('currentPassword').value = '';
        document.getElementById('newPassword').value = '';
        document.getElementById('confirmPassword').value = '';
      } else {
        showMessage(data.message || 'Failed to update password', 'error');
      }
    } catch (error) {
      console.error('Change password error:', error);
      showMessage('An unexpected error occurred', 'error');
    } finally {
      submitBtn.disabled = false;
      submitBtn.innerHTML = originalText;
      submitBtn.style.opacity = '1';
    }
  }

  // 显示消息
  function showMessage(message, type) {
    const messageEl = document.getElementById('passwordMessage');
    messageEl.textContent = message;
    messageEl.className = `acc-message ${type}`;
    messageEl.style.display = 'block';

    // 5秒后自动隐藏成功消息
    if (type === 'success') {
      setTimeout(() => {
        messageEl.style.display = 'none';
      }, 5000);
    }
  }

  // 页面加载时执行
  loadUserInfo();
  loadOrders(); // 加载订单
  loadRecentOrders(); // 加载Dashboard的最近订单
  loadWishlist(); // 加载Wishlist

  // 处理URL参数，自动切换到指定Tab
  const urlParams = new URLSearchParams(window.location.search);
  const tabParam = urlParams.get('tab');

  if (tabParam) {
    // 查找对应的tab按钮并触发点击
    const tabButton = document.querySelector(`[data-tab="${tabParam}"]`);
    if (tabButton) {
      tabButton.click();
    }
  }

  // 暴露到全局
  window.handlePasswordChange = handlePasswordChange;
  window.saveAccountDetails = saveAccountDetails;

  // 显示地址信息
  function displayAddress(type, address) {
    const displayEl = document.getElementById(`${type}AddressDisplay`);
    if (!displayEl) return;

    if (!address || !address.address_1) {
      displayEl.innerHTML = '<p style="color: #999;">No address saved</p>';
      return;
    }

    const fullName = `${address.first_name || ''} ${address.last_name || ''}`.trim();
    const addressLine1 = address.address_1 || '';
    const addressLine2 = address.address_2 ? `, ${address.address_2}` : '';
    const cityStateZip = `${address.city || ''}, ${address.state || ''} ${address.postcode || ''}`.trim();
    const country = address.country || '';
    const phone = address.phone || '';
    const email = address.email || '';

    let html = '';
    if (fullName) html += `<p><strong>${fullName}</strong></p>`;
    if (addressLine1) html += `<p>${addressLine1}${addressLine2}</p>`;
    if (cityStateZip && country) html += `<p>${cityStateZip}, ${country}</p>`;
    if (phone) html += `<p class="acc-phone">${phone}</p>`;
    if (type === 'billing' && email) html += `<p class="acc-phone">${email}</p>`;

    displayEl.innerHTML = html || '<p style="color: #999;">No address saved</p>';
  }

  // 填充地址表单
  function populateAddressForm(type, address) {
    if (!address) return;

    document.getElementById(`${type}_first_name`).value = address.first_name || '';
    document.getElementById(`${type}_last_name`).value = address.last_name || '';
    document.getElementById(`${type}_company`).value = address.company || '';
    document.getElementById(`${type}_country`).value = address.country || 'US';
    document.getElementById(`${type}_address_1`).value = address.address_1 || '';
    document.getElementById(`${type}_address_2`).value = address.address_2 || '';
    document.getElementById(`${type}_city`).value = address.city || '';
    document.getElementById(`${type}_postcode`).value = address.postcode || '';

    if (type === 'billing') {
      document.getElementById(`${type}_phone`).value = address.phone || '';
      document.getElementById(`${type}_email`).value = address.email || '';
    }
  }

  // 保存Billing地址
  document.getElementById('billingAddressForm')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    await saveAddress('billing');
  });

  // 保存Shipping地址
  document.getElementById('shippingAddressForm')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    await saveAddress('shipping');
  });

  // 保存地址函数
  async function saveAddress(type) {
    const address = {
      firstName: document.getElementById(`${type}_first_name`).value.trim(),
      lastName: document.getElementById(`${type}_last_name`).value.trim(),
      company: document.getElementById(`${type}_company`).value.trim(),
      country: document.getElementById(`${type}_country`).value,
      address1: document.getElementById(`${type}_address_1`).value.trim(),
      address2: document.getElementById(`${type}_address_2`).value.trim(),
      city: document.getElementById(`${type}_city`).value.trim(),
      postcode: document.getElementById(`${type}_postcode`).value.trim(),
    };

    // Billing额外字段
    if (type === 'billing') {
      address.phone = document.getElementById(`${type}_phone`).value.trim();
      address.email = document.getElementById(`${type}_email`).value.trim();
    }

    // 验证必填字段
    if (!address.firstName || !address.lastName || !address.address1 || !address.city || !address.postcode) {
      showAddressMessage(type, 'Please fill in all required fields', 'error');
      return;
    }

    const btn = document.getElementById(`save${type.charAt(0).toUpperCase() + type.slice(1)}Btn`);
    const originalText = btn.textContent;
    btn.disabled = true;
    btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Saving...';
    btn.style.opacity = '0.7';

    try {
      const response = await fetch('/api/user/update-address', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({ type, address }),
      });

      const data = await response.json();

      if (data.success) {
        showAddressMessage(type, 'Address updated successfully!', 'success');

        // 更新显示
        displayAddress(type, data.address);

        // 2秒后关闭表单
        setTimeout(() => {
          document.getElementById(`${type}FormBlock`).style.display = 'none';
        }, 2000);
      } else {
        showAddressMessage(type, data.message || 'Failed to update address', 'error');
      }
    } catch (error) {
      console.error('Update address error:', error);
      showAddressMessage(type, 'An unexpected error occurred', 'error');
    } finally {
      btn.disabled = false;
      btn.innerHTML = originalText;
      btn.style.opacity = '1';
    }
  }

  // 显示地址消息
  function showAddressMessage(type, message, messageType) {
    const messageEl = document.getElementById(`${type}AddressMessage`);
    messageEl.textContent = message;
    messageEl.className = `acc-message ${messageType}`;
    messageEl.style.display = 'block';

    // 5秒后自动隐藏成功消息
    if (messageType === 'success') {
      setTimeout(() => {
        messageEl.style.display = 'none';
      }, 5000);
    }
  }

  // 保存Account Details
  async function saveAccountDetails() {
    const firstName = document.getElementById('account_first_name').value.trim();
    const lastName = document.getElementById('account_last_name').value.trim();
    const email = document.getElementById('account_email').value.trim();

    // 验证
    if (!firstName || !lastName || !email) {
      showAccountMessage('Please fill in all required fields', 'error');
      return;
    }

    // 验证邮箱格式
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!emailRegex.test(email)) {
      showAccountMessage('Please enter a valid email address', 'error');
      return;
    }

    const btn = document.getElementById('saveAccountDetailsBtn');
    const originalText = btn.textContent;
    btn.disabled = true;
    btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Saving...';
    btn.style.opacity = '0.7';

    try {
      const response = await fetch('/api/user/update-profile', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          firstName,
          lastName,
          email,
        }),
      });

      const data = await response.json();

      if (data.success) {
        showAccountMessage('Profile updated successfully!', 'success');
        // 重新加载用户信息以更新所有显示
        await loadUserInfo();
      } else {
        showAccountMessage(data.message || 'Failed to update profile', 'error');
      }
    } catch (error) {
      console.error('Update profile error:', error);
      showAccountMessage('An unexpected error occurred', 'error');
    } finally {
      btn.disabled = false;
      btn.innerHTML = originalText;
      btn.style.opacity = '1';
    }
  }

  // 显示Account Details消息
  function showAccountMessage(message, type) {
    const messageEl = document.getElementById('accountDetailsMessage');
    messageEl.textContent = message;
    messageEl.className = `acc-message ${type}`;
    messageEl.style.display = 'block';

    // 5秒后自动隐藏成功消息
    if (type === 'success') {
      setTimeout(() => {
        messageEl.style.display = 'none';
      }, 5000);
    }
  }

  // 加载订单列表
  async function loadOrders() {
    try {
      const response = await fetch('/api/user/orders');
      const data = await response.json();

      const ordersLoading = document.getElementById('ordersLoading');
      const ordersList = document.getElementById('ordersList');
      const noOrders = document.getElementById('noOrders');
      const orderCount = document.getElementById('orderCount');

      ordersLoading.style.display = 'none';

      if (data.success && data.orders && data.orders.length > 0) {
        // 显示订单列表
        orderCount.textContent = `Showing ${data.orders.length} order${data.orders.length > 1 ? 's' : ''}`;
        ordersList.style.display = 'block';

        // 渲染订单
        ordersList.innerHTML = data.orders.map(order => {
          const orderDate = new Date(order.date_created).toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'short',
            day: 'numeric'
          });

          // 状态映射
          const statusMap = {
            'pending': { text: 'Pending', class: 'processing' },
            'processing': { text: 'Processing', class: 'processing' },
            'on-hold': { text: 'On Hold', class: 'processing' },
            'completed': { text: 'Completed', class: 'delivered' },
            'cancelled': { text: 'Cancelled', class: 'cancelled' },
            'refunded': { text: 'Refunded', class: 'cancelled' },
            'failed': { text: 'Failed', class: 'cancelled' }
          };

          const status = statusMap[order.status] || { text: order.status, class: 'processing' };

          return `
            <div class="acc-order-row">
              <div class="acc-order-cell col-id">
                <span class="label">Order</span>
                <strong class="val-mono">#${order.number}</strong>
              </div>
              <div class="acc-order-cell col-date">
                <span class="label">Date</span>
                <span class="val">${orderDate}</span>
              </div>
              <div class="acc-order-cell col-status">
                <span class="label">Status</span>
                <span class="acc-pill-status ${status.class}">${status.text}</span>
              </div>
              <div class="acc-order-cell col-total">
                <span class="label">Total</span>
                <strong class="val-price">$${parseFloat(order.total).toFixed(2)}</strong>
              </div>
              <div class="acc-order-cell col-action">
                <a href="/order/${order.id}" class="acc-btn-detail">View</a>
              </div>
            </div>
          `;
        }).join('');

        // 更新侧边栏订单数量徽章
        const sidebarBadge = document.getElementById('sidebarOrderCount');
        if (sidebarBadge) {
          sidebarBadge.textContent = data.orders.length;
          sidebarBadge.style.display = 'inline-block';
        }

        // 更新Dashboard订单统计
        const dashboardMetric = document.getElementById('dashboardOrdersMetric');
        if (dashboardMetric) {
          dashboardMetric.textContent = `${data.orders.length} Total Order${data.orders.length > 1 ? 's' : ''}`;
        }
      } else {
        // 显示无订单状态
        orderCount.textContent = 'No orders';
        noOrders.style.display = 'block';

        // 隐藏侧边栏徽章
        const sidebarBadge = document.getElementById('sidebarOrderCount');
        if (sidebarBadge) {
          sidebarBadge.style.display = 'none';
        }

        // 更新Dashboard订单统计
        const dashboardMetric = document.getElementById('dashboardOrdersMetric');
        if (dashboardMetric) {
          dashboardMetric.textContent = '0 Total Orders';
        }
      }
    } catch (error) {
      console.error('Load orders error:', error);
      document.getElementById('ordersLoading').innerHTML = '<p style="color: #999;">Failed to load orders</p>';
    }
  }

  // 加载Dashboard的最近订单（最多显示3个）
  async function loadRecentOrders() {
    try {
      const response = await fetch('/api/user/orders');
      const data = await response.json();

      const recentOrdersLoading = document.getElementById('recentOrdersLoading');
      const recentOrdersList = document.getElementById('recentOrdersList');
      const noRecentOrders = document.getElementById('noRecentOrders');

      recentOrdersLoading.style.display = 'none';

      if (data.success && data.orders && data.orders.length > 0) {
        // 只显示最近3个订单
        const recentOrders = data.orders.slice(0, 3);
        recentOrdersList.style.display = 'block';

        // 状态映射
        const statusMap = {
          'pending': { text: 'Pending', class: 'processing' },
          'processing': { text: 'Processing', class: 'processing' },
          'on-hold': { text: 'On Hold', class: 'processing' },
          'completed': { text: 'Completed', class: 'delivered' },
          'cancelled': { text: 'Cancelled', class: 'cancelled' },
          'refunded': { text: 'Refunded', class: 'cancelled' },
          'failed': { text: 'Failed', class: 'cancelled' }
        };

        // 渲染最近订单
        recentOrdersList.innerHTML = recentOrders.map(order => {
          const orderDate = new Date(order.date_created).toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'short',
            day: 'numeric'
          });

          const status = statusMap[order.status] || { text: order.status, class: 'processing' };

          return `
            <div class="acc-order-row">
              <div class="acc-order-cell col-id">
                <span class="label">Order</span>
                <strong class="val-mono">#${order.number}</strong>
              </div>
              <div class="acc-order-cell col-date">
                <span class="label">Date</span>
                <span class="val">${orderDate}</span>
              </div>
              <div class="acc-order-cell col-status">
                <span class="label">Status</span>
                <span class="acc-pill-status ${status.class}">${status.text}</span>
              </div>
              <div class="acc-order-cell col-total">
                <span class="label">Total</span>
                <strong class="val-price">$${parseFloat(order.total).toFixed(2)}</strong>
              </div>
              <div class="acc-order-cell col-action">
                <a href="/order/${order.id}" class="acc-btn-detail">View</a>
              </div>
            </div>
          `;
        }).join('');
      } else {
        // 显示无订单状态
        noRecentOrders.style.display = 'block';
      }
    } catch (error) {
      console.error('Load recent orders error:', error);
      document.getElementById('recentOrdersLoading').innerHTML = '<p style="color: #999;">Failed to load orders</p>';
    }
  }

  // 更新Dashboard地址统计
  function updateAddressMetric(billing, shipping) {
    const dashboardMetric = document.getElementById('dashboardAddressesMetric');
    if (!dashboardMetric) return;

    let addressCount = 0;
    if (billing && billing.address_1) addressCount++;
    if (shipping && shipping.address_1) addressCount++;

    dashboardMetric.textContent = `${addressCount} Saved Address${addressCount !== 1 ? 'es' : ''}`;
  }

