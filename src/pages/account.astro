---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/CartDrawer.astro';

// 服务器端检查认证状态
const userId = Astro.cookies.get('user_id')?.value;
const userEmail = Astro.cookies.get('user_email')?.value;

// 如果未登录，重定向到首页
if (!userId || !userEmail) {
  return Astro.redirect('/');
}
---

<Layout title="My Account - E.B.Belle">
  <Header />

  <!-- Breadcrumb -->
  <div class="acc-breadcrumb">
    <div class="acc-wrapper">
      <div class="acc-crumbs">
        <a href="/">Home</a>
        <span>/</span>
        <strong>My Account</strong>
      </div>
    </div>
  </div>

  <!-- Account Page Main Scope -->
  <div class="acc-root-scope">
    <div class="acc-wrapper">
      
      <div class="acc-header-area">
        <h1 class="acc-heading">My Account</h1>
        <p class="acc-subheading">Manage your orders, profile details and shipping addresses</p>
      </div>

      <div class="acc-main-grid">
        <!-- Sidebar Navigation -->
        <aside class="acc-sidebar-panel">
          <div class="acc-user-card">
            <div class="acc-avatar">
              <i class="fa-solid fa-user"></i>
            </div>
            <div class="acc-user-meta">
              <span class="acc-u-name" id="sidebarUserName">Loading...</span>
              <span class="acc-u-email" id="sidebarUserEmail">Loading...</span>
            </div>
          </div>

          <!-- 横向滑动专属隔离仓：彻底切断宽度外溢 -->
          <div class="acc-nav-scroller">
            <nav class="acc-nav-list" aria-label="Account navigation">
              <button type="button" class="acc-nav-pill active" data-tab="dashboard">
                <i class="fa-solid fa-gauge"></i>
                <span>Dashboard</span>
              </button>
              <button type="button" class="acc-nav-pill" data-tab="orders">
                <i class="fa-solid fa-box"></i>
                <span>Orders</span>
                <span class="acc-count-badge" id="sidebarOrderCount" style="display: none;"></span>
              </button>
              <button type="button" class="acc-nav-pill" data-tab="wishlist">
                <i class="fa-solid fa-heart"></i>
                <span>Wishlist</span>
                <span class="acc-count-badge" id="sidebarWishlistCount" style="display: none;"></span>
              </button>
              <button type="button" class="acc-nav-pill" data-tab="addresses">
                <i class="fa-solid fa-location-dot"></i>
                <span>Addresses</span>
              </button>
              <button type="button" class="acc-nav-pill" data-tab="account-details">
                <i class="fa-solid fa-user-pen"></i>
                <span>Account Details</span>
              </button>
              <a href="/logout" class="acc-nav-pill acc-logout-pill">
                <i class="fa-solid fa-arrow-right-from-bracket"></i>
                <span>Logout</span>
              </a>
            </nav>
          </div>
        </aside>

        <!-- Main Content Area -->
        <main class="acc-content-panel">
          
          <!-- Tab 1: Dashboard -->
          <div class="acc-tab-pane active" id="dashboard">
            <div class="acc-welcome-box">
              <h2>Welcome back, <strong id="welcomeUserName">Loading...</strong></h2>
              <p>From your dashboard you can easily review recent orders, update shipping addresses, and manage your account credentials.</p>
            </div>

            <div class="acc-metric-grid">
              <div class="acc-metric-card">
                <div class="acc-icon-bubble"><i class="fa-solid fa-box"></i></div>
                <h3>Orders</h3>
                <p id="dashboardOrdersMetric"><i class="fa-solid fa-spinner fa-spin"></i> Loading...</p>
                <button type="button" class="acc-text-link" data-tab="orders">View all orders &rarr;</button>
              </div>
              <div class="acc-metric-card">
                <div class="acc-icon-bubble"><i class="fa-solid fa-location-dot"></i></div>
                <h3>Addresses</h3>
                <p id="dashboardAddressesMetric"><i class="fa-solid fa-spinner fa-spin"></i> Loading...</p>
                <button type="button" class="acc-text-link" data-tab="addresses">Manage addresses &rarr;</button>
              </div>
              <div class="acc-metric-card">
                <div class="acc-icon-bubble"><i class="fa-solid fa-user-gear"></i></div>
                <h3>Security</h3>
                <p>Password & Profile</p>
                <button type="button" class="acc-text-link" data-tab="account-details">Edit details &rarr;</button>
              </div>
            </div>

            <div class="acc-recent-block">
              <div class="acc-block-bar">
                <h3>Recent Orders</h3>
                <button type="button" class="acc-mini-link" data-tab="orders">View All</button>
              </div>

              <!-- Loading state -->
              <div id="recentOrdersLoading" class="acc-order-list" style="text-align: center; padding: 40px; color: #999;">
                <i class="fa-solid fa-spinner fa-spin"></i>
                <p>Loading recent orders...</p>
              </div>

              <!-- Orders list -->
              <div class="acc-order-list" id="recentOrdersList" style="display: none;"></div>

              <!-- Empty state -->
              <div id="noRecentOrders" style="display: none; text-align: center; padding: 40px; color: #999;">
                <i class="fa-solid fa-box-open" style="font-size: 48px; margin-bottom: 16px; opacity: 0.3;"></i>
                <p>No orders yet</p>
                <a href="/shop" class="acc-btn-detail" style="margin-top: 16px; display: inline-block;">Start Shopping</a>
              </div>
            </div>
          </div>

          <!-- Tab 2: Orders -->
          <div class="acc-tab-pane" id="orders">
            <div class="acc-pane-title-row">
              <h2>Order History</h2>
              <span id="orderCount">Loading...</span>
            </div>

            <!-- 加载状态 -->
            <div id="ordersLoading" style="text-align: center; padding: 40px;">
              <i class="fa-solid fa-spinner fa-spin" style="font-size: 24px; color: #999;"></i>
              <p style="margin-top: 12px; color: #666;">Loading your orders...</p>
            </div>

            <!-- 订单列表 -->
            <div class="acc-order-list" id="ordersList" style="display: none;"></div>

            <!-- 无订单状态 -->
            <div id="noOrders" style="display: none; text-align: center; padding: 60px 20px;">
              <i class="fa-solid fa-shopping-bag" style="font-size: 48px; color: #ddd; margin-bottom: 20px;"></i>
              <h3 style="font-size: 18px; margin-bottom: 12px; color: #333;">No Orders Yet</h3>
              <p style="color: #666; margin-bottom: 24px;">You haven't placed any orders yet.</p>
              <a href="/shop" class="acc-btn-detail" style="display: inline-block; padding: 12px 28px; background: #111; color: #fff; text-decoration: none; font-size: 12px; font-weight: 700; text-transform: uppercase;">
                Start Shopping
              </a>
            </div>
          </div>

          <!-- Tab 3: Wishlist -->
          <div class="acc-tab-pane" id="wishlist">
            <div class="acc-pane-title-row">
              <h2>My Wishlist</h2>
              <span id="wishlistCount">Loading...</span>
            </div>

            <!-- 加载状态 -->
            <div id="wishlistLoading" style="text-align: center; padding: 40px;">
              <i class="fa-solid fa-spinner fa-spin" style="font-size: 24px; color: #999;"></i>
              <p style="margin-top: 12px; color: #666;">Loading your wishlist...</p>
            </div>

            <!-- Wishlist网格 -->
            <div id="wishlistGrid" style="display: none; display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 24px; margin-top: 24px;"></div>

            <!-- 空状态 -->
            <div id="noWishlist" style="display: none; text-align: center; padding: 60px 20px;">
              <i class="fa-solid fa-heart" style="font-size: 48px; color: #ddd; margin-bottom: 20px;"></i>
              <h3 style="font-size: 18px; margin-bottom: 12px; color: #333;">Your Wishlist is Empty</h3>
              <p style="color: #666; margin-bottom: 24px;">Save your favorite items to view them here later.</p>
              <a href="/shop" class="acc-btn-detail" style="display: inline-block; padding: 12px 28px; background: #111; color: #fff; text-decoration: none; font-size: 12px; font-weight: 700; text-transform: uppercase;">
                Browse Products
              </a>
            </div>
          </div>

          <!-- Tab 4: Addresses -->
          <div class="acc-tab-pane" id="addresses">
            <div class="acc-pane-title-row">
              <h2>Addresses</h2>
              <span>Selected by default at checkout</span>
            </div>

            <div class="acc-address-grid">
              <div class="acc-address-box">
                <div class="acc-address-top">
                  <div>
                    <span class="acc-tag">DEFAULT</span>
                    <h3>Billing Address</h3>
                  </div>
                  <button type="button" class="acc-edit-btn" id="openEditBillingBtn">
                    <i class="fa-solid fa-pen"></i> Edit
                  </button>
                </div>
                <div id="billingAddressDisplay">
                  <p><i class="fa-solid fa-spinner fa-spin"></i> Loading...</p>
                </div>
              </div>

              <div class="acc-address-box">
                <div class="acc-address-top">
                  <div>
                    <span class="acc-tag">DEFAULT</span>
                    <h3>Shipping Address</h3>
                  </div>
                  <button type="button" class="acc-edit-btn" id="openEditShippingBtn">
                    <i class="fa-solid fa-pen"></i> Edit
                  </button>
                </div>
                <div id="shippingAddressDisplay">
                  <p><i class="fa-solid fa-spinner fa-spin"></i> Loading...</p>
                </div>
              </div>
            </div>

            <!-- Billing Edit Form -->
            <div class="acc-edit-form-panel" id="billingFormBlock" style="display: none;">
              <div class="acc-form-header">
                <h3>Edit Billing Address</h3>
                <button type="button" id="closeBillingFormBtn"><i class="fa-solid fa-xmark"></i></button>
              </div>
              <form id="billingAddressForm" class="acc-form-body">
                <div class="acc-row-2">
                  <div class="acc-input-group">
                    <label>First Name *</label>
                    <input id="billing_first_name" type="text" required />
                  </div>
                  <div class="acc-input-group">
                    <label>Last Name *</label>
                    <input id="billing_last_name" type="text" required />
                  </div>
                </div>
                <div class="acc-input-group">
                  <label>Company (Optional)</label>
                  <input id="billing_company" type="text" />
                </div>
                <div class="acc-input-group">
                  <label>Country *</label>
                  <select id="billing_country" required>
                    <option value="US">United States</option>
                    <option value="CA">Canada</option>
                    <option value="GB">United Kingdom</option>
                    <option value="AU">Australia</option>
                    <option value="CN">China</option>
                  </select>
                </div>
                <div class="acc-input-group">
                  <label>Address *</label>
                  <input id="billing_address_1" type="text" required />
                  <input id="billing_address_2" type="text" placeholder="Apartment, suite, etc. (optional)" style="margin-top: 6px;" />
                </div>
                <div class="acc-row-2">
                  <div class="acc-input-group">
                    <label>City *</label>
                    <input id="billing_city" type="text" required />
                  </div>
                  <div class="acc-input-group">
                    <label>ZIP Code *</label>
                    <input id="billing_postcode" type="text" required />
                  </div>
                </div>
                <div class="acc-row-2">
                  <div class="acc-input-group">
                    <label>Phone *</label>
                    <input id="billing_phone" type="tel" required />
                  </div>
                  <div class="acc-input-group">
                    <label>Email *</label>
                    <input id="billing_email" type="email" required />
                  </div>
                </div>
                <div id="billingAddressMessage" class="acc-message" style="display: none;"></div>
                <div class="acc-form-btns">
                  <button type="submit" id="saveBillingBtn" class="acc-submit-btn">Save Address</button>
                  <button type="button" class="acc-cancel-btn" id="cancelBillingFormBtn">Cancel</button>
                </div>
              </form>
            </div>

            <!-- Shipping Edit Form -->
            <div class="acc-edit-form-panel" id="shippingFormBlock" style="display: none;">
              <div class="acc-form-header">
                <h3>Edit Shipping Address</h3>
                <button type="button" id="closeShippingFormBtn"><i class="fa-solid fa-xmark"></i></button>
              </div>
              <form id="shippingAddressForm" class="acc-form-body">
                <div class="acc-row-2">
                  <div class="acc-input-group">
                    <label>First Name *</label>
                    <input id="shipping_first_name" type="text" required />
                  </div>
                  <div class="acc-input-group">
                    <label>Last Name *</label>
                    <input id="shipping_last_name" type="text" required />
                  </div>
                </div>
                <div class="acc-input-group">
                  <label>Company (Optional)</label>
                  <input id="shipping_company" type="text" />
                </div>
                <div class="acc-input-group">
                  <label>Country *</label>
                  <select id="shipping_country" required>
                    <option value="US">United States</option>
                    <option value="CA">Canada</option>
                    <option value="GB">United Kingdom</option>
                    <option value="AU">Australia</option>
                    <option value="CN">China</option>
                  </select>
                </div>
                <div class="acc-input-group">
                  <label>Address *</label>
                  <input id="shipping_address_1" type="text" required />
                  <input id="shipping_address_2" type="text" placeholder="Apartment, suite, etc. (optional)" style="margin-top: 6px;" />
                </div>
                <div class="acc-row-2">
                  <div class="acc-input-group">
                    <label>City *</label>
                    <input id="shipping_city" type="text" required />
                  </div>
                  <div class="acc-input-group">
                    <label>ZIP Code *</label>
                    <input id="shipping_postcode" type="text" required />
                  </div>
                </div>
                <div id="shippingAddressMessage" class="acc-message" style="display: none;"></div>
                <div class="acc-form-btns">
                  <button type="submit" id="saveShippingBtn" class="acc-submit-btn">Save Address</button>
                  <button type="button" class="acc-cancel-btn" id="cancelShippingFormBtn">Cancel</button>
                </div>
              </form>
            </div>
          </div>

          <!-- Tab 5: Account Details -->
          <div class="acc-tab-pane" id="account-details">
            <div class="acc-pane-title-row">
              <h2>Account Details</h2>
              <span>Update your personal profile</span>
            </div>

            <form class="acc-form-body" style="max-width: 620px;">
              <div class="acc-row-2">
                <div class="acc-input-group">
                  <label>First Name *</label>
                  <input id="account_first_name" type="text" required />
                </div>
                <div class="acc-input-group">
                  <label>Last Name *</label>
                  <input id="account_last_name" type="text" required />
                </div>
              </div>
              <div class="acc-input-group">
                <label>Display Name</label>
                <input id="account_display_name" type="text" readonly style="background-color: #f5f5f5; cursor: not-allowed;" />
                <small style="font-size: 10px; color: #999; margin-top: 4px; display: block;">Display name cannot be changed</small>
              </div>
              <div class="acc-input-group">
                <label>Email *</label>
                <input id="account_email" type="email" required />
              </div>

              <!-- 保存个人信息按钮 -->
              <div class="acc-form-btns" style="margin-bottom: 24px;">
                <button type="button" id="saveAccountDetailsBtn" class="acc-submit-btn" onclick="saveAccountDetails()">
                  Save Changes
                </button>
              </div>
              <div id="accountDetailsMessage" class="acc-message" style="display: none; margin-top: -12px; margin-bottom: 24px;"></div>

              <div class="acc-password-box">
                <h4>Password Change</h4>
                <div class="acc-input-group">
                  <label>Current Password</label>
                  <input type="password" id="currentPassword" placeholder="••••••••" />
                </div>
                <div class="acc-input-group">
                  <label>New Password</label>
                  <input type="password" id="newPassword" placeholder="••••••••" minlength="8" />
                </div>
                <div class="acc-input-group">
                  <label>Confirm New Password</label>
                  <input type="password" id="confirmPassword" placeholder="••••••••" minlength="8" />
                </div>
                <p class="acc-pwd-hint">Password must be at least 8 characters long.</p>
                <div id="passwordMessage" class="acc-message" style="display: none;"></div>
              </div>

              <div class="acc-form-btns">
                <button type="button" id="savePasswordBtn" class="acc-submit-btn" onclick="handlePasswordChange()">Save Changes</button>
              </div>
            </form>
          </div>

        </main>
      </div>

    </div>
  </div>

  <Footer />
  <CartDrawer />
</Layout>

<style>
  /* 全局最高优先级隔离与防超宽设置 */
  .acc-root-scope {
    width: 100% !important;
    max-width: 100% !important;
    overflow-x: hidden !important;
    background-color: #f7f5f0;
    padding: 36px 0 70px;
    box-sizing: border-box !important;
  }

  .acc-wrapper {
    width: 100% !important;
    max-width: 1200px !important;
    margin-left: auto !important;
    margin-right: auto !important;
    padding-left: 18px !important;
    padding-right: 18px !important;
    box-sizing: border-box !important;
  }

  .acc-breadcrumb {
    background: #fbf9f6;
    padding: 12px 0;
    border-bottom: 1px solid #eee8df;
    width: 100%;
    overflow-x: hidden;
  }
  .acc-crumbs {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    display: flex;
    align-items: center;
    gap: 8px;
    color: #777;
  }
  .acc-crumbs a { color: #555; text-decoration: none; }
  .acc-crumbs strong { color: #111; font-weight: 600; }

  /* 标题区域 */
  .acc-header-area { margin-bottom: 24px; }
  .acc-heading {
    font-family: 'Bodoni Moda', 'Didot', Georgia, serif;
    font-size: 32px;
    font-weight: 500;
    margin: 0 0 4px;
    color: #111;
  }
  .acc-subheading { margin: 0; font-size: 13.5px; color: #777; }

  /* 栅格双列 */
  .acc-main-grid {
    display: grid;
    grid-template-columns: 260px minmax(0, 1fr);
    gap: 28px;
    align-items: flex-start;
    width: 100%;
    min-width: 0;
    box-sizing: border-box;
  }

  /* 侧边栏 */
  .acc-sidebar-panel {
    background: #ffffff;
    border: 1px solid #e6ded3;
    border-radius: 4px;
    padding: 18px;
    position: sticky;
    top: 20px;
    min-width: 0;
    box-sizing: border-box;
  }
  .acc-user-card {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-bottom: 14px;
    margin-bottom: 12px;
    border-bottom: 1px solid #f0eae1;
    min-width: 0;
  }
  .acc-avatar {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: #f4efe8;
    color: #8c8273;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .acc-user-meta { min-width: 0; flex: 1; }
  .acc-u-name { display: block; font-size: 15px; font-weight: 600; color: #111; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .acc-u-email { display: block; font-size: 12px; color: #888; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  .acc-nav-list { display: flex; flex-direction: column; gap: 3px; width: 100%; }
  .acc-nav-pill {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    border-radius: 2px;
    font-size: 13px;
    font-weight: 500;
    color: #555;
    background: transparent;
    border: none;
    cursor: pointer;
    text-align: left;
    width: 100%;
    text-decoration: none;
    transition: all 0.2s;
  }
  .acc-nav-pill i { width: 16px; color: #999; }
  .acc-nav-pill:hover { background: #faf8f5; color: #111; }
  .acc-nav-pill.active { background: #111; color: #fff; }
  .acc-nav-pill.active i { color: #fff; }
  .acc-count-badge { margin-left: auto; font-size: 11px; background: #eae5dc; color: #333; padding: 2px 6px; border-radius: 10px; }
  .acc-nav-pill.active .acc-count-badge { background: #333; color: #fff; }
  .acc-logout-pill { margin-top: 10px; border-top: 1px solid #f0eae1; padding-top: 12px; color: #c52424; }

  /* 主面板内容 */
  .acc-content-panel {
    background: #ffffff;
    border: 1px solid #e6ded3;
    border-radius: 4px;
    padding: 28px;
    min-width: 0;
    width: 100%;
    box-sizing: border-box;
  }
  .acc-tab-pane { display: none; width: 100%; min-width: 0; }
  .acc-tab-pane.active { display: block; }
  .acc-pane-title-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 20px;
    padding-bottom: 12px;
    border-bottom: 1px solid #eee8df;
  }
  .acc-pane-title-row h2 { font-size: 20px; margin: 0; color: #111; }
  .acc-pane-title-row span { font-size: 12.5px; color: #888; }

  /* Dashboard Welcome */
  .acc-welcome-box {
    background: #fbf9f6;
    border-left: 3px solid #a3824c;
    padding: 16px 20px;
    margin-bottom: 24px;
  }
  .acc-welcome-box h2 { font-size: 16px; margin: 0 0 4px; }
  .acc-welcome-box p { margin: 0; font-size: 13px; color: #666; line-height: 1.5; }

  .acc-metric-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin-bottom: 28px;
  }
  .acc-metric-card {
    background: #fbf9f6;
    border: 1px solid #ebe5dc;
    border-radius: 3px;
    padding: 18px 14px;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .acc-icon-bubble {
    width: 36px;
    height: 36px;
    background: #ede7de;
    color: #a3824c;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 10px;
  }
  .acc-metric-card h3 { font-size: 14px; margin: 0 0 2px; }
  .acc-metric-card p { font-size: 12px; color: #888; margin: 0 0 10px; }
  .acc-text-link {
    background: none; border: none; padding: 0; font-size: 11.5px;
    font-weight: 600; color: #a3824c; text-align: left; cursor: pointer;
  }

  /* 订单列表（响应式流，绝不溢出） */
  .acc-recent-block { margin-top: 10px; }
  .acc-block-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; }
  .acc-block-bar h3 { font-size: 15px; margin: 0; }
  .acc-mini-link { background: none; border: none; font-size: 12px; color: #a3824c; cursor: pointer; }

  .acc-order-list { display: flex; flex-direction: column; gap: 10px; width: 100%; }
  .acc-order-row {
    display: grid;
    grid-template-columns: 1fr 1.2fr 1.2fr 1fr auto;
