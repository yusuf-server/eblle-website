  function resetMobileFilters() {
    const mobileContainer = document.getElementById('mobileFilterContent');
    if (!mobileContainer) return;

    const savedPage = pageBeforeFilter;
    mobileContainer.querySelectorAll('input[data-filter]:checked').forEach(input => {
      input.checked = false;
      input.closest('.color-swatch')?.classList.remove('selected');
    });

    const desktopContainer = document.getElementById('filters-container');
    if (desktopContainer) {
      desktopContainer.querySelectorAll('input[data-filter]:checked').forEach(input => {
        input.checked = false;
        input.closest('.color-swatch')?.classList.remove('selected');
      });
    }

    currentFilters = null;
    updateMobileFilterCount();
    closeMobileFilterDrawer();
    loadPage(savedPage, null);
  }

