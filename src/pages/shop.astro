  // 渲染筛选区域
  function renderFilters(data) {
    const container = document.getElementById('filters-container');
    const mobileContainer = document.getElementById('mobileFilterContent');

    if (!container) return;

    let html = '';

    // Filters 标题（仅桌面端）
    html += '<div class="filters-header">';
    html += '<h2>Filters</h2>';
    html += '<button class="filters-reset" onclick="resetAllFilters()" title="Reset all filters">';
    html += '<i class="fa-solid fa-rotate-right"></i>';
    html += '</button>';
    html += '</div>';

    // 1. NEW ARRIVALS (放在最前面，按图片顺序)
    if (data.newArrivals && data.newArrivals.length > 0) {
      html += '<div class="filter-section">';
      html += '<div class="filter-header" onclick="toggleFilterSection(this)">';
      html += '<h3 class="filter-title">NEW ARRIVALS</h3>';
      html += '<button class="filter-toggle">';
      html += '<i class="fa-solid fa-chevron-up"></i>';
      html += '</button>';
      html += '</div>';
      html += '<div class="filter-content">';
      html += '<ul class="filter-list">';

      data.newArrivals.forEach(cat => {
        const hasChildren = cat.children && cat.children.length > 0;

        // 只显示子分类，不显示父级
        if (hasChildren) {
          // 排序子分类：提取日期并降序排列（最新的在最上面）
          const sortedChildren = [...cat.children].sort((a, b) => {
            // 提取格式如 "2026.9.NEW" 的日期部分
            const extractDate = (name) => {
              const match = name.match(/(\d{4})\.(\d{1,2})/);
              if (match) {
                const year = parseInt(match[1]);
                const month = parseInt(match[2]);
                return year * 100 + month; // 转换为数字便于比较，如 202609
              }
              return 0;
            };

            return extractDate(b.name) - extractDate(a.name); // 降序
          });

          // 直接渲染子分类，不需要折叠按钮
          sortedChildren.forEach(child => {
            html += '<li>';
            html += `<label>`;
