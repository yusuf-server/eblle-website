  // 同步筛选到桌面端（保持UI一致）
  function syncFiltersToDesktop(filters) {
    const desktopContainer = document.getElementById('filters-container');
    if (!desktopContainer) return;

    // 清除所有桌面端选中状态
    desktopContainer.querySelectorAll('input[data-filter]:checked').forEach(input => {
      input.checked = false;
    });

    // 应用新的选中状态
    filters.categories.forEach(id => {
      const input = desktopContainer.querySelector(`input[name="category"][value="${id}"]`);
      if (input) input.checked = true;
    });

    filters.colors.forEach(id => {
      const input = desktopContainer.querySelector(`input[name="color"][value="${id}"]`);
      if (input) {
        input.checked = true;
        const swatch = input.closest('.color-swatch');
        if (swatch) swatch.classList.add('selected');
      }
    });

    filters.materials.forEach(id => {
      const input = desktopContainer.querySelector(`input[name="material"][value="${id}"]`);
      if (input) input.checked = true;
    });
  }

