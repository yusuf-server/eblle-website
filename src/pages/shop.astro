<script>
  window.shopQuickOrderInitialized = true;

  // 全局赠品数据（与详情页保持严格一致）
  const QUICK_GIFTS_DATA = [
    {
      id: 56339,
      name: "E.B.belle PVC Zipper Jewelry Packaging Bag Pouch",
      price: "0.00",
      image: "https://images.unsplash.com/photo-1584917865442-de89df76afd3?w=200&q=80"
    },
    {
      id: 57994,
      name: "E.B.belle Velvet Anti-Tarnish Jewelry Keepsake Pouch",
      price: "0.00",
      image: "https://images.unsplash.com/photo-1544816155-12df9643f363?w=200&q=80"
    }
  ];

// 2. 动态异步同步真实商品数据（价格、图片、标题）
  async function fetchAndSyncQuickGiftsData() {
    for (const gift of QUICK_GIFTS_DATA) {
      if (gift.loaded) continue;
      try {
        // 调用站内现有的产品详情 API 接口
        const res = await fetch(`/api/product-detail?id=${gift.id}`);
        if (!res.ok) continue;
        const data = await res.json();
        
        if (data && data.name) {
          gift.name = data.name;
          // 优先取原价 regular_price，保证和后台原价完全对齐
          const regPrice = (data.regular_price !== undefined && data.regular_price !== null && data.regular_price !== '')
            ? data.regular_price
            : (data.price || '0.00');
          gift.price = parseFloat(regPrice).toFixed(2);

          // 取第一张商品图
          if (data.images && data.images[0] && data.images[0].src) {
            gift.image = data.images[0].src;
          }
          gift.loaded = true;
        }
      } catch (err) {
        console.warn(`[QuickGift Fetch Error] for ${gift.id}:`, err);
      }
    }

    // 数据获取成功后，若弹窗已经打开，即刻动态刷新 DOM 中的显示内容
    updateQuickGiftsDOM();
  }

  // 3. 动态刷新当前 DOM 中正在展示的赠品标题、价格和图片
  function updateQuickGiftsDOM() {
    ['desktop', 'mobile'].forEach(device => {
      const track = document.getElementById(`${device}QuickGiftTrack`);
      if (!track) return;

      const slides = track.querySelectorAll('.quick-gift-slide');
      slides.forEach((slide, index) => {
        const gift = QUICK_GIFTS_DATA[index];
        if (!gift) return;

        const imgEl = slide.querySelector('.quick-gift-img');
        const nameEl = slide.querySelector('.quick-gift-name');
        const priceEl = slide.querySelector('.quick-gift-price');

        if (imgEl && gift.image) imgEl.src = gift.image;
        if (nameEl && gift.name) {
          nameEl.textContent = gift.name;
          nameEl.title = gift.name;
        }
        if (priceEl && gift.price !== undefined) {
          priceEl.textContent = `$${gift.price}`;
        }
      });
    });
  }
  // 全局赠品轮播定时器
  let quickGiftTimerDesktop = null;
  let quickGiftTimerMobile = null;
  let quickGiftIndexDesktop = 0;
  let quickGiftIndexMobile = 0;

  function updateBreadcrumb() {
    const urlParams = new URLSearchParams(window.location.search);
    const searchQuery = urlParams.get('q');
    const category = urlParams.get('category');
    const breadcrumb = document.querySelector('.breadcrumb');

    if (breadcrumb) {
      if (searchQuery) {
        breadcrumb.innerHTML = `
          <a href="/">Home</a>
          <span>/</span>
          <a href="/shop">Shop</a>
          <span>/</span>
          <span>Search: "${searchQuery}"</span>
        `;
      } else if (category) {
        const categoryName = category.replace(/-/g, ' ').replace(/\b\w/g, l => l.toUpperCase());
        breadcrumb.innerHTML = `
          <a href="/">Home</a>
          <span>/</span>
          <a href="/shop">Shop</a>
          <span>/</span>
          <span>${categoryName}</span>
        `;
      } else {
        breadcrumb.innerHTML = `
          <a href="/">Home</a>
          <span>/</span>
          <span>Shop</span>
        `;
      }
    }
  }

  let currentPage = 1;
  let totalPages = 1;
  let totalProducts = 0;
  const perPage = 20;
  let currentFilters = null;
  let pageBeforeFilter = 1;

  window.toggleFilterSection = function(header) {
    const section = header.parentElement;
    const content = section.querySelector('.filter-content');
    const toggle = section.querySelector('.filter-toggle');
    content.classList.toggle('collapsed');
    toggle.classList.toggle('collapsed');
  };

  window.toggleChildren = function(button, targetId) {
    const target = document.getElementById(targetId);
    if (target) {
      target.classList.toggle('show');
      button.classList.toggle('expanded');
    }
  };

  window.resetAllFilters = function() {
    const allCheckboxes = document.querySelectorAll('#filters-container input[type="checkbox"]');
    allCheckboxes.forEach(checkbox => {
      checkbox.checked = false;
    });

    const colorSwatches = document.querySelectorAll('.color-swatch.selected');
    colorSwatches.forEach(swatch => {
      swatch.classList.remove('selected');
    });

    handleFilterChange();
  };

  function generatePagination(current, total) {
    const pages = [];
    if (total <= 7) {
      for (let i = 1; i <= total; i++) {
        pages.push(i);
      }
    } else {
      pages.push(1);
      if (current > 3) pages.push('...');
      const start = Math.max(2, current - 1);
      const end = Math.min(total - 1, current + 1);
      for (let i = start; i <= end; i++) {
        pages.push(i);
      }
      if (current < total - 2) pages.push('...');
      pages.push(total);
    }
    return pages;
  }

  function renderPagination() {
    const pages = generatePagination(currentPage, totalPages);
    const desktopPagination = document.getElementById('pagination-desktop');
    const mobilePagination = document.getElementById('pagination-mobile');

    [desktopPagination, mobilePagination].forEach(container => {
      if (!container) return;

      const isMobile = container.id.includes('mobile');
      const btnClass = isMobile ? 'mobile-page-btn' : 'page-btn';
      const dotsClass = isMobile ? 'mobile-page-dots' : 'page-dots';

      let html = `
        <button class="${btnClass}" data-page="prev" ${currentPage === 1 ? 'disabled' : ''}>
          <i class="fa-solid fa-chevron-left"></i>
        </button>
      `;

      pages.forEach(page => {
        if (page === '...') {
          html += `<span class="${dotsClass}">...</span>`;
        } else {
          html += `<button class="${btnClass} ${currentPage === page ? 'active' : ''}" data-page="${page}">${page}</button>`;
        }
      });

      html += `
        <button class="${btnClass}" data-page="next" ${currentPage >= totalPages ? 'disabled' : ''}>
          <i class="fa-solid fa-chevron-right"></i>
        </button>
      `;

      container.innerHTML = html;
    });

    document.querySelectorAll('[data-page]').forEach(btn => {
      btn.addEventListener('click', handlePageClick);
    });
  }

  async function handlePageClick(e) {
    const pageValue = e.currentTarget.dataset.page;
    let newPage = currentPage;

    if (pageValue === 'prev') {
      newPage = Math.max(1, currentPage - 1);
    } else if (pageValue === 'next') {
      newPage = Math.min(totalPages, currentPage + 1);
    } else {
      newPage = parseInt(pageValue);
    }

    if (newPage === currentPage) return;

    currentPage = newPage;
    const url = new URL(window.location);
    url.searchParams.set('page', newPage);
    window.history.pushState({}, '', url);
    renderPagination();
    window.scrollTo({ top: 0, behavior: 'smooth' });

    await loadPage(newPage, currentFilters);
  }

  async function loadPage(page, filters = null) {
    try {
      const desktopGrid = document.getElementById('products-grid-desktop');
      const mobileGrid = document.getElementById('products-grid-mobile');

      const skeletonHTML = Array.from({ length: 20 }, () => `
        <div class="product-skeleton">
          <div class="skeleton-image"></div>
          <div class="skeleton-content">
            <div class="skeleton-line skeleton-title"></div>
            <div class="skeleton-line skeleton-price"></div>
            <div class="skeleton-line skeleton-meta"></div>
          </div>
        </div>
      `).join('');

      if (desktopGrid) desktopGrid.innerHTML = skeletonHTML;
      if (mobileGrid) mobileGrid.innerHTML = skeletonHTML;

      const requestBody = { page: page, per_page: perPage };
      const urlParams = new URLSearchParams(window.location.search);
      const searchQuery = urlParams.get('q');
      if (searchQuery) requestBody.search = searchQuery;

      const categoryParam = urlParams.get('category');
      if (categoryParam) requestBody.category = categoryParam;

      if (filters) {
        if (filters.categories && filters.categories.length > 0) {
          requestBody.category = filters.categories.join(',');
        }
        if (filters.colors && filters.colors.length > 0) {
          requestBody.color = filters.colors.join(',');
        }
        if (filters.materials && filters.materials.length > 0) {
          requestBody.material = filters.materials.join(',');
        }
      }

      const response = await fetch(`/api/products`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(requestBody)
      });

      if (!response.ok) throw new Error(`API请求失败: ${response.status}`);

      const data = await response.json();
      totalProducts = data.total || 0;
      totalPages = data.totalPages || 1;

      const totalProductsSpan = document.getElementById('total-products');
      const productsCountDesktop = document.getElementById('products-count-desktop');
      if (totalProductsSpan) totalProductsSpan.textContent = totalProducts;
      if (productsCountDesktop) productsCountDesktop.textContent = totalProducts;

      if (!data.products || data.products.length === 0) {
        const emptyHTML = `
          <div style="grid-column: 1/-1; text-align: center; padding: 80px 20px; color: #666;">
            <i class="fa-solid fa-box-open" style="font-size: 64px; margin-bottom: 20px; color: #ddd;"></i>
            <p style="font-size: 18px; margin-bottom: 12px; font-weight: 600; color: #333;">No products found</p>
            <p style="font-size: 14px; color: #999; margin-bottom: 20px;">Try adjusting your filters</p>
          </div>
        `;
        if (desktopGrid) desktopGrid.innerHTML = emptyHTML;
        if (mobileGrid) mobileGrid.innerHTML = emptyHTML;
        return;
      }

      currentProducts = data.products;
      renderProducts(data.products);
      currentPage = page;
      renderPagination();

    } catch (error) {
      console.error('加载产品失败:', error);
    }
  }

  const escapeHtml = (text) => {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  };

  function renderProductCard(product, isMobile, layout = 'grid') {
    const hasDiscount = product.regular_price && product.price && parseFloat(product.regular_price) > parseFloat(product.price);
    const discountPercent = hasDiscount
      ? Math.round(((parseFloat(product.regular_price) - parseFloat(product.price)) / parseFloat(product.regular_price)) * 100)
      : 0;

    const productName = escapeHtml(product.name);
    const productSlug = encodeURIComponent(product.slug);
    const imageUrl = product.images && product.images[0] ? product.images[0].src : 'https://images.unsplash.com/photo-1515562141207-7a88fb7ce338?w=400&q=80';
    const rating = parseFloat(product.average_rating) || 0;
    const totalSales = parseInt(product.total_sales) || 0;

    if (isMobile && layout === 'list') {
      return `
        <div class="mobile-product-card-list">
          <a href="/product/${productSlug}" class="card-list-link">
            <div class="card-list-image">
              ${hasDiscount ? `<span class="mobile-badge-list">-${discountPercent}%</span>` : ''}
              <img src="${imageUrl}" alt="${productName}" loading="lazy"/>
            </div>
            <div class="card-list-content">
              <div class="card-list-header">
                <h3 class="card-list-title">${productName}</h3>
                <button class="mobile-wishlist-btn-list" onclick="event.preventDefault();">
                  <i class="fa-regular fa-heart"></i>
                </button>
              </div>
              <div class="card-list-price">
                <span class="list-price-current">US$${product.price}</span>
                ${hasDiscount ? `<span class="list-price-old">$${product.regular_price}</span>` : ''}
                ${hasDiscount ? `<span class="list-discount-badge">-${discountPercent}%</span>` : ''}
              </div>
              <div class="card-list-meta">
                <span class="list-moq">MOQ: 1 pc</span>
                <span class="list-divider">|</span>
                <span class="list-material">316L Steel</span>
              </div>
              <div class="card-list-footer">
                <div class="list-rating">
                  ${rating > 0 ? `<span class="stars">${"⭐".repeat(Math.round(rating))}</span>` : ''}
                  ${rating > 0 ? `<span class="rating-num">${rating}</span>` : ''}
                  ${totalSales > 0 ? `<span class="sales-count">${totalSales} orders</span>` : ''}
                </div>
                <button class="mobile-add-btn-list" data-product='${JSON.stringify(product).replace(/'/g, "&apos;")}'>
                  <i class="fa-solid fa-cart-shopping"></i>
                  <span>Add</span>
                </button>
              </div>
            </div>
          </a>
        </div>
      `;
    } else if (isMobile) {
      return `
        <div class="mobile-product-card">
          <a href="/product/${productSlug}">
            <div class="mobile-product-image">
              ${hasDiscount ? `<span class="mobile-badge new">-${discountPercent}%</span>` : ''}
              <button class="mobile-wishlist-btn" onclick="event.preventDefault();">
                <i class="fa-regular fa-heart"></i>
              </button>
              <img src="${imageUrl}" alt="${productName}" loading="lazy"/>
            </div>
            <div class="mobile-product-info">
              <h3 class="mobile-product-title">${productName}</h3>
              <div class="mobile-product-price">
                <span class="mobile-price">US$${product.price}</span>
                ${hasDiscount ? `<span class="mobile-old-price">$${product.regular_price}</span>` : ''}
              </div>
              <div class="mobile-product-meta">
                <span class="mobile-moq">MOQ: 1 pc</span>
                <span class="mobile-material">316L Steel</span>
              </div>
              <button class="mobile-add-btn" data-product='${JSON.stringify(product).replace(/'/g, "&apos;")}'>
                <i class="fa-solid fa-cart-shopping"></i>
                <span>Add</span>
              </button>
            </div>
          </a>
        </div>
      `;
    } else {
      return `
        <div class="product-card-shop">
          <a href="/product/${productSlug}">
            <div class="product-image-wrapper">
              ${hasDiscount ? `<span class="product-badge new">-${discountPercent}%</span>` : ''}
              <button class="wishlist-btn" onclick="event.preventDefault();">
                <i class="fa-regular fa-heart"></i>
              </button>
              <img src="${imageUrl}" alt="${productName}" loading="lazy"/>
            </div>
            <div class="product-details-shop">
              <h3 class="product-title-shop">${productName}</h3>
              <div class="product-price-shop">
                <span class="price-current">US$${product.price}</span>
                ${hasDiscount ? `<span class="price-old">$${product.regular_price}</span>` : ''}
              </div>
              <div class="product-meta">
                <span class="moq">MOQ: 1 pc</span>
                <span class="material">316L Steel</span>
              </div>
              <button class="add-to-cart-btn" data-product='${JSON.stringify(product).replace(/'/g, "&apos;")}'>
                <i class="fa-solid fa-cart-shopping"></i>
                <span>Add</span>
              </button>
            </div>
          </a>
        </div>
      `;
    }
  }

  function renderProducts(products) {
    const desktopGrid = document.getElementById('products-grid-desktop');
    const mobileGrid = document.getElementById('products-grid-mobile');

    if (!products || products.length === 0) return;

    if (desktopGrid) {
      desktopGrid.innerHTML = products.map(p => renderProductCard(p, false)).join('');
    }
    if (mobileGrid) {
      const currentLayout = mobileGrid.classList.contains('list-layout') ? 'list' : 'grid';
      mobileGrid.innerHTML = products.map(p => renderProductCard(p, true, currentLayout)).join('');
    }

    if (desktopGrid) {
      desktopGrid.addEventListener('click', function(e) {
        const addBtn = e.target.closest('.add-to-cart-btn');
        if (addBtn) {
          e.preventDefault();
          e.stopPropagation();
          try {
            const product = JSON.parse(addBtn.dataset.product);
            openQuickOrderWithData(product);
          } catch (error) {
            console.error('解析产品失败:', error);
          }
        }
      });
    }

    if (mobileGrid) {
      mobileGrid.addEventListener('click', function(e) {
        const addBtn = e.target.closest('.mobile-add-btn, .mobile-add-btn-list');
        if (addBtn) {
          e.preventDefault();
          e.stopPropagation();
          try {
            const product = JSON.parse(addBtn.dataset.product);
            openQuickOrderWithData(product);
          } catch (error) {
            console.error('解析移动产品失败:', error);
          }
        }
      });
    }
  }

  function applySorting(sortType) {
    if (!currentProducts || currentProducts.length === 0) return;
    let sortedProducts = [...currentProducts];

    switch (sortType) {
      case 'popularity':
        sortedProducts.sort((a, b) => (parseInt(b.total_sales) || 0) - (parseInt(a.total_sales) || 0));
        break;
      case 'rating':
        sortedProducts.sort((a, b) => (parseFloat(b.average_rating) || 0) - (parseFloat(a.average_rating) || 0));
        break;
      case 'date':
        sortedProducts.sort((a, b) => new Date(b.date_created || 0) - new Date(a.date_created || 0));
        break;
      case 'price':
        sortedProducts.sort((a, b) => (parseFloat(a.price) || 0) - (parseFloat(b.price) || 0));
        break;
      case 'price-desc':
        sortedProducts.sort((a, b) => (parseFloat(b.price) || 0) - (parseFloat(a.price) || 0));
        break;
      default:
        break;
    }
    renderProducts(sortedProducts);
  }

  document.addEventListener('DOMContentLoaded', () => {
    updateBreadcrumb();
    loadFilters();
    fetchAndSyncQuickGiftsData();
    const urlParams = new URLSearchParams(window.location.search);
    const pageParam = urlParams.get('page');
    loadPage(pageParam ? parseInt(pageParam) : 1);
  });

  async function loadFilters() {
    try {
      const response = await fetch('/api/filters');
      if (!response.ok) throw new Error('Failed to load filters');
      const data = await response.json();
      renderFilters(data);
    } catch (error) {
      console.error('加载筛选失败:', error);
    }
  }

  function renderFilters(data) {
    const container = document.getElementById('filters-container');
    const mobileContainer = document.getElementById('mobileFilterContent');
    if (!container) return;

    let html = '';
    html += '<div class="filters-header">';
    html += '<h2>Filters</h2>';
    html += '<button class="filters-reset" onclick="resetAllFilters()" title="Reset all filters">';
    html += '<i class="fa-solid fa-rotate-right"></i>';
    html += '</button></div>';

    if (data.newArrivals && data.newArrivals.length > 0) {
      html += '<div class="filter-section">';
      html += '<div class="filter-header" onclick="toggleFilterSection(this)">';
      html += '<h3 class="filter-title">NEW ARRIVALS</h3>';
      html += '<button class="filter-toggle"><i class="fa-solid fa-chevron-up"></i></button></div>';
      html += '<div class="filter-content"><ul class="filter-list">';
      data.newArrivals.forEach(cat => {
        if (cat.children && cat.children.length > 0) {
          cat.children.forEach(child => {
            html += `<li><label><input type="checkbox" name="category" value="${child.id}" data-slug="${child.slug}" data-filter="category"><span>${child.name}</span></label></li>`;
          });
        }
      });
      html += '</ul></div></div>';
    }

    if (data.allJewelry && data.allJewelry.length > 0) {
      html += '<div class="filter-section">';
      html += '<div class="filter-header" onclick="toggleFilterSection(this)">';
      html += '<h3 class="filter-title">ALL JEWELRY</h3>';
      html += '<button class="filter-toggle"><i class="fa-solid fa-chevron-up"></i></button></div>';
      html += '<div class="filter-content"><ul class="filter-list">';
      data.allJewelry.forEach(cat => {
        const hasChildren = cat.children && cat.children.length > 0;
        html += `<li><div class="category-parent"><label><input type="checkbox" name="category" value="${cat.id}" data-slug="${cat.slug}" data-filter="category"><span>${cat.name}</span></label>`;
        if (hasChildren) {
          html += `<button class="toggle-children" onclick="event.stopPropagation(); toggleChildren(this, 'children-${cat.id}')"><i class="fa-solid fa-chevron-down"></i></button>`;
        }
        html += '</div>';
        if (hasChildren) {
          html += `<ul class="filter-children" id="children-${cat.id}">`;
          cat.children.forEach(child => {
            html += `<li><label><input type="checkbox" name="category" value="${child.id}" data-slug="${child.slug}" data-filter="category"><span>${child.name}</span></label></li>`;
          });
          html += '</ul>';
        }
        html += '</li>';
      });
      html += '</ul></div></div>';
    }

    if (data.materials && data.materials.length > 0) {
      html += '<div class="filter-section">';
      html += '<div class="filter-header" onclick="toggleFilterSection(this)">';
      html += '<h3 class="filter-title">MATERIAL</h3>';
      html += '<button class="filter-toggle"><i class="fa-solid fa-chevron-up"></i></button></div>';
      html += '<div class="filter-content"><ul class="filter-list">';
      data.materials.forEach(material => {
        html += `<li><label><input type="checkbox" name="material" value="${material.id}" data-slug="${material.slug}" data-filter="material"><span>${material.name}</span></label></li>`;
      });
      html += '</ul></div></div>';
    }

    if (data.colors && data.colors.length > 0) {
      html += '<div class="filter-section">';
      html += '<div class="filter-header" onclick="toggleFilterSection(this)">';
      html += '<h3 class="filter-title">COLOR</h3>';
      html += '<button class="filter-toggle"><i class="fa-solid fa-chevron-up"></i></button></div>';
      html += '<div class="filter-content"><div class="color-swatches">';
      data.colors.forEach(color => {
        html += `<div class="color-swatch-wrapper"><label class="color-swatch" style="background: ${color.hex};" title="${color.name}"><input type="checkbox" name="color" value="${color.id}" data-slug="${color.slug}" data-filter="color"></label><span class="color-label">${color.name}</span></div>`;
      });
      html += '</div></div></div>';
    }

    container.innerHTML = html;

    if (mobileContainer) {
      const tempDiv = document.createElement('div');
      tempDiv.innerHTML = html;
      const header = tempDiv.querySelector('.filters-header');
      if (header) header.remove();
      mobileContainer.innerHTML = tempDiv.innerHTML;
    }

    const filterInputs = container.querySelectorAll('input[data-filter]');
    filterInputs.forEach(input => input.addEventListener('change', handleFilterChange));

    const colorSwatches = container.querySelectorAll('.color-swatch input');
    colorSwatches.forEach(input => {
      input.addEventListener('change', function() {
        const swatch = this.closest('.color-swatch');
        if (this.checked) swatch.classList.add('selected');
        else swatch.classList.remove('selected');
      });
    });

    if (mobileContainer) {
      mobileContainer.querySelectorAll('input[data-filter]').forEach(input => input.addEventListener('change', updateMobileFilterCount));
      mobileContainer.querySelectorAll('.color-swatch input').forEach(input => {
        input.addEventListener('change', function() {
          const swatch = this.closest('.color-swatch');
          if (this.checked) swatch.classList.add('selected');
          else swatch.classList.remove('selected');
          updateMobileFilterCount();
        });
      });
    }
  }

  function handleFilterChange() {
    const selectedFilters = { categories: [], colors: [], materials: [] };
    document.querySelectorAll('input[name="category"]:checked').forEach(input => selectedFilters.categories.push(input.value));
    document.querySelectorAll('input[name="color"]:checked').forEach(input => selectedFilters.colors.push(input.value));
    document.querySelectorAll('input[name="material"]:checked').forEach(input => selectedFilters.materials.push(input.value));

    currentFilters = selectedFilters;
    loadPage(1, selectedFilters);
  }

  const sortBtn = document.getElementById('mobileSortBtn');
  const sortDropdown = document.getElementById('mobileSortDropdown');
  const sortOptions = document.querySelectorAll('.sort-option');
  let currentSort = 'menu_order';
  let currentProducts = [];

  if (sortBtn && sortDropdown) {
    sortBtn.addEventListener('click', () => {
      sortDropdown.classList.toggle('show');
      sortBtn.classList.toggle('active');
    });

    sortOptions.forEach(option => {
      option.addEventListener('click', () => {
        const sortType = option.dataset.sort;
        sortOptions.forEach(opt => opt.classList.remove('active'));
        option.classList.add('active');
        sortBtn.querySelector('span').textContent = option.textContent;
        sortDropdown.classList.remove('show');
        sortBtn.classList.remove('active');
        currentSort = sortType;
        applySorting(sortType);
      });
    });

    document.addEventListener('click', (e) => {
      if (!sortBtn.contains(e.target) && !sortDropdown.contains(e.target)) {
        sortDropdown.classList.remove('show');
        sortBtn.classList.remove('active');
      }
    });
  }

  const desktopSortBtns = document.querySelectorAll('.sort-left .sort-btn');
  desktopSortBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const sortType = btn.dataset.sort;
      desktopSortBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      currentSort = sortType;
      applySorting(sortType);
    });
  });

  const layoutBtns = document.querySelectorAll('.layout-btn');
  const mobileProductsGrid = document.getElementById('products-grid-mobile');
  layoutBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const layout = btn.dataset.layout;
      layoutBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      if (mobileProductsGrid) {
        if (layout === 'list') mobileProductsGrid.classList.add('list-layout');
        else mobileProductsGrid.classList.remove('list-layout');

        if (currentProducts && currentProducts.length > 0) {
          mobileProductsGrid.innerHTML = currentProducts.map(p => renderProductCard(p, true, layout)).join('');
        }
      }
    });
  });

  const mobileFilterBtn = document.getElementById('mobileFilterBtn');
  const mobileFilterOverlay = document.getElementById('mobileFilterOverlay');
  const mobileFilterDrawer = document.getElementById('mobileFilterDrawer');
  const mobileFilterClose = document.getElementById('mobileFilterClose');
  const mobileFilterApply = document.getElementById('mobileFilterApply');
  const mobileFilterReset = document.getElementById('mobileFilterReset');

  function openMobileFilterDrawer() {
    mobileFilterOverlay.classList.add('active');
    mobileFilterDrawer.classList.add('active');
    document.body.style.overflow = 'hidden';
  }

  function closeMobileFilterDrawer() {
    mobileFilterOverlay.classList.remove('active');
    mobileFilterDrawer.classList.remove('active');
    document.body.style.overflow = '';
  }

  function updateMobileFilterCount() {
    const mobileContainer = document.getElementById('mobileFilterContent');
    if (!mobileContainer) return;
    const count = mobileContainer.querySelectorAll('input[data-filter]:checked').length;
    const countBadge = document.getElementById('mobileFilterCount');
    if (countBadge) countBadge.textContent = count;
  }

  function applyMobileFilters() {
    const mobileContainer = document.getElementById('mobileFilterContent');
    if (!mobileContainer) return;

    pageBeforeFilter = currentPage;
    const selectedFilters = { categories: [], colors: [], materials: [] };
    mobileContainer.querySelectorAll('input[name="category"]:checked').forEach(input => selectedFilters.categories.push(input.value));
    mobileContainer.querySelectorAll('input[name="color"]:checked').forEach(input => selectedFilters.colors.push(input.value));
    mobileContainer.querySelectorAll('input[name="material"]:checked').forEach(input => selectedFilters.materials.push(input.value));

    syncFiltersToDesktop(selectedFilters);
    currentFilters = selectedFilters;
    closeMobileFilterDrawer();
    loadPage(1, selectedFilters);
  }

  function syncFiltersToDesktop(filters) {
    const desktopContainer = document.getElementById('filters-container');
    if (!desktopContainer) return;

    desktopContainer.querySelectorAll('input[data-filter]:checked').forEach(input => input.checked = false);
    filters.categories.forEach(id => {
      const input = desktopContainer.querySelector(`input[name="category"][value="${id}"]`);
      if (input) input.checked = true;
    });
    filters.colors.forEach(id => {
      const input = desktopContainer.querySelector(`input[name="color"][value="${id}"]`);
      if (input) {
        input.checked = true;
        input.closest('.color-swatch')?.classList.add('selected');
      }
    });
    filters.materials.forEach(id => {
      const input = desktopContainer.querySelector(`input[name="material"][value="${id}"]`);
      if (input) input.checked = true;
    });
