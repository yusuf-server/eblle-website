---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/CartDrawer.astro';
import ProductSkeleton from '../components/ProductSkeleton.astro';

// 不再在服务端获取数据，改为客户端加载
const perPage = 20;

// 生成分页数组
const generatePagination = (current: number, total: number) => {
  const pages: (number | string)[] = [];

  if (total <= 7) {
    for (let i = 1; i <= total; i++) {
      pages.push(i);
    }
  } else {
    pages.push(1);
    if (current > 3) {
      pages.push('...');
    }
    const start = Math.max(2, current - 1);
    const end = Math.min(total - 1, current + 1);
    for (let i = start; i <= end; i++) {
      pages.push(i);
    }
    if (current < total - 2) {
      pages.push('...');
    }
    pages.push(total);
  }

  return pages;
};

// 添加缓存控制，确保页面不被缓存
if (Astro.response) {
  Astro.response.headers.set('Cache-Control', 'no-store, no-cache, must-revalidate');
}
---

<Layout title="Shop - E.B.Belle">
  <Header />

  <!-- Mobile Search Bar -->
  <div class="mobile-search-container">
    <div class="mobile-search-wrapper">
      <i class="fa-solid fa-magnifying-glass search-icon"></i>
      <input
        type="text"
        class="mobile-search-input"
        placeholder="Search 50,000+ wholesale necklaces..."
      />
      <button class="mobile-search-btn">SEARCH</button>
    </div>
  </div>

  <!-- BREADCRUMB -->
  <div class="breadcrumb-section">
    <div class="container">
      <div class="breadcrumb-content">
        <div class="breadcrumb-wrapper">
          <div class="breadcrumb">
            <a href="/">Home</a>
            <span>/</span>
            <span>Shop</span>
          </div>
        </div>
        <div class="mobile-results-count">(<span id="total-products">0</span>)</div>
      </div>
    </div>
  </div>

  <!-- Mobile Filter Bar -->
  <div class="mobile-filter-bar">
    <button class="filter-main-btn" id="mobileFilterBtn">
      <i class="fa-solid fa-sliders"></i>
      <span>Filters</span>
      <span class="filter-count" id="mobileFilterCount">0</span>
    </button>
    <button class="filter-tag-btn active">Best Match</button>
    <button class="filter-tag-btn">316L Steel</button>
    <button class="filter-tag-btn">$925 Silver</button>
    <button class="filter-tag-btn">Waterproof</button>
  </div>

  <!-- Mobile Filter Drawer -->
  <div class="mobile-filter-drawer-overlay" id="mobileFilterOverlay"></div>
  <div class="mobile-filter-drawer" id="mobileFilterDrawer">
    <div class="mobile-filter-header">
      <h3>Filters</h3>
      <button class="mobile-filter-close" id="mobileFilterClose">
        <i class="fa-solid fa-times"></i>
      </button>
    </div>
    <div class="mobile-filter-content" id="mobileFilterContent">
      <!-- 筛选内容将动态插入这里 -->
    </div>
    <div class="mobile-filter-footer">
      <button class="mobile-filter-reset" id="mobileFilterReset">
        <i class="fa-solid fa-rotate-right"></i>
        Reset
      </button>
      <button class="mobile-filter-apply" id="mobileFilterApply">
        Apply Filters
      </button>
    </div>
  </div>

  <!-- Quick Order Modal (桌面端) -->
  <div class="quick-order-overlay" id="quickOrderOverlay"></div>
  <div class="quick-order-modal" id="quickOrderModal">
    <button class="quick-order-close" id="quickOrderClose">
      <i class="fa-solid fa-times"></i>
    </button>
    <div class="quick-order-content" id="quickOrderContent">
      <!-- 产品详情将动态插入这里 -->
    </div>
  </div>

  <!-- Quick Order Mobile Sheet (移动端) -->
  <div class="quick-order-mobile-overlay" id="quickOrderMobileOverlay"></div>
  <div class="quick-order-mobile-sheet" id="quickOrderMobileSheet">
    <div class="mobile-sheet-header" id="mobileSheetHeader">
      <button class="mobile-sheet-close" id="quickOrderMobileClose">
        <i class="fa-solid fa-times"></i>
      </button>
      <!-- 产品图片、标题、价格将动态插入这里 -->
    </div>
    <div class="mobile-sheet-content" id="quickOrderMobileContent">
      <!-- 产品详情将动态插入这里 -->
    </div>
  </div>

  <!-- Mobile Sort & Layout Control -->
  <div class="mobile-control-bar">
    <button class="sort-btn" id="mobileSortBtn">
      <span>Sort</span>
      <i class="fa-solid fa-chevron-down"></i>
    </button>
    <div class="layout-toggle">
      <button class="layout-btn active" data-layout="grid">
        <i class="fa-solid fa-grip"></i>
      </button>
      <button class="layout-btn" data-layout="list">
        <i class="fa-solid fa-bars"></i>
      </button>
    </div>
  </div>

  <!-- Sort Dropdown -->
  <div class="mobile-sort-dropdown" id="mobileSortDropdown">
    <button class="sort-option active" data-sort="menu_order">Default sorting</button>
    <button class="sort-option" data-sort="popularity">Sort by popularity</button>
    <button class="sort-option" data-sort="rating">Sort by average rating</button>
    <button class="sort-option" data-sort="date">Sort by latest</button>
    <button class="sort-option" data-sort="price">Sort by price: low to high</button>
    <button class="sort-option" data-sort="price-desc">Sort by price: high to low</button>
  </div>

  <!-- Mobile Products Grid -->
  <div class="mobile-products-container">
    <div class="mobile-products-grid" id="products-grid-mobile">
      <!-- 骨架屏，JavaScript加载后会替换 -->
      <ProductSkeleton count={20} />
    </div>

    <!-- Mobile Pagination -->
    <div class="mobile-pagination" id="pagination-mobile">
      <button
        class="mobile-page-btn page-prev"
        data-page="prev"
        disabled
      >
        <i class="fa-solid fa-chevron-left"></i>
      </button>

      <button class="mobile-page-btn active" data-page="1">1</button>

      <button
        class="mobile-page-btn page-next"
        data-page="next"
      >
        <i class="fa-solid fa-chevron-right"></i>
      </button>
    </div>
  </div>

  <!-- SHOP MAIN CONTENT -->
  <div class="shop-container">
    <div class="container">
      <div class="shop-layout">
        <!-- Sidebar Filters -->
        <aside class="shop-sidebar">
          <!-- 筛选区域，JavaScript动态加载 -->
          <div id="filters-container">
            <!-- 加载中状态 -->
            <div class="filters-loading">
              <div class="loading-skeleton"></div>
              <div class="loading-skeleton"></div>
              <div class="loading-skeleton"></div>
            </div>
          </div>
        </aside>

        <!-- Main Product Area -->
        <main class="shop-main">
          <!-- Sorting Bar -->
          <div class="sorting-bar">
            <div class="sort-left">
              <span class="sort-label">Sort by:</span>
              <button class="sort-btn active" data-sort="menu_order">Default sorting</button>
              <button class="sort-btn" data-sort="popularity">Sort by popularity</button>
              <button class="sort-btn" data-sort="rating">Sort by average rating</button>
              <button class="sort-btn" data-sort="date">Sort by latest</button>
              <button class="sort-btn" data-sort="price">Sort by price: low to high</button>
              <button class="sort-btn" data-sort="price-desc">Sort by price: high to low</button>
            </div>
            <div class="sort-right">
              <span class="products-count"><span id="products-count-desktop">0</span> Products Found</span>
              <div class="view-toggle">
                <button class="view-btn active"><i class="fa-solid fa-grip"></i></button>
                <button class="view-btn"><i class="fa-solid fa-list"></i></button>
              </div>
            </div>
          </div>

          <!-- Product Grid -->
          <div class="products-grid" id="products-grid-desktop">
            <!-- 骨架屏，JavaScript加载后会替换 -->
            <ProductSkeleton count={20} />

          </div>
          <!-- Pagination -->
          <div class="pagination" id="pagination-desktop">
            <button
              class="page-btn page-prev"
              data-page="prev"
              disabled
            >
              <i class="fa-solid fa-chevron-left"></i>
            </button>

            <button class="page-btn active" data-page="1">1</button>

            <button
              class="page-btn page-next"
              data-page="next"
            >
              <i class="fa-solid fa-chevron-right"></i>
            </button>
          </div>
        </main>
      </div>
    </div>
  </div>

  <Footer />
  <CartDrawer />
</Layout>


<style is:global>
  /* Prevent horizontal scroll on mobile */
  * {
    box-sizing: border-box;
  }

  body {
    overflow-x: hidden;
  }

  @media (max-width: 820px) {
    :root {
      --container-w: 100%;
    }
    .container {
      padding: 0 10px;
    }
    .breadcrumb-content {
      width: 100%;
      max-width: 100%;
      box-sizing: border-box;
    }
    .mobile-results-count {
      display: block;
    }
    .breadcrumb-wrapper {
      width: 65%;
      max-width: 65%;
    }
    .mobile-results-count {
      width: 30%;
      max-width: 30%;
    }
  }
  .mobile-search-container {
    display: none;
    padding: 12px 16px;
    background: white;
    border-bottom: 1px solid #e5e5e5;
  }
  .mobile-search-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    background: #F7F4EE;
    border: 1px solid #e5e5e5;
    border-radius: 8px;
    padding: 10px 12px;
  }
  .search-icon {
    font-size: 16px;
    color: #999;
    margin-right: 10px;
  }
  .mobile-search-input {
    flex: 1;
    border: none;
    background: transparent;
    font-size: 13px;
    color: #333;
    outline: none;
  }
  .mobile-search-input::placeholder {
    color: #999;
  }
  .mobile-search-btn {
    background: transparent;
    border: none;
    color: #B8860B;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
    padding: 0 8px;
    cursor: pointer;
    text-transform: uppercase;
  }
  .mobile-search-btn:active {
    opacity: 0.7;
  }

  @media (max-width: 768px) {
    .mobile-search-container {
      display: block;
    }
  }

  /* Mobile Filter Bar */
  .mobile-filter-bar {
    display: none;
    background: #f9f9f9;
    padding: 6px 16px 10px;
    gap: 6px;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .mobile-filter-bar::-webkit-scrollbar {
    display: none;
  }

  /* 移动端筛选Drawer */
  .mobile-filter-drawer-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5);
    z-index: 997;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s, visibility 0.3s;
  }

  .mobile-filter-drawer-overlay.active {
    opacity: 1;
    visibility: visible;
  }

  .mobile-filter-drawer {
    position: fixed;
    top: 0;
    right: 0;
    width: 85%;
    max-width: 400px;
    height: 100%;
    background: #fff;
    z-index: 998;
    transform: translateX(100%);
    transition: transform 0.3s ease;
    display: flex;
    flex-direction: column;
  }

  .mobile-filter-drawer.active {
    transform: translateX(0);
  }

  .mobile-filter-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px;
    border-bottom: 1px solid #e5e5e5;
  }

  .mobile-filter-header h3 {
    font-size: 18px;
    font-weight: 600;
    margin: 0;
  }

  .mobile-filter-close {
    background: none;
    border: none;
    font-size: 24px;
    color: #666;
    cursor: pointer;
    padding: 0;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .mobile-filter-content {
    flex: 1;
    overflow-y: auto;
    padding: 20px;
  }

  /* 移动端drawer内的筛选区域优化 */
  .mobile-filter-content .filter-section {
    margin-bottom: 20px;
  }

  .mobile-filter-content .filter-header {
    padding: 12px 0;
    cursor: pointer;
  }

  .mobile-filter-content .filter-title {
    font-size: 15px;
    font-weight: 600;
  }

  .mobile-filter-content .filter-content {
    padding-top: 8px;
  }

  .mobile-filter-content .filter-list {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .mobile-filter-content .filter-list li {
    display: flex;
    align-items: flex-start;
  }

  .mobile-filter-content label {
    display: flex;
    align-items: center;
    gap: 12px;
    cursor: pointer;
    padding: 6px 0;
    width: 100%;
    font-size: 16px;
    -webkit-tap-highlight-color: transparent;
  }

  .mobile-filter-content input[type="checkbox"] {
    width: 22px;
    height: 22px;
    min-width: 22px;
    cursor: pointer;
    accent-color: #B8860B;
  }

  .mobile-filter-content .category-parent {
    width: 100%;
  }

  .mobile-filter-content .color-options {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(80px, 1fr));
    gap: 12px;
    padding-top: 8px;
  }

  .mobile-filter-content .color-swatch-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }

  .mobile-filter-content .color-swatch {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 3px solid transparent;
    cursor: pointer;
    transition: all 0.2s;
    -webkit-tap-highlight-color: transparent;
  }

  .mobile-filter-content .color-swatch.selected {
    border-color: #B8860B;
    box-shadow: 0 0 0 2px #fff, 0 0 0 4px #B8860B;
  }

  .mobile-filter-content .color-label {
    font-size: 12px;
    color: #666;
    text-align: center;
  }

  .mobile-filter-footer {
    display: flex;
    gap: 12px;
    padding: 16px 20px;
    border-top: 1px solid #e5e5e5;
    background: #fff;
  }

  .mobile-filter-reset {
    flex: 0 0 auto;
    padding: 12px 20px;
    background: #fff;
    border: 1px solid #ddd;
    border-radius: 4px;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 8px;
    transition: all 0.2s;
  }

  .mobile-filter-reset:active {
    background: #f5f5f5;
  }

  .mobile-filter-apply {
    flex: 1;
    padding: 12px 20px;
    background: #1a1a1a;
    color: #fff;
    border: none;
    border-radius: 4px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s;
  }

  .mobile-filter-apply:active {
    background: #000;
  }

  /* Quick Order Modal (桌面端) */
  .quick-order-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.6);
    z-index: 1001;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s, visibility 0.3s;
  }

  .quick-order-overlay.active {
    opacity: 1;
    visibility: visible;
  }

  .quick-order-modal {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scale(0.9);
    width: 90%;
    max-width: 1200px;
    max-height: 85vh;
    background: #fff;
    border-radius: 12px;
    z-index: 1002;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s;
    overflow: hidden;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
  }

  .quick-order-modal.active {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, -50%) scale(1);
  }

  .quick-order-close {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 40px;
    height: 40px;
    background: rgba(255, 255, 255, 0.9);
    border: none;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    color: #333;
    z-index: 10;
    transition: all 0.2s;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .quick-order-close:hover {
    background: #fff;
    transform: rotate(90deg);
  }

  .quick-order-content {
    display: grid;
    grid-template-columns: 45% 55%;
    height: 85vh;
    overflow: hidden;
  }

  .quick-order-images {
    background: #f9f9f9;
    padding: 40px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    overflow-y: auto;
  }

  .quick-order-main-image {
    width: 100%;
    aspect-ratio: 1;
    border-radius: 8px;
    overflow: hidden;
    background: #fff;
  }

  .quick-order-main-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .quick-order-thumbnails {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 12px;
  }

  .quick-order-thumb {
    aspect-ratio: 1;
    border-radius: 6px;
    overflow: hidden;
    cursor: pointer;
    border: 2px solid transparent;
    transition: all 0.2s;
  }

  .quick-order-thumb:hover,
  .quick-order-thumb.active {
    border-color: #B8860B;
  }

  .quick-order-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .quick-order-details {
    padding: 40px;
    overflow-y: auto;
  }

  .quick-order-title {
    font-size: 24px;
    font-weight: 600;
    margin-bottom: 12px;
    color: #1a1a1a;
  }

  .quick-order-price {
    font-size: 32px;
    font-weight: 700;
    color: #B8860B;
    margin-bottom: 16px;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .quick-order-price-current {
    font-size: 32px;
    color: #B8860B;
  }

  .quick-order-price-regular {
    font-size: 24px;
    color: #999;
    text-decoration: line-through;
  }

  .quick-order-stock {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 16px;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 24px;
  }

  .quick-order-stock.in-stock {
    background: #d4edda;
    color: #155724;
  }

  .quick-order-stock.out-of-stock {
    background: #f8d7da;
    color: #721c24;
  }

  .quick-order-stock-placeholder {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 16px;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 24px;
    background: #f0f0f0;
    color: #666;
  }

  .quick-order-section {
    margin-bottom: 32px;
    padding-bottom: 24px;
    border-bottom: 1px solid #e5e5e5;
  }

  .quick-order-section:last-child {
    border-bottom: none;
  }

  .quick-order-section-title {
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
    color: #666;
    margin-bottom: 16px;
  }

  .quick-order-options {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .quick-order-option {
    padding: 10px 20px;
    border: 2px solid #ddd;
    border-radius: 6px;
    background: #fff;
    cursor: pointer;
    transition: all 0.2s;
    font-size: 14px;
  }

  .quick-order-option:hover {
    border-color: #B8860B;
  }

  .quick-order-option.selected {
    border-color: #B8860B;
    background: #B8860B;
    color: #fff;
  }

  .quick-order-quantity {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .quick-order-qty-btn {
    width: 36px;
    height: 36px;
    border: 1px solid #ddd;
    background: #fff;
    border-radius: 4px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    transition: all 0.2s;
  }

  .quick-order-qty-btn:hover {
    border-color: #B8860B;
    color: #B8860B;
  }

  .quick-order-qty-input {
    width: 60px;
    height: 36px;
    text-align: center;
    border: 1px solid #ddd;
    border-radius: 4px;
    font-size: 16px;
  }

  .quick-order-add-btn {
    width: 100%;
    padding: 16px;
    background: #B8860B;
    color: #fff;
    border: none;
    border-radius: 8px;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
  }

  .quick-order-add-btn:hover:not(.disabled) {
    background: #8B6914;
  }

  .quick-order-add-btn.disabled {
    background: #ccc;
    color: #666;
    cursor: not-allowed;
  }

  .quick-order-loading {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 60px 20px;
    gap: 16px;
  }

  .loading-spinner {
    width: 40px;
    height: 40px;
    border: 4px solid #f0f0f0;
    border-top: 4px solid #B8860B;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  .quick-order-loading p {
    color: #666;
    font-size: 14px;
  }

  /* Quick Order Mobile Sheet (移动端) */
  .quick-order-mobile-overlay {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5);
    z-index: 1001;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s, visibility 0.3s;
  }

  .quick-order-mobile-overlay.active {
    opacity: 1;
    visibility: visible;
  }

  .quick-order-mobile-sheet {
    display: none;
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    max-height: 85vh;
    background: #fff;
    border-radius: 20px 20px 0 0;
    z-index: 1002;
    transform: translateY(100%);
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
