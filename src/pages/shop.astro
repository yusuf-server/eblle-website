  // 排序函数
  function applySorting(sortType) {
    console.log('应用排序:', sortType);

    if (!currentProducts || currentProducts.length === 0) {
      console.warn('没有产品可以排序');
      return;
    }

    let sortedProducts = [...currentProducts];

    switch (sortType) {
      case 'menu_order':
        // 默认排序（保持原始顺序）
        break;

      case 'popularity':
        // 按销量排序（假设total_sales字段）
        sortedProducts.sort((a, b) => {
          const salesA = parseInt(a.total_sales) || 0;
          const salesB = parseInt(b.total_sales) || 0;
          return salesB - salesA;
        });
        break;

      case 'rating':
        // 按评分排序
        sortedProducts.sort((a, b) => {
          const ratingA = parseFloat(a.average_rating) || 0;
          const ratingB = parseFloat(b.average_rating) || 0;
          return ratingB - ratingA;
        });
        break;

      case 'date':
        // 按日期排序（最新的在前）
        sortedProducts.sort((a, b) => {
          const dateA = new Date(a.date_created || 0);
          const dateB = new Date(b.date_created || 0);
          return dateB - dateA;
        });
        break;

      case 'price':
        // 价格从低到高
        sortedProducts.sort((a, b) => {
          const priceA = parseFloat(a.price) || 0;
          const priceB = parseFloat(b.price) || 0;
          return priceA - priceB;
        });
        break;

      case 'price-desc':
        // 价格从高到低
        sortedProducts.sort((a, b) => {
          const priceA = parseFloat(a.price) || 0;
          const priceB = parseFloat(b.price) || 0;
          return priceB - priceA;
        });
        break;

      default:
        console.warn('未知的排序类型:', sortType);
    }

    console.log('排序后的产品数量:', sortedProducts.length);

    // 重新渲染产品
    renderProducts(sortedProducts);
  }

