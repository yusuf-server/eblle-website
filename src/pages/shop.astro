<script>
  // 标记 shop.astro 的完整 Quick Order 实现已加载
  window.shopQuickOrderInitialized = true;

  // 初始化面包屑导航
  function updateBreadcrumb() {
    const urlParams = new URLSearchParams(window.location.search);
    const searchQuery = urlParams.get('q');
    const category = urlParams.get('category');
    const breadcrumb = document.querySelector('.breadcrumb');

    if (breadcrumb) {
      if (searchQuery) {
        // 显示搜索结果面包屑
        breadcrumb.innerHTML = `
          <a href="/">Home</a>
          <span>/</span>
          <a href="/shop">Shop</a>
          <span>/</span>
          <span>Search: "${searchQuery}"</span>
        `;
      } else if (category) {
        // 显示分类面包屑
        const categoryName = category.replace(/-/g, ' ').replace(/\b\w/g, l => l.toUpperCase());
        breadcrumb.innerHTML = `
          <a href="/">Home</a>
          <span>/</span>
          <a href="/shop">Shop</a>
          <span>/</span>
          <span>${categoryName}</span>
        `;
      } else {
        // 默认面包屑
        breadcrumb.innerHTML = `
          <a href="/">Home</a>
          <span>/</span>
          <span>Shop</span>
        `;
      }
    }
  }

  // 页面状态
  let currentPage = 1;
  let totalPages = 1;
  let totalProducts = 0;
  const perPage = 20;
  let isLoading = false;
  let currentFilters = null; // 保存当前筛选条件
  let pageBeforeFilter = 1; // 保存筛选前的页码

  // 全局函数：折叠/展开筛选区块
  window.toggleFilterSection = function(header) {
    const section = header.parentElement;
    const content = section.querySelector('.filter-content');
    const toggle = section.querySelector('.filter-toggle');

    content.classList.toggle('collapsed');
    toggle.classList.toggle('collapsed');
  };

  // 全局函数：折叠/展开子分类
  window.toggleChildren = function(button, targetId) {
    const target = document.getElementById(targetId);
    if (target) {
      target.classList.toggle('show');
      button.classList.toggle('expanded');
    }
  };

  // 全局函数：重置所有筛选
  window.resetAllFilters = function() {
    const allCheckboxes = document.querySelectorAll('#filters-container input[type="checkbox"]');
    allCheckboxes.forEach(checkbox => {
      checkbox.checked = false;
    });

    // 移除颜色选中样式
    const colorSwatches = document.querySelectorAll('.color-swatch.selected');
    colorSwatches.forEach(swatch => {
      swatch.classList.remove('selected');
    });

    // 触发筛选变化
    handleFilterChange();
