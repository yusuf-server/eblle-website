  // 生成分页按钮
  function generatePagination(current, total) {
    const pages = [];
    if (total <= 7) {
      for (let i = 1; i <= total; i++) {
        pages.push(i);
      }
    } else {
      pages.push(1);
      if (current > 3) {
        pages.push('...');
      }
      const start = Math.max(2, current - 1);
      const end = Math.min(total - 1, current + 1);
      for (let i = start; i <= end; i++) {
        pages.push(i);
      }
      if (current < total - 2) {
        pages.push('...');
      }
      pages.push(total);
    }
    return pages;
  }

  // 渲染分页按钮
  function renderPagination() {
    const pages = generatePagination(currentPage, totalPages);

    // 桌面端
    const desktopPagination = document.getElementById('pagination-desktop');
    const mobilePagination = document.getElementById('pagination-mobile');

    [desktopPagination, mobilePagination].forEach(container => {
      if (!container) return;

      const isMobile = container.id.includes('mobile');
      const btnClass = isMobile ? 'mobile-page-btn' : 'page-btn';
      const dotsClass = isMobile ? 'mobile-page-dots' : 'page-dots';

      let html = `
        <button class="${btnClass}" data-page="prev" ${currentPage === 1 ? 'disabled' : ''}>
          <i class="fa-solid fa-chevron-left"></i>
        </button>
      `;

      pages.forEach(page => {
        if (page === '...') {
          html += `<span class="${dotsClass}">...</span>`;
        } else {
          html += `<button class="${btnClass} ${currentPage === page ? 'active' : ''}" data-page="${page}">${page}</button>`;
        }
      });

      html += `
        <button class="${btnClass}" data-page="next" ${currentPage >= totalPages ? 'disabled' : ''}>
          <i class="fa-solid fa-chevron-right"></i>
        </button>
      `;

      container.innerHTML = html;
    });

    // 绑定点击事件
    document.querySelectorAll('[data-page]').forEach(btn => {
      btn.addEventListener('click', handlePageClick);
    });
  }

  // 处理分页点击
  async function handlePageClick(e) {
    console.log('=== 分页按钮被点击 ===');
    console.log('事件对象:', e);
    console.log('目标元素:', e.currentTarget);

    const pageValue = e.currentTarget.dataset.page;
    console.log('页码值:', pageValue);

    let newPage = currentPage;

    if (pageValue === 'prev') {
      newPage = Math.max(1, currentPage - 1);
    } else if (pageValue === 'next') {
      newPage = Math.min(totalPages, currentPage + 1);
    } else {
      newPage = parseInt(pageValue);
    }

    console.log('当前页:', currentPage, '新页码:', newPage);

    if (newPage === currentPage) {
      console.log('页码相同，不执行加载');
      return;
    }

    // 1. 立即更新页码（视觉反馈）
    currentPage = newPage;

    // 2. 立即更新URL
    const url = new URL(window.location);
    url.searchParams.set('page', newPage);
    window.history.pushState({}, '', url);

    // 3. 立即更新分页按钮UI
    renderPagination();

    // 4. 立即滚动到顶部
    window.scrollTo({ top: 0, behavior: 'smooth' });

    // 5. 然后加载产品（会显示骨架屏）
    await loadPage(newPage, currentFilters);
  }

  // 加载指定页的产品
  async function loadPage(page, filters = null) {
    try {
      console.log('开始加载第', page, '页...', filters ? '带筛选条件' : '');

      // 显示骨架屏
      const desktopGrid = document.getElementById('products-grid-desktop');
      const mobileGrid = document.getElementById('products-grid-mobile');

      console.log('找到的网格容器:', { desktopGrid, mobileGrid });

      // 生成骨架屏HTML
      const skeletonHTML = Array.from({ length: 20 }, () => `
        <div class="product-skeleton">
          <div class="skeleton-image"></div>
          <div class="skeleton-content">
            <div class="skeleton-line skeleton-title"></div>
            <div class="skeleton-line skeleton-price"></div>
            <div class="skeleton-line skeleton-meta"></div>
          </div>
        </div>
      `).join('');

      if (desktopGrid) desktopGrid.innerHTML = skeletonHTML;
      if (mobileGrid) mobileGrid.innerHTML = skeletonHTML;

      // 准备请求参数
      const requestBody = {
        page: page,
        per_page: perPage
      };

      // 添加搜索关键词
      const urlParams = new URLSearchParams(window.location.search);
      const searchQuery = urlParams.get('q');
      if (searchQuery) {
        requestBody.search = searchQuery;
        console.log('添加搜索参数:', searchQuery);
      }

      // 添加 URL 分类参数
      const categoryParam = urlParams.get('category');
      if (categoryParam) {
        requestBody.category = categoryParam;
        console.log('添加分类参数:', categoryParam);
      }

      // 添加筛选条件（筛选条件优先级更高，会覆盖 URL 参数）
      if (filters) {
        if (filters.categories && filters.categories.length > 0) {
          requestBody.category = filters.categories.join(',');
          console.log('覆盖分类参数（来自筛选）:', requestBody.category);
        }
        if (filters.colors && filters.colors.length > 0) {
          requestBody.color = filters.colors.join(',');
        }
        if (filters.materials && filters.materials.length > 0) {
          requestBody.material = filters.materials.join(',');
        }
      }

      console.log('最终请求参数:', requestBody);

      console.log('准备请求API:', requestBody);

      const response = await fetch(`/api/products`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify(requestBody)
      });

      console.log('API响应状态:', response.status, response.statusText);

      if (!response.ok) {
        throw new Error(`API请求失败: ${response.status} ${response.statusText}`);
      }

      const data = await response.json();

      console.log('API返回数据:', data);
      console.log('产品数量:', data.products?.length);
      console.log('第一个产品:', data.products?.[0]);

      // 更新全局变量
      totalProducts = data.total || 0;
      totalPages = data.totalPages || 1;

      console.log('更新后的totalProducts:', totalProducts, 'totalPages:', totalPages);

      // 更新产品数量显示
      const totalProductsSpan = document.getElementById('total-products');
      const productsCountDesktop = document.getElementById('products-count-desktop');
      if (totalProductsSpan) {
        totalProductsSpan.textContent = totalProducts;
      }
      if (productsCountDesktop) {
        productsCountDesktop.textContent = totalProducts;
      }

      // 检查是否有产品
      if (!data.products || data.products.length === 0) {
        console.log('没有找到产品');

        const emptyHTML = `
          <div style="grid-column: 1/-1; text-align: center; padding: 80px 20px; color: #666;">
            <i class="fa-solid fa-box-open" style="font-size: 64px; margin-bottom: 20px; color: #ddd;"></i>
            <p style="font-size: 18px; margin-bottom: 12px; font-weight: 600; color: #333;">No products found</p>
            <p style="font-size: 14px; color: #999; margin-bottom: 20px;">Try adjusting your filters</p>
          </div>
        `;

        if (desktopGrid) desktopGrid.innerHTML = emptyHTML;
        if (mobileGrid) mobileGrid.innerHTML = emptyHTML;

        // 隐藏分页
        const paginationContainers = document.querySelectorAll('.pagination');
        paginationContainers.forEach(container => {
          if (container) container.innerHTML = '';
        });

        // 滚动到顶部
        window.scrollTo({ top: 0, behavior: 'smooth' });

        return;
      }

      // 保存产品数据
      currentProducts = data.products;

      // 更新产品列表
      renderProducts(data.products);

      // 更新当前页（如果是从handlePageClick调用的，这个已经更新过了，但为了兼容其他调用保留）
      currentPage = page;

      // 更新分页按钮（确保状态正确）
      renderPagination();

      console.log('页面加载完成');

    } catch (error) {
      console.error('加载产品失败:', error);
      console.error('错误堆栈:', error.stack);

      // 显示错误信息
      const mobileGrid = document.getElementById('products-grid-mobile');
      const desktopGrid = document.getElementById('products-grid-desktop');

      const errorHTML = `
        <div style="grid-column: 1/-1; text-align: center; padding: 60px 20px; color: #d32f2f;">
          <i class="fa-solid fa-exclamation-circle" style="font-size: 64px; margin-bottom: 20px;"></i>
          <p style="font-size: 18px; margin-bottom: 12px; font-weight: 600;">加载产品失败</p>
          <p style="font-size: 14px; color: #666; margin-bottom: 20px;">${error.message || '未知错误'}</p>
          <button onclick="location.reload()" style="padding: 10px 20px; background: #d32f2f; color: white; border: none; border-radius: 4px; cursor: pointer;">
            重新加载
          </button>
