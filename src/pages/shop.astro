  // 桌面端变体选择器：同步价格、库存及主图切换
  function updateQuickOrderVariationStock() {
    const variationsData = window.currentProductVariationsData;
    if (!variationsData || variationsData.length === 0) return;

    const selectedAttributes = {};
    document.querySelectorAll('.quick-order-options').forEach(optionsGroup => {
      const attrName = optionsGroup.dataset.attribute;
      const selected = optionsGroup.querySelector('.quick-order-option.selected');
      if (attrName && selected) selectedAttributes[attrName] = selected.dataset.value;
    });

    const matchedVariation = variationsData.find(variation => {
      return variation.attributes.every(attr => selectedAttributes[attr.name] === attr.option);
    });

    const stockContainer = document.getElementById('quickOrderStockContainer');
    const priceContainer = document.getElementById('quickOrderPriceContainer');
    const addBtn = document.getElementById('quickOrderAddBtn');
    const mainImg = document.getElementById('quickOrderMainImg');

    if (matchedVariation) {
      const price = parseFloat(matchedVariation.price) || 0;
      const regularPrice = parseFloat(matchedVariation.regular_price) || 0;

      let priceHTML = '';
      if (regularPrice > price) {
        priceHTML = `<div class="quick-order-price"><span class="quick-order-price-current">$${price.toFixed(2)}</span><span class="quick-order-price-regular">$${regularPrice.toFixed(2)}</span></div>`;
      } else {
        priceHTML = `<div class="quick-order-price">$${price.toFixed(2)}</div>`;
      }
      priceContainer.innerHTML = priceHTML;

      // 核心联动：桌面端主图与缩略图切换
      if (matchedVariation.image?.src && mainImg) {
        mainImg.src = matchedVariation.image.src;
        // 查找缩略图高亮
        document.querySelectorAll('.quick-order-thumb').forEach(thumb => {
          const thumbImg = thumb.querySelector('img');
          if (thumbImg && thumbImg.src.split('?')[0] === matchedVariation.image.src.split('?')[0]) {
            thumb.classList.add('active');
          } else {
            thumb.classList.remove('active');
          }
        });
      }

      const stockStatus = matchedVariation.stock_status;
      const stockQuantity = matchedVariation.stock_quantity;

      if (stockStatus === 'outofstock') {
        stockContainer.innerHTML = '<div class="quick-order-stock out-of-stock"><i class="fa-solid fa-circle-xmark"></i> Out of Stock</div>';
        addBtn.classList.add('disabled');
        addBtn.disabled = true;
        addBtn.innerHTML = '<i class="fa-solid fa-cart-shopping"></i> Out of Stock';
      } else {
        stockContainer.innerHTML = `<div class="quick-order-stock in-stock"><i class="fa-solid fa-circle-check"></i> In Stock ${stockQuantity ? '(' + stockQuantity + ' available)' : ''}</div>`;
        addBtn.classList.remove('disabled');
        addBtn.disabled = false;
        addBtn.innerHTML = '<i class="fa-solid fa-cart-shopping"></i> Add to Cart';
      }
    } else {
      stockContainer.innerHTML = '<div class="quick-order-stock-placeholder">Please select all options</div>';
      addBtn.classList.add('disabled');
      addBtn.disabled = true;
      addBtn.innerHTML = '<i class="fa-solid fa-cart-shopping"></i> Add to Cart';
    }
  }

  window.changeQuickOrderQty = function(change) {
    const input = document.getElementById('quickOrderQty');
    if (!input) return;
    let qty = parseInt(input.value) || 1;
    input.value = Math.max(1, qty + change);
  };

  // =========================================================
  // Quick Order Gift Carousel 驱动与自动播放机制
  // =========================================================
  window.nextQuickGift = function(device) {
    const track = document.getElementById(`${device}QuickGiftTrack`);
    if (!track) return;
    if (device === 'desktop') {
      quickGiftIndexDesktop = (quickGiftIndexDesktop + 1) % QUICK_GIFTS_DATA.length;
      track.style.transform = `translateX(-${quickGiftIndexDesktop * 100}%)`;
    } else {
      quickGiftIndexMobile = (quickGiftIndexMobile + 1) % QUICK_GIFTS_DATA.length;
      track.style.transform = `translateX(-${quickGiftIndexMobile * 100}%)`;
    }
  };

  window.prevQuickGift = function(device) {
    const track = document.getElementById(`${device}QuickGiftTrack`);
    if (!track) return;
    if (device === 'desktop') {
      quickGiftIndexDesktop = (quickGiftIndexDesktop - 1 + QUICK_GIFTS_DATA.length) % QUICK_GIFTS_DATA.length;
      track.style.transform = `translateX(-${quickGiftIndexDesktop * 100}%)`;
    } else {
      quickGiftIndexMobile = (quickGiftIndexMobile - 1 + QUICK_GIFTS_DATA.length) % QUICK_GIFTS_DATA.length;
      track.style.transform = `translateX(-${quickGiftIndexMobile * 100}%)`;
    }
  };

  function startQuickGiftAutoPlay(device) {
    stopQuickGiftAutoPlay(device);
    if (device === 'desktop') {
      quickGiftTimerDesktop = setInterval(() => nextQuickGift('desktop'), 4000);
    } else {
      quickGiftTimerMobile = setInterval(() => nextQuickGift('mobile'), 4000);
    }
  }

  function stopQuickGiftAutoPlay(device) {
    if (!device || device === 'desktop') {
      if (quickGiftTimerDesktop) { clearInterval(quickGiftTimerDesktop); quickGiftTimerDesktop = null; }
    }
    if (!device || device === 'mobile') {
      if (quickGiftTimerMobile) { clearInterval(quickGiftTimerMobile); quickGiftTimerMobile = null; }
    }
  }

  // 直接加购 Gift 产品到购物车
  window.addGiftDirectlyToCart = function(giftId, giftName, giftPrice, giftImage, btnEl) {
    try {
      let cart = [];
      try {
        const cartData = localStorage.getItem('ebbelle_cart');
        if (cartData) cart = JSON.parse(cartData);
      } catch (e) {
        console.error('读取购物车失败:', e);
      }

      const cartItemId = `${giftId}_gift`;
      const existingIndex = cart.findIndex(item => item.cartItemId === cartItemId);

      if (existingIndex > -1) {
        cart[existingIndex].quantity += 1;
      } else {
        cart.push({
          cartItemId: cartItemId,
          id: giftId,
          name: giftName,
          price: parseFloat(giftPrice).toFixed(2),
          quantity: 1,
          image: giftImage,
          selectedVariants: { Gift: 'Complimentary' },
          variationId: null
        });
      }

      localStorage.setItem('ebbelle_cart', JSON.stringify(cart));
      window.dispatchEvent(new CustomEvent('cartUpdated', { detail: { cart } }));

      if (btnEl) {
        const originalText = btnEl.textContent;
        btnEl.textContent = 'ADDED ✓';
        btnEl.style.background = '#16a34a';
        btnEl.style.borderColor = '#16a34a';
        setTimeout(() => {
          btnEl.textContent = originalText;
          btnEl.style.background = '';
          btnEl.style.borderColor = '';
        }, 1200);
      }

      const cartDrawer = document.getElementById('cartDrawer');
      const cartOverlay = document.getElementById('cartOverlay');
      if (cartDrawer && cartOverlay) {
        cartDrawer.classList.add('active');
        cartOverlay.classList.add('active');
        document.body.style.overflow = 'hidden';
      }
    } catch (err) {
      console.error('加购赠品失败:', err);
    }
  };

  // 移动端加购
  window.addMobileQuickOrderToCart = function() {
    try {
      const productData = window.currentProductData || {};
      const variationsData = window.currentProductVariationsData || [];
      const type = window.currentProductType || 'simple';
      const qty = parseInt(document.getElementById('mobileQtyInput')?.value) || 1;

      const selectedAttributes = {};
      document.querySelectorAll('.mobile-attribute-options').forEach(optionsGroup => {
        const attrName = optionsGroup.dataset.attribute;
        const selected = optionsGroup.querySelector('.mobile-attribute-option.selected');
        if (attrName && selected) selectedAttributes[attrName] = selected.dataset.value;
      });

      let cart = [];
      try {
        const cartData = localStorage.getItem('ebbelle_cart');
        if (cartData) cart = JSON.parse(cartData);
      } catch (e) {
        console.error('读取购物车失败:', e);
      }

      let cartItem;
      let cartItemId;

      if (type === 'variable' && variationsData.length > 0) {
        const matchedVariation = variationsData.find(variation => {
          return variation.attributes.every(attr => selectedAttributes[attr.name] === attr.option);
        });

        if (!matchedVariation) {
          alert('Please select all available options');
          return;
        }

        const variantName = matchedVariation.attributes.map(attr => attr.option).join(', ');
        const variationKey = Object.entries(selectedAttributes)
          .sort(([a], [b]) => a.localeCompare(b))
          .map(([k, v]) => `${k}:${String(v).trim().replace(/\s+/g, '_')}`)
          .join('|');
        cartItemId = `${productData.id}_${variationKey}`;

        cartItem = {
          cartItemId: cartItemId,
          id: productData.id,
          name: `${productData.name} - ${variantName}`,
          price: matchedVariation.price,
          quantity: qty,
          image: matchedVariation.image?.src || productData.images?.[0]?.src || '',
          selectedVariants: selectedAttributes,
          variationId: matchedVariation.id
        };
      } else {
        cartItemId = `${productData.id}_simple`;
        cartItem = {
          cartItemId: cartItemId,
          id: productData.id,
          name: productData.name,
          price: productData.price,
          quantity: qty,
          image: productData.images?.[0]?.src || '',
          selectedVariants: {},
          variationId: null
        };
      }

      const existingIndex = cart.findIndex(item => item.cartItemId === cartItemId);
      if (existingIndex > -1) {
        cart[existingIndex].quantity += qty;
      } else {
        cart.push(cartItem);
      }

      localStorage.setItem('ebbelle_cart', JSON.stringify(cart));
      window.dispatchEvent(new CustomEvent('cartUpdated', { detail: { cart } }));

      closeQuickOrder();

      setTimeout(() => {
        const cartDrawer = document.getElementById('cartDrawer');
        const cartOverlay = document.getElementById('cartOverlay');
        if (cartDrawer && cartOverlay) {
          cartDrawer.classList.add('active');
          cartOverlay.classList.add('active');
          document.body.style.overflow = 'hidden';
        }
      }, 300);

    } catch (e) {
      console.error('添加到购物车失败:', e);
    }
  };

  // 桌面端加购
  window.addQuickOrderToCart = async function(productId, productType) {
    const qty = parseInt(document.getElementById('quickOrderQty').value) || 1;

    const selectedVariations = {};
    document.querySelectorAll('.quick-order-section').forEach(section => {
      const title = section.querySelector('.quick-order-section-title')?.textContent;
      const selected = section.querySelector('.quick-order-option.selected');
      if (title && selected && title !== 'Quantity') {
        selectedVariations[title] = selected.textContent;
      }
    });

    try {
      const productData = window.currentProductData || {};
      const variationsData = window.currentProductVariationsData || [];

      let selectedVariation = null;
      let price = productData.price || '0';
      let productName = productData.name || '';
      let productImage = productData.images?.[0]?.src || '';

      if (productType === 'variable' && variationsData.length > 0) {
        selectedVariation = variationsData.find(variation => {
          return variation.attributes.every(attr => selectedVariations[attr.name] === attr.option);
        });

        if (selectedVariation) {
          price = selectedVariation.price;
          if (selectedVariation.image?.src) {
            productImage = selectedVariation.image.src;
          }
        }
      }

      let cart = [];
      try {
        const cartData = localStorage.getItem('ebbelle_cart');
        if (cartData) cart = JSON.parse(cartData);
      } catch (e) {
        console.error('读取购物车失败:', e);
      }

      const variationKey = Object.entries(selectedVariations)
        .sort(([a], [b]) => a.localeCompare(b))
        .map(([k, v]) => `${k}:${v}`)
        .join('|');
      const cartItemId = `${productId}_${variationKey || 'simple'}`;

      const existingIndex = cart.findIndex(item => item.cartItemId === cartItemId);
      if (existingIndex > -1) {
        cart[existingIndex].quantity += qty;
      } else {
        cart.push({
          cartItemId: cartItemId,
          id: productId,
          name: productName,
          price: price,
          quantity: qty,
          image: productImage,
          selectedVariants: selectedVariations,
          variationId: selectedVariation?.id || null
        });
      }

      localStorage.setItem('ebbelle_cart', JSON.stringify(cart));
      window.dispatchEvent(new CustomEvent('cartUpdated', { detail: { cart } }));

      closeQuickOrder();

      setTimeout(() => {
        const cartDrawer = document.getElementById('cartDrawer');
        const cartOverlay = document.getElementById('cartOverlay');
        if (cartDrawer && cartOverlay) {
          cartDrawer.classList.add('active');
          cartOverlay.classList.add('active');
          document.body.style.overflow = 'hidden';
        }
      }, 300);

    } catch (e) {
      console.error('添加到购物车失败:', e);
    }
  };

  if (quickOrderClose) quickOrderClose.addEventListener('click', closeQuickOrder);
  if (quickOrderOverlay) quickOrderOverlay.addEventListener('click', closeQuickOrder);
  if (quickOrderMobileClose) quickOrderMobileClose.addEventListener('click', closeQuickOrder);
  if (quickOrderMobileOverlay) quickOrderMobileOverlay.addEventListener('click', closeQuickOrder);
</script>