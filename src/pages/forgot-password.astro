---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';

const WC_URL = import.meta.env.WC_STORE_URL || import.meta.env.WC_URL;
---

<Layout title="Reset Password - E.B.Belle">
  <Header />

  <div class="reset-container">
    <div class="reset-card">

      <!-- 请求重置面板 -->
      <div id="request-panel" class="reset-panel">
        <div class="reset-icon">
          <i class="fa-solid fa-lock"></i>
        </div>
        <h1 class="reset-title">Forgot Password?</h1>
        <p class="reset-desc">
          No worries! Enter your email address and we'll send you a link to reset your password.
        </p>

        <form id="form-forgot" class="reset-form" onsubmit="handleForgotPassword(event)">
          <div class="form-group">
            <label class="form-label" for="reset-email">Email Address</label>
            <div class="input-wrap">
              <i class="fa-regular fa-envelope input-icon"></i>
              <input
                type="email"
                id="reset-email"
                class="form-input"
                placeholder="name@example.com"
                required
              />
            </div>
          </div>

          <button type="submit" class="btn-primary" id="btn-send">
            <span>SEND RESET LINK</span>
            <i class="fa-solid fa-arrow-right"></i>
          </button>
        </form>

        <div class="reset-footer">
          <a href="/" class="back-link" onclick="event.preventDefault(); window.openAuthModal?.('login')">
            <i class="fa-solid fa-arrow-left"></i>
            <span>Back to Sign In</span>
          </a>
        </div>
      </div>

      <!-- 成功确认面板 -->
      <div id="success-panel" class="reset-panel success-view">
        <div class="success-icon">
          <i class="fa-solid fa-paper-plane"></i>
        </div>
        <h2 class="success-title">Check Your Email</h2>
        <p class="success-desc">
          We've sent a password reset link to<br />
          <strong id="sent-email-txt">your email</strong>
        </p>
        <p class="success-note">
          Please check your inbox and click the link to reset your password. The link will expire in 30 minutes.
        </p>

        <button type="button" class="btn-secondary" onclick="resetFormState()">
          Send Another Link
        </button>

        <div class="reset-footer">
          <a href="/" class="back-link" onclick="event.preventDefault(); window.openAuthModal?.('login')">
            <i class="fa-solid fa-arrow-left"></i>
            <span>Back to Sign In</span>
          </a>
        </div>
      </div>

    </div>
  </div>
</Layout>

<style>
  .reset-container {
    min-height: calc(100vh - 80px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px 20px;
    background: #F7F5F0;
  }

  .reset-card {
    width: 100%;
    max-width: 460px;
    background: #FFFFFF;
    border-radius: 12px;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.08);
    overflow: hidden;
  }

  .reset-panel {
    padding: 48px 40px;
    display: block;
  }

  .success-view {
    display: none;
  }

  .success-view.active {
    display: block;
  }

  .reset-icon {
    width: 64px;
    height: 64px;
    margin: 0 auto 24px;
    background: #FEF3E2;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .reset-icon i {
    font-size: 28px;
    color: #B8860B;
  }

  .reset-title {
    font-size: 26px;
    font-weight: 700;
    text-align: center;
    margin-bottom: 12px;
    color: #1A1917;
  }

  .reset-desc {
    font-size: 14px;
    color: #6B6660;
    text-align: center;
    line-height: 1.6;
    margin-bottom: 32px;
  }

  .reset-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .form-label {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    color: #6B6660;
  }

  .input-wrap {
    position: relative;
  }

  .input-icon {
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    color: #9C958A;
    font-size: 16px;
  }

  .form-input {
    width: 100%;
    height: 48px;
    padding: 0 14px 0 44px;
    border: 1px solid #D9D4CB;
    border-radius: 4px;
    font-size: 14px;
    color: #1A1917;
    transition: border-color 0.2s;
  }

  .form-input:focus {
    outline: none;
    border-color: #1A1917;
  }

  .form-input::placeholder {
    color: #B3ADA3;
  }

  .btn-primary {
    width: 100%;
    height: 48px;
    background: #1A1917;
    color: #FFFFFF;
    border: none;
    border-radius: 4px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    cursor: pointer;
    transition: background 0.2s;
    margin-top: 8px;
  }

  .btn-primary:hover {
    background: #A3824C;
  }

  .btn-primary:disabled {
    opacity: 0.7;
    cursor: not-allowed;
  }

  .reset-footer {
    margin-top: 32px;
    text-align: center;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: #6B6660;
    text-decoration: none;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: #1A1917;
  }

  .success-icon {
    width: 80px;
    height: 80px;
    margin: 0 auto 28px;
    background: linear-gradient(135deg, #B8860B 0%, #D4A843 100%);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    animation: scaleIn 0.5s ease;
  }

  .success-icon i {
    font-size: 36px;
    color: #FFFFFF;
  }

  @keyframes scaleIn {
    from {
      transform: scale(0);
      opacity: 0;
    }
    to {
      transform: scale(1);
      opacity: 1;
    }
  }

  .success-title {
    font-size: 24px;
    font-weight: 700;
    text-align: center;
    margin-bottom: 16px;
    color: #1A1917;
  }

  .success-desc {
    font-size: 14px;
    color: #6B6660;
    text-align: center;
    line-height: 1.6;
    margin-bottom: 16px;
  }

  .success-desc strong {
    color: #1A1917;
    font-weight: 600;
  }

  .success-note {
    font-size: 12px;
    color: #8C867D;
    text-align: center;
    line-height: 1.6;
    margin-bottom: 28px;
    padding: 16px;
    background: #FAF8F5;
    border-radius: 6px;
  }

  .btn-secondary {
    width: 100%;
    height: 48px;
    background: transparent;
    color: #1A1917;
    border: 1px solid #D9D4CB;
    border-radius: 4px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.2s;
  }

  .btn-secondary:hover {
    background: #FAF8F5;
    border-color: #1A1917;
  }

  @media (max-width: 768px) {
    .reset-panel {
      padding: 36px 28px;
    }

    .reset-title {
      font-size: 22px;
    }

    .reset-desc {
      font-size: 13px;
    }
  }
</style>

<script define:vars={{ WC_URL }}>
  async function handleForgotPassword(e) {
    e.preventDefault();
    const email = document.getElementById('reset-email').value;
    const sendBtn = document.getElementById('btn-send');

    sendBtn.innerHTML = `<span>SENDING...</span> <i class="fa-solid fa-spinner fa-spin"></i>`;
    sendBtn.disabled = true;

    try {
      // 使用WordPress原生的lost-password端点
      const formData = new FormData();
      formData.append('user_login', email);

      const response = await fetch(`${WC_URL}/wp-login.php?action=lostpassword`, {
        method: 'POST',
        body: formData,
      });

      // WordPress会返回HTML，我们假设请求成功就显示成功消息
      // 无论用户是否存在，都显示相同消息（安全考虑）
      document.getElementById('sent-email-txt').textContent = email;
      document.getElementById('request-panel').style.display = 'none';
      document.getElementById('success-panel').classList.add('active');

    } catch (error) {
      console.error('Forgot password error:', error);
      // 即使出错也显示成功消息（安全考虑）
      document.getElementById('sent-email-txt').textContent = email;
      document.getElementById('request-panel').style.display = 'none';
      document.getElementById('success-panel').classList.add('active');
    }
  }

  function resetFormState() {
    document.getElementById('success-panel').classList.remove('active');
    document.getElementById('request-panel').style.display = 'block';
    const sendBtn = document.getElementById('btn-send');
    sendBtn.innerHTML = `<span>SEND RESET LINK</span> <i class="fa-solid fa-arrow-right"></i>`;
    sendBtn.disabled = false;
    document.getElementById('reset-email').value = '';
  }

  window.handleForgotPassword = handleForgotPassword;
  window.resetFormState = resetFormState;
</script>
