<script is:inline define:vars={{ productId: product.id, productSlug: product.slug }}>
  window.productId = productId;
  window.productSlug = productSlug;

  let currentSlide = 0;
  let totalSlides = 0;
  let autoPlayTimer = null;
  let isAutoPlaying = true;
  let touchStartX = 0;
  let touchEndX = 0;

  function initSlider() {
    const sliderContainer = document.getElementById('sliderContainer');
    if (!sliderContainer) return;

    const slides = sliderContainer.querySelectorAll('.slider-item');
    totalSlides = slides.length;

    if (totalSlides <= 1) return;

    sliderContainer.addEventListener('touchstart', handleTouchStart, { passive: true });
    sliderContainer.addEventListener('touchend', handleTouchEnd, { passive: true });

    let isDragging = false;
    let startX = 0;

    sliderContainer.addEventListener('mousedown', (e) => {
      isDragging = true;
      startX = e.clientX;
      sliderContainer.style.cursor = 'grabbing';
      pauseAutoPlay();
    });

    document.addEventListener('mousemove', (e) => {
      if (!isDragging) return;
      e.preventDefault();
    });

    document.addEventListener('mouseup', (e) => {
      if (!isDragging) return;
      isDragging = false;
      sliderContainer.style.cursor = 'grab';

      const diffX = e.clientX - startX;
      if (Math.abs(diffX) > 50) {
        if (diffX > 0) {
          prevImage();
        } else {
          nextImage();
        }
      }
    });

    sliderContainer.addEventListener('mouseenter', pauseAutoPlay);
    sliderContainer.addEventListener('mouseleave', resumeAutoPlay);

    startAutoPlay();
  }

  function goToSlide(index) {
    if (index < 0 || index >= totalSlides) return;

    currentSlide = index;
    updateSlider();
    updateThumbnails();
    pauseAutoPlay();

    setTimeout(resumeAutoPlay, 3000);
  }

  function prevImage() {
    currentSlide = (currentSlide - 1 + totalSlides) % totalSlides;
    updateSlider();
    updateThumbnails();
    pauseAutoPlay();
    setTimeout(resumeAutoPlay, 3000);
  }

  function nextImage() {
    currentSlide = (currentSlide + 1) % totalSlides;
    updateSlider();
    updateThumbnails();
    pauseAutoPlay();
    setTimeout(resumeAutoPlay, 3000);
  }

  function updateSlider() {
    const sliderContainer = document.getElementById('sliderContainer');
    if (!sliderContainer) return;

    sliderContainer.style.transform = `translateX(-${currentSlide * 100}%)`;

    const counter = document.getElementById('currentImageIndex');
    if (counter) {
      counter.textContent = currentSlide + 1;
    }
  }

  function updateThumbnails() {
    document.querySelectorAll('.thumbnail').forEach((thumb, index) => {
      if (index === currentSlide) {
        thumb.classList.add('active');
      } else {
        thumb.classList.remove('active');
      }
    });
  }

  function handleTouchStart(e) {
    touchStartX = e.changedTouches[0].screenX;
    pauseAutoPlay();
  }

  function handleTouchEnd(e) {
    touchEndX = e.changedTouches[0].screenX;
    handleSwipe();
  }

  function handleSwipe() {
    const swipeThreshold = 50;
    const diff = touchStartX - touchEndX;

    if (Math.abs(diff) > swipeThreshold) {
      if (diff > 0) {
        nextImage();
      } else {
        prevImage();
      }
    } else {
      setTimeout(resumeAutoPlay, 3000);
    }
  }

  function startAutoPlay() {
    if (totalSlides <= 1) return;

    autoPlayTimer = setInterval(() => {
      if (isAutoPlaying) {
        nextImage();
      }
    }, 4000);
  }

  function pauseAutoPlay() {
    isAutoPlaying = false;
    if (autoPlayTimer) {
      clearInterval(autoPlayTimer);
      autoPlayTimer = null;
    }
  }

  function resumeAutoPlay() {
    if (!isAutoPlaying && totalSlides > 1) {
      isAutoPlaying = true;
      startAutoPlay();
    }
  }

  function changeQty(delta) {
    const input = document.getElementById('qtyInput');
    if (input) {
      const currentValue = parseInt(input.value, 10) || 1;
      const newValue = Math.max(1, currentValue + delta);
      input.value = newValue;
    }
  }

  // =========================================================
  // 移动端专属 Lightbox 弹窗交互
  // =========================================================
  function openMobileLightbox() {
    if (window.innerWidth > 768) return;
    const modal = document.getElementById('mobileLightboxModal');
    const stickyImg = document.getElementById('stickyThumbImg');
    const lightboxImg = document.getElementById('lightboxImg');

    if (modal && stickyImg && lightboxImg) {
      lightboxImg.src = stickyImg.src;
      modal.classList.add('active');
      document.body.style.overflow = 'hidden';
    }
  }

  function closeMobileLightbox(e) {
    const modal = document.getElementById('mobileLightboxModal');
    if (e && e.target && e.target.id === 'lightboxImg') return;

    if (modal) {
      modal.classList.remove('active');
      document.body.style.overflow = '';
    }
  }

  window.openMobileLightbox = openMobileLightbox;
  window.closeMobileLightbox = closeMobileLightbox;

  // ========== 购物车功能 ==========

  function getCurrentProductData() {
    const quantity = parseInt(document.getElementById('qtyInput')?.value || 1);
    const selectedAttrs = getSelectedAttributes();
    const matchingVariation = findMatchingVariation(selectedAttrs);

    const productName = document.querySelector('.product-title')?.textContent || '';
    const productImage = document.querySelector('.slider-item img')?.src || '';

    let price = document.querySelector('.current-price')?.textContent.replace(/[^0-9.]/g, '') || '0';
    let variationId = null;
    let stockStatus = 'instock';

    if (matchingVariation) {
      price = matchingVariation.price;
      variationId = matchingVariation.id;
      stockStatus = matchingVariation.stock_status;
    }

    return {
      id: variationId || window.productId,
      productId: window.productId,
      variationId: variationId,
      name: productName,
      price: price,
      quantity: quantity,
      image: productImage,
      selectedVariants: selectedAttrs,
      stockStatus: stockStatus,
      slug: window.productSlug
    };
  }

  function addToCartHandler() {
    const productData = getCurrentProductData();

    if (productData.stockStatus !== 'instock') {
      alert('Sorry, this product is out of stock.');
      return;
    }

    let cart = [];
    try {
      const cartData = localStorage.getItem('ebbelle_cart');
      cart = cartData ? JSON.parse(cartData) : [];
    } catch (e) {
      console.error('Failed to get cart:', e);
    }

    const existingIndex = cart.findIndex(item =>
      item.productId === productData.productId &&
      item.variationId === productData.variationId &&
      JSON.stringify(item.selectedVariants) === JSON.stringify(productData.selectedVariants)
    );

    if (existingIndex > -1) {
      cart[existingIndex].quantity += productData.quantity;
    } else {
      cart.push({
        ...productData,
        cartItemId: Date.now() + Math.random()
      });
    }

    try {
      localStorage.setItem('ebbelle_cart', JSON.stringify(cart));
      window.dispatchEvent(new CustomEvent('cartUpdated', { detail: { cart } }));

      if (typeof window.toggleCart === 'function') {
        window.toggleCart(true);
      }

      console.log('Added to cart:', productData);
    } catch (e) {
      console.error('Failed to save cart:', e);
      alert('Failed to add to cart. Please try again.');
    }
  }

  function buyNowHandler() {
    const productData = getCurrentProductData();

    if (productData.stockStatus !== 'instock') {
      alert('Sorry, this product is out of stock.');
      return;
    }

    addToCartHandler();

    setTimeout(() => {
      window.location.href = '/checkout';
    }, 300);
  }

  function bindCartButtons() {
    document.querySelectorAll('.btn-add-cart, .sticky-btn-cart').forEach(btn => {
      btn.addEventListener('click', addToCartHandler);
    });

    document.querySelectorAll('.btn-buy-now, .sticky-btn-buy').forEach(btn => {
      btn.addEventListener('click', buyNowHandler);
    });
  }

  function toggleAccordion(id) {
    const content = document.getElementById(`content-${id}`);
    const icon = document.getElementById(`icon-${id}`);

    if (content) {
      const isActive = content.classList.contains('active');

      document.querySelectorAll('.accordion-content').forEach(acc => {
        acc.classList.remove('active');
      });
      document.querySelectorAll('.accordion-header i').forEach(ic => {
        ic.classList.remove('fa-chevron-up');
        ic.classList.add('fa-chevron-down');
      });

      if (!isActive) {
        content.classList.add('active');
        if (icon) {
          icon.classList.remove('fa-chevron-down');
          icon.classList.add('fa-chevron-up');
        }
      }
    }
  }

  let variationsData = [];
  try {
    const dataElement = document.getElementById('variationsData');
    if (dataElement) {
      variationsData = JSON.parse(dataElement.textContent);
    }
  } catch (e) {
    console.error('Failed to parse variations data:', e);
  }

  function getSelectedAttributes() {
    const selected = {};
    document.querySelectorAll('.variant-option.active').forEach(btn => {
      const attribute = btn.getAttribute('data-attribute');
      const value = btn.getAttribute('data-value');
      if (attribute && value) {
        selected[attribute] = value;
      }
    });
    return selected;
  }

  function findMatchingVariation(selectedAttrs) {
    if (!variationsData || variationsData.length === 0) return null;

    return variationsData.find(variation => {
      if (!variation.attributes || variation.attributes.length === 0) return false;

      return variation.attributes.every(attr => {
        const attrSlug = attr.name.toLowerCase().replace(/\s+/g, '-');
        return selectedAttrs[attrSlug] &&
               selectedAttrs[attrSlug].toLowerCase() === attr.option.toLowerCase();
      });
    });
  }

  function updateAvailableOptions() {
    if (!variationsData || variationsData.length === 0) return;

    const selectedAttrs = getSelectedAttributes();

    document.querySelectorAll('.variant-group').forEach(group => {
      const buttons = group.querySelectorAll('.variant-option');

      buttons.forEach(btn => {
        const attribute = btn.getAttribute('data-attribute');
        const value = btn.getAttribute('data-value');

        const testAttrs = { ...selectedAttrs, [attribute]: value };

        const hasStockVariation = variationsData.some(variation => {
          if (!variation.attributes || variation.attributes.length === 0) return false;

          const matches = variation.attributes.every(attr => {
            const attrSlug = attr.name.toLowerCase().replace(/\s+/g, '-');
            return testAttrs[attrSlug] &&
                   testAttrs[attrSlug].toLowerCase() === attr.option.toLowerCase();
          });

          return matches && variation.stock_status === 'instock';
        });

        if (!hasStockVariation) {
          btn.disabled = true;
          btn.classList.add('out-of-stock');
        } else {
          btn.disabled = false;
          btn.classList.remove('out-of-stock');
        }
      });
    });
  }

  function updatePriceAndStock(variation) {
    if (!variation) return;

    // 1. 同步价格更新 (桌面端与移动端悬浮底栏)
    const currentPrice = document.querySelector('.current-price');
    const originalPrice = document.querySelector('.original-price');
    const stickyPriceVal = document.getElementById('stickyPriceVal');

    if (variation.price && currentPrice) {
      const priceText = currentPrice.querySelector('.dollar') ?
        `<span class="dollar">$</span>${variation.price}` :
        `$${variation.price}`;
      currentPrice.innerHTML = priceText;
    }

    if (stickyPriceVal && variation.price) {
      stickyPriceVal.textContent = `$${variation.price}`;
    }

    // 2. 同步图片：主图悄悄同步切过去，同时给底部 48px 大缩略图换图（绝不乱滚页面）
    const variationImgSrc = variation.image && variation.image.src ? variation.image.src : null;
    if (variationImgSrc) {
      const stickyThumbImg = document.getElementById('stickyThumbImg');
      if (stickyThumbImg) {
        stickyThumbImg.src = variationImgSrc;
      }

      const sliderContainer = document.getElementById('sliderContainer');
      const allSlideImgs = sliderContainer ? sliderContainer.querySelectorAll('.slider-item img') : [];
      
      let matchedIndex = -1;
      allSlideImgs.forEach((img, idx) => {
        const cleanSlideSrc = img.src.split('?')[0];
        const cleanVarSrc = variationImgSrc.split('?')[0];
        if (img.src === variationImgSrc || cleanSlideSrc === cleanVarSrc) {
          matchedIndex = idx;
        }
      });

      if (matchedIndex !== -1) {
        if (typeof window.goToSlide === 'function') {
          window.goToSlide(matchedIndex);
        }
      } else if (allSlideImgs.length > 0) {
        allSlideImgs[0].src = variationImgSrc;
        const firstThumbnailImg = document.querySelector('.thumbnail img');
        if (firstThumbnailImg) {
          firstThumbnailImg.src = variationImgSrc;
        }
        if (typeof window.goToSlide === 'function') {
          window.goToSlide(0);
        }
      }
    }

    // 3. 库存状态文字更新
    const stockStatus = document.querySelector('.info-item:has(.fa-circle-check) span');
    if (stockStatus) {
      stockStatus.textContent = variation.stock_status === 'instock' ? 'In Stock' : 'Out of Stock';
    }

    // 4. 加购与立即购买按钮状态切换
    const addToCartBtns = document.querySelectorAll('.btn-add-cart, .sticky-btn-cart');
    const buyNowBtns = document.querySelectorAll('.btn-buy-now, .sticky-btn-buy');

    if (variation.stock_status !== 'instock') {
      addToCartBtns.forEach(btn => {
        btn.disabled = true;
        btn.style.opacity = '0.5';
        btn.style.cursor = 'not-allowed';
      });
      buyNowBtns.forEach(btn => {
        btn.disabled = true;
        btn.style.opacity = '0.5';
        btn.style.cursor = 'not-allowed';
      });
    } else {
      addToCartBtns.forEach(btn => {
        btn.disabled = false;
        btn.style.opacity = '1';
        btn.style.cursor = 'pointer';
      });
      buyNowBtns.forEach(btn => {
        btn.disabled = false;
        btn.style.opacity = '1';
        btn.style.cursor = 'pointer';
      });
    }
  }

  function selectVariant(attribute, value, element) {
    const buttons = element.parentElement.querySelectorAll('.variant-option');
    buttons.forEach(btn => btn.classList.remove('active'));
    element.classList.add('active');

    const selectedValueSpan = document.getElementById(`selected-${attribute}`);
    if (selectedValueSpan) {
      selectedValueSpan.textContent = value;
    }

    // 实时读取当前全部选中的属性值，拼成 "Gold / Set A" 的直观规格，绝不卡在 Default
    const selectedAttrs = getSelectedAttributes();
    const valuesList = Object.values(selectedAttrs);
    const stickyLabel = document.getElementById('stickyVariantLabel');
    if (stickyLabel && valuesList.length > 0) {
      stickyLabel.textContent = valuesList.join(' / ');
    }

    const matchingVariation = findMatchingVariation(selectedAttrs);

    if (matchingVariation) {
      updatePriceAndStock(matchingVariation);
    }

    updateAvailableOptions();
  }

  window.goToSlide = goToSlide;
  window.prevImage = prevImage;
  window.nextImage = nextImage;
  window.changeQty = changeQty;
  window.selectVariant = selectVariant;
  window.toggleAccordion = toggleAccordion;

  function initVariants() {
    if (variationsData && variationsData.length > 0) {
      updateAvailableOptions();

      const selectedAttrs = getSelectedAttributes();
      const matchingVariation = findMatchingVariation(selectedAttrs);
      if (matchingVariation) {
        updatePriceAndStock(matchingVariation);
      }
    }
  }

  // =========================================================
  // Related Products Slider (桌面 5 个 / 移动端 1 个 / 每次滑动 1 个)
  // =========================================================
  function initRelatedSlider() {
    const sliderContainer = document.querySelector('.related-slider-container');
    const slider = document.getElementById('relatedSlider');
    const prevBtn = document.getElementById('relatedPrevBtn');
    const nextBtn = document.getElementById('relatedNextBtn');

    if (!slider || !prevBtn || !nextBtn || !sliderContainer) return;

    const allProducts = Array.from(slider.children);
    const totalProducts = allProducts.length;
    if (totalProducts === 0) return;

    let currentIndex = 0;
    let autoPlayInterval = null;
    let isAutoPlaying = true;

    function getVisibleCount() {
      const width = window.innerWidth;
      if (width <= 768) {
        return 1;
      }
      if (width <= 1024) {
        return 3;
      }
      return 5;
    }

    function updateSliderPosition() {
      const firstCard = allProducts[0];
      if (!firstCard) return;

      const stepWidth = firstCard.offsetWidth + 16;
      const offset = -currentIndex * stepWidth;

      slider.style.transform = `translateX(${offset}px)`;
    }

    function nextSlide() {
      const visibleCount = getVisibleCount();
      const maxIndex = Math.max(0, totalProducts - visibleCount);

      if (currentIndex < maxIndex) {
        currentIndex += 1;
      } else {
        currentIndex = 0;
      }
      updateSliderPosition();
    }

    function prevSlide() {
      const visibleCount = getVisibleCount();
      const maxIndex = Math.max(0, totalProducts - visibleCount);

      if (currentIndex > 0) {
        currentIndex -= 1;
      } else {
        currentIndex = maxIndex;
      }
      updateSliderPosition();
    }

    function startAutoPlay() {
      stopAutoPlay();
      autoPlayInterval = setInterval(() => {
        if (isAutoPlaying) {
          nextSlide();
        }
      }, 3500);
    }

    function stopAutoPlay() {
      if (autoPlayInterval) {
        clearInterval(autoPlayInterval);
        autoPlayInterval = null;
      }
    }

    function pauseAndResume() {
      isAutoPlaying = false;
      stopAutoPlay();
      setTimeout(() => {
        isAutoPlaying = true;
        startAutoPlay();
      }, 4000);
    }

    prevBtn.addEventListener('click', () => {
      prevSlide();
      pauseAndResume();
    });

    nextBtn.addEventListener('click', () => {
      nextSlide();
      pauseAndResume();
    });

    sliderContainer.addEventListener('mouseenter', stopAutoPlay);
    sliderContainer.addEventListener('mouseleave', startAutoPlay);

    let touchStartX = 0;
    sliderContainer.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].screenX;
      stopAutoPlay();
    }, { passive: true });

    sliderContainer.addEventListener('touchend', (e) => {
      const diffX = touchStartX - e.changedTouches[0].screenX;
      if (Math.abs(diffX) > 40) {
        if (diffX > 0) {
          nextSlide();
        } else {
          prevSlide();
        }
      }
      pauseAndResume();
    }, { passive: true });

    window.addEventListener('resize', () => {
      const visibleCount = getVisibleCount();
      const maxIndex = Math.max(0, totalProducts - visibleCount);
      if (currentIndex > maxIndex) {
        currentIndex = maxIndex;
      }
      updateSliderPosition();
    });

    updateSliderPosition();
    startAutoPlay();
  }

  // =========================================================
  // Product Carousel (Gift) 驱动 + 客户端兜底与加购
  // =========================================================
  async function initGiftCarousel() {
    const carousel = document.getElementById('giftCarousel');
    const track = document.getElementById('giftTrack');
    const slides = carousel ? carousel.querySelectorAll('.gift-slide') : [];
    const prevBtn = document.getElementById('giftPrevBtn');
    const nextBtn = document.getElementById('giftNextBtn');
    const addGiftBtn = document.getElementById('addGiftBtn');

    if (!carousel || !track || slides.length === 0) return;

    slides.forEach(async (slide) => {
      const isLoaded = slide.getAttribute('data-loaded') === 'true';
      const giftId = slide.getAttribute('data-id');

      if (!isLoaded && giftId) {
        try {
          const res = await fetch('/api/products/' + giftId);
          if (res.ok) {
            const data = await res.json();
            if (data && data.name) {
              slide.setAttribute('data-name', data.name);
              const titleEl = slide.querySelector('.gift-title-el');
              if (titleEl) {
                titleEl.textContent = data.name;
                titleEl.title = data.name;
              }
              const regPrice = (data.regular_price !== undefined && data.regular_price !== null && data.regular_price !== '')
                ? data.regular_price
                : (data.price || '0.00');
              const finalPrice = parseFloat(regPrice).toFixed(2);
              
              slide.setAttribute('data-price', finalPrice);
              const priceEl = slide.querySelector('.gift-price-el');
              if (priceEl) {
                priceEl.textContent = '$' + finalPrice;
              }
              const imgSrc = (data.images && data.images[0]) ? data.images[0].src : '';
              if (imgSrc) {
                slide.setAttribute('data-image', imgSrc);
                const imgEl = slide.querySelector('.gift-img-el');
                if (imgEl) imgEl.src = imgSrc;
              }
            }
          }
        } catch (err) {
          console.warn('[Client Product Fetch Error] for ' + giftId + ':', err);
        }
      }
    });

    let currentIndex = 0;
    const totalSlides = slides.length;
    let autoPlayTimer = null;
    const AUTO_DELAY = 4000;

    function updateSlide(index) {
      currentIndex = (index + totalSlides) % totalSlides;
      track.style.transform = 'translateX(-' + (currentIndex * 100) + '%)';
      slides.forEach((slide, i) => {
        slide.classList.toggle('active', i === currentIndex);
      });
    }

    function nextSlide() {
      updateSlide(currentIndex + 1);
    }

    function prevSlide() {
      updateSlide(currentIndex - 1);
    }

    function startAutoPlay() {
      stopAutoPlay();
      autoPlayTimer = setInterval(nextSlide, AUTO_DELAY);
    }

    function stopAutoPlay() {
      if (autoPlayTimer) {
        clearInterval(autoPlayTimer);
        autoPlayTimer = null;
      }
    }

    function pauseAndRestart() {
      stopAutoPlay();
      setTimeout(startAutoPlay, 3500);
    }

    nextBtn?.addEventListener('click', () => {
      pauseAndRestart();
      nextSlide();
    });

    prevBtn?.addEventListener('click', () => {
      pauseAndRestart();
      prevSlide();
    });

    carousel.addEventListener('mouseenter', stopAutoPlay);
    carousel.addEventListener('mouseleave', startAutoPlay);

    let touchStartX = 0;
    carousel.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].screenX;
      stopAutoPlay();
    }, { passive: true });

    carousel.addEventListener('touchend', (e) => {
      const diffX = touchStartX - e.changedTouches[0].screenX;
      if (Math.abs(diffX) > 40) {
        if (diffX > 0) nextSlide();
        else prevSlide();
      }
      pauseAndRestart();
    }, { passive: true });

    addGiftBtn?.addEventListener('click', () => {
      const currentSlide = slides[currentIndex];
      const giftId = parseInt(currentSlide.getAttribute('data-id'), 10);
      const giftName = currentSlide.getAttribute('data-name');
      const giftPrice = currentSlide.getAttribute('data-price') || '0.00';
      const giftImage = currentSlide.getAttribute('data-image') || '';

      const giftItemData = {
        id: giftId,
        productId: giftId,
        variationId: null,
        name: giftName,
        price: giftPrice,
        quantity: 1,
        image: giftImage,
        selectedVariants: {},
        stockStatus: 'instock',
        slug: ''
      };

      let cart = [];
      try {
        const cartData = localStorage.getItem('ebbelle_cart');
        cart = cartData ? JSON.parse(cartData) : [];
      } catch (e) {
        console.error('Failed to get cart:', e);
      }

      const existingIndex = cart.findIndex((item) =>
        item.productId === giftItemData.productId &&
        item.variationId === giftItemData.variationId
      );

      if (existingIndex > -1) {
        cart[existingIndex].quantity += 1;
      } else {
        cart.push({
          ...giftItemData,
          cartItemId: Date.now() + Math.random()
        });
      }

      try {
        localStorage.setItem('ebbelle_cart', JSON.stringify(cart));
        window.dispatchEvent(new CustomEvent('cartUpdated', { detail: { cart } }));

        if (typeof window.toggleCart === 'function') {
          window.toggleCart(true);
        }

        const originalText = addGiftBtn.textContent;
        addGiftBtn.textContent = 'ADDED ✓';
        addGiftBtn.style.background = '#16a34a';
        addGiftBtn.style.borderColor = '#16a34a';
        setTimeout(() => {
          addGiftBtn.textContent = originalText;
          addGiftBtn.style.background = '';
          addGiftBtn.style.borderColor = '';
        }, 1200);
      } catch (e) {
        console.error('Failed to save cart:', e);
        alert('Failed to add item to cart. Please try again.');
      }
    });

    startAutoPlay();
  }

  // 文字展开与折叠切换逻辑
  function initDescToggle() {
    const wrapper = document.getElementById('descWrapper');
    const content = document.getElementById('descContent');
    const btn = document.getElementById('btnToggleDesc');

    if (!wrapper || !content || !btn) return;

    if (content.scrollHeight <= content.clientHeight + 10) {
      content.style.webkitMaskImage = 'none';
      content.style.maskImage = 'none';
      btn.style.display = 'none';
      return;
    }

    btn.addEventListener('click', () => {
      const isExpanded = content.classList.contains('expanded');
      if (isExpanded) {
        content.classList.remove('expanded');
        btn.textContent = 'Show more';
      } else {
        content.classList.add('expanded');
        btn.textContent = 'Show less';
      }
    });
  }

  function initAll() {
    initSlider();
    initVariants();
    bindCartButtons();
    initRelatedSlider();
    initGiftCarousel();
    initDescToggle();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAll);
  } else {
    initAll();
  }
</script>