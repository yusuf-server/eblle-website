---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CartDrawer from '../../components/CartDrawer.astro';
import { getProductBySlug, getProductVariations, getRelatedProducts } from '../../lib/woocommerce';

export const prerender = false;

const { slug } = Astro.params;

// 获取产品数据
const product = await getProductBySlug(slug);

if (!product) {
  return Astro.redirect('/404');
}

// 计算折扣百分比
const hasDiscount = product.regular_price && product.price && parseFloat(product.regular_price) > parseFloat(product.price);
const discountPercent = hasDiscount
  ? Math.round(((parseFloat(product.regular_price) - parseFloat(product.price)) / parseFloat(product.regular_price)) * 100)
  : 0;

// 获取主图和缩略图
const images = product.images && product.images.length > 0
  ? product.images
  : [{ src: 'https://images.unsplash.com/photo-1515562141207-7a88fb7ce338?w=800&q=80', alt: product.name }];

const mainImage = images[0];
const thumbnails = images.slice(0, 5); // 最多5张缩略图

// 获取产品分类（用于面包屑）
// 优先显示主分类，如果没有则取第一个分类
const getPrimaryCategory = () => {
  if (!product.categories || product.categories.length === 0) {
    return { name: 'All Jewelry', slug: '' };
  }

  // 如果只有一个分类，直接返回
  if (product.categories.length === 1) {
    return product.categories[0];
  }

  // 多分类情况：优先取第一个（通常是主分类）
  // WooCommerce 默认会把主分类放在第一位
  return product.categories[0];
};

const primaryCategory = getPrimaryCategory();
const category = primaryCategory.name;
const categorySlug = primaryCategory.slug;

// 清理HTML标签
const stripHtml = (html: string) => html?.replace(/<[^>]*>/g, '') || '';
const shortDesc = stripHtml(product.short_description || product.description || '').substring(0, 200);

// 获取变体数据（如果是变体产品）
let variations = [];
let attributes = [];
if (product.type === 'variable' && product.variations && product.variations.length > 0) {
  variations = await getProductVariations(product.id);
  attributes = product.attributes || [];
}

// 获取相关产品（基于分类和标签）
const categoryIds = product.categories?.map(cat => cat.id) || [];
const tagIds = product.tags?.map(tag => tag.id) || [];
const relatedProducts = await getRelatedProducts(product.id, categoryIds, tagIds, 6);
---

<Layout title={`${product.name} - E.B.Belle`}>
  <Header />

  <main class="product-detail-page">
    <div class="product-container">
      <!-- Breadcrumb -->
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <i class="fa-solid fa-chevron-right"></i>
        <a href="/shop">Shop</a>
        <i class="fa-solid fa-chevron-right"></i>
        {categorySlug ? (
          <a href={`/shop?category=${categorySlug}`}>{category}</a>
        ) : (
          <span>{category}</span>
        )}
        <i class="fa-solid fa-chevron-right"></i>
        <span class="breadcrumb-current">{product.name}</span>
      </nav>

      <!-- Product Hero Section -->
      <div class="product-hero">
        <!-- Left: Product Image Gallery -->
        <div class="product-gallery">
          <!-- Main Image Slider -->
          <div class="main-image-slider">
            <div class="slider-container" id="sliderContainer">
              {images.map((img, index) => (
                <div class="slider-item" data-index={index}>
                  <img src={img.src} alt={`${product.name} - View ${index + 1}`}>
                </div>
              ))}
            </div>

            <!-- Image Counter -->
            <div class="image-counter">
              <span id="currentImageIndex">1</span>/{images.length}
            </div>

            <!-- Navigation Arrows -->
            {images.length > 1 && (
              <>
                <button type="button" class="slider-arrow prev" onclick="prevImage()" aria-label="Previous image">
                  <i class="fa-solid fa-chevron-left"></i>
                </button>
                <button type="button" class="slider-arrow next" onclick="nextImage()" aria-label="Next image">
                  <i class="fa-solid fa-chevron-right"></i>
                </button>
              </>
            )}
          </div>

          <!-- Thumbnails -->
          <div class="thumbnails">
            {thumbnails.map((img, index) => (
              <div
                class={`thumbnail ${index === 0 ? 'active' : ''}`}
                onclick={`goToSlide(${index})`}
                data-index={index}
              >
                <img src={img.src} alt={`View ${index + 1}`}>
              </div>
            ))}
          </div>
        </div>

        <!-- Right: Product Info -->
        <div class="product-info">
          <!-- Title & Price Header -->
          <div class="product-header">
            <h1 class="product-title">{product.name}</h1>
            <div class="price-row">
              <span class="current-price"><span class="dollar">$</span>{product.price}</span>
              {hasDiscount && (
                <>
                  <span class="original-price">${product.regular_price}</span>
                  <span class="sale-badge">Sale · Save {discountPercent}%</span>
                </>
              )}
            </div>
            <div class="rating-row">
              <i class="fa-solid fa-star star-icon"></i>
              <span class="rating-score">{product.average_rating || '0.0'}</span>
              <span class="rating-count">({product.rating_count || 0} reviews)</span>
            </div>
          </div>

          <!-- Wholesale Pricing Table -->
          <div class="wholesale-table">
            <div class="table-header">
              <div class="header-left">
                <i class="fa-solid fa-tag"></i>
                <span>Wholesale & Volume Pricing</span>
              </div>
              <span class="header-badge">Tiered Discounts</span>
            </div>
            <div class="pricing-grid">
              <div class="price-tier">
                <span class="tier-qty">1 – 9 pcs</span>
                <span class="tier-price">${product.price}</span>
                <span class="tier-label">Retail</span>
              </div>
              <div class="price-tier">
                <span class="tier-qty">10 – 49 pcs</span>
                <span class="tier-price">${(parseFloat(product.price) * 0.79).toFixed(2)}</span>
                <span class="tier-save">Save 21%</span>
              </div>
              <div class="price-tier">
                <span class="tier-qty">50 – 99 pcs</span>
                <span class="tier-price">${(parseFloat(product.price) * 0.62).toFixed(2)}</span>
                <span class="tier-save">Save 38%</span>
              </div>
              <div class="price-tier best">
                <span class="tier-qty">100+ pcs</span>
                <span class="tier-price">${(parseFloat(product.price) * 0.45).toFixed(2)}</span>
                <span class="tier-badge">Best Value</span>
              </div>
            </div>
            <div class="auto-apply">
              <i class="fa-solid fa-circle-check"></i>
              <span>Applied automatically in cart based on order quantity</span>
            </div>
          </div>

          <!-- Description & Badges -->
          <p class="product-description">
            {shortDesc}
          </p>
          <div class="feature-badges">
            <span class="badge">316L STAINLESS STEEL</span>
            <span class="badge">PVD GOLD PLATING</span>
            <span class="badge">WATERPROOF</span>
            <span class="badge">HYPOALLERGENIC</span>
          </div>

          <!-- Product Variants Selection -->
          {attributes.length > 0 && (
            <div class="variants-section">
              {attributes.map((attr) => {
                const options = attr.options || [];
                const attrName = attr.name || '';
                const attrSlug = attrName.toLowerCase().replace(/\s+/g, '-');

                // 默认隐藏的属性
                const hiddenAttributes = ['material', 'weight'];
                if (hiddenAttributes.includes(attrSlug)) {
                  return null;
                }

                // 必须显示的属性（即使只有1个选项）
                const alwaysShowAttributes = ['set', 'style'];
                const mustShow = alwaysShowAttributes.includes(attrSlug);

                // 其他属性（包括color和size）：只有选项数>1时才显示（除非是必须显示的）
                if (!mustShow && options.length <= 1) {
                  return null;
                }

                return (
                  <div class="variant-group">
                    <div class="variant-label">
                      <span class="label-text">{attrName}:</span>
                      <span class="selected-value" id={`selected-${attrSlug}`}>
                        {options.length > 0 ? options[0] : 'Select'}
                      </span>
                    </div>
                    <div class="variant-options">
                      {options.map((option, index) => (
                        <button
                          type="button"
                          class={`variant-option ${index === 0 ? 'active' : ''}`}
                          data-attribute={attrSlug}
                          data-value={option}
                          onclick={`selectVariant('${attrSlug}', '${option}', this)`}
                        >
                          {option}
                        </button>
                      ))}
                    </div>
                  </div>
                );
              })}
            </div>
          )}

          <!-- Hidden data container for variations -->
          {variations.length > 0 && (
            <script is:inline id="variationsData" type="application/json" set:html={JSON.stringify(variations)} />
          )}

          <!-- Quantity & Actions -->
          <div class="actions-section" id="actionsSection">
            <div class="quantity-row">
              <span class="qty-label">Quantity</span>
              <div class="quantity-selector">
                <button type="button" onclick="changeQty(-1)"><i class="fa-solid fa-minus"></i></button>
                <input type="number" id="qtyInput" value="1" min="1" readonly>
                <button type="button" onclick="changeQty(1)"><i class="fa-solid fa-plus"></i></button>
              </div>
            </div>
            <div class="button-group">
              <button type="button" class="btn-add-cart">Add to Cart</button>
              <button type="button" class="btn-buy-now">Buy Now</button>
            </div>
            <button type="button" class="btn-wholesale">Inquire for Wholesale / Customization</button>
          </div>

          <!-- Member Offers -->
          <div class="offers-card">
            <div class="offers-header">
              <div class="header-left">
                <i class="fa-solid fa-ticket"></i>
                <span>Exclusive Member Offers</span>
              </div>
              <span class="header-badge">Limited Time</span>
            </div>
            <div class="offers-grid">
              <div class="offer-item">
                <div class="offer-amount">US$ 130</div>
                <button type="button" class="offer-btn">Claim <i class="fa-solid fa-arrow-right"></i></button>
                <p class="offer-desc">Sign up for membership to claim US$ 130 coupon package</p>
              </div>
              <div class="offer-item">
                <div class="offer-amount">15% OFF</div>
                <button type="button" class="offer-btn">Get Code <i class="fa-solid fa-arrow-right"></i></button>
                <p class="offer-desc">Enjoy introductory discount up to 15% on your order</p>
              </div>
            </div>
          </div>

          <!-- Free Gift Carousel -->
          <div class="gift-carousel">
            <button type="button" class="carousel-btn prev" aria-label="Previous gift"><i class="fa-solid fa-chevron-left"></i></button>
            <div class="gift-content">
              <div class="gift-image">
                <div class="gift-placeholder">E.B.B</div>
              </div>
              <div class="gift-info">
                <h4>E.B.belle PVC Zipper Jewelry Packaging Bag Pouch (Custom Logo Accepted)</h4>
                <div class="gift-price-row">
                  <span class="gift-price">$0.00</span>
                  <span class="gift-tag">Complimentary Gift</span>
                </div>
              </div>
            </div>
            <div class="gift-actions">
              <button type="button" class="btn-add-gift">ADD FREE GIFT</button>
              <button type="button" class="carousel-btn next" aria-label="Next gift"><i class="fa-solid fa-chevron-right"></i></button>
            </div>
          </div>

          <!-- Safe Checkout -->
          <div class="checkout-badges">
            <div class="section-divider">
              <span>Guaranteed Safe Checkout</span>
            </div>
            <div class="payment-methods">
              <div class="payment-badge visa">VISA</div>
              <div class="payment-badge mc">MC</div>
              <div class="payment-badge amex">AMEX</div>
              <div class="payment-badge discover">DISCOVER</div>
              <div class="payment-badge paypal">PayPal</div>
              <div class="payment-badge apple">Apple Pay</div>
            </div>
          </div>

          <!-- Accordions -->
          <div class="accordions">
            <div class="accordion-item">
              <button type="button" class="accordion-header" onclick="toggleAccordion('desc')">
                <span>Description</span>
                <i class="fa-solid fa-chevron-down" id="icon-desc"></i>
              </button>
              <div class="accordion-content active" id="content-desc">
                <div class="accordion-body" set:html={product.description || product.short_description || '<p>No description available.</p>'}>
                </div>
              </div>
            </div>

            <div class="accordion-item">
              <button type="button" class="accordion-header" onclick="toggleAccordion('care')">
                <span>Material & Care</span>
                <i class="fa-solid fa-chevron-down" id="icon-care"></i>
              </button>
              <div class="accordion-content" id="content-care">
                <div class="accordion-body">
                  <p>Crafted with 316L Stainless Steel and plated with 14K Gold using PVD technology. This piece is tarnish-resistant, waterproof, and hypoallergenic.</p>
                  <p>To maintain its shine, gently wipe with a soft cloth after use. While waterproof, we recommend removing before swimming in chlorinated pools or oceans to extend its lifespan.</p>
                </div>
              </div>
            </div>

            <div class="accordion-item">
              <button type="button" class="accordion-header" onclick="toggleAccordion('shipping')">
                <span>Shipping & Returns</span>
                <i class="fa-solid fa-chevron-down" id="icon-shipping"></i>
              </button>
              <div class="accordion-content" id="content-shipping">
                <div class="accordion-body">
                  <p>Enjoy free standard shipping on all orders over $50. Orders are typically processed within 1-2 business days.</p>
                  <p>We accept returns within 30 days of delivery. Items must be in original condition with tags attached. See our full return policy for details.</p>
                </div>
              </div>
            </div>

            <div class="accordion-item">
              <button type="button" class="accordion-header" onclick="toggleAccordion('wholesale')">
                <span>Wholesale & Customization</span>
                <i class="fa-solid fa-chevron-down" id="icon-wholesale"></i>
              </button>
              <div class="accordion-content" id="content-wholesale">
                <div class="accordion-body">
                  <p><strong>Minimum Order Quantity:</strong> 50 pieces per design</p>
                  <p><strong>Customization Options:</strong> Logo engraving, custom plating (18k Gold, Rose Gold, Rhodium), and bespoke packaging.</p>
                  <p><strong>Lead Time:</strong> 15-25 business days depending on order volume.</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Related Products Section -->
      <!-- Related Products Section -->
      {relatedProducts.length > 0 && (
        <section class="related-products">
          <h2 class="section-title">You May Also Like</h2>

          <div class="related-slider-container">
            <!-- Previous Button -->
            <button type="button" class="slider-nav prev-btn" id="relatedPrevBtn" aria-label="Previous products">
              <i class="fa-solid fa-chevron-left"></i>
            </button>

            <!-- Products Slider -->
            <div class="related-slider" id="relatedSlider">
              {relatedProducts.map((relatedProduct) => {
                const relatedImage = relatedProduct.images?.[0]?.src || 'https://images.unsplash.com/photo-1515562141207-7a88fb7ce338?w=400&q=80';

                // 确保价格有效
                const regularPrice = relatedProduct.regular_price && relatedProduct.regular_price !== ''
                  ? parseFloat(relatedProduct.regular_price)
                  : 0;
                const salePrice = relatedProduct.price && relatedProduct.price !== ''
                  ? parseFloat(relatedProduct.price)
                  : 0;

                // 计算折扣
                const relatedHasDiscount = regularPrice > 0 && salePrice > 0 && regularPrice > salePrice;
                const relatedDiscountPercent = relatedHasDiscount
                  ? Math.round(((regularPrice - salePrice) / regularPrice) * 100)
                  : 0;

                return (
                  <a href={`/product/${relatedProduct.slug}`} class="product-card">
                    <div class="product-image">
                      {relatedHasDiscount && relatedDiscountPercent > 0 && (
                        <span class="discount-badge">-{relatedDiscountPercent}%</span>
                      )}
                      <img src={relatedImage} alt={relatedProduct.name} loading="lazy" />
                    </div>
                    <div class="product-details">
                      <h3>{relatedProduct.name}</h3>
                      <div class="prices">
                        <span class="price">${salePrice.toFixed(2)}</span>
                        {relatedHasDiscount && (
                          <span class="original">${regularPrice.toFixed(2)}</span>
                        )}
                      </div>
                    </div>
                  </a>
                );
              })}
            </div>

            <!-- Next Button -->
            <button type="button" class="slider-nav next-btn" id="relatedNextBtn" aria-label="Next products">
              <i class="fa-solid fa-chevron-right"></i>
            </button>
          </div>
        </section>
      )}

      <!-- Customer Reviews Section -->
      <section class="customer-reviews">
        <div class="reviews-header">
          <h2 class="section-title">Customer Reviews</h2>
          <div class="rating-summary">
            <div class="stars">
              <i class="fa-solid fa-star"></i>
              <i class="fa-solid fa-star"></i>
              <i class="fa-solid fa-star"></i>
              <i class="fa-solid fa-star"></i>
              <i class="fa-solid fa-star-half-stroke"></i>
            </div>
            <span class="rating-text">4.8 (124 Reviews)</span>
          </div>
        </div>

        <div class="reviews-grid">
          <!-- Review 1 -->
          <div class="review-card">
            <div class="review-header">
              <div class="reviewer-info">
                <span class="reviewer-name">Sarah M.</span>
                <span class="verified-badge">
                  <i class="fa-solid fa-circle-check"></i>
                  Verified Buyer
                </span>
              </div>
              <div class="review-stars">
                <i class="fa-solid fa-star"></i>
                <i class="fa-solid fa-star"></i>
                <i class="fa-solid fa-star"></i>
                <i class="fa-solid fa-star"></i>
                <i class="fa-solid fa-star"></i>
              </div>
            </div>
            <h4 class="review-title">Perfect everyday piece</h4>
            <p class="review-text">I've worn this necklace every day since I got it. It hasn't tarnished at all in the shower, and it looks so elegant layered with my other gold chains. Highly recommend!</p>
          </div>

          <!-- Review 2 -->
          <div class="review-card">
            <div class="review-header">
              <div class="reviewer-info">
                <span class="reviewer-name">Emily R.</span>
                <span class="verified-badge">
                  <i class="fa-solid fa-circle-check"></i>
                  Verified Buyer
                </span>
              </div>
              <div class="review-stars">
                <i class="fa-solid fa-star"></i>
                <i class="fa-solid fa-star"></i>
                <i class="fa-solid fa-star"></i>
                <i class="fa-solid fa-star"></i>
                <i class="fa-regular fa-star"></i>
              </div>
            </div>
            <h4 class="review-title">Beautiful but delicate</h4>
            <p class="review-text">The pearl is lovely and has a nice luster. The chain is very thin, which gives it that dainty look, but you have to be a bit careful not to snag it. Overall, a great purchase for the price.</p>
          </div>
        </div>

        <div class="reviews-footer">
          <button type="button" class="btn-read-all">Read All Reviews</button>
        </div>
      </section>
    </div>

    <!-- Mobile Sticky Bottom Buy Bar -->
    <div class="mobile-sticky-action-bar">
      <div class="sticky-price-block">
        <span class="sticky-price">${product.price}</span>
        {hasDiscount && <span class="sticky-original">${product.regular_price}</span>}
      </div>
      <div class="sticky-btn-group">
        <button type="button" class="sticky-btn-cart" onclick="document.querySelector('.btn-add-cart')?.click()">Add to Cart</button>
        <button type="button" class="sticky-btn-buy" onclick="document.querySelector('.btn-buy-now')?.click()">Buy Now</button>
      </div>
    </div>
  </main>

  <Footer />
  <CartDrawer />
</Layout>

<style>
  /* =========================================================
     1. 全局与基础安全布局重置（杜绝任何横向溢出与白边）
     ========================================================= */
  *, *::before, *::after {
    box-sizing: border-box;
  }

  .product-detail-page {
    background: #ffffff;
    padding: 24px 0 80px;
    width: 100%;
    max-width: 100%;
    overflow-x: hidden;
  }

  .product-container {
    width: 100%;
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 20px;
    box-sizing: border-box;
  }

  /* 面包屑导航 */
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 13.5px;
    color: #747878;
    margin-bottom: 32px;
    white-space: nowrap;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .breadcrumb::-webkit-scrollbar {
    display: none;
  }
  .breadcrumb a {
    color: #747878;
    text-decoration: none;
    transition: color 0.2s;
    flex-shrink: 0;
  }
  .breadcrumb a:hover {
    color: #0e0f0f;
  }
  .breadcrumb i {
    font-size: 9px;
    flex-shrink: 0;
    color: #aaa;
  }
  .breadcrumb span {
    color: #0e0f0f;
    flex-shrink: 0;
  }
  .breadcrumb-current {
    color: #0e0f0f;
    font-weight: 500;
    max-width: 300px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* 移动端响应式优化 */
  @media (max-width: 768px) {
    .breadcrumb {
      gap: 8px;
      font-size: 12.5px;
      margin-bottom: 20px;
    }
    .breadcrumb i {
      font-size: 8px;
    }
    .breadcrumb-current {
      max-width: 150px;
    }
  }

  @media (max-width: 480px) {
    .breadcrumb {
      gap: 6px;
      font-size: 12px;
    }
    .breadcrumb-current {
      max-width: 120px;
    }
  }

  /* =========================================================
     2. 主图与画廊 (Gallery)
     ========================================================= */
  .product-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 64px;
    margin-bottom: 80px;
    align-items: flex-start;
    width: 100%;
  }

  .product-gallery {
    display: flex;
    flex-direction: column;
    gap: 14px;
    width: 100%;
    min-width: 0;
  }

  /* Main Image Slider */
  .main-image-slider {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    background: #f6f3ed;
    border: 1px solid #ddd8ce;
    border-radius: 4px;
    overflow: hidden;
  }

  .slider-container {
    display: flex;
    width: 100%;
    height: 100%;
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    touch-action: pan-y pinch-zoom;
  }

  .slider-item {
    flex: 0 0 100%;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .slider-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    user-select: none;
    -webkit-user-drag: none;
  }

  /* Image Counter */
  .image-counter {
    position: absolute;
    top: 16px;
    right: 16px;
    background: rgba(14, 15, 15, 0.75);
    backdrop-filter: blur(4px);
    color: #ffffff;
    font-size: 13px;
    font-weight: 600;
    padding: 6px 12px;
    border-radius: 20px;
    z-index: 3;
    letter-spacing: 0.3px;
  }

  .image-counter #currentImageIndex {
    font-weight: 700;
  }

  /* Slider Navigation Arrows */
  .slider-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 40px;
    height: 40px;
    background: rgba(255, 255, 255, 0.9);
    border: 1px solid rgba(221, 216, 206, 0.8);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 2;
    transition: all 0.2s ease;
    font-size: 16px;
    color: #0e0f0f;
  }

  .slider-arrow:hover {
    background: #ffffff;
    transform: translateY(-50%) scale(1.1);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  }

  .slider-arrow.prev {
    left: 16px;
  }

  .slider-arrow.next {
    right: 16px;
  }

  /* Hide arrows on mobile */
  @media (max-width: 768px) {
    .slider-arrow {
      display: none;
    }
  }

  .main-image {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    background: #f6f3ed;
    border: 1px solid #ddd8ce;
    border-radius: 4px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .gallery-badge {
    position: absolute;
    top: 14px;
    left: 14px;
    background: #0e0f0f;
    color: #fff;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
    padding: 4px 10px;
    border-radius: 2px;
    z-index: 2;
  }
  .btn-wishlist {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.9);
    border: 1px solid #ddd8ce;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #444;
    cursor: pointer;
    font-size: 15px;
    z-index: 2;
    transition: all 0.2s;
  }
  .btn-wishlist:hover {
    background: #fff;
    color: #a82424;
    transform: scale(1.05);
  }
  .main-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.2s ease;
  }
  .thumbnails {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    padding-bottom: 4px;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .thumbnails::-webkit-scrollbar {
    display: none;
  }
  .thumbnail {
    width: 80px;
    height: 80px;
    flex-shrink: 0;
    border: 1px solid #ddd8ce;
    border-radius: 3px;
    overflow: hidden;
    cursor: pointer;
    transition: all 0.2s;
    background: #f6f3ed;
  }
  .thumbnail:hover {
    border-color: #747878;
  }
  .thumbnail.active {
    border-color: #0e0f0f;
    border-width: 2px;
  }
  .thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* =========================================================
     3. 产品主信息区 (Info Header)
     ========================================================= */
  .product-info {
    display: flex;
    flex-direction: column;
    padding-top: 4px;
    gap: 22px;
    min-width: 0;
    width: 100%;
  }

  .product-header {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-bottom: 20px;
    border-bottom: 1px solid #ddd8ce;
    min-width: 0;
  }
  .product-title {
    font-size: 32px;
    font-weight: 500;
    font-family: 'Bodoni Moda', Georgia, serif;
    color: #0e0f0f;
    line-height: 1.25;
    margin: 0;
    word-break: break-word;
  }
  .price-rating-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
  }
  .price-row {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }
  .current-price {
    font-size: 34px;
    font-weight: 400;
    color: #0e0f0f;
    font-family: 'Bodoni Moda', Georgia, serif;
  }
  .current-price .dollar {
    font-size: 26px;
    margin-right: 2px;
  }
  .original-price {
    font-size: 16px;
    color: #8c8c8c;
    text-decoration: line-through;
  }
  .sale-badge {
    background: #f7f4ee;
    border: 1px solid rgba(163, 130, 76, 0.6);
    color: #725b29;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 3px 8px;
    border-radius: 2px;
  }
  .rating-row {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .star-icon {
    color: #725b29;
    font-size: 13px;
  }
  .rating-score {
    font-size: 13px;
    font-weight: 700;
    color: #0e0f0f;
  }
  .rating-count {
    font-size: 12px;
    color: #747878;
  }

  /* =========================================================
     4. 批发阶梯价格表 (Wholesale Table)
     ========================================================= */
  .wholesale-table {
    background: #fbf9f5;
    border: 1px solid #e2ddd3;
    border-radius: 4px;
    padding: 18px 20px;
    width: 100%;
  }
  .table-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 14px;
    flex-wrap: wrap;
    gap: 8px;
  }
  .header-left {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .header-left i {
    color: #725b29;
    font-size: 14px;
  }
  .header-left span {
    font-size: 12.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: #0e0f0f;
  }
  .header-badge {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: #725b29;
  }
  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 8px;
    margin-bottom: 14px;
  }
  .price-tier {
    background: #fff;
    border: 1px solid #e0dad0;
    border-radius: 3px;
    padding: 10px 8px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 3px;
    min-width: 0;
  }
  .price-tier.best {
    background: #fdf6e9;
    border-color: #d1a85f;
  }
  .tier-qty {
    font-size: 10px;
    font-weight: 600;
    color: #6d6a64;
    text-transform: uppercase;
  }
  .tier-price {
    font-size: 17px;
    font-weight: 700;
    color: #0e0f0f;
  }
  .tier-label, .tier-save, .tier-badge {
    font-size: 9.5px;
    text-transform: uppercase;
    font-weight: 700;
  }
  .tier-label {
    color: #8c8c8c;
  }
  .tier-save {
    color: #16a34a;
  }
  .tier-badge {
    color: #8c631a;
  }
  .auto-apply {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 11.5px;
    color: #666;
    line-height: 1.4;
  }
  .auto-apply i {
    color: #16a34a;
    font-size: 13px;
  }

  /* 描述文案与标签 */
  .product-description {
    font-size: 14.5px;
    line-height: 1.6;
    color: #4a4d4d;
    margin: 0;
    word-break: break-word;
  }
  .feature-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .feature-badges .badge {
    background: #fbf9f5;
    border: 1px solid #ddd8ce;
    color: #5c5f5f;
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 1.2px;
    padding: 5px 10px;
    border-radius: 2px;
  }

  /* =========================================================
     Product Variants Selection
     ========================================================= */
  .variants-section {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 20px 0;
    border-bottom: 1px solid #e5dfd5;
    width: 100%;
  }

  .variant-group {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .variant-label {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
  }

  .variant-label .label-text {
    color: #5c5f5f;
    font-weight: 600;
  }

  .variant-label .selected-value {
    color: #0e0f0f;
    font-weight: 600;
  }

  .variant-options {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .variant-option {
    min-width: 60px;
    height: 40px;
    padding: 0 16px;
    background: #ffffff;
    border: 1.5px solid #ddd8ce;
    border-radius: 3px;
    color: #5c5f5f;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .variant-option:hover {
    border-color: #0e0f0f;
    background: #fbf9f5;
  }

  .variant-option.active {
    border-color: #0e0f0f;
    background: #0e0f0f;
    color: #ffffff;
    font-weight: 600;
  }

  .variant-option:disabled {
    opacity: 0.4;
    cursor: not-allowed;
    background: #f5f5f5;
    border-color: #e5e5e5;
    position: relative;
  }

  .variant-option:disabled:hover {
    border-color: #e5e5e5;
    background: #f5f5f5;
  }

  .variant-option.out-of-stock {
    opacity: 0.4;
    cursor: not-allowed;
    background: #f5f5f5;
    border-color: #e5e5e5;
    text-decoration: line-through;
    color: #999;
  }

  .variant-option.out-of-stock:hover {
    border-color: #e5e5e5;
    background: #f5f5f5;
  }

  /* =========================================================
     5. 核心操作区：数量与购买按钮（重点优化）
     ========================================================= */
  .actions-section {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-bottom: 22px;
    border-bottom: 1px solid #ddd8ce;
    width: 100%;
  }

  /* 数量行：两端对齐，轻巧极简 */
  .quantity-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }
  .qty-label {
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: #666;
  }
  .quantity-selector {
    display: flex;
    align-items: center;
    border: 1px solid #dcd7ce;
    background: #fbf9f5;
    height: 32px;
    width: 96px;
    border-radius: 2px;
  }
  .quantity-selector button {
    width: 28px;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    color: #444;
    cursor: pointer;
    font-size: 11px;
    padding: 0;
  }
  .quantity-selector input {
    flex: 1;
    width: 100%;
    min-width: 0;
    text-align: center;
    border: none;
    background: transparent;
    font-size: 13px;
    font-weight: 600;
    color: #111;
    padding: 0;
  }
  .quantity-selector input:focus {
    outline: none;
  }

  /* 按钮组：强制横向左右并排平分 */
  .button-group {
    display: flex !important;
    flex-direction: row !important;
    gap: 10px !important;
    width: 100% !important;
  }
  .btn-add-cart,
  .btn-buy-now {
    flex: 1 1 0% !important;
    height: 46px !important;
    min-height: 46px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    font-size: 11.5px !important;
    font-weight: 700 !important;
    letter-spacing: 1.5px !important;
    text-transform: uppercase !important;
    border-radius: 2px !important;
    cursor: pointer !important;
    padding: 0 8px !important;
    white-space: nowrap !important;
    transition: all 0.2s ease !important;
  }
  /* 左边：黑底白字 */
  .btn-add-cart {
    background: #0e0f0f !important;
    border: 1px solid #0e0f0f !important;
    color: #ffffff !important;
  }
  .btn-add-cart:hover,
  .btn-add-cart:active {
    background: #2b2b2b !important;
  }
  /* 右边：香槟轻奢浅米金底 */
  .btn-buy-now {
    background: #eee8dc !important;
    border: 1px solid #ded7ca !important;
    color: #111111 !important;
  }
  .btn-buy-now:hover,
  .btn-buy-now:active {
    background: #e4dccf !important;
  }

  /* 批发全宽线框按钮 */
  .btn-wholesale {
    width: 100% !important;
    height: 44px !important;
    min-height: 44px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    background: transparent !important;
    border: 1px solid #0e0f0f !important;
    color: #0e0f0f !important;
    font-size: 11px !important;
    font-weight: 700 !important;
    letter-spacing: 1.5px !important;
    text-transform: uppercase !important;
    border-radius: 2px !important;
    cursor: pointer !important;
    padding: 0 12px !important;
    white-space: nowrap !important;
    transition: all 0.2s ease !important;
  }
  .btn-wholesale:hover,
  .btn-wholesale:active {
    background: #fbf9f5 !important;
  }

  /* =========================================================
     6. 会员优惠券与赠品栏
     ========================================================= */
  .offers-card {
    background: #fbf9f5;
    border: 1px solid #e2ddd3;
    border-radius: 4px;
    padding: 16px 18px;
    width: 100%;
  }
  .offers-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
  }
  .offers-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }
  .offer-item {
    background: #fff;
    border: 1px solid #e2ddd3;
    border-radius: 3px;
    padding: 14px 12px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }
  .offer-amount {
    font-size: 20px;
    font-weight: 700;
    color: #111;
  }
  .offer-desc {
    font-size: 11px;
    color: #777;
    line-height: 1.35;
    margin: 0;
  }
  .offer-btn {
    align-self: flex-start;
    background: none;
    border: none;
    color: #0e0f0f;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 0;
    margin-top: 4px;
  }
  .offer-btn:hover {
    color: #725b29;
  }

  /* 赠品横条 */
  .gift-carousel {
    background: #fbf9f5;
    border: 1px solid #e2ddd3;
    border-radius: 4px;
    padding: 12px 14px;
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
  }
  .carousel-btn {
    display: none;
  }
  .gift-content {
    flex: 1;
    display: flex;
    gap: 10px;
    align-items: center;
    min-width: 0;
  }
  .gift-image {
    width: 44px;
    height: 44px;
    background: #fff;
    border: 1px solid #ddd8ce;
    border-radius: 3px;
    flex-shrink: 0;
    overflow: hidden;
  }
  .gift-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    font-weight: 700;
    color: #725b29;
  }
  .gift-info {
    min-width: 0;
    flex: 1;
  }
  .gift-info h4 {
    font-size: 11.5px;
    font-weight: 500;
    color: #1c1c18;
    line-height: 1.3;
    margin: 0 0 3px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .gift-price-row {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .gift-price {
    font-size: 12.5px;
    font-weight: 700;
    color: #0e0f0f;
  }
  .gift-tag {
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: #16a34a;
    background: #f0fdf4;
    padding: 1px 5px;
    border-radius: 2px;
  }
  .gift-actions {
    flex-shrink: 0;
  }
  .btn-add-gift {
    padding: 8px 12px;
    background: #0e0f0f;
    border: none;
    color: #fff;
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    border-radius: 2px;
    cursor: pointer;
    white-space: nowrap;
  }

  /* 安全支付与保障徽章 */
  .checkout-badges {
    padding-bottom: 20px;
    border-bottom: 1px solid #ddd8ce;
    width: 100%;
  }
  .section-divider {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 14px;
  }
  .section-divider::before,
  .section-divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: repeating-linear-gradient(to right, #ddd8ce 0, #ddd8ce 4px, transparent 4px, transparent 8px);
  }
  .section-divider span {
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: #8c8c8c;
    white-space: nowrap;
  }
  .payment-methods {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
  }
  .payment-badge {
    height: 22px;
    padding: 0 8px;
    border-radius: 2px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 9px;
    font-weight: 700;
    color: #fff;
  }
  .payment-badge.visa { background: #1A1F71; }
  .payment-badge.mc { background: #EB001B; }
  .payment-badge.amex { background: #006FCF; }
  .payment-badge.discover { background: #FF6000; }
  .payment-badge.paypal { background: #003087; }
  .payment-badge.apple { background: #000; }

  /* 三大服务保障条 */
  .trust-strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 0;
    border-bottom: 1px solid #ddd8ce;
    width: 100%;
    gap: 8px;
  }
  .trust-item {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: 1;
  }
  .trust-item i {
    font-size: 16px;
    color: #725b29;
    flex-shrink: 0;
  }
  .trust-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .trust-text strong {
    font-size: 11px;
    color: #111;
    font-weight: 600;
    line-height: 1.2;
    white-space: nowrap;
  }
  .trust-text span {
    font-size: 9.5px;
    color: #777;
    white-space: nowrap;
  }

  /* 手风琴面板 */
  .accordions {
    border-top: none;
    margin-bottom: 24px;
    width: 100%;
  }
  .accordion-item {
    border-bottom: 1px solid #ddd8ce;
  }
  .accordion-header {
    width: 100%;
    padding: 14px 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
  }
  .accordion-header span {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: #111;
  }
  .accordion-header i {
    font-size: 12px;
    color: #747878;
    transition: transform 0.3s;
  }
  .accordion-content {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.35s ease;
  }
  .accordion-content.active {
    max-height: 800px;
  }
  .accordion-body {
    padding-bottom: 16px;
    font-size: 13px;
    line-height: 1.6;
    color: #555;
    word-break: break-word;
  }
  .accordion-body p { margin: 0 0 6px; }
  .accordion-body ul { padding-left: 18px; margin: 6px 0; }
  .accordion-body li { margin-bottom: 3px; }

  /* 推荐商品区 */
  .related-products {
    border-top: 1px solid #ddd8ce;
    padding-top: 40px;
    margin-bottom: 60px;
    width: 100%;
  }
  .section-title {
    font-size: 22px;
    font-weight: 500;
    font-family: 'Bodoni Moda', Georgia, serif;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: #0e0f0f;
    margin: 0 0 32px;
    text-align: center;
  }

  /* Related Products Slider Container */
  .related-slider-container {
    position: relative;
    padding: 0 60px;
    overflow: hidden;
  }

  .related-slider {
    display: flex;
    gap: 16px;
    transition: transform 0.5s ease-in-out;
    will-change: transform;
  }

  .related-slider .product-card {
    flex: 0 0 calc(25% - 12px);
    min-width: 0;
  }

  /* Slider Navigation Buttons */
  .slider-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(255, 255, 255, 0.95);
