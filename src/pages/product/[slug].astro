<script is:inline define:vars={{ productId: product.id, productSlug: product.slug }}>
  // 产品数据
  window.productId = productId;
  window.productSlug = productSlug;

  // 图片滑动器状态
  let currentSlide = 0;
  let totalSlides = 0;
  let autoPlayTimer = null;
  let isAutoPlaying = true;
  let touchStartX = 0;
  let touchEndX = 0;

  // 初始化滑动器
  function initSlider() {
    const sliderContainer = document.getElementById('sliderContainer');
    if (!sliderContainer) return;

    const slides = sliderContainer.querySelectorAll('.slider-item');
    totalSlides = slides.length;

    if (totalSlides <= 1) return; // 只有一张图片时不需要滑动

    // 添加触摸事件
    sliderContainer.addEventListener('touchstart', handleTouchStart, { passive: true });
    sliderContainer.addEventListener('touchend', handleTouchEnd, { passive: true });

    // 添加鼠标拖动事件
    let isDragging = false;
    let startX = 0;

    sliderContainer.addEventListener('mousedown', (e) => {
      isDragging = true;
      startX = e.clientX;
      sliderContainer.style.cursor = 'grabbing';
      pauseAutoPlay();
    });

    document.addEventListener('mousemove', (e) => {
      if (!isDragging) return;
      e.preventDefault();
    });

    document.addEventListener('mouseup', (e) => {
      if (!isDragging) return;
      isDragging = false;
      sliderContainer.style.cursor = 'grab';

      const diffX = e.clientX - startX;
      if (Math.abs(diffX) > 50) {
        if (diffX > 0) {
          prevImage();
        } else {
          nextImage();
        }
      }
    });

    // 鼠标悬停时暂停自动播放
    sliderContainer.addEventListener('mouseenter', pauseAutoPlay);
    sliderContainer.addEventListener('mouseleave', resumeAutoPlay);

    // 开始自动播放
    startAutoPlay();
  }

  // 跳转到指定幻灯片
  function goToSlide(index) {
    if (index < 0 || index >= totalSlides) return;

    currentSlide = index;
    updateSlider();
    updateThumbnails();
    pauseAutoPlay();

    // 3秒后恢复自动播放
    setTimeout(resumeAutoPlay, 3000);
  }

  // 上一张
  function prevImage() {
    currentSlide = (currentSlide - 1 + totalSlides) % totalSlides;
    updateSlider();
    updateThumbnails();
    pauseAutoPlay();
    setTimeout(resumeAutoPlay, 3000);
  }

  // 下一张
  function nextImage() {
    currentSlide = (currentSlide + 1) % totalSlides;
    updateSlider();
    updateThumbnails();
    pauseAutoPlay();
    setTimeout(resumeAutoPlay, 3000);
  }

  // 更新滑动器位置
  function updateSlider() {
    const sliderContainer = document.getElementById('sliderContainer');
    if (!sliderContainer) return;

    sliderContainer.style.transform = `translateX(-${currentSlide * 100}%)`;

    // 更新计数器
    const counter = document.getElementById('currentImageIndex');
    if (counter) {
      counter.textContent = currentSlide + 1;
    }
  }

  // 更新缩略图激活状态
  function updateThumbnails() {
    document.querySelectorAll('.thumbnail').forEach((thumb, index) => {
      if (index === currentSlide) {
        thumb.classList.add('active');
      } else {
        thumb.classList.remove('active');
      }
    });
  }

  // 触摸开始
  function handleTouchStart(e) {
    touchStartX = e.changedTouches[0].screenX;
    pauseAutoPlay();
  }

  // 触摸结束
  function handleTouchEnd(e) {
    touchEndX = e.changedTouches[0].screenX;
    handleSwipe();
  }

  // 处理滑动手势
  function handleSwipe() {
    const swipeThreshold = 50;
    const diff = touchStartX - touchEndX;

    if (Math.abs(diff) > swipeThreshold) {
      if (diff > 0) {
        // 向左滑动 - 下一张
        nextImage();
      } else {
        // 向右滑动 - 上一张
        prevImage();
      }
    } else {
      // 滑动距离不够，恢复自动播放
      setTimeout(resumeAutoPlay, 3000);
    }
  }

  // 开始自动播放
  function startAutoPlay() {
    if (totalSlides <= 1) return;

    autoPlayTimer = setInterval(() => {
      if (isAutoPlaying) {
        nextImage();
      }
    }, 4000); // 每4秒切换一次
  }

  // 暂停自动播放
  function pauseAutoPlay() {
    isAutoPlaying = false;
    if (autoPlayTimer) {
      clearInterval(autoPlayTimer);
      autoPlayTimer = null;
    }
  }

  // 恢复自动播放
  function resumeAutoPlay() {
    if (!isAutoPlaying && totalSlides > 1) {
      isAutoPlaying = true;
      startAutoPlay();
    }
  }

  // 修改购买数量
  function changeQty(delta) {
    const input = document.getElementById('qtyInput');
    if (input) {
      const currentValue = parseInt(input.value, 10) || 1;
      const newValue = Math.max(1, currentValue + delta);
      input.value = newValue;
    }
  }

  // ========== 购物车功能 ==========

  // 获取当前产品信息
  function getCurrentProductData() {
    const quantity = parseInt(document.getElementById('qtyInput')?.value || 1);
    const selectedAttrs = getSelectedAttributes();
    const matchingVariation = findMatchingVariation(selectedAttrs);

    // 获取产品基本信息
    const productName = document.querySelector('.product-title')?.textContent || '';
    const productImage = document.querySelector('.slider-item img')?.src ||
                        document.querySelector('.main-image img')?.src || '';

    let price = document.querySelector('.current-price')?.textContent.replace(/[^0-9.]/g, '') || '0';
    let variationId = null;
    let stockStatus = 'instock';

    // 如果找到匹配的变体，使用变体数据
    if (matchingVariation) {
      price = matchingVariation.price;
      variationId = matchingVariation.id;
      stockStatus = matchingVariation.stock_status;
    }

    return {
      id: variationId || window.productId, // 使用变体ID或产品ID
      productId: window.productId,
      variationId: variationId,
      name: productName,
      price: price,
      quantity: quantity,
      image: productImage,
      selectedVariants: selectedAttrs,
      stockStatus: stockStatus,
      slug: window.productSlug
    };
  }

  // 添加到购物车
  function addToCartHandler() {
    const productData = getCurrentProductData();

    // 检查库存
    if (productData.stockStatus !== 'instock') {
      alert('Sorry, this product is out of stock.');
      return;
    }

    // 获取现有购物车
    let cart = [];
    try {
      const cartData = localStorage.getItem('ebbelle_cart');
      cart = cartData ? JSON.parse(cartData) : [];
    } catch (e) {
      console.error('Failed to get cart:', e);
    }

    // 查找是否已存在相同的商品
    const existingIndex = cart.findIndex(item =>
      item.productId === productData.productId &&
      item.variationId === productData.variationId &&
      JSON.stringify(item.selectedVariants) === JSON.stringify(productData.selectedVariants)
    );

    if (existingIndex > -1) {
      // 如果已存在，增加数量
      cart[existingIndex].quantity += productData.quantity;
    } else {
      // 如果不存在，添加新商品
      cart.push({
        ...productData,
        cartItemId: Date.now() + Math.random()
      });
    }

    // 保存购物车
    try {
      localStorage.setItem('ebbelle_cart', JSON.stringify(cart));

      // 触发购物车更新事件
      window.dispatchEvent(new CustomEvent('cartUpdated', { detail: { cart } }));

      // 打开购物车抽屉
      if (typeof window.toggleCart === 'function') {
        window.toggleCart(true);
      }

      console.log('Added to cart:', productData);
    } catch (e) {
      console.error('Failed to save cart:', e);
      alert('Failed to add to cart. Please try again.');
    }
  }

  // 立即购买
  function buyNowHandler() {
    const productData = getCurrentProductData();

    // 检查库存
    if (productData.stockStatus !== 'instock') {
      alert('Sorry, this product is out of stock.');
      return;
    }

    // 添加到购物车
    addToCartHandler();

    // 跳转到结账页面
    setTimeout(() => {
      window.location.href = '/checkout';
    }, 300);
  }

  // 绑定按钮事件
  function bindCartButtons() {
    // 绑定所有"Add to Cart"按钮
    document.querySelectorAll('.btn-add-cart, .sticky-btn-cart').forEach(btn => {
      btn.addEventListener('click', addToCartHandler);
    });

    // 绑定所有"Buy Now"按钮
    document.querySelectorAll('.btn-buy-now, .sticky-btn-buy').forEach(btn => {
      btn.addEventListener('click', buyNowHandler);
    });
  }

  // 手风琴折叠展开
  function toggleAccordion(id) {
    const content = document.getElementById(`content-${id}`);
    const icon = document.getElementById(`icon-${id}`);

    if (content) {
      const isActive = content.classList.contains('active');

      // 关闭同组其他手风琴
      document.querySelectorAll('.accordion-content').forEach(acc => {
        acc.classList.remove('active');
      });
      document.querySelectorAll('.accordion-header i').forEach(ic => {
        ic.classList.remove('fa-chevron-up');
        ic.classList.add('fa-chevron-down');
      });

      // 切换当前手风琴状态
      if (!isActive) {
        content.classList.add('active');
        if (icon) {
          icon.classList.remove('fa-chevron-down');
          icon.classList.add('fa-chevron-up');
        }
      }
    }
  }

  // 获取变体数据
  let variationsData = [];
  try {
    const dataElement = document.getElementById('variationsData');
    if (dataElement) {
      variationsData = JSON.parse(dataElement.textContent);
    }
  } catch (e) {
    console.error('Failed to parse variations data:', e);
  }

  // 获取当前选中的所有属性
  function getSelectedAttributes() {
    const selected = {};
    document.querySelectorAll('.variant-option.active').forEach(btn => {
      const attribute = btn.getAttribute('data-attribute');
      const value = btn.getAttribute('data-value');
      if (attribute && value) {
        selected[attribute] = value;
      }
    });
    return selected;
  }

  // 根据选中的属性查找匹配的变体
  function findMatchingVariation(selectedAttrs) {
    if (!variationsData || variationsData.length === 0) return null;

    return variationsData.find(variation => {
      if (!variation.attributes || variation.attributes.length === 0) return false;

      // 检查所有属性是否匹配
      return variation.attributes.every(attr => {
        const attrSlug = attr.name.toLowerCase().replace(/\s+/g, '-');
        return selectedAttrs[attrSlug] &&
               selectedAttrs[attrSlug].toLowerCase() === attr.option.toLowerCase();
      });
    });
  }

  // 更新可用选项（禁用缺货的选项）
  function updateAvailableOptions() {
    if (!variationsData || variationsData.length === 0) return;

    const selectedAttrs = getSelectedAttributes();

    // 检查每个属性的每个选项
    document.querySelectorAll('.variant-group').forEach(group => {
      const buttons = group.querySelectorAll('.variant-option');

      buttons.forEach(btn => {
        const attribute = btn.getAttribute('data-attribute');
        const value = btn.getAttribute('data-value');

        // 创建临时选择来测试这个选项
        const testAttrs = { ...selectedAttrs, [attribute]: value };

        // 查找是否有匹配且有库存的变体
        const hasStockVariation = variationsData.some(variation => {
          if (!variation.attributes || variation.attributes.length === 0) return false;

          const matches = variation.attributes.every(attr => {
            const attrSlug = attr.name.toLowerCase().replace(/\s+/g, '-');
            return testAttrs[attrSlug] &&
                   testAttrs[attrSlug].toLowerCase() === attr.option.toLowerCase();
          });

          return matches && variation.stock_status === 'instock';
        });

        // 如果没有有库存的变体，禁用这个选项
        if (!hasStockVariation) {
          btn.disabled = true;
          btn.classList.add('out-of-stock');
        } else {
          btn.disabled = false;
          btn.classList.remove('out-of-stock');
        }
      });
    });
  }

  // 更新价格和库存状态
  function updatePriceAndStock(variation) {
    if (!variation) return;

    // 更新价格
    const currentPrice = document.querySelector('.current-price');
    const originalPrice = document.querySelector('.original-price');
    const stickyPrice = document.querySelector('.sticky-price');
    const stickyOriginal = document.querySelector('.sticky-original');

    if (variation.price && currentPrice) {
      const priceText = currentPrice.querySelector('.dollar') ?
        `<span class="dollar">$</span>${variation.price}` :
        `$${variation.price}`;
      currentPrice.innerHTML = priceText;
    }

    if (stickyPrice) {
      stickyPrice.textContent = `$${variation.price}`;
    }

    // 更新库存状态
    const stockStatus = document.querySelector('.info-item:has(.fa-circle-check) span');
    if (stockStatus) {
      stockStatus.textContent = variation.stock_status === 'instock' ? 'In Stock' : 'Out of Stock';
    }

    // 禁用/启用购买按钮
    const addToCartBtns = document.querySelectorAll('.btn-add-cart, .sticky-btn-cart');
    const buyNowBtns = document.querySelectorAll('.btn-buy-now, .sticky-btn-buy');

    if (variation.stock_status !== 'instock') {
      addToCartBtns.forEach(btn => {
        btn.disabled = true;
        btn.style.opacity = '0.5';
        btn.style.cursor = 'not-allowed';
      });
      buyNowBtns.forEach(btn => {
        btn.disabled = true;
        btn.style.opacity = '0.5';
        btn.style.cursor = 'not-allowed';
      });
    } else {
      addToCartBtns.forEach(btn => {
        btn.disabled = false;
        btn.style.opacity = '1';
        btn.style.cursor = 'pointer';
      });
      buyNowBtns.forEach(btn => {
        btn.disabled = false;
        btn.style.opacity = '1';
        btn.style.cursor = 'pointer';
      });
    }
  }

  // 变体选择
  function selectVariant(attribute, value, element) {
    // 更新选中状态
    const buttons = element.parentElement.querySelectorAll('.variant-option');
    buttons.forEach(btn => btn.classList.remove('active'));
    element.classList.add('active');

    // 更新显示的选中值
    const selectedValueSpan = document.getElementById(`selected-${attribute}`);
    if (selectedValueSpan) {
      selectedValueSpan.textContent = value;
    }

    // 获取当前选中的所有属性
    const selectedAttrs = getSelectedAttributes();

    // 查找匹配的变体
    const matchingVariation = findMatchingVariation(selectedAttrs);

    if (matchingVariation) {
      console.log('Found matching variation:', matchingVariation);
      updatePriceAndStock(matchingVariation);
    }

    // 更新可用选项
    updateAvailableOptions();
  }

  // 暴露全局函数
  window.goToSlide = goToSlide;
  window.prevImage = prevImage;
  window.nextImage = nextImage;
  window.changeQty = changeQty;
  window.selectVariant = selectVariant;
  window.toggleAccordion = toggleAccordion;

  // 初始化变体选择器
  function initVariants() {
    if (variationsData && variationsData.length > 0) {
      // 初始化时更新可用选项
      updateAvailableOptions();

      // 检查默认选中的变体
      const selectedAttrs = getSelectedAttributes();
      const matchingVariation = findMatchingVariation(selectedAttrs);
      if (matchingVariation) {
        updatePriceAndStock(matchingVariation);
      }
    }
  }

  // =========================================================
  // Related Products Slider (自动轮播 + 手动控制)
  // =========================================================
  function initRelatedSlider() {
    const slider = document.getElementById('relatedSlider');
    const prevBtn = document.getElementById('relatedPrevBtn');
    const nextBtn = document.getElementById('relatedNextBtn');

    if (!slider || !prevBtn || !nextBtn) return;

    const allProducts = Array.from(slider.children);
    const totalProducts = allProducts.length;

    if (totalProducts === 0) return;

    let currentIndex = 0;
    let productsPerPage = 4;
    let autoPlayInterval = null;
    let isAutoPlaying = true;
    let isMobile = false;

    // 根据屏幕宽度确定每页显示数量
    function updateProductsPerPage() {
      const width = window.innerWidth;
      isMobile = width <= 480;

      if (isMobile) {
        // 移动端：使用原生滚动
        return;
      } else if (width <= 768) {
        productsPerPage = 2;
      } else if (width <= 992) {
        productsPerPage = 3;
      } else {
        productsPerPage = 4;
      }
    }

    // 桌面端：每次滑动一个产品（使用 transform 实现平滑动画）
    function showProducts(startIndex) {
      // 确保所有产品都显示（通过 transform 控制位置）
      allProducts.forEach(product => {
        product.style.display = 'block';
      });

      // 计算偏移量
      const cardWidth = allProducts[0].offsetWidth + 16; // 卡片宽度 + gap
      const offset = -startIndex * cardWidth;

      // 应用 transform 动画
      slider.style.transform = `translateX(${offset}px)`;

      currentIndex = startIndex;

      // 无限循环，按钮始终可用
      prevBtn.disabled = false;
      nextBtn.disabled = false;
    }

    // 下一页（无限循环）
    function nextSlide() {
      if (currentIndex + productsPerPage < totalProducts) {
        showProducts(currentIndex + 1);
      } else {
        // 到达末尾，循环回到开头
        showProducts(0);
      }
    }

    // 上一页（无限循环）
    function prevSlide() {
      if (currentIndex > 0) {
        showProducts(currentIndex - 1);
      } else {
        // 到达开头，循环到末尾
        const lastIndex = Math.max(0, totalProducts - productsPerPage);
        showProducts(lastIndex);
      }
    }

    // 开始自动播放
    function startAutoPlay() {
      if (autoPlayInterval) clearInterval(autoPlayInterval);

      autoPlayInterval = setInterval(() => {
        if (isAutoPlaying) {
          nextSlide();
        }
      }, 3000); // 每3秒滑动一次
    }

    // 停止自动播放
    function stopAutoPlay() {
      if (autoPlayInterval) {
        clearInterval(autoPlayInterval);
        autoPlayInterval = null;
      }
    }

    // 暂停自动播放（临时）
    function pauseAutoPlay() {
      isAutoPlaying = false;
      setTimeout(() => {
        isAutoPlaying = true;
      }, 5000); // 5秒后恢复自动播放
    }

    // 按钮点击事件
    prevBtn.addEventListener('click', () => {
      pauseAutoPlay();
      prevSlide();
    });

    nextBtn.addEventListener('click', () => {
      pauseAutoPlay();
      nextSlide();
    });

    // 移动端触摸滑动暂停自动播放
    if (isMobile) {
      let touchStartTime = 0;

      slider.addEventListener('touchstart', () => {
        touchStartTime = Date.now();
        pauseAutoPlay();
      });

      slider.addEventListener('touchend', () => {
        const touchDuration = Date.now() - touchStartTime;
        // 如果是快速滑动（小于300ms），认为是用户主动操作
        if (touchDuration < 300) {
          pauseAutoPlay();
        }
      });

      // 监听滚动事件，滚动时暂停
      slider.addEventListener('scroll', () => {
        pauseAutoPlay();
      });
    }

    // 窗口大小改变时重新计算
    window.addEventListener('resize', () => {
      const oldProductsPerPage = productsPerPage;
      const wasMobile = isMobile;
      updateProductsPerPage();

      if (isMobile && !wasMobile) {
        // 切换到移动端：显示所有产品，隐藏按钮
        stopAutoPlay();
        allProducts.forEach(product => {
          product.style.display = 'block';
        });
        prevBtn.style.display = 'none';
        nextBtn.style.display = 'none';

        // 移动端也启动自动播放（通过滚动实现）
        startMobileAutoScroll();
      } else if (!isMobile && wasMobile) {
        // 切换到桌面端：显示按钮，重新分页
        stopMobileAutoScroll();
        prevBtn.style.display = 'flex';
        nextBtn.style.display = 'flex';
        currentIndex = 0;
        showProducts(0);
        startAutoPlay();
      } else if (!isMobile && oldProductsPerPage !== productsPerPage) {
        // 桌面端改变尺寸
        currentIndex = 0;
        showProducts(0);
      }
    });

    // 移动端自动滚动
    let mobileAutoScrollInterval = null;

    function startMobileAutoScroll() {
      if (!isMobile || mobileAutoScrollInterval) return;

      mobileAutoScrollInterval = setInterval(() => {
        if (isAutoPlaying && slider) {
          const scrollWidth = slider.scrollWidth;
          const clientWidth = slider.clientWidth;
          const maxScroll = scrollWidth - clientWidth;

          if (slider.scrollLeft >= maxScroll - 10) {
            // 滚动到末尾，返回开头
            slider.scrollTo({ left: 0, behavior: 'smooth' });
          } else {
            // 滚动一个卡片宽度
            const cardWidth = allProducts[0].offsetWidth + 12; // 卡片宽度 + gap
            slider.scrollBy({ left: cardWidth, behavior: 'smooth' });
          }
        }
      }, 3000);
    }

    function stopMobileAutoScroll() {
      if (mobileAutoScrollInterval) {
        clearInterval(mobileAutoScrollInterval);
        mobileAutoScrollInterval = null;
      }
    }

    // 初始化
    updateProductsPerPage();

    if (isMobile) {
      // 移动端：显示所有产品，启动自动滚动
      allProducts.forEach(product => {
        product.style.display = 'block';
      });
      prevBtn.style.display = 'none';
      nextBtn.style.display = 'none';
      startMobileAutoScroll();
    } else {
      // 桌面端：分页显示，启动自动播放
      showProducts(0);
      startAutoPlay();
    }

    // 页面可见性变化时控制自动播放
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        stopAutoPlay();
        stopMobileAutoScroll();
      } else {
        if (isMobile) {
          startMobileAutoScroll();
        } else {
          startAutoPlay();
        }
      }
    });
  }

  // 页面加载完成后初始化
  function initAll() {
    initSlider();
    initVariants();
    bindCartButtons();
    initRelatedSlider();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAll);
  } else {
    initAll();
  }
</script>