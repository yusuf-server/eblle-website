---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CartDrawer from '../../components/CartDrawer.astro';
import { getProductBySlug, getProductVariations, getRelatedProducts } from '../../lib/woocommerce';

export const prerender = false;

const { slug } = Astro.params;

// 获取当前主产品数据
const product = await getProductBySlug(slug);

if (!product) {
  return Astro.redirect('/404');
}

// 计算折扣百分比
const hasDiscount = Boolean(product.regular_price && product.price && parseFloat(product.regular_price) > parseFloat(product.price));
const discountPercent = hasDiscount
  ? Math.round(((parseFloat(product.regular_price) - parseFloat(product.price)) / parseFloat(product.regular_price)) * 100)
  : 0;

// 获取主图和缩略图
const images = product.images && product.images.length > 0
  ? product.images
  : [{ src: 'https://images.unsplash.com/photo-1515562141207-7a88fb7ce338?w=800&q=80', alt: product.name }];

const mainImage = images[0];
const thumbnails = images.slice(0, 10);

const getPrimaryCategory = () => {
  if (!product.categories || product.categories.length === 0) {
    return { name: 'All Jewelry', slug: '' };
  }
  return product.categories[0];
};

const primaryCategory = getPrimaryCategory();
const category = primaryCategory.name;
const categorySlug = primaryCategory.slug;

// 确保为纯 JS 语法，去除类型标记
const stripHtml = (html) => (html ? html.replace(/<[^>]*>/g, '') : '');
const shortDesc = stripHtml(product.short_description || product.description || '').substring(0, 200);

let variations = [];
let attributes = [];
if (product.type === 'variable' && product.variations && product.variations.length > 0) {
  variations = await getProductVariations(product.id);
  attributes = product.attributes || [];
}

const categoryIds = product.categories ? product.categories.map((cat) => cat.id) : [];
const tagIds = product.tags ? product.tags.map((tag) => tag.id) : [];
// 获取 10 个相关产品
const relatedProducts = await getRelatedProducts(product.id, categoryIds, tagIds, 10);

// =========================================================
// 纯原生 JavaScript 获取 56339 & 57994 真实数据
// =========================================================
const giftProductIds = [56339, 57994];
const wcUrl = import.meta.env.WC_STORE_URL || import.meta.env.WC_URL || import.meta.env.PUBLIC_WC_URL || '';
const wcKey = import.meta.env.WC_CONSUMER_KEY || '';
const wcSecret = import.meta.env.WC_CONSUMER_SECRET || '';

function getAccurateRegularPrice(p) {
  if (!p) return '0.00';
  if (p.regular_price !== undefined && p.regular_price !== null && p.regular_price !== '') {
    return parseFloat(p.regular_price).toFixed(2);
  }
  if (p.price !== undefined && p.price !== null && p.price !== '') {
    return parseFloat(p.price).toFixed(2);
  }
  return '0.00';
}

function encodeBasicAuth(key, secret) {
  if (typeof btoa === 'function') {
    return btoa(key + ':' + secret);
  }
  return '';
}

const rawGiftProducts = await Promise.all(
  giftProductIds.map(async (id) => {
    try {
      if (!wcUrl || !wcKey || !wcSecret) return null;
      const auth = encodeBasicAuth(wcKey, wcSecret);
      const endpoint = wcUrl.replace(/\/$/, '') + '/wp-json/wc/v3/products/' + id;
      const res = await fetch(endpoint, {
        headers: {
          'Authorization': 'Basic ' + auth,
          'Content-Type': 'application/json'
        }
      });
      if (!res.ok) return null;
      const data = await res.json();

      if (data && data.type === 'variable' && (!data.price || data.price === '') && data.variations && data.variations.length > 0) {
        const varEndpoint = wcUrl.replace(/\/$/, '') + '/wp-json/wc/v3/products/' + id + '/variations/' + data.variations[0];
        const varRes = await fetch(varEndpoint, {
          headers: {
            'Authorization': 'Basic ' + auth,
            'Content-Type': 'application/json'
          }
        });
        if (varRes.ok) {
          const varData = await varRes.json();
          data.regular_price = (varData.regular_price !== undefined && varData.regular_price !== '') ? varData.regular_price : varData.price;
          data.price = varData.price;
          if ((!data.images || data.images.length === 0) && varData.image) {
            data.images = [varData.image];
          }
        }
      }
      return data;
    } catch (e) {
      console.warn('[Gift Fetch Error] Product ' + id + ':', e);
      return null;
    }
  })
);

const giftProducts = giftProductIds.map((id, index) => {
  const p = rawGiftProducts[index];
  if (p && p.name) {
    return {
      id: p.id,
      name: p.name,
      image: (p.images && p.images[0]) ? p.images[0].src : '',
      regular_price: getAccurateRegularPrice(p),
      loaded: true
    };
  }
  return {
    id: id,
    name: (id === 56339) ? 'E.B.belle PVC Zipper Jewelry Packaging Bag Pouch' : 'E.B.belle Velvet Anti-Tarnish Jewelry Keepsake Pouch',
    image: '',
    regular_price: '0.00',
    loaded: false
  };
});
---

<Layout title={`${product.name} - E.B.Belle`}>
  <Header />

  <main class="product-detail-page">
    <div class="product-container">
      <!-- Breadcrumb -->
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <i class="fa-solid fa-chevron-right"></i>
        <a href="/shop">Shop</a>
        <i class="fa-solid fa-chevron-right"></i>
        {categorySlug ? (
          <a href={`/shop?category=${categorySlug}`}>{category}</a>
        ) : (
          <span>{category}</span>
        )}
        <i class="fa-solid fa-chevron-right"></i>
        <span class="breadcrumb-current">{product.name}</span>
      </nav>

      <!-- Product Hero Section -->
      <div class="product-hero">
        <!-- Left: Product Image Gallery -->
        <div class="product-gallery">
          <div class="main-image-slider">
            <div class="slider-container" id="sliderContainer">
              {images.map((img, index) => (
                <div class="slider-item" data-index={index}>
                  <img src={img.src} alt={`${product.name} - View ${index + 1}`}>
                </div>
              ))}
            </div>

            <div class="image-counter">
              <span id="currentImageIndex">1</span>/{images.length}
            </div>

            {images.length > 1 && (
              <>
                <button type="button" class="slider-arrow prev" onclick="prevImage()" aria-label="Previous image">
                  <i class="fa-solid fa-chevron-left"></i>
                </button>
                <button type="button" class="slider-arrow next" onclick="nextImage()" aria-label="Next image">
                  <i class="fa-solid fa-chevron-right"></i>
                </button>
              </>
            )}
          </div>

          <div class="thumbnails">
            {thumbnails.map((img, index) => (
              <div
                class={`thumbnail ${index === 0 ? 'active' : ''}`}
                onclick={`goToSlide(${index})`}
                data-index={index}
              >
                <img src={img.src} alt={`View ${index + 1}`}>
              </div>
            ))}
          </div>
        </div>

        <!-- Right: Product Info -->
        <div class="product-info">
          <!-- Title & Price Header -->
          <div class="product-header">
            <h1 class="product-title">{product.name}</h1>
            <div class="price-row">
              <span class="current-price"><span class="dollar">$</span>{product.price}</span>
              {hasDiscount && (
                <>
                  <span class="original-price">${product.regular_price}</span>
                  <span class="sale-badge">Sale · Save {discountPercent}%</span>
                </>
              )}
            </div>
            <div class="rating-row">
              <i class="fa-solid fa-star star-icon"></i>
              <span class="rating-score">{product.average_rating || '0.0'}</span>
              <span class="rating-count">({product.rating_count || 0} reviews)</span>
            </div>
          </div>

          <!-- Wholesale Pricing Table -->
          <div class="wholesale-table">
            <div class="table-header">
              <div class="header-left">
                <i class="fa-solid fa-tag"></i>
                <span>Wholesale & Volume Pricing</span>
              </div>
              <span class="header-badge">Tiered Discounts</span>
            </div>
            <div class="pricing-grid">
              <div class="price-tier">
                <span class="tier-qty">1 – 9 pcs</span>
                <span class="tier-price">${product.price}</span>
                <span class="tier-label">Retail</span>
              </div>
              <div class="price-tier">
                <span class="tier-qty">10 – 49 pcs</span>
                <span class="tier-price">${(parseFloat(product.price) * 0.79).toFixed(2)}</span>
                <span class="tier-save">Save 21%</span>
              </div>
              <div class="price-tier">
                <span class="tier-qty">50 – 99 pcs</span>
                <span class="tier-price">${(parseFloat(product.price) * 0.62).toFixed(2)}</span>
                <span class="tier-save">Save 38%</span>
              </div>
              <div class="price-tier best">
                <span class="tier-qty">100+ pcs</span>
                <span class="tier-price">${(parseFloat(product.price) * 0.45).toFixed(2)}</span>
                <span class="tier-badge">Best Value</span>
              </div>
            </div>
            <div class="auto-apply">
              <i class="fa-solid fa-circle-check"></i>
              <span>Applied automatically in cart based on order quantity</span>
            </div>
          </div>

          <!-- Product Carousel -->
          <div class="gift-carousel" id="giftCarousel">
            <button type="button" class="carousel-btn prev" id="giftPrevBtn" aria-label="Previous gift">
              <i class="fa-solid fa-chevron-left"></i>
            </button>
            <div class="gift-viewport">
              <div class="gift-track" id="giftTrack">
                {giftProducts.map((gift, idx) => (
                  <div 
                    class={`gift-slide ${idx === 0 ? 'active' : ''}`}
                    data-id={gift.id}
                    data-name={gift.name}
                    data-price={gift.regular_price}
                    data-image={gift.image}
                    data-loaded={gift.loaded ? "true" : "false"}
                  >
                    <div class="gift-content">
                      <div class="gift-image">
                        <img 
                          class="gift-img-el" 
                          src={gift.image || 'https://images.unsplash.com/photo-1584917865442-de89df76afd3?w=200&q=80'} 
                          alt={gift.name} 
                        />
                      </div>
                      <div class="gift-info">
                        <h4 class="gift-title-el" title={gift.name}>{gift.name}</h4>
                        <div class="gift-price-row">
                          <span class="gift-price gift-price-el">${gift.regular_price}</span>
                          <span class="gift-tag">Add-on Item</span>
                        </div>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </div>
            <div class="gift-actions">
              <button type="button" class="btn-add-gift" id="addGiftBtn">ADD TO BAG</button>
              <button type="button" class="carousel-btn next" id="giftNextBtn" aria-label="Next gift">
                <i class="fa-solid fa-chevron-right"></i>
              </button>
            </div>
          </div>

          <!-- Description with Fade & Show More/Less -->
          <div class="desc-expandable-wrapper" id="descWrapper">
            <div class="product-description-content" id="descContent">
              <p class="product-description">
                {stripHtml(product.description || product.short_description || '')}
              </p>
            </div>
            <button type="button" class="btn-toggle-desc" id="btnToggleDesc">Show more</button>
          </div>

          <div class="feature-badges">
            <span class="badge">316L STAINLESS STEEL</span>
            <span class="badge">PVD GOLD PLATING</span>
            <span class="badge">WATERPROOF</span>
            <span class="badge">HYPOALLERGENIC</span>
          </div>

          <!-- Product Variants Selection -->
          {attributes.length > 0 && (
            <div class="variants-section">
              {attributes.map((attr, attrIndex) => {
                const options = attr.options || [];
                const attrName = attr.name || '';
                const attrSlug = attrName.toLowerCase().replace(/\s+/g, '-');

                const hiddenAttributes = ['material', 'weight'];
                if (hiddenAttributes.includes(attrSlug)) {
                  return null;
                }

                const alwaysShowAttributes = ['set', 'style'];
                const mustShow = alwaysShowAttributes.includes(attrSlug);

                if (!mustShow && options.length <= 1) {
                  return null;
                }

                const isFirstAttribute = attrIndex === 0;

                const optionImages = {};
                if (isFirstAttribute && variations.length > 0) {
                  options.forEach((option) => {
                    const matchingVariation = variations.find((v) => {
                      return v.attributes && v.attributes.some((a) =>
                        a.name.toLowerCase().replace(/\s+/g, '-') === attrSlug &&
                        a.option.toLowerCase() === option.toLowerCase()
                      );
                    });

                    if (matchingVariation && matchingVariation.image && matchingVariation.image.src) {
                      optionImages[option] = matchingVariation.image.src;
                    }
                  });
                }

                return (
                  <div class="variant-group">
                    <div class="variant-label">
                      <span class="label-text">{attrName}:</span>
                      <span class="selected-value" id={`selected-${attrSlug}`}>
                        {options.length > 0 ? options[0] : 'Select'}
                      </span>
                    </div>
                    <div class="variant-options">
                      {options.map((option, index) => {
                        const hasImage = isFirstAttribute && optionImages[option];

                        return (
                          <button
                            type="button"
                            class={`variant-option ${index === 0 ? 'active' : ''} ${hasImage ? 'with-image' : ''}`}
                            data-attribute={attrSlug}
                            data-value={option}
                            onclick={`selectVariant('${attrSlug}', '${option}', this)`}
                          >
                            {hasImage && (
                              <span class="option-image">
                                <img src={optionImages[option]} alt={option} loading="lazy" />
                              </span>
                            )}
                            <span class="option-label">{option}</span>
                          </button>
                        );
                      })}
                    </div>
                  </div>
                );
              })}
            </div>
          )}

          {variations.length > 0 && (
            <script is:inline id="variationsData" type="application/json" set:html={JSON.stringify(variations)} />
          )}

          <!-- Quantity & Actions -->
          <div class="actions-section" id="actionsSection">
            <div class="quantity-row">
              <span class="qty-label">Quantity</span>
              <div class="quantity-selector">
                <button type="button" onclick="changeQty(-1)"><i class="fa-solid fa-minus"></i></button>
                <input type="number" id="qtyInput" value="1" min="1" readonly>
                <button type="button" onclick="changeQty(1)"><i class="fa-solid fa-plus"></i></button>
              </div>
            </div>
            <div class="button-group">
              <button type="button" class="btn-add-cart">Add to Cart</button>
              <button type="button" class="btn-buy-now">Buy Now</button>
            </div>
            <button type="button" class="btn-wholesale">Inquire for Wholesale / Customization</button>
          </div>

          <!-- Member Offers -->
          <div class="offers-card">
            <div class="offers-header">
              <div class="header-left">
                <i class="fa-solid fa-ticket"></i>
                <span>Exclusive Member Offers</span>
              </div>
              <span class="header-badge">Limited Time</span>
            </div>
            <div class="offers-grid">
              <div class="offer-item">
                <div class="offer-amount">US$ 130</div>
                <button type="button" class="offer-btn">Claim <i class="fa-solid fa-arrow-right"></i></button>
                <p class="offer-desc">Sign up for membership to claim US$ 130 coupon package</p>
              </div>
              <div class="offer-item">
                <div class="offer-amount">15% OFF</div>
                <button type="button" class="offer-btn">Get Code <i class="fa-solid fa-arrow-right"></i></button>
                <p class="offer-desc">Enjoy introductory discount up to 15% on your order</p>
              </div>
            </div>
          </div>

          <!-- Safe Checkout -->
          <div class="checkout-badges">
            <div class="section-divider">
              <span>Guaranteed Safe Checkout</span>
            </div>
            <div class="payment-methods">
              <div class="payment-badge visa">VISA</div>
              <div class="payment-badge mc">MC</div>
              <div class="payment-badge amex">AMEX</div>
              <div class="payment-badge discover">DISCOVER</div>
              <div class="payment-badge paypal">PayPal</div>
              <div class="payment-badge apple">Apple Pay</div>
            </div>
          </div>

          <!-- Accordions -->
          <div class="accordions">
            <div class="accordion-item">
              <button type="button" class="accordion-header" onclick="toggleAccordion('desc')">
                <span>Description</span>
                <i class="fa-solid fa-chevron-down" id="icon-desc"></i>
              </button>
              <div class="accordion-content active" id="content-desc">
                <div class="accordion-body" set:html={product.description || product.short_description || '<p>No description available.</p>'}>
                </div>
              </div>
            </div>

            <div class="accordion-item">
              <button type="button" class="accordion-header" onclick="toggleAccordion('care')">
                <span>Material & Care</span>
                <i class="fa-solid fa-chevron-down" id="icon-care"></i>
              </button>
              <div class="accordion-content" id="content-care">
                <div class="accordion-body">
                  <p>Crafted with 316L Stainless Steel and plated with 14K Gold using PVD technology. This piece is tarnish-resistant, waterproof, and hypoallergenic.</p>
                  <p>To maintain its shine, gently wipe with a soft cloth after use. While waterproof, we recommend removing before swimming in chlorinated pools or oceans to extend its lifespan.</p>
                </div>
              </div>
            </div>

            <div class="accordion-item">
              <button type="button" class="accordion-header" onclick="toggleAccordion('shipping')">
                <span>Shipping & Returns</span>
                <i class="fa-solid fa-chevron-down" id="icon-shipping"></i>
              </button>
              <div class="accordion-content" id="content-shipping">
                <div class="accordion-body">
                  <p>Enjoy free standard shipping on all orders over $50. Orders are typically processed within 1-2 business days.</p>
                  <p>We accept returns within 30 days of delivery. Items must be in original condition with tags attached. See our full return policy for details.</p>
                </div>
              </div>
            </div>

            <div class="accordion-item">
              <button type="button" class="accordion-header" onclick="toggleAccordion('wholesale')">
                <span>Wholesale & Customization</span>
                <i class="fa-solid fa-chevron-down" id="icon-wholesale"></i>
              </button>
              <div class="accordion-content" id="content-wholesale">
                <div class="accordion-body">
                  <p><strong>Minimum Order Quantity:</strong> 50 pieces per design</p>
                  <p><strong>Customization Options:</strong> Logo engraving, custom plating (18k Gold, Rose Gold, Rhodium), and bespoke packaging.</p>
                  <p><strong>Lead Time:</strong> 15-25 business days depending on order volume.</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- =========================================================
           Related Products Section (桌面端 5 列 / 移动端 1 列 / 每次滑动 1 个)
           ========================================================= -->
      {relatedProducts.length > 0 && (
        <section class="related-products">
          <h2 class="section-title">You May Also Like</h2>

          <div class="related-slider-container">
            <button type="button" class="slider-nav prev-btn" id="relatedPrevBtn" aria-label="Previous products">
              <i class="fa-solid fa-chevron-left"></i>
            </button>

            <div class="related-slider" id="relatedSlider">
              {relatedProducts.map((relatedProduct) => {
                const relatedImage = (relatedProduct.images && relatedProduct.images[0]) ? relatedProduct.images[0].src : 'https://images.unsplash.com/photo-1515562141207-7a88fb7ce338?w=400&q=80';
                const regularPrice = (relatedProduct.regular_price && relatedProduct.regular_price !== '') ? parseFloat(relatedProduct.regular_price) : 0;
                const salePrice = (relatedProduct.price && relatedProduct.price !== '') ? parseFloat(relatedProduct.price) : 0;
                const relatedHasDiscount = Boolean(regularPrice > 0 && salePrice > 0 && regularPrice > salePrice);
                const relatedDiscountPercent = relatedHasDiscount ? Math.round(((regularPrice - salePrice) / regularPrice) * 100) : 0;

                return (
                  <a href={`/product/${relatedProduct.slug}`} class="product-card">
                    <div class="product-image">
                      {relatedHasDiscount && relatedDiscountPercent > 0 && (
                        <span class="discount-badge">-{relatedDiscountPercent}%</span>
                      )}
                      <img src={relatedImage} alt={relatedProduct.name} loading="lazy" />
                    </div>
                    <div class="product-details">
                      <h3>{relatedProduct.name}</h3>
                      <div class="prices">
                        <span class="price">${salePrice.toFixed(2)}</span>
                        {relatedHasDiscount && (
                          <span class="original">${regularPrice.toFixed(2)}</span>
                        )}
                      </div>
                    </div>
                  </a>
                );
              })}
            </div>

            <button type="button" class="slider-nav next-btn" id="relatedNextBtn" aria-label="Next products">
              <i class="fa-solid fa-chevron-right"></i>
            </button>
          </div>
        </section>
      )}

      <!-- Customer Reviews Section -->
      <section class="customer-reviews">
        <div class="reviews-header">
          <h2 class="section-title">Customer Reviews</h2>
          <div class="rating-summary">
            <div class="stars">
              <i class="fa-solid fa-star"></i>
              <i class="fa-solid fa-star"></i>
              <i class="fa-solid fa-star"></i>
              <i class="fa-solid fa-star"></i>
              <i class="fa-solid fa-star-half-stroke"></i>
            </div>
            <span class="rating-text">4.8 (124 Reviews)</span>
          </div>
        </div>

        <div class="reviews-grid">
          <div class="review-card">
            <div class="review-header">
              <div class="reviewer-info">
                <span class="reviewer-name">Sarah M.</span>
                <span class="verified-badge">
                  <i class="fa-solid fa-circle-check"></i>
                  Verified Buyer
                </span>
              </div>
              <div class="review-stars">
                <i class="fa-solid fa-star"></i>
                <i class="fa-solid fa-star"></i>
                <i class="fa-solid fa-star"></i>
                <i class="fa-solid fa-star"></i>
                <i class="fa-solid fa-star"></i>
              </div>
            </div>
            <h4 class="review-title">Perfect everyday piece</h4>
            <p class="review-text">I've worn this necklace every day since I got it. It hasn't tarnished at all in the shower, and it looks so elegant layered with my other gold chains. Highly recommend!</p>
          </div>

          <div class="review-card">
            <div class="review-header">
              <div class="reviewer-info">
                <span class="reviewer-name">Emily R.</span>
                <span class="verified-badge">
                  <i class="fa-solid fa-circle-check"></i>
                  Verified Buyer
                </span>
              </div>
              <div class="review-stars">
                <i class="fa-solid fa-star"></i>
                <i class="fa-solid fa-star"></i>
                <i class="fa-solid fa-star"></i>
                <i class="fa-solid fa-star"></i>
                <i class="fa-regular fa-star"></i>
              </div>
            </div>
            <h4 class="review-title">Beautiful but delicate</h4>
            <p class="review-text">The pearl is lovely and has a nice luster. The chain is very thin, which gives it that dainty look, but you have to be a bit careful not to snag it. Overall, a great purchase for the price.</p>
          </div>
        </div>

        <div class="reviews-footer">
          <button type="button" class="btn-read-all">Read All Reviews</button>
        </div>
      </section>
    </div>

    <!-- 移动端底部悬浮购买栏 (48px高清缩略图 + 放大镜角标 + 动态规格) -->
    <div class="mobile-sticky-action-bar">
      <!-- 左侧大变体预览图 (48x48，点击唤起 Lightbox) -->
      <div class="sticky-thumb-wrap" onclick="openMobileLightbox()" aria-label="Zoom image">
        <img id="stickyThumbImg" src={mainImage.src} alt={product.name} />
        <!-- 放大微标识角标 -->
        <span class="zoom-indicator">
          <i class="fa-solid fa-magnifying-glass-plus"></i>
        </span>
      </div>

      <!-- 价格与动态规格文字 -->
      <div class="sticky-price-block">
        <div class="sticky-prices">
          <span class="sticky-price" id="stickyPriceVal">${product.price}</span>
          {hasDiscount && <span class="sticky-original">${product.regular_price}</span>}
        </div>
        <span class="sticky-variant-label" id="stickyVariantLabel">Standard</span>
      </div>

      <!-- 购买按钮组 -->
      <div class="sticky-btn-group">
        <button type="button" class="sticky-btn-cart" onclick="document.querySelector('.btn-add-cart')?.click()">Add to Cart</button>
        <button type="button" class="sticky-btn-buy" onclick="document.querySelector('.btn-buy-now')?.click()">Buy Now</button>
      </div>
    </div>

    <!-- 移动端专属高清大图 Lightbox 遮罩层 (桌面端隐藏) -->
    <div id="mobileLightboxModal" class="mobile-lightbox" onclick="closeMobileLightbox(event)">
      <button type="button" class="lightbox-close" onclick="closeMobileLightbox()" aria-label="Close preview">
        <i class="fa-solid fa-xmark"></i>
      </button>
      <div class="lightbox-content">
        <img id="lightboxImg" src={mainImage.src} alt="Product Full View" />
        <span class="lightbox-caption">Tap anywhere to close</span>
      </div>
    </div>
  </main>

  <Footer />
  <CartDrawer />
</Layout>

