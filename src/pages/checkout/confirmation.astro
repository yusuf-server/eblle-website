---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Order Confirmation - E.B.Belle">
  <!-- Simplified Header -->
  <header class="checkout-header">
    <div class="header-container">
      <a href="/" class="header-logo">
        <svg width="24" height="24" viewBox="0 0 48 48" fill="none">
          <path clip-rule="evenodd" d="M24 4H6V17.3333V30.6667H24V44H42V30.6667V17.3333H24V4Z" fill="currentColor" fill-rule="evenodd"></path>
        </svg>
        <span>E.B.Belle</span>
      </a>
    </div>
  </header>

  <main class="confirmation-page">
    <div class="confirmation-container">
      <!-- Success Icon -->
      <div class="success-circle">
        <i class="fa-solid fa-check"></i>
      </div>

      <!-- Main Content -->
      <h1>Order Confirmed!</h1>
      <p class="subtitle">Thank you for your purchase</p>

      <div class="order-number">
        <span class="label">Order Number:</span>
        <span class="number">#EB-2024-001234</span>
      </div>

      <p class="confirmation-email">
        We've sent a confirmation email to <strong id="customerEmail">john.doe@email.com</strong>
      </p>

      <!-- Order Details Card -->
      <div class="order-card">
        <h2>Order Details</h2>

        <div class="order-items">
          <div class="order-item">
            <img src="https://images.unsplash.com/photo-1515562141207-7a88fb7ce338?w=200&q=80" alt="">
            <div class="item-info">
              <h3>Dainty 14K Gold Pearl Pendant Necklace</h3>
              <p>Qty: 1 × $15.90</p>
            </div>
            <span class="price">$15.90</span>
          </div>
          <div class="order-item">
            <img src="https://images.unsplash.com/photo-1611591475806-03c09b0b4b2c?w=200&q=80" alt="">
            <div class="item-info">
              <h3>Diamond Accent Gold Hoops</h3>
              <p>Qty: 1 × $32.00</p>
            </div>
            <span class="price">$32.00</span>
          </div>
        </div>

        <div class="order-totals">
          <div class="total-row">
            <span>Subtotal</span>
            <span>$47.90</span>
          </div>
          <div class="total-row">
            <span>Shipping</span>
            <span>$5.00</span>
          </div>
          <div class="total-row">
            <span>Tax</span>
            <span>$4.23</span>
          </div>
          <div class="total-row grand">
            <span>Total Paid</span>
            <span>$57.13</span>
          </div>
        </div>
      </div>

      <!-- Info Grid -->
      <div class="info-grid">
        <div class="info-box">
          <div class="info-header">
            <i class="fa-solid fa-truck"></i>
            <h3>Shipping Address</h3>
          </div>
          <div class="info-body" id="shippingAddress">
            <p>John Doe</p>
            <p>123 Main Street, Apt 4B</p>
            <p>New York, NY 10001</p>
            <p>United States</p>
          </div>
        </div>

        <div class="info-box">
          <div class="info-header">
            <i class="fa-solid fa-credit-card"></i>
            <h3>Payment Method</h3>
          </div>
          <div class="info-body">
            <p>Visa ending in 3456</p>
            <p class="success-text">
              <i class="fa-solid fa-circle-check"></i>
              Payment Successful
            </p>
          </div>
        </div>
      </div>

      <!-- Delivery Info -->
      <div class="delivery-box">
        <div class="delivery-icon">
          <i class="fa-solid fa-box"></i>
        </div>
        <div class="delivery-content">
          <h3>Estimated Delivery</h3>
          <p class="delivery-date">December 20-23, 2024</p>
          <p class="delivery-note">You'll receive tracking information via email once your order ships.</p>
        </div>
      </div>

      <!-- Actions -->
      <div class="action-buttons">
        <a href="/" class="btn-primary">Continue Shopping</a>
        <a href="#" class="btn-secondary">Track Order</a>
      </div>

      <!-- Support -->
      <p class="support-text">
        Need help? Contact us at <a href="mailto:support@ebbelle.com">support@ebbelle.com</a> or call <a href="tel:+18005551234">+1 (800) 555-1234</a>
      </p>
    </div>
  </main>
</Layout>

<style>
  /* Header */
  .checkout-header {
    border-bottom: 1px solid #c4c7c7;
    background: #fcf9f3;
  }
  .header-container {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 40px;
    height: 72px;
    display: flex;
    align-items: center;
  }
  .header-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: #0e0f0f;
  }
  .header-logo span {
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.5px;
  }

  /* Main */
  .confirmation-page {
    background: #fcf9f3;
    min-height: calc(100vh - 72px);
    padding: 80px 24px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .confirmation-container {
    max-width: 720px;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  /* Success Icon */
  .success-circle {
    width: 80px;
    height: 80px;
    background: #16a34a;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 32px;
    box-shadow: 0 8px 24px rgba(22, 163, 74, 0.3);
    animation: scaleIn 0.5s ease-out;
  }
  @keyframes scaleIn {
    from {
      transform: scale(0);
      opacity: 0;
    }
    to {
      transform: scale(1);
      opacity: 1;
    }
  }
  .success-circle i {
    font-size: 40px;
    color: #fff;
  }

  h1 {
    font-family: 'Bodoni Moda', serif;
    font-size: 36px;
    font-weight: 500;
    color: #0e0f0f;
    margin-bottom: 8px;
  }
  .subtitle {
    font-size: 18px;
    color: #747878;
    margin-bottom: 32px;
  }

  .order-number {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 24px;
    background: #f6f3ed;
    border: 1px solid #ddd8ce;
    border-radius: 4px;
    margin-bottom: 24px;
  }
  .order-number .label {
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: #747878;
  }
  .order-number .number {
    font-size: 18px;
    font-weight: 700;
    color: #0e0f0f;
    font-family: 'Courier New', monospace;
  }

  .confirmation-email {
    font-size: 15px;
    color: #747878;
    line-height: 1.6;
    margin-bottom: 48px;
  }
  .confirmation-email strong {
    color: #1c1c18;
  }

  /* Order Card */
  .order-card {
    width: 100%;
    background: #fff;
    border: 1px solid #ddd8ce;
    border-radius: 4px;
    padding: 32px;
    margin-bottom: 32px;
    text-align: left;
  }
  .order-card h2 {
    font-family: 'Bodoni Moda', serif;
    font-size: 20px;
    font-weight: 500;
    color: #0e0f0f;
    margin-bottom: 24px;
    padding-bottom: 16px;
    border-bottom: 1px solid #ddd8ce;
  }

  .order-items {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding-bottom: 24px;
    margin-bottom: 24px;
    border-bottom: 1px solid #ddd8ce;
  }
  .order-item {
    display: flex;
    gap: 16px;
    align-items: center;
  }
  .order-item img {
    width: 64px;
    height: 64px;
    border: 1px solid #ddd8ce;
    border-radius: 4px;
    object-fit: cover;
  }
  .item-info {
    flex: 1;
  }
  .item-info h3 {
    font-size: 15px;
    font-weight: 500;
    color: #1c1c18;
    margin-bottom: 4px;
  }
  .item-info p {
    font-size: 13px;
    color: #747878;
  }
  .order-item .price {
    font-size: 16px;
    font-weight: 600;
    color: #0e0f0f;
  }

  .order-totals {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .total-row {
    display: flex;
    justify-content: space-between;
    font-size: 15px;
    color: #747878;
  }
  .total-row.grand {
    font-size: 18px;
    font-weight: 700;
    color: #0e0f0f;
    padding-top: 12px;
    margin-top: 12px;
    border-top: 2px solid #ddd8ce;
  }

  /* Info Grid */
  .info-grid {
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 32px;
  }
  .info-box {
    background: #fff;
    border: 1px solid #ddd8ce;
    border-radius: 4px;
    padding: 24px;
    text-align: left;
  }
  .info-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
    padding-bottom: 12px;
    border-bottom: 1px solid #f6f3ed;
  }
  .info-header i {
    font-size: 20px;
    color: #725b29;
  }
  .info-header h3 {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: #0e0f0f;
  }
  .info-body {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .info-body p {
    font-size: 14px;
    color: #747878;
    line-height: 1.5;
  }
  .success-text {
    display: flex;
    align-items: center;
    gap: 6px;
    color: #16a34a !important;
    font-weight: 600 !important;
    margin-top: 8px;
  }
  .success-text i {
    font-size: 16px;
  }

  /* Delivery Box */
  .delivery-box {
    width: 100%;
    display: flex;
    gap: 20px;
    padding: 24px;
    background: #f6f3ed;
    border: 1px solid #ddd8ce;
    border-radius: 4px;
    margin-bottom: 32px;
    text-align: left;
  }
  .delivery-icon {
    width: 48px;
    height: 48px;
    background: #fff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .delivery-icon i {
    font-size: 24px;
    color: #725b29;
  }
  .delivery-content h3 {
    font-size: 16px;
    font-weight: 700;
    color: #0e0f0f;
    margin-bottom: 8px;
  }
  .delivery-date {
    font-size: 18px;
    font-weight: 600;
    color: #725b29;
    margin-bottom: 8px;
  }
  .delivery-note {
    font-size: 13px;
    color: #747878;
    line-height: 1.5;
  }

  /* Actions */
  .action-buttons {
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-bottom: 32px;
  }
  .btn-primary,
  .btn-secondary {
    padding: 16px 32px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    text-align: center;
    text-decoration: none;
    border-radius: 4px;
    transition: all 0.2s;
  }
  .btn-primary {
    background: #0e0f0f;
    color: #fff;
    border: 1px solid #0e0f0f;
  }
  .btn-primary:hover {
    background: #242424;
  }
  .btn-secondary {
    background: transparent;
    color: #0e0f0f;
    border: 1px solid #0e0f0f;
  }
  .btn-secondary:hover {
    background: #f6f3ed;
  }

  /* Support */
  .support-text {
    font-size: 13px;
    color: #747878;
    line-height: 1.6;
  }
  .support-text a {
    color: #725b29;
    font-weight: 600;
    text-decoration: underline;
  }
  .support-text a:hover {
    color: #0e0f0f;
  }

  @media (max-width: 768px) {
    .info-grid,
    .action-buttons {
      grid-template-columns: 1fr;
    }
    h1 {
      font-size: 28px;
    }
  }
</style>

<script>
  // Load shipping info
  const shippingInfo = sessionStorage.getItem('shippingInfo');
  if (shippingInfo) {
    const data = JSON.parse(shippingInfo);

    // Update email
    const emailEl = document.getElementById('customerEmail');
    if (emailEl) {
      emailEl.textContent = data.email;
    }

    // Update shipping address
    const addressDiv = document.getElementById('shippingAddress');
    if (addressDiv) {
      addressDiv.innerHTML = `
        <p>${data.firstName} ${data.lastName}</p>
        <p>${data.address}${data.apartment ? ', ' + data.apartment : ''}</p>
        <p>${data.city}, ${data.state} ${data.zip}</p>
        <p>${data.country}</p>
      `;
    }
  }

  // Clear session storage after 3 seconds
  setTimeout(() => {
    sessionStorage.removeItem('shippingInfo');
  }, 3000);
</script>
