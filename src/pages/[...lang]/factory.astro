      padding: 0 16px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      width: 100%;
      box-sizing: border-box;
    }
    .exhibition-fullbleed-strip::-webkit-scrollbar {
      display: none;
    }
    .exhibition-pure-img-box {
      flex: 0 0 75%;
      height: 200px;
      border-radius: 6px;
      scroll-snap-align: start;
    }

    /* Craftsmanship */
    .craftsmanship-fullwidth-section {
      padding: 40px 0;
    }
    .steps-flow-wide {
      gap: 24px;
      margin-top: 24px;
    }
    .step-row-wide,
    .step-row-wide.row-reversed {
      flex-direction: column;
      gap: 16px;
      padding: 16px;
    }
    .craft-img-box {
      height: 220px;
    }
    .step-col-text {
      padding: 0;
    }
    .step-title {
      font-size: 22px;
      margin-bottom: 12px;
    }
    .step-lead-paragraph,
    .step-bullet-line {
      font-size: 13.5px;
      line-height: 1.6;
    }
    .step-text-body,
    .step-bullet-group {
      gap: 12px;
    }

    /* 移动端入场位移幅度收紧，避免横向抖动撑破 */
    .reveal-from-left {
      transform: translateY(20px);
    }
    .reveal-from-right {
      transform: translateY(20px);
    }
    .scroll-reveal-wrap.is-visible .reveal-from-left,
    .scroll-reveal-wrap.is-visible .reveal-from-right {
      transform: translateY(0);
    }

    /* FAQ */
    .factory-faq-section {
      padding: 36px 0;
    }
    .faq-acc-header {
      font-size: 13px;
      padding: 14px 0;
    }

    /* CTA */
    .atelier-cta-section {
      padding: 40px 0;
    }
    .cta-inner-box {
      padding: 24px 16px;
    }
    .cta-inner-box h2 {
      font-size: 20px;
    }
    .btn-primary, .btn-secondary {
      width: 100%;
      text-align: center;
    }
  }
</style>

<script>
  // 1. 数字递增滚动动画 (Counter Animation)
  function initCounters() {
    const counters = document.querySelectorAll('.counter');
    const speed = 1200;

    const observer = new IntersectionObserver((entries, obs) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const counterEl = entry.target as HTMLElement;
          const target = +counterEl.getAttribute('data-target')!;
          let startTime: number | null = null;

          function updateCounter(currentTime: number) {
            if (!startTime) startTime = currentTime;
            const progress = Math.min((currentTime - startTime) / speed, 1);
            const easeProgress = 1 - Math.pow(1 - progress, 3);
            counterEl.textContent = Math.floor(easeProgress * target).toLocaleString();

            if (progress < 1) {
              requestAnimationFrame(updateCounter);
            } else {
              counterEl.textContent = target.toLocaleString();
            }
          }

          requestAnimationFrame(updateCounter);
          obs.unobserve(counterEl);
        }
      });
    }, { threshold: 0.2 });

    counters.forEach(c => observer.observe(c));
  }

  // 2. 工艺步骤图文从两侧进入视口动画 (Scroll Reveal)
  function initScrollReveal() {
    const revealWraps = document.querySelectorAll('.scroll-reveal-wrap');

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
        } else {
          entry.target.classList.remove('is-visible');
        }
      });
    }, {
      threshold: 0.15,
      rootMargin: '0px 0px -30px 0px'
    });

    revealWraps.forEach(w => observer.observe(w));
  }

  // 3. Lightbox 弹窗查看证书与检测报告
  function initLightbox() {
    const modal = document.getElementById('lightboxModal');
    const closeBtn = document.getElementById('lightboxClose');
    const imgEl = document.getElementById('lightboxImg') as HTMLImageElement;
    const captionEl = document.getElementById('lightboxCaption');
    const triggers = document.querySelectorAll('.lightbox-trigger');

    if (!modal || !closeBtn || !imgEl || !captionEl) return;

    function openModal(src: string, title: string) {
      imgEl.src = src;
      imgEl.alt = title;
      captionEl.textContent = title;
      modal.classList.add('active');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      modal.classList.remove('active');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      setTimeout(() => {
        imgEl.src = '';
      }, 200);
    }

    triggers.forEach(t => {
      t.addEventListener('click', () => {
        const src = t.getAttribute('data-src') || '';
        const title = t.getAttribute('data-title') || '';
        if (src) openModal(src, title);
      });
    });

    closeBtn.addEventListener('click', closeModal);
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.classList.contains('active')) {
        closeModal();
      }
    });
  }

  // 4. FAQ 手风琴展开与收起
  function initFAQ() {
    const items = document.querySelectorAll('.faq-acc-item');
    items.forEach(item => {
      const header = item.querySelector('.faq-acc-header');
      const content = item.querySelector('.faq-acc-content') as HTMLElement;
      if (!header || !content) return;

      header.addEventListener('click', () => {
        const isOpen = item.classList.contains('active');

        // 关闭其他
        items.forEach(other => {
          if (other !== item && other.classList.contains('active')) {
            other.classList.remove('active');
            const otherContent = other.querySelector('.faq-acc-content') as HTMLElement;
            if (otherContent) otherContent.style.maxHeight = '0';
          }
        });

        if (isOpen) {
          item.classList.remove('active');
          content.style.maxHeight = '0';
        } else {
          item.classList.add('active');
          content.style.maxHeight = content.scrollHeight + 'px';
        }
      });
    });
  }

  // DOM 就绪后挂载
  document.addEventListener('DOMContentLoaded', () => {
    initCounters();
    initScrollReveal();
    initLightbox();
    initFAQ();
  });
</script>