---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CartDrawer from '../../components/CartDrawer.astro';
import { SUPPORTED_LOCALES, type SupportedLocale } from '../../lib/i18n/utils';
import { t } from '../../lib/i18n/translations';
import { translate } from '../../lib/i18n/translator';
import { getCacheFromContext } from '../../lib/i18n/cache';

// 获取语言参数
const lang = Astro.params.lang as SupportedLocale | undefined;
const currentLocale: SupportedLocale = lang && SUPPORTED_LOCALES.includes(lang as SupportedLocale)
  ? (lang as SupportedLocale)
  : 'en';

// 获取缓存和上下文
const cache = getCacheFromContext(Astro.locals);
const translateConfig = {
  engine: 'cloudflare-ai' as const,
  cache,
  cachePrefix: 'factory'
};
const context = {
  AI: Astro.locals.AI
};

// 翻译辅助函数
async function tr(text: string): Promise<string> {
  if (currentLocale === 'en' || !text) return text;
  return await translate(text, currentLocale, translateConfig, context);
}

// 批量翻译 craftSteps
async function translateCraftSteps(steps: any[]): Promise<any[]> {
  if (currentLocale === 'en') return steps;

  const translatedSteps = [];
  for (const step of steps) {
    const translatedStep = {
      ...step,
      title: await tr(step.title),
      lead: step.lead ? await tr(step.lead) : undefined,
      secondaryLead: step.secondaryLead ? await tr(step.secondaryLead) : undefined,
      points: await Promise.all(
        (step.points || []).map(async (point: any) => ({
          label: await tr(point.label),
          text: await tr(point.text)
        }))
      )
    };
    translatedSteps.push(translatedStep);
  }
  return translatedSteps;
}

// 1. 统计数据
const stats = [
  { target: 4000, suffix: ' m²', label: await tr('Floor Space') },
  { target: 88, label: await tr('Employees') },
  { target: 80, prefix: '$', suffix: ' M', label: await tr('Annual Export Revenue') },
  { target: 70, suffix: '%', label: await tr('North America Market') }
];

// 2. 证书数据（固定展示）
const certificates = [
  { title: await tr('ISO 9001 Quality System'), image: 'https://ebbellejewelry.com/wp-content/uploads/2026/05/%E4%BC%81%E4%B8%9A%E5%BE%AE%E4%BF%A1%E6%88%AA%E5%9B%BE_17774417906666.webp' },
  { title: await tr('SGS Environmental Certificate'), image: 'https://ebbellejewelry.com/wp-content/uploads/2026/05/%E4%BC%81%E4%B8%9A%E5%BE%AE%E4%BF%A1%E6%88%AA%E5%9B%BE_17774418086050.webp' },
  { title: await tr('Sedex SMETA Compliance'), image: 'https://ebbellejewelry.com/wp-content/uploads/2026/05/%E4%BC%81%E4%B8%9A%E5%BE%AE%E4%BF%A1%E6%88%AA%E5%9B%BE_17774418164822.webp' },
  { title: await tr('Business Social Compliance'), image: 'https://ebbellejewelry.com/wp-content/uploads/2026/05/%E4%BC%81%E4%B8%9A%E5%BE%AE%E4%BF%A1%E6%88%AA%E5%9B%BE_17774418308964.webp' },
  { title: await tr('RJC Code of Practices'), image: 'https://ebbellejewelry.com/wp-content/uploads/2026/05/%E4%BC%81%E4%B8%9A%E5%BE%AE%E4%BF%A1%E6%88%AA%E5%9B%BE_17774418381688.webp' },
  { title: await tr('Conflict-Free Minerals'), image: 'https://ebbellejewelry.com/wp-content/uploads/2026/05/%E4%BC%81%E4%B8%9A%E5%BE%AE%E4%BF%A1%E6%88%AA%E5%9B%BE_17774418474420.webp' }
];

// 3. REACH 报告数据（无缝头尾相连滚动）
const reachReports = [
  { title: await tr('Nickel Release Test Pass'), image: 'https://ebbellejewelry.com/wp-content/uploads/2026/05/%E4%BC%81%E4%B8%9A%E5%BE%AE%E4%BF%A1%E6%88%AA%E5%9B%BE_17774534625267.webp' },
  { title: await tr('Lead Content Detection Pass'), image: 'https://ebbellejewelry.com/wp-content/uploads/2026/05/%E4%BC%81%E4%B8%9A%E5%BE%AE%E4%BF%A1%E6%88%AA%E5%9B%BE_17774534744118.webp' },
  { title: await tr('Cadmium Total Assay Pass'), image: 'https://ebbellejewelry.com/wp-content/uploads/2026/05/%E4%BC%81%E4%B8%9A%E5%BE%AE%E4%BF%A1%E6%88%AA%E5%9B%BE_17774534814137.webp' },
  { title: await tr('Phthalates Screening'), image: 'https://ebbellejewelry.com/wp-content/uploads/2026/05/%E4%BC%81%E4%B8%9A%E5%BE%AE%E4%BF%A1%E6%88%AA%E5%9B%BE_17774534881435.webp' },
  { title: await tr('PVD Durability Stress Test'), image: 'https://ebbellejewelry.com/wp-content/uploads/2026/05/%E4%BC%81%E4%B8%9A%E5%BE%AE%E4%BF%A1%E6%88%AA%E5%9B%BE_17774534942647.webp' },
];

// 4. 展会 5 张图（全屏纯图无文字展示）
const exhibitionImages = [
  'https://ebbellejewelry.com/wp-content/uploads/2026/07/beauty_1772944925060-scaled.webp',
  'https://ebbellejewelry.com/wp-content/uploads/2026/07/beauty_1772864607113-scaled.webp',
  'https://ebbellejewelry.com/wp-content/uploads/2026/07/beauty_1772862229285-scaled.webp',
  'https://ebbellejewelry.com/wp-content/uploads/2026/07/beauty_1772790933534-scaled.webp',
  'https://ebbellejewelry.com/wp-content/uploads/2026/07/beauty_1772789410329-scaled.webp'
];

// 5. 工艺流程步骤（按照截图 1~9 顺序与文本排版精准更新）
const craftSteps = [
  {
    step: '01',
    title: 'Our Craftsmanship',
    lead: 'We maintain a dedicated procurement team that can quickly locate a wide variety of jewelry materials — including natural gemstones, lab-grown stones, freshwater pearls, cords, and metal components.',
    secondaryLead: 'This means you have the freedom to bring almost any design idea to life. No need to worry about where to find specific materials. We’ll handle the search, so you can focus on being creative.',
    points: [],
    image: 'https://ebbellejewelry.com/wp-content/uploads/2026/05/Materials-Sourcing-scaled.webp'
  },
  {
    step: '02',
    title: 'Design & Digital Engineering',
    lead: 'Every custom order starts as a concept. Our goal is to turn that idea into a manufacturable blueprint.',
    points: [
      {
        label: '3D Modeling & Technical Detailing',
        text: 'Our CAD engineers use specialized software to build an exact 3D model of your jewelry. We define every dimension: inner diameter, thickness, clasp type, and surface texture. This digital file serves as the complete technical specification for the entire production.'
      }
    ],
    image: 'https://ebbellejewelry.com/wp-content/uploads/2026/05/Design-Digital-Engineering-scaled.webp'
  },
  {
    step: '03',
    title: 'Prototype & Mold Creation',
    lead: 'Once the 3D model is approved, we create a physical prototype. We use a high-resolution 3D printer to produce a wax pattern. For repeat orders, we create a durable silicone or metal mold from the wax master. This mold ensures every future cast piece is identical to the prototype.',
    points: [],
    image: 'https://ebbellejewelry.com/wp-content/uploads/2026/05/Prototype-Mold-Creation.webp'
  },
  {
    step: '04',
    title: 'Lost-Wax Casting — The Core Process',
    lead: 'This centuries-old method allows us to mass-produce complex metal shapes with incredible accuracy.',
    points: [
      {
        label: 'Wax Tree Assembly',
        text: 'Multiple wax patterns are attached to a central wax rod, forming a “wax tree” for efficient batch casting.'
      },
      {
        label: 'Investment Coating',
        text: 'The wax tree is dipped into ceramic slurry and sand, creating a heat-resistant shell.'
      },
      {
        label: 'Burnout & Dewaxing',
        text: 'The shell is placed in a kiln. The wax melts and flows out, leaving a perfect hollow cavity.'
      },
      {
        label: 'Metal Pouring',
        text: 'Molten metal is poured into the hot cavity. After cooling, the ceramic shell is broken away, revealing a cast metal tree.'
      }
    ],
    image: 'https://ebbellejewelry.com/wp-content/uploads/2026/05/Lost-Wax-Casting-%E2%80%94-The-Core-Process-scaled.webp'
  },
  {
    step: '05',
    title: 'Raw Processing & Initial Shaping',
    points: [
      {
        label: 'De-spruing & Cutting',
        text: 'Workers snip each rough piece from the metal tree, removing “sprues.”'
      },
      {
        label: 'Filing & Smoothing',
        text: 'Artisans use hand files and rotary tools to remove sprues, flatten surfaces, and correct minor issues.'
      },
      {
        label: 'Rough Sanding & Grinding',
        text: 'Industrial sanders remove casting textures, creating a smooth foundation for high-gloss finishing.'
      }
    ],
    image: 'https://ebbellejewelry.com/wp-content/uploads/2026/05/Raw-Processing-Initial-Shaping-scaled.webp'
  },
  {
    step: '06',
    title: 'Assembly & Joining',
    points: [
      {
        label: 'Laser & Hand Soldering',
        text: 'Laser welding for delicate parts like earring posts; hand soldering for stronger joins like clasps and hinges.'
      },
      {
        label: 'Component Fitting',
        text: 'Technicians manually assemble moving parts — securing clasps, adjusting safety catches, and installing jump rings.'
      }
    ],
    image: 'https://ebbellejewelry.com/wp-content/uploads/2026/05/Assembly-Joining.webp'
  },
  {
    step: '07',
    title: 'Surface Finishing & Coloration',
    points: [
      {
        label: 'High-Polishing',
        text: 'Automated and hand polishing for mirror finish or matte texture.'
      },
      {
        label: 'Electroplating',
        text: 'Bonds a thin layer of 18K gold, silver, or rhodium to enhance color and prevent tarnish.'
      },
      {
        label: 'Color Filling (Enamel & Epoxy)',
        text: 'Colored resin injected into recessed areas, then baked for a durable, glossy finish.'
      }
    ],
    image: 'https://ebbellejewelry.com/wp-content/uploads/2026/05/Surface-Finishing-Coloration.webp'
  },
  {
    step: '08',
    title: 'Stone Setting & Final Assembly',
    points: [
      {
        label: 'Stone Mounting',
        text: 'Precision setting of CZ, crystals, or synthetic gems using Prong, Bezel, or Micro-Pavé techniques.'
      },
      {
        label: 'Ring Sizing & Calibration',
        text: 'Every ring is measured against standard US sizes; pieces off by 0.5mm are rejected.'
      },
      {
        label: 'Chain & Component Assembly',
        text: 'Final hand assembly — attaching pendants to chains, clasps to necklaces, and assembling multi-part earrings.'
      }
    ],
    image: 'https://ebbellejewelry.com/wp-content/uploads/2026/05/6cec4830-c86e-4777-bb45-9baef2ac897a.webp'
  },
  {
    step: '09',
    title: 'Cleaning, Inspection & Packaging',
    points: [
      {
        label: 'Ultrasonic Cleaning',
        text: 'High-frequency sound waves remove polishing compound, oil, and dust.'
      },
      {
        label: 'Multi-Point QC',
        text: 'Every piece is inspected for plating consistency, stone security, solder strength, and symmetry. Defective pieces are rejected.'
      },
      {
        label: 'Sorting & Packaging',
        text: 'Approved pieces are sorted by SKU and packed according to your requirements — velvet pouches, custom boxes, or bulk orders.'
      }
    ],
    image: 'https://ebbellejewelry.com/wp-content/uploads/2026/05/Cleaning-Inspection-Packaging-scaled.webp'
  }
];

// 翻译工艺流程步骤
const translatedCraftSteps = await translateCraftSteps(craftSteps);

// 6. 常见问题
const faqsRaw = [
  {
    q: `HOW’S YOUR PRICE AND QUALITY?`,
    a: `Our price is mid-range, but our quality is top-notch. Many regular customers sell our products really well.`
  },
  {
    q: `WHAT MATERIALS AND SAFETY STANDARDS DO YOU FOLLOW?`,
    a: `We use 316L stainless steel with 18K gold PVD plating. It’s waterproof, tarnish-free, and hypoallergenic. All products meet EU REACH and US CA65 safety standards.`
  },
  {
    q: `WHAT’S YOUR MOQ FOR CUSTOM ORDERS?`,
    a: `Full custom design: 100 pieces. Just changing the color: 50 pieces. We also offer low MOQ based on our existing molds. We can add logos, do laser engraving, change colors, or add charms for your DIY ideas.`
  },
  {
    q: `HOW FAST IS SHIPPING AND DELIVERY?`,
    a: `Dispatch: Most items are ready to ship within 24 hours. Delivery: Usually takes 5 to 25 days, depending on the shipping method you choose.`
  },
  {
    q: `WHAT IF SOME ITEMS ARE OUT OF STOCK?`,
    a: `We can: Ship what’s ready first, Refund the out-of-stock items, or Send them together with your next order.`
  },
  {
    q: `WHAT’S YOUR MONTHLY PRODUCTION CAPACITY?`,
    a: `We produce 500,000 pieces of stainless steel jewelry per month. That means we can handle bulk orders and keep up with peak seasons.`
  },
  {
    q: `WHAT PAYMENT METHODS DO YOU ACCEPT FOR LARGE ORDERS?`,
    a: `For single orders under $2,000, full payment is required. You can pay via TT, credit card, Western Union, or other convenient methods. For orders over $2,000, we require a 50% deposit, with the remaining 50% due before shipment. Additionally, for orders over $1,000, we offer OA 60 days (Open Account with 60-day payment terms).` 
  }
];

// 翻译FAQs
const faqs = await Promise.all(
  faqsRaw.map(async (faq) => ({
    q: await tr(faq.q),
    a: await tr(faq.a)
  }))
);

// 翻译Hero文本
const heroTitle = await tr('Behind the Scenes at E.B.belle');
const heroDesc = await tr('Over 4,000 m² modern high-precision jewelry atelier delivering OEM/ODM excellence to prestigious brands worldwide.');
const heroCtaBtn = await tr('Explore Craftsmanship');
---

<Layout title="Factory & Craftsmanship - E.B.Belle">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" slot="head" />

  <Header />

  <main class="factory-page">
    <!-- 1. HERO SECTION -->
    <section class="factory-hero">
      <div class="hero-bg-wrap">
        <img src="https://ebbellejewelry.com/wp-content/uploads/2026/05/IMG_344211-scaled.webp" alt="E.B.Belle Factory Workshop" class="hero-bg" />
        <div class="hero-overlay"></div>
      </div>
      <div class="hero-content">

        <h1 class="hero-title">{heroTitle}</h1>
        <p class="hero-desc">{heroDesc}</p>
        <a href="#craft-steps" class="hero-cta-btn">{heroCtaBtn}</a>
      </div>
    </section>

    <!-- 2. STATS SECTION (页面加载数字逐步递增动画) -->
    <section class="factory-stats-section">
      <div class="container-fluid">
        <div class="stats-grid">
          {stats.map((s) => (
            <div class="stat-card">
              <div class="stat-number">
                {s.prefix && <span class="prefix">{s.prefix}</span>}
                <span class="counter" data-target={s.target}>0</span>
                {s.suffix && <span class="suffix">{s.suffix}</span>}
              </div>
              <p class="stat-label">{s.label}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 3. QUALITY CONTROL & CUSTOMIZATION PILLARS -->
    <section class="pillars-section">
      <div class="container">
        <h2 class="section-title">Quality Control & Customization</h2>
        <div class="pillars-grid">
          <div class="pillar-box">
            <h3><i class="fa-solid fa-shield-halved"></i> QC Process</h3>
            <ul>
              <li><i class="fa-solid fa-check"></i>  6 dedicated QC inspectors</li>
              <li><i class="fa-solid fa-check"></i> 5 Years of QC Experience</li>
              <li><i class="fa-solid fa-check"></i> Raw material → In-production → Pre-packing → Post-packing checks</li>
              <li><i class="fa-solid fa-check"></i> RoHS & REACH certified</li>
              <li><i class="fa-solid fa-check"></i> Quality Assured: Every stone is perfectly bonded with precision adhesive for a flawless finish.</li>
            </ul>
          </div>
          <div class="pillar-box">
            <h3><i class="fa-solid fa-wand-magic-sparkles"></i> Customization Options</h3>
            <ul>
              <li><i class="fa-solid fa-check"></i>  Logo, label, packaging, color, size, material, and graphics.</li>
              <li><i class="fa-solid fa-check"></i> Sample-based or graphic-based design.</li>
              <li><i class="fa-solid fa-check"></i> 1-year warranty on all products.</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. CERTIFICATES & QUALITY STANDARDS (改和Exhibitions同等宽度，满宽平铺展示) -->
    <section class="certificates-static-section">
      <div class="container-fluid">
        <div class="section-header-center">
          <h2 class="section-title">Certificates & Quality Standards</h2>
          <p class="section-desc">Our management systems and workplace standards are verified by world-leading inspection, verification, testing, and certification bodies.</p>
        </div>
        <div class="certificates-grid">
          {certificates.map((item) => (
            <div class="cert-card lightbox-trigger" data-title={item.title} data-src={item.image}>
              <div class="cert-img-wrap">
                <img src={item.image} alt={item.title} loading="lazy" />
                <div class="zoom-hint"><i class="fa-solid fa-magnifying-glass-plus"></i> View Certificate</div>
              </div>
              <p class="cert-caption">{item.title}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 5. REACH & HEAVY METAL TEST REPORTS (双循环绝对连续滚动，杜绝尾部白边断开) -->
    <section class="marquee-section bg-alt">
      <div class="container-fluid">
        <div class="section-header-center">
          <h2 class="section-title">REACH & Heavy Metal Test Reports</h2>
          <p class="section-desc">Zero harmful substances. Fully compliant with EU REACH Regulation (EC) No 1907/2006 and US California Proposition 65.</p>
        </div>
      </div>
      <div class="continuous-marquee-container">
        <div class="continuous-marquee-rail">
          <!-- 跑马灯A组 -->
          <div class="report-group-flex">
            {[...reachReports, ...reachReports].map((item) => (
              <div class="report-card lightbox-trigger" data-title={item.title} data-src={item.image}>
                <div class="img-wrap">
                  <img src={item.image} alt={item.title} loading="lazy" />
                  <div class="zoom-hint"><i class="fa-solid fa-magnifying-glass-plus"></i> View Report</div>
                </div>
                <p class="card-caption">{item.title}</p>
              </div>
            ))}
          </div>
          <!-- 跑马灯B组（与A组完全一致，形成首尾闭环） -->
          <div class="report-group-flex" aria-hidden="true">
            {[...reachReports, ...reachReports].map((item) => (
              <div class="report-card lightbox-trigger" data-title={item.title} data-src={item.image}>
                <div class="img-wrap">
                  <img src={item.image} alt={item.title} loading="lazy" />
                  <div class="zoom-hint"><i class="fa-solid fa-magnifying-glass-plus"></i> View Report</div>
                </div>
                <p class="card-caption">{item.title}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 6. MEET US ON EXHIBITIONS (全屏满宽，纯图片无文字，桌面端5图并排，移动端一张半) -->
    <section class="exhibitions-fullbleed-section">
      <div class="exhibitions-title-area">
        <h2 class="section-title">Meet Us On Exhibitions</h2>
        <p class="section-desc">Connecting with over 1,200 fine jewelry brand owners and international designers across global trade fairs.</p>
      </div>
      <div class="exhibition-fullbleed-strip">
        {exhibitionImages.map((imgUrl) => (
          <div class="exhibition-pure-img-box">
            <img src={imgUrl} alt="E.B.Belle Exhibition" loading="lazy" />
          </div>
        ))}
      </div>
    </section>

    <!-- 7. OUR CRAFTSMANSHIP (全屏大宽屏设计 + 滚动到视口图文两侧进入动画) -->
    <section class="craftsmanship-fullwidth-section" id="craft-steps">
      <div class="container-wide">
        <div class="section-header-center">
          <h2 class="section-title">Our Craftsmanship</h2>
          <p class="section-desc">From raw ingots to fine luxury pieces — precision industrial automation seamlessly fused with master artisanal finishing.</p>
        </div>

        <div class="steps-flow-wide">
          {translatedCraftSteps.map((item, index) => {
            const isReversed = index % 2 !== 0;
            return (
              <div class={`step-row-wide ${isReversed ? 'row-reversed' : ''} scroll-reveal-wrap`}>
                <div class={`step-col-img reveal-from-${isReversed ? 'right' : 'left'}`}>
                  <div class="craft-img-box">
                    <img src={item.image} alt={item.title} loading="lazy" />
                    <span class="step-badge">{item.step}</span>
                  </div>
                </div>
                <div class={`step-col-text reveal-from-${isReversed ? 'left' : 'right'}`}>
                  <span class="step-num-text">PROCESS {item.step}</span>
                  <h3 class="step-title">{item.title}</h3>
                  <div class="step-text-body">
                    {item.lead && <p class="step-lead-paragraph">{item.lead}</p>}
                    {item.secondaryLead && <p class="step-lead-paragraph">{item.secondaryLead}</p>}
                    {item.points && item.points.length > 0 && (
                      <div class="step-bullet-group">
                        {item.points.map((pt) => (
                          <p class="step-bullet-line">
                            <strong>{pt.label}:</strong> {pt.text}
                          </p>
                        ))}
                      </div>
                    )}
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- 8. FAQ ACCORDION -->
    <section class="factory-faq-section">
      <div class="container">
        <h2 class="section-title">THINGS YOU MIGHT WANT TO KNOW</h2>
        <div class="faq-accordion-list">
          {faqs.map((faq) => (
            <div class="faq-acc-item">
              <button type="button" class="faq-acc-header">
                <span>{faq.q}</span>
                <i class="fa-solid fa-chevron-down"></i>
              </button>
              <div class="faq-acc-content">
                <p>{faq.a}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 9. BOTTOM ATELIER CONTACT CTA -->
    <section class="atelier-cta-section">
      <div class="container">
        <div class="cta-inner-box">
          <span class="cta-kicker">COLLABORATE WITH E.B.BELLE</span>
          <h2>Ready to start your custom jewelry line?</h2>
          <p>Get in touch with our manufacturing team for a free consultation.</p>
          <div class="cta-btns">
            <a href="mailto:contact@ebbellejewelry.com" class="btn-primary">Request a Quote</a>
            <a href="https://api.whatsapp.com/send/?phone=8618458005614&text=I+am+from+E.B.belle+website.+I+am+interested+in+your+wholesale+business+or+OEM%2FODM&type=phone_number&app_absent=0" class="btn-secondary">Chat on WhatsApp</a>
          </div>
          <span class="cta1-kicker">📧 sales01@ebbellejewelry.com  |  📍 Yiwu, China</span>
        </div>
      </div>
    </section>

    <!-- 10. LIGHTBOX 弹窗组件 -->
