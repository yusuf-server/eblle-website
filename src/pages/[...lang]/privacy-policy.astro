---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CartDrawer from '../../components/CartDrawer.astro';
import { SUPPORTED_LOCALES, type SupportedLocale } from '../../lib/i18n/utils';
import { t } from '../../lib/i18n/translations';
import { translate } from '../../lib/i18n/translator';
import { getCacheFromContext } from '../../lib/i18n/cache';

// 1. 获取语言参数
const lang = Astro.params.lang as SupportedLocale | undefined;
const currentLocale: SupportedLocale = lang && SUPPORTED_LOCALES.includes(lang as SupportedLocale)
  ? (lang as SupportedLocale)
  : 'en';

// 2. 缓存和上下文配置
const cache = getCacheFromContext(Astro.locals);
const translateConfig = {
  engine: 'cloudflare-ai' as const,
  cache,
  cachePrefix: 'privacy-policy'
};
const context = {
  AI: Astro.locals.AI
};

// 3. 动态翻译辅助函数
async function tr(text: string): Promise<string> {
  if (currentLocale === 'en' || !text) return text;
  return await translate(text, currentLocale, translateConfig, context);
}

// 4. HTML 原版 12 章节文本精准提取与翻译
const pageTitle = await tr('Privacy & Security');
const introText = await tr('At E.B.belle, we value your privacy and are committed to protecting your personal information. This Privacy & Security policy explains how we collect, use, and safeguard your data when you visit our website or make a purchase.');

const rawSections = [
  {
    title: '1. Information We Collect',
    paragraphs: [
      'We collect personal information that you voluntarily provide to us when you create an account, place an order, subscribe to our newsletter, or contact customer service.',
      'This information may include:'
    ],
    bullets: [
      { label: 'Contact Information', text: 'Your name, email address, phone number, shipping address, and billing address.' },
      { label: 'Payment Information', text: 'Credit card details or PayPal account information, which are processed securely by our payment partners.' },
      { label: 'Order Information', text: 'The products you purchase, order date, and order status.' },
      { label: 'Account Information', text: 'Your username, password, and order history.' },
      { label: 'Technical Information', text: 'Your IP address, browser type, and device information, which are collected automatically through cookies.' }
    ]
  },
  {
    title: '2. How We Use Your Information',
    paragraphs: [
      'We use your personal information for the following purposes:'
    ],
    bullets: [
      { text: 'To process and fulfill your orders, including payment processing, shipping, and order confirmation.' },
      { text: 'To communicate with you, including sending order updates, responding to your inquiries, and providing customer support.' },
      { text: 'To improve our services by analyzing website usage and customer preferences.' },
      { text: 'To send promotional emails, but only with your consent. You may opt out at any time.' },
      { text: 'To comply with applicable laws and regulations.' }
    ]
  },
  {
    title: '3. Sharing Your Information',
    paragraphs: [
      'We do not sell, trade, or rent your personal information to third parties. However, we may share your information with trusted service providers who assist us in operating our website and serving you. These include payment processors, shipping carriers, email service providers, and analytics providers.',
      'These third parties are contractually obligated to keep your information confidential and may only use it for the services we request. We may also disclose your information if required by law or to protect our legal rights.'
    ],
    bullets: []
  },
  {
    title: '4. Data Security',
    paragraphs: [
      'We take data security seriously and implement appropriate technical and organizational measures to protect your personal information from unauthorized access, disclosure, alteration, or destruction.',
      'All data transmitted between your browser and our website is encrypted using Secure Socket Layer (SSL) technology. Your payment information is processed directly by PCI-compliant payment partners, and we do not store full credit card details on our servers. Access to customer data is limited to authorized personnel only.',
      'While we strive to protect your information, no method of transmission over the Internet is 100% secure, and we cannot guarantee absolute security.'
    ],
    bullets: []
  },
  {
    title: '5. Cookies and Tracking Technologies',
    paragraphs: [
      'We use cookies and similar tracking technologies to enhance your browsing experience. Cookies are small text files stored on your device that help us remember items in your shopping cart, recognize you on return visits, and analyze website traffic.',
      'We use:'
    ],
    bullets: [
      { label: 'Essential cookies', text: 'required for basic website functionality (shopping cart, checkout, etc.)' },
      { label: 'Analytics cookies', text: 'to understand how visitors interact with our site' },
      { label: 'Functional cookies', text: 'to remember your preferences such as language and currency' }
    ],
    outro: 'You can control cookies through your browser settings. However, disabling essential cookies may affect website functionality.'
  },
  {
    title: '6. Your Rights',
    paragraphs: [
      'Depending on your location, you may have certain rights regarding your personal information. These include:'
    ],
    bullets: [
      { text: 'The right to access a copy of the personal information we hold about you' },
      { text: 'The right to request correction of inaccurate or incomplete information' },
      { text: 'The right to request deletion of your personal information (subject to legal obligations)' },
      { text: 'The right to unsubscribe from marketing communications at any time' },
      { text: 'The right to request transfer of your data to another service provider' }
    ],
    outro: 'To exercise any of these rights, please contact us at support@ebbellejewelry.com. We will respond within 30 days.'
  },
  {
    title: '7. Children’s Privacy',
    paragraphs: [
      'Our website is not intended for children under the age of 13. We do not knowingly collect personal information from children. If you believe a child has provided us with personal information, please contact us immediately.'
    ],
    bullets: []
  },
  {
    title: '8. International Data Transfers',
    paragraphs: [
      'E.B.belle is a global brand. Your information may be transferred to and processed in countries other than your own, including Hong Kong where our business is based and the countries where our service providers operate. We ensure that appropriate safeguards are in place to protect your information.'
    ],
    bullets: []
  },
  {
    title: '9. Retention of Data',
    paragraphs: [
      'We retain your personal information only as long as necessary to fulfill the purposes outlined in this policy.'
    ],
    bullets: [
      { text: 'Order information is retained for seven years for tax and accounting purposes.' },
      { text: 'Account information is retained until you delete your account.' },
      { text: 'Marketing data is retained until you unsubscribe.' }
    ]
  },
  {
    title: '10. Third-Party Links',
    paragraphs: [
      'Our website may contain links to third-party websites, such as social media platforms and payment gateways. We are not responsible for the privacy practices or content of those sites. We encourage you to read their privacy policies before providing any personal information.'
    ],
    bullets: []
  },
  {
    title: '11. Changes to This Policy',
    paragraphs: [
      'We may update this Privacy & Security policy from time to time to reflect changes in our practices or legal requirements. The updated version will be posted on this page with the effective date. It is your responsibility to review this page periodically. Your continued use of our website constitutes acceptance of any changes.'
    ],
    bullets: []
  },
  {
    title: '12. Contact Us',
    paragraphs: [
      'If you have any questions or concerns about this Privacy & Security policy or how we handle your personal information, please contact us at:',
      'E.B.belle Customer Service',
      'Email: support@ebbellejewelry.com'
    ],
    bullets: []
  }
];

// 批量异步翻译所有隐私条款章节
const sections = await Promise.all(
  rawSections.map(async (sec) => ({
    title: await tr(sec.title),
    paragraphs: await Promise.all(sec.paragraphs.map(async (p) => await tr(p))),
    bullets: await Promise.all(
      sec.bullets.map(async (b) => ({
        label: b.label ? await tr(b.label) : undefined,
        text: await tr(b.text)
      }))
    ),
    outro: sec.outro ? await tr(sec.outro) : undefined
  }))
);
---

<Layout title={`${pageTitle} - E.B.Belle`}>
  <Header />

  <main class="privacy-page">
    <div class="privacy-container">
      <!-- 页面大标题 -->
      <h1 class="page-heading">{pageTitle}</h1>

      <!-- 顶部前言引言框 -->
      <div class="intro-callout">
        <p>{introText}</p>
      </div>

      <!-- 隐私条款主体文章 -->
      <article class="privacy-article">
        {sections.map((sec) => (
          <section class="privacy-block">
            <h2 class="privacy-block-title">{sec.title}</h2>
            <div class="privacy-block-content">
              {sec.paragraphs.map((p) => (
                <p>{p}</p>
              ))}

              {sec.bullets && sec.bullets.length > 0 && (
                <ul class="privacy-bullet-list">
                  {sec.bullets.map((b) => (
                    <li>
                      {b.label && <strong>{b.label} – </strong>}
                      <span>{b.text}</span>
                    </li>
                  ))}
                </ul>
              )}

              {sec.outro && <p class="privacy-outro">{sec.outro}</p>}
            </div>
          </section>
        ))}
      </article>
    </div>
  </main>

  <Footer />
  <CartDrawer />
</Layout>

<style>
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  .privacy-page {
    width: 100%;
    background: #ffffff;
    color: #1a1a1a;
    padding: 60px 20px 100px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  }

  /* 居中最佳法务阅读容器 */
  .privacy-container {
    max-width: 860px;
    margin: 0 auto;
  }

  /* 页面大标题：高级珠宝风 */
  .page-heading {
    font-family: 'Cinzel', 'Bodoni Moda', 'Playfair Display', Georgia, serif;
    font-size: 28px;
    font-weight: 500;
    letter-spacing: 3px;
    text-align: center;
    color: #111;
    margin-bottom: 36px;
    text-transform: uppercase;
    position: relative;
    padding-bottom: 14px;
  }

  .page-heading::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 48px;
    height: 1.5px;
    background: #d4a04d;
  }

  /* 顶部引言高亮框（左侧香槟金条） */
  .intro-callout {
    background: #fafaf8;
    border-left: 3px solid #d4a04d;
    padding: 22px 26px;
    margin-bottom: 46px;
    border-radius: 2px;
  }

  .intro-callout p {
    font-size: 13.5px;
    line-height: 1.75;
    color: #444;
    margin: 0;
  }

  .privacy-article {
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  .privacy-block {
    display: flex;
    flex-direction: column;
    border-bottom: 1px solid #f2f2f2;
    padding-bottom: 28px;
  }

  .privacy-block:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  /* 💎 统一珠宝风分类标题（星芒 ✦ + 渐变金线） */
  .privacy-block-title {
    font-family: 'Cinzel', 'Bodoni Moda', Georgia, serif;
    font-size: 16px;
    font-weight: 600;
    letter-spacing: 1.5px;
    color: #1a1a1a;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 16px;
    position: relative;
    padding-bottom: 10px;
  }

  .privacy-block-title::before {
    content: '✦';
    font-size: 13px;
    color: #d4a04d;
    line-height: 1;
    transform: translateY(-0.5px);
    text-shadow: 0 0 6px rgba(212, 160, 77, 0.35);
  }

  .privacy-block-title::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 1px;
    background: linear-gradient(90deg, rgba(212, 160, 77, 0.6) 0%, rgba(212, 160, 77, 0.15) 30%, rgba(235, 235, 235, 0.4) 100%);
  }

  .privacy-block-content {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .privacy-block-content p {
    font-size: 13px;
    line-height: 1.8;
    color: #555;
    margin: 0;
    text-align: justify;
  }

  /* 结构化列表 */
  .privacy-bullet-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 4px 0 6px;
  }

  .privacy-bullet-list li {
    font-size: 13px;
    color: #555;
    line-height: 1.7;
    position: relative;
    padding-left: 16px;
  }

  .privacy-bullet-list li::before {
    content: '•';
    color: #d4a04d;
    position: absolute;
    left: 0;
    font-size: 15px;
    line-height: 1.35;
  }

  .privacy-bullet-list li strong {
    color: #111;
    font-weight: 700;
  }

  .privacy-outro {
    margin-top: 4px !important;
  }

  /* 移动端响应式适配 */
  @media (max-width: 768px) {
    .privacy-page {
      padding: 40px 16px 70px;
    }
    .page-heading {
      font-size: 22px;
      margin-bottom: 28px;
      letter-spacing: 2px;
    }
    .intro-callout {
      padding: 16px;
      margin-bottom: 32px;
    }
    .privacy-block-title {
      font-size: 14px;
    }
    .privacy-block-content p,
    .privacy-bullet-list li {
      font-size: 12.5px;
      line-height: 1.75;
      text-align: left;
    }
  }
</style>