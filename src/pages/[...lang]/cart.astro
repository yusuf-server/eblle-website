</style>

<script is:inline>
  // ============================================================
  // 客户端多语言工具函数
  // ============================================================
  const SUPPORTED_LOCALES = ['en', 'fr', 'de', 'es'];

  const TRANSLATIONS = {
    en: {
      itemsInBag: 'items in your bag',
      emptyCart: 'Your cart is currently empty',
      continueShopping: 'Continue Shopping',
      product: 'Product',
      price: 'Price',
      quantity: 'Quantity',
      subtotal: 'Subtotal',
      total: 'Total:'
    },
    fr: {
      itemsInBag: 'articles dans votre panier',
      emptyCart: 'Votre panier est actuellement vide',
      continueShopping: 'Continuer vos achats',
      product: 'Produit',
      price: 'Prix',
      quantity: 'Quantité',
      subtotal: 'Sous-total',
      total: 'Total:'
    },
    de: {
      itemsInBag: 'Artikel in Ihrem Warenkorb',
      emptyCart: 'Ihr Warenkorb ist derzeit leer',
      continueShopping: 'Weiter einkaufen',
      product: 'Produkt',
      price: 'Preis',
      quantity: 'Menge',
      subtotal: 'Zwischensumme',
      total: 'Gesamt:'
    },
    es: {
      itemsInBag: 'artículos en su carrito',
      emptyCart: 'Su carrito está actualmente vacío',
      continueShopping: 'Seguir comprando',
      product: 'Producto',
      price: 'Precio',
      quantity: 'Cantidad',
      subtotal: 'Subtotal',
      total: 'Total:'
    }
  };

  function getCurrentLocale() {
    const pathname = window.location.pathname;
    for (const locale of SUPPORTED_LOCALES) {
      if (pathname.startsWith(`/${locale}/`) || pathname === `/${locale}`) {
        return locale;
      }
    }
    return 'en';
  }

  function t(key) {
    const locale = getCurrentLocale();
    return TRANSLATIONS[locale]?.[key] || TRANSLATIONS.en[key] || key;
  }

  // 货币处理函数
  const CURRENCY_SYMBOLS = { USD: '$', EUR: '€', GBP: '£', CAD: 'C$' };
  const CURRENCY_RATES = { USD: 1.0, EUR: 0.92, GBP: 0.79, CAD: 1.36 };

  function getCurrentCurrency() {
    return localStorage.getItem('ebbelle_currency') || 'USD';
  }
  function getCurrencySymbol(currency) {
    return CURRENCY_SYMBOLS[currency || getCurrentCurrency()] || '$';
  }
  function convertPrice(priceUSD, targetCurrency) {
    const currency = targetCurrency || getCurrentCurrency();
    const rate = CURRENCY_RATES[currency] || 1.0;
    return priceUSD * rate;
  }
  function formatPrice(priceUSD, targetCurrency) {
    const currency = targetCurrency || getCurrentCurrency();
    const converted = convertPrice(priceUSD, currency);
    const symbol = getCurrencySymbol(currency);
    const formatted = converted.toFixed(2);
    return currency === 'EUR' ? `${formatted}${symbol}` : `${symbol}${formatted}`;
  }

  function getCart() {
    try {
      const cart = localStorage.getItem('ebbelle_cart');
      return cart ? JSON.parse(cart) : [];
    } catch (e) {
      return [];
    }
  }

  function saveCart(cart) {
    try {
      localStorage.setItem('ebbelle_cart', JSON.stringify(cart));
      window.dispatchEvent(new CustomEvent('cartUpdated', { detail: { cart } }));
    } catch (e) {}
  }

  // ============================================================
  // 圣诞专属免费礼盒映射（3 个码可任意切换兑换，每次仅生效 1 个，不可叠加）
  // ============================================================
  const XMAS_GIFT_CATALOG = {
    GIFT125: {
      code: 'GIFT125',
      name: 'Crimson Surprise — Christmas Mystery Gift',
      image: 'https://api.ebbellejewelry.com/wp-content/uploads/2026/11/gift666.png'
    },
    GIFT124: {
      code: 'GIFT124',
      name: 'Pine Surprise — Christmas Mystery Gift',
      image: 'https://api.ebbellejewelry.com/wp-content/uploads/2026/11/gift999.png'
    },
    GIFT777: {
      code: 'GIFT777',
      name: 'Stellar Surprise — Christmas Mystery Gift',
      image: 'https://api.ebbellejewelry.com/wp-content/uploads/2026/11/gift888.png'
    }
  };
  const XMAS_EXCLUSIVE_CODES = Object.keys(XMAS_GIFT_CATALOG);

  let cartXmasPromoActive = false;
  let cartXmasBackendData = null;

  // 在加购列表中排他同步免费圣诞实物礼盒（自动替换旧礼盒，确保每次只有 1 个生效）
  function syncXmasMysteryGiftInCart(validCode) {
    const cart = getCart();
    const regularItems = cart.filter(item => !item.isXmasMysteryGift);
    const upper = (validCode || '').toUpperCase().trim();
    const giftMeta = XMAS_GIFT_CATALOG[upper];

    let nextCart = regularItems;
    if (giftMeta && regularItems.length > 0) {
      nextCart = [
        ...regularItems,
        {
          cartItemId: `xmas_mystery_gift_${upper}`,
          id: 0,
          name: giftMeta.name,
          price: '0.00',
          basePrice: '0.00',
          quantity: 1,
          weight: 0,
          image: giftMeta.image,
          isXmasMysteryGift: true,
          xmasGiftCode: upper
        }
      ];
    }

    const changed = JSON.stringify(cart) !== JSON.stringify(nextCart);
    if (changed) {
      localStorage.setItem('ebbelle_cart', JSON.stringify(nextCart));
      window.dispatchEvent(new CustomEvent('cartUpdated', { detail: { cart: nextCart } }));
    }
    return changed;
  }

  function computeLocalXmasBogo(cart) {
    const unitPrices = [];
    cart.forEach(item => {
      if (item.isXmasMysteryGift) return; // 免费礼物不计入买X送Y门槛件数
      const p = Math.max(0, parseFloat(item.price) || 0);
      const q = Math.max(0, parseInt(item.quantity, 10) || 0);
      for (let i = 0; i < q; i++) unitPrices.push(p);
    });
    unitPrices.sort((a, b) => b - a);
    const totalQty = unitPrices.length;
    const subtotal = parseFloat(unitPrices.reduce((s, v) => s + v, 0).toFixed(2));

    let freeCount = 0;
    let tierLabel = '';
    if (totalQty >= 8) {
      freeCount = 3;
      tierLabel = 'Buy 5 Get 3 Free';
    } else if (totalQty >= 5) {
      freeCount = 2;
      tierLabel = 'Buy 3 Get 2 Free';
    } else if (totalQty >= 2) {
      freeCount = 1;
      tierLabel = 'Buy 2 Get 1 Free';
    }

    const freeSlice = freeCount > 0 ? unitPrices.slice(-freeCount) : [];
    const discount = parseFloat(freeSlice.reduce((s, v) => s + v, 0).toFixed(2));
    return {
      total_qty: totalQty,
      eligible: totalQty >= 2,
      free_count: freeCount,
      tier_label: tierLabel,
      xmas_discount: discount,
      subtotal
    };
  }

  // 渲染购物车页面
  function renderCartPage() {
    const cart = getCart();
    const wrapper = document.getElementById('cartItemsWrapper');
    const itemsCountTag = document.querySelector('.items-count-tag');

    if (!wrapper) return;

    const regularItems = cart.filter(item => !item.isXmasMysteryGift);
    const totalItems = cart.reduce((sum, item) => sum + item.quantity, 0);
    if (itemsCountTag) {
      itemsCountTag.textContent = `${totalItems} ${t('itemsInBag')}`;
    }

    // 若常规商品已清空，同时清空残留的免费圣诞礼物
    if (regularItems.length === 0) {
      if (cart.length > 0) {
        localStorage.setItem('ebbelle_cart', JSON.stringify([]));
      }
      wrapper.innerHTML = `
        <div style="text-align: center; padding: 60px 20px; color: #999;">
          <i class="fa-solid fa-cart-shopping" style="font-size: 48px; margin-bottom: 16px; opacity: 0.25;"></i>
          <p style="font-size: 16px; color: #555; margin: 0 0 20px;">${t('emptyCart')}</p>
          <a href="/shop" class="btn-continue-shopping" style="display: inline-flex; border: 1px solid #1a1917; padding: 10px 22px; border-radius: 2px;">
            <i class="fa-solid fa-arrow-left"></i>
            <span>${t('continueShopping')}</span>
          </a>
        </div>
      `;
      updateCartSummary();
      return;
    }

    const itemsHTML = cart.map(item => {
      const isMysteryGift = Boolean(item.isXmasMysteryGift);
      const price = parseFloat(item.price) || 0;
      const itemWeight = parseFloat(item.weight) || 0;
      const totalWeight = itemWeight * item.quantity;

      let variantsText = '';
      if (isMysteryGift) {
        variantsText = `🎄 Redeemed with Code: ${item.xmasGiftCode} (1 Gift Per Order)`;
      } else if (item.selectedVariants) {
        variantsText = Object.entries(item.selectedVariants)
          .filter(([_, value]) => value)
          .map(([key, value]) => `${key.charAt(0).toUpperCase() + key.slice(1)}: ${value}`)
          .join(' / ');
      }

      const weightText = (!isMysteryGift && itemWeight > 0) ? ` • ${totalWeight.toFixed(3)}kg` : '';
      const priceDisplay = isMysteryGift ? '<span style="color:#961820; font-weight:700;">FREE</span>' : formatPrice(price);
      const lineTotalDisplay = isMysteryGift ? '<span style="color:#961820; font-weight:700;">FREE</span>' : formatPrice(price * item.quantity);

      return `
        <div class="cart-item-card" data-cart-item-id="${item.cartItemId}" ${isMysteryGift ? 'style="background: linear-gradient(90deg, #fff8f6 0%, #ffffff 100%) !important;"' : ''}>
          <div class="item-product-col">
            <div class="item-thumb" ${isMysteryGift ? 'style="padding:6px !important; background:#fff8f0 !important; border-color:#d6b879 !important;"' : ''}>
              <img src="${item.image}" alt="${item.name}" ${isMysteryGift ? 'style="object-fit:contain !important;"' : ''} />
            </div>
            <div class="item-meta">
              <h3 class="item-title">
                ${isMysteryGift ? `<span>${item.name}</span>` : `<a href="/product/${item.slug || ''}">${item.name}</a>`}
              </h3>
              ${variantsText ? `<p class="item-variant" ${isMysteryGift ? 'style="color:#961820 !important; font-weight:600 !important;"' : ''}>${variantsText}${weightText}</p>` : (weightText ? `<p class="item-variant">${weightText.substring(3)}</p>` : '')}
              <div class="mobile-price-row">
                <span class="unit-price item-price">${priceDisplay}</span>
              </div>
            </div>
          </div>

          <div class="item-price-col">
            <span class="unit-price item-price">${priceDisplay}</span>
          </div>

          <div class="item-quantity-col">
            ${isMysteryGift
              ? `<span style="display:inline-block; font-size:11.5px; font-weight:700; color:#234638; background:#e7f3ed; border:1px solid #9bc7b2; padding:4px 10px; border-radius:999px;">Qty: 1 (Free Gift)</span>`
              : `<div class="quantity-stepper">
                  <button type="button" class="stepper-btn" data-action="decrease" aria-label="Decrease quantity">-</button>
                  <input type="number" class="stepper-input" value="${item.quantity}" min="1" readonly />
                  <button type="button" class="stepper-btn" data-action="increase" aria-label="Increase quantity">+</button>
                </div>`
            }
          </div>

          <div class="item-total-col">
            <span class="total-label">${t('total')}</span>
            <span class="line-total">${lineTotalDisplay}</span>
          </div>

          <div class="item-action-col">
            <button type="button" class="btn-remove" data-action="delete" title="Remove item" aria-label="Remove item">
              <i class="fa-regular fa-trash-can"></i>
            </button>
          </div>
        </div>
      `;
    }).join('');

    wrapper.innerHTML = `
      <div class="cart-header-row">
        <span class="col-product">${t('product')}</span>
        <span class="col-price">${t('price')}</span>
        <span class="col-quantity">${t('quantity')}</span>
        <span class="col-total">${t('subtotal')}</span>
        <span class="col-action"></span>
      </div>
      ${itemsHTML}
    `;

    updateCartSummary();
  }

  // 购物车页状态
  let cartUserEmail = '';
  let cartFreeShippingThreshold = 25;
  let cartIsNewCustomer = true;
  let cartManualCoupon = sessionStorage.getItem('ebbelle_cart_manual_coupon') || '';
  let cartDiscountAmount = 0;
  let cartCouponFreeShipping = false;

  async function initCartUserContext() {
    try {
      const meRes = await fetch('/api/auth/me');
      const meData = await meRes.json();
      if (meData && meData.authenticated && meData.user && meData.user.email) {
        cartUserEmail = meData.user.email;
      }
    } catch (e) {}

    const couponInput = document.getElementById('cartCouponInput');
    if (couponInput && cartManualCoupon) {
      couponInput.value = cartManualCoupon;
    }
    await syncCartWithBackend();
  }

  async function syncCartWithBackend() {
    const cart = getCart();
    const regularCart = cart.filter(item => !item.isXmasMysteryGift);
    const subtotal = regularCart.reduce((sum, item) => sum + ((parseFloat(item.price) || 0) * item.quantity), 0);
    const feedbackEl = document.getElementById('cartCouponFeedback');
    const itemsPayload = regularCart.map(item => ({
      id: item.id || item.product_id,
      price: parseFloat(item.price) || 0,
      quantity: parseInt(item.quantity, 10) || 1
    }));

    const localXmas = computeLocalXmasBogo(cart);
    const upperCode = (cartManualCoupon || '').toUpperCase().trim();
    const isXmasCode = XMAS_EXCLUSIVE_CODES.includes(upperCode);

    // 若用户输入的是圣诞专属券（GIFT125/GIFT124/GIFT777），仅在达标圣诞满赠时传 promo_mode: 'xmas_bogo' 供后端联动校验
    const reqPromoMode = (isXmasCode && localXmas.eligible) ? 'xmas_bogo' : '';

    try {
      const res = await fetch('/api/woocommerce/calculate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          email: cartUserEmail,
          subtotal: subtotal > 0 ? subtotal : 10,
          country: 'US',
          selected_offer: 'bundle_tier',
          promo_mode: reqPromoMode,
          manual_coupon: cartManualCoupon,
          items: itemsPayload
        })
      });
      const data = await res.json();
      if (data && data.success) {
        cartIsNewCustomer = typeof data.is_new_customer === 'boolean' ? data.is_new_customer : true;
        if (typeof data.free_shipping_min === 'number' && data.free_shipping_min > 0) {
          cartFreeShippingThreshold = data.free_shipping_min;
        } else {
          cartFreeShippingThreshold = cartIsNewCustomer ? 25 : 50;
        }

        cartXmasPromoActive = Boolean(data.xmas_promo_active);
        cartXmasBackendData = data.xmas_data || null;

        if (cartManualCoupon && subtotal > 0) {
          if (isXmasCode) {
            cartDiscountAmount = 0;
            cartCouponFreeShipping = false;
            if (cartXmasPromoActive && localXmas.eligible && data.xmas_coupon_status === 'valid') {
              const didChange = syncXmasMysteryGiftInCart(upperCode);
              if (feedbackEl) {
                feedbackEl.style.display = 'flex';
                feedbackEl.style.background = '#fff5f5';
                feedbackEl.style.color = '#961820';
                feedbackEl.style.border = '1px solid #f5c2c7';
                feedbackEl.innerHTML = `
                  <span>${data.xmas_coupon_message}</span>
                  <button type="button" onclick="removeCartPromoCode()" style="background:none; border:none; color:#555; cursor:pointer; font-size:11.5px; text-decoration:underline; padding:0;">Remove</button>
                `;
              }
              if (didChange) renderCartPage();
            } else {
              const didChange = syncXmasMysteryGiftInCart('');
              const errMsg = !cartXmasPromoActive
                ? `Holiday code ${upperCode} is only valid during the Christmas Event.`
                : (!localXmas.eligible
                  ? `Add at least 2 items to join the Christmas Event and redeem ${upperCode}.`
                  : (data.xmas_coupon_message || data.coupon_message || `Unable to apply ${upperCode}.`));
              if (feedbackEl) {
                feedbackEl.style.display = 'flex';
                feedbackEl.style.background = '#fdecea';
                feedbackEl.style.color = '#c62828';
                feedbackEl.style.border = '1px solid #ffcdd2';
                feedbackEl.innerHTML = `
                  <span><i class="fa-solid fa-circle-exclamation"></i> ${errMsg}</span>
                  <button type="button" onclick="removeCartPromoCode()" style="background:none; border:none; color:#555; cursor:pointer; font-size:11.5px; text-decoration:underline; padding:0;">Clear</button>
                `;
              }
              if (didChange) renderCartPage();
            }
          } else {
            // 非圣诞专属码：清空任何圣诞免费礼盒
            const didChange = syncXmasMysteryGiftInCart('');
            if (data.coupon_status === 'valid') {
              const baseRes = await fetch('/api/woocommerce/calculate', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  email: cartUserEmail,
                  subtotal: subtotal,
                  country: 'US',
                  selected_offer: 'bundle_tier',
                  manual_coupon: '',
                  items: itemsPayload
                })
              });
              const baseData = await baseRes.json();
              const baseDiscount = (baseData && baseData.success) ? (parseFloat(baseData.discount_total) || 0) : 0;
              cartDiscountAmount = Math.max(0, parseFloat(((parseFloat(data.discount_total) || 0) - baseDiscount).toFixed(2)));
              cartCouponFreeShipping = Boolean(data.base_shipping_free && !(baseData && baseData.base_shipping_free));

              if (feedbackEl) {
                feedbackEl.style.display = 'flex';
                feedbackEl.style.background = '#edf7ee';
                feedbackEl.style.color = '#2e7d32';
                feedbackEl.style.border = '1px solid #c8e6c9';
                feedbackEl.innerHTML = `
                  <span><i class="fa-solid fa-tag"></i> ${data.coupon_message}</span>
                  <button type="button" onclick="removeCartPromoCode()" style="background:none; border:none; color:#555; cursor:pointer; font-size:11.5px; text-decoration:underline; padding:0;">Remove</button>
                `;
              }
            } else {
              cartDiscountAmount = 0;
              cartCouponFreeShipping = false;
              sessionStorage.removeItem('ebbelle_cart_manual_coupon');
              if (feedbackEl && data.coupon_message) {
                feedbackEl.style.display = 'flex';
                feedbackEl.style.background = '#fdecea';
                feedbackEl.style.color = '#c62828';
                feedbackEl.style.border = '1px solid #ffcdd2';
                feedbackEl.innerHTML = `<span><i class="fa-solid fa-circle-exclamation"></i> ${data.coupon_message}</span>`;
              }
            }
            if (didChange) renderCartPage();
          }
        } else {
          const didChange = syncXmasMysteryGiftInCart('');
          cartDiscountAmount = 0;
          cartCouponFreeShipping = false;
          if (feedbackEl) feedbackEl.style.display = 'none';
          if (didChange) renderCartPage();
        }
      }
    } catch (e) {}

    updateCartSummary();
  }

  window.removeCartPromoCode = function() {
    cartManualCoupon = '';
    cartDiscountAmount = 0;
    cartCouponFreeShipping = false;
    sessionStorage.removeItem('ebbelle_cart_manual_coupon');
    const inp = document.getElementById('cartCouponInput');
    if (inp) inp.value = '';
    const feedbackEl = document.getElementById('cartCouponFeedback');
    if (feedbackEl) feedbackEl.style.display = 'none';
    syncXmasMysteryGiftInCart('');
    renderCartPage();
  };

  document.getElementById('cartCouponApplyBtn')?.addEventListener('click', async () => {
    const inp = document.getElementById('cartCouponInput');
    const btn = document.getElementById('cartCouponApplyBtn');
    const code = inp ? inp.value.trim() : '';
    if (!code) return;

    cartManualCoupon = code;
    sessionStorage.setItem('ebbelle_cart_manual_coupon', code);

    if (btn) {
      btn.disabled = true;
      btn.textContent = '...';
    }
    try {
      await syncCartWithBackend();
    } finally {
      if (btn) {
        btn.disabled = false;
        btn.textContent = 'APPLY';
      }
    }
  });

  // 更新总览价格与动态激励横幅
  function updateCartSummary() {
    const cart = getCart();
    const totalItems = cart.reduce((sum, item) => sum + item.quantity, 0);
    const subtotal = cart.reduce((sum, item) => {
      if (item.isXmasMysteryGift) return sum;
      const price = parseFloat(item.price) || 0;
      return sum + (price * item.quantity);
    }, 0);

    const subtotalSpan = document.getElementById('cartSubtotalVal');
    const subtotalName = document.getElementById('subtotalLabel');
    const discountRow = document.getElementById('cartDiscountRow');
    const discountLabel = document.getElementById('cartDiscountLabel');
    const discountVal = document.getElementById('cartDiscountVal');
    const shippingTag = document.getElementById('cartShippingStatusTag');
    const totalSpan = document.getElementById('cartTotalVal');

    if (subtotalName) {
      subtotalName.textContent = `${t('subtotal')} (${totalItems} ${t('itemsInBag')})`;
    }
    if (subtotalSpan) {
      subtotalSpan.textContent = formatPrice(subtotal);
    }

    const freeShippingThreshold = cartFreeShippingThreshold || 25;
    const remaining = Math.max(0, freeShippingThreshold - subtotal);
    const vipShippingUnlocked = (remaining <= 0 && subtotal > 0) || (cartCouponFreeShipping && subtotal > 0);
    const bannerEl = document.getElementById('cartProgressBanner');

    // 分支 A：圣诞大促已开启且在活动时间内
    if (cartXmasPromoActive && bannerEl) {
      const xmasCalc = computeLocalXmasBogo(cart);
      const qty = xmasCalc.total_qty;
      const isMaxed = qty >= 8;

      let nextTarget = 2;
      let nextTierName = 'Buy 2 Get 1 Free';
      if (qty >= 8) {
        nextTarget = 8;
        nextTierName = 'Buy 5 Get 3 Free (Max Tier)';
      } else if (qty >= 5) {
        nextTarget = 8;
        nextTierName = 'Buy 5 Get 3 Free';
      } else if (qty >= 2) {
        nextTarget = 5;
        nextTierName = 'Buy 3 Get 2 Free';
      }

      const rawPct = isMaxed ? 100 : Math.min(100, Math.round((qty / nextTarget) * 100));
      const riderLeftPct = Math.min(92, Math.max(8, rawPct));
      const needMore = Math.max(0, nextTarget - qty);

      let goalHeadline = '';
      if (qty === 0) {
        goalHeadline = `Add 2 items anywhere on site to unlock <strong>Buy 2 Get 1 Free</strong>!`;
      } else if (isMaxed) {
        goalHeadline = `🎉 <strong>Buy 5 Get 3 Free</strong> Unlocked! (3 lowest-priced items FREE)`;
      } else if (qty >= 2) {
        goalHeadline = `🎄 <strong>${xmasCalc.tier_label}</strong> Active! Add <strong>${needMore} more</strong> to upgrade to <strong>${nextTierName}</strong>`;
      } else {
        goalHeadline = `Add <strong>${needMore} more item</strong> to unlock <strong>Buy 2 Get 1 Free</strong>!`;
      }

      const ms1Class = qty >= 2 ? (qty < 5 ? 'xmas-cart-ms current' : 'xmas-cart-ms reached') : 'xmas-cart-ms';
      const ms2Class = qty >= 5 ? (qty < 8 ? 'xmas-cart-ms current' : 'xmas-cart-ms reached') : 'xmas-cart-ms';
      const ms3Class = qty >= 8 ? 'xmas-cart-ms current' : 'xmas-cart-ms';

      const vipPerkText = cartIsNewCustomer
        ? `New Guest Welcome: <strong>15% OFF</strong> &amp; <strong>Free Shipping</strong> over ${formatPrice(freeShippingThreshold)} also available at checkout`
        : `VIP Member Benefit: <strong>Free Shipping</strong> over ${formatPrice(freeShippingThreshold)} &amp; <strong>$200 Bundle</strong> also available at checkout`;
      const vipStatusTag = vipShippingUnlocked
        ? `✓ ${formatPrice(freeShippingThreshold)} Free Ship Ready`
        : `${formatPrice(remaining)} to Free Ship`;

      bannerEl.className = 'shipping-progress-banner is-xmas-theme';
      bannerEl.innerHTML = `
        <div class="xmas-cart-top-row">
          <span class="xmas-cart-kicker"><i class="fa-solid fa-sleigh"></i> Christmas Mix &amp; Match Event</span>
          <span class="xmas-cart-pill">🎄 Sitewide Stackable Tiers</span>
        </div>

        <div class="xmas-cart-goal-line">
          <span>${goalHeadline}</span>
          ${xmasCalc.xmas_discount > 0
            ? `<span class="xmas-cart-save-badge">Est. Free Gift Value: -${formatPrice(xmasCalc.xmas_discount)}</span>`
            : `<span class="xmas-cart-save-badge">${qty} / ${nextTarget} Items</span>`}
        </div>

        <div class="xmas-sleigh-track-wrap">
          <div class="xmas-santa-rider" style="left: ${riderLeftPct}%;" title="Santa & Reindeer delivering your holiday gifts!">
            <span class="rider-trail">✨</span>
            <span class="rider-emojis">🎁🛷🎅🦌</span>
          </div>
          <div class="xmas-sleigh-track">
            <div class="xmas-sleigh-fill ${isMaxed ? 'is-maxed' : ''}" style="width: ${rawPct}%;"></div>
          </div>
        </div>

        <div class="xmas-cart-milestones">
          <div class="${ms1Class}">${qty >= 2 ? '✓ ' : ''}2 Items: Buy 2 Get 1</div>
          <div class="${ms2Class}">${qty >= 5 ? '✓ ' : ''}5 Items: Buy 3 Get 2</div>
          <div class="${ms3Class}">${qty >= 8 ? '✓ ' : ''}8 Items: Buy 5 Get 3</div>
        </div>

        <div class="xmas-vip-keep-note">
          <span><i class="fa-solid fa-crown"></i> ${vipPerkText}</span>
          <span class="xmas-vip-status-tag">${vipStatusTag}</span>
        </div>
      `;

      const activeDiscount = xmasCalc.eligible ? xmasCalc.xmas_discount : (subtotal > 0 ? Math.min(subtotal, cartDiscountAmount) : 0);
      if (discountRow && discountVal && discountLabel) {
        if (activeDiscount > 0) {
          discountRow.style.display = 'flex';
          discountLabel.textContent = xmasCalc.eligible ? `🎄 ${xmasCalc.tier_label}` : `Promo (${cartManualCoupon.toUpperCase()})`;
          discountVal.textContent = `-${formatPrice(activeDiscount)}`;
        } else {
          discountRow.style.display = 'none';
        }
      }
      if (shippingTag) {
        shippingTag.textContent = xmasCalc.eligible ? 'Standard / VIP at Checkout' : (vipShippingUnlocked ? 'FREE' : 'Calculated next step');
      }
      if (totalSpan) {
        totalSpan.textContent = formatPrice(Math.max(0, subtotal - activeDiscount));
      }
      return;
    }

    // 分支 B：非圣诞活动时段
    const effectiveDiscount = subtotal > 0 ? Math.min(subtotal, cartDiscountAmount) : 0;
    if (discountRow && discountVal && discountLabel) {
      if (effectiveDiscount > 0) {
        discountRow.style.display = 'flex';
        discountLabel.textContent = `Promo (${cartManualCoupon.toUpperCase()})`;
        discountVal.textContent = `-${formatPrice(effectiveDiscount)}`;
      } else {
        discountRow.style.display = 'none';
      }
    }

    const estimatedTotal = Math.max(0, subtotal - effectiveDiscount);
    if (totalSpan) {
      totalSpan.textContent = formatPrice(estimatedTotal);
    }

    const progress = vipShippingUnlocked ? 100 : Math.min(100, (subtotal / freeShippingThreshold) * 100);

    if (shippingTag) {
      shippingTag.textContent = vipShippingUnlocked ? 'FREE' : 'Calculated next step';
    }

    if (bannerEl) {
      bannerEl.className = `shipping-progress-banner${vipShippingUnlocked ? ' unlocked' : ''}`;
      const msgHtml = (!vipShippingUnlocked && remaining > 0)
        ? `<i class="fa-solid fa-truck-fast"></i> You're <span class="highlight">${formatPrice(remaining)}</span> away from <strong>FREE SHIPPING!</strong>`
        : (subtotal > 0
          ? `<i class="fa-solid fa-truck-fast"></i> <strong>Congratulations! You've unlocked FREE SHIPPING!</strong>`
          : `<i class="fa-solid fa-truck-fast"></i> You're <span class="highlight">${formatPrice(freeShippingThreshold)}</span> away from <strong>FREE SHIPPING!</strong>`);

      bannerEl.innerHTML = `
        <div class="progress-header">
          <p class="progress-message">${msgHtml}</p>
          <span class="progress-percent">${Math.round(progress)}%</span>
        </div>
        <div class="progress-bar-track">
          <div class="progress-fill" style="width: ${progress}%;"></div>
        </div>
        <div class="progress-labels">
          <span>Current: <strong>${formatPrice(subtotal)}</strong></span>
          <span>Free threshold: <strong>${formatPrice(freeShippingThreshold)}</strong></span>
        </div>
      `;
    }
  }

  // 更新商品数量
  function updateCartQuantity(cartItemId, newQuantity) {
    if (newQuantity < 1) return;
    const cart = getCart();
    const item = cart.find(i => String(i.cartItemId) === String(cartItemId));
    if (item && !item.isXmasMysteryGift) {
      item.quantity = newQuantity;

      const basePrice = parseFloat(item.basePrice || item.price);
      let finalPrice = basePrice;
      if (newQuantity >= 100) {
        finalPrice = basePrice * 0.90;
      } else if (newQuantity >= 50) {
        finalPrice = basePrice * 0.94;
      } else if (newQuantity >= 10) {
        finalPrice = basePrice * 0.97;
      }
      item.price = finalPrice.toFixed(2);

      saveCart(cart);

      const cartItem = document.querySelector(`[data-cart-item-id="${cartItemId}"]`);
      if (cartItem) {
        const stepperInput = cartItem.querySelector('.stepper-input');
        const lineTotal = cartItem.querySelector('.line-total');
        const priceElement = cartItem.querySelector('.item-price');

        if (stepperInput) stepperInput.value = newQuantity;
        if (priceElement) priceElement.textContent = formatPrice(finalPrice);
        if (lineTotal) {
          lineTotal.textContent = formatPrice(finalPrice * newQuantity);
        }
      }
      updateCartSummary();
      if (cartManualCoupon) {
        syncCartWithBackend();
      }
    }
  }

  function removeCartItem(cartItemId) {
    let cart = getCart();
    const target = cart.find(i => String(i.cartItemId) === String(cartItemId));
    if (target && target.isXmasMysteryGift) {
      cartManualCoupon = '';
      sessionStorage.removeItem('ebbelle_cart_manual_coupon');
      const inp = document.getElementById('cartCouponInput');
      if (inp) inp.value = '';
      const feedbackEl = document.getElementById('cartCouponFeedback');
      if (feedbackEl) feedbackEl.style.display = 'none';
    }
    cart = cart.filter(i => String(i.cartItemId) !== String(cartItemId));
    saveCart(cart);
    renderCartPage();
    if (cartManualCoupon) {
      syncCartWithBackend();
    }
  }

  document.getElementById('cartItemsWrapper')?.addEventListener('click', (e) => {
    const button = e.target.closest('button');
    if (!button) return;

    const cartItem = button.closest('.cart-item-card');
    if (!cartItem) return;

    const cartItemId = cartItem.dataset.cartItemId;
    const action = button.dataset.action;
    const stepperInput = cartItem.querySelector('.stepper-input');
    const currentQty = parseInt(stepperInput?.value || 1, 10);

    if (action === 'delete') {
      removeCartItem(cartItemId);
    } else if (action === 'increase') {
      updateCartQuantity(cartItemId, currentQty + 1);
    } else if (action === 'decrease') {
      if (currentQty > 1) {
        updateCartQuantity(cartItemId, currentQty - 1);
      } else {
        removeCartItem(cartItemId);
      }
    }
  });

  document.getElementById('btnClearAll')?.addEventListener('click', () => {
    cartManualCoupon = '';
    sessionStorage.removeItem('ebbelle_cart_manual_coupon');
    saveCart([]);
    renderCartPage();
  });

  window.addEventListener('cartUpdated', () => {
    renderCartPage();
  });
  document.addEventListener('DOMContentLoaded', () => {
    renderCartPage();
    initCartUserContext();
  });
</script>