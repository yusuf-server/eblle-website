<script>
  function initContactPage() {
    // 1. 数量范围标签单选
    const volumeButtons = document.querySelectorAll('#volumeButtonGroup .volume-btn');
    const selectedVolumeInput = document.getElementById('selectedVolume') as HTMLInputElement;

    volumeButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        volumeButtons.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');

        if (selectedVolumeInput) {
          selectedVolumeInput.value = btn.getAttribute('data-val') || '';
        }
      });
    });

    // 2. 表单发送请求给 WordPress 后端的 wp_mail 接口
    const contactForm = document.getElementById('contactConciergeForm') as HTMLFormElement;
    const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement;
    const successToast = document.getElementById('formSuccessToast');
    const errorToast = document.getElementById('formErrorToast');
    const errorDesc = document.getElementById('formErrorDesc');

    const mainEl = document.querySelector('main[data-api-url]') as HTMLElement;
    const apiUrl = mainEl?.getAttribute('data-api-url') || '';

    if (contactForm && submitBtn) {
      contactForm.addEventListener('submit', async (e) => {
        e.preventDefault();

        const originalBtnHtml = submitBtn.innerHTML;
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i><span>TRANSMITTING...</span>';

        if (successToast) successToast.classList.add('hidden');
        if (errorToast) errorToast.classList.add('hidden');

        const payload = {
          name: (document.getElementById('fullName') as HTMLInputElement)?.value.trim(),
          email: (document.getElementById('businessEmail') as HTMLInputElement)?.value.trim(),
          phone: (document.getElementById('phoneContact') as HTMLInputElement)?.value.trim(),
          inquiry_type: (document.getElementById('inquiryType') as HTMLSelectElement)?.value,
          volume: selectedVolumeInput ? selectedVolumeInput.value : '',
          message: (document.getElementById('messageField') as HTMLTextAreaElement)?.value.trim()
        };

        try {
          const res = await fetch(apiUrl, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify(payload)
          });

          const data = await res.json();

          if (res.ok && data.success) {
            submitBtn.innerHTML = '<span>MESSAGE DELIVERED</span><i class="fa-solid fa-check"></i>';
            submitBtn.style.backgroundColor = '#835503';

            if (successToast) successToast.classList.remove('hidden');
            contactForm.reset();

            volumeButtons.forEach((b, idx) => {
              if (idx === 1) b.classList.add('active');
              else b.classList.remove('active');
            });
            if (selectedVolumeInput) selectedVolumeInput.value = '50-200 Pcs';

            setTimeout(() => {
              submitBtn.disabled = false;
              submitBtn.innerHTML = originalBtnHtml;
              submitBtn.style.backgroundColor = '';
            }, 4000);
          } else {
            throw new Error(data.message || 'Server error while sending email.');
          }
        } catch (err: any) {
          console.error('Contact Form error:', err);
          submitBtn.disabled = false;
          submitBtn.innerHTML = originalBtnHtml;
          if (errorToast) {
            if (errorDesc) errorDesc.textContent = err.message || 'Please try again or email us directly at sales01@ebbellejewelry.com.';
            errorToast.classList.remove('hidden');
          }
        }
      });
    }
  }

  document.addEventListener('DOMContentLoaded', initContactPage);
</script>