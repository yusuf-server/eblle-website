    background: #ffffff;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 600;
    color: #444;
    cursor: pointer;
  }

  .copy-link-btn:hover {
    border-color: #1a1a1a;
    color: #1a1a1a;
  }

  /* 右侧粘性边栏 */
  .sidebar-sticky-stack {
    position: sticky;
    top: 84px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .toc-card {
    padding: 22px;
    background: #ffffff;
    border: 1px solid #ece6dc;
    border-radius: 8px;
  }

  .toc-card-title {
    font-size: 14px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #1a1a1a;
    margin: 0 0 14px 0;
    padding-bottom: 10px;
    border-bottom: 1px solid #f2ede4;
  }

  :global(.toc-links-list) {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  :global(.toc-links-list a) {
    font-size: 13px;
    font-weight: 500;
    color: #555555;
    line-height: 1.4;
    display: block;
    transition: color 0.2s ease;
  }

  :global(.toc-links-list a:hover) {
    color: #9e6325;
  }

  .sidebar-vip-card {
    padding: 26px 22px;
    background: #f9f4ed;
    border: 1.5px dashed rgba(201, 147, 63, 0.45);
    border-radius: 8px;
    text-align: center;
  }

  .vip-tag {
    display: inline-block;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.16em;
    color: #9e6325;
    margin-bottom: 6px;
  }

  .sidebar-vip-card h4 {
    font-size: 30px;
