---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import CartDrawer from '../../../components/CartDrawer.astro';
import AuthModal from '../../../components/AuthModal.astro';
import { SUPPORTED_LOCALES, type SupportedLocale, addLocalePrefix } from '../../../lib/i18n/utils';
// [slug].astro 里还有这一行也要改：
import { wcRequest } from '../../../lib/woocommerce';

export const prerender = false;

const lang = Astro.params.lang as SupportedLocale | undefined;
const slug = Astro.params.slug || '';
const currentPath = Astro.url.pathname;

let currentLocale: SupportedLocale = lang && SUPPORTED_LOCALES.includes(lang) ? lang : 'en';
if (currentLocale === 'en') {
  for (const loc of SUPPORTED_LOCALES) {
    if (currentPath.startsWith(`/${loc}/`) || currentPath === `/${loc}`) {
      currentLocale = loc as SupportedLocale;
      break;
    }
  }
}

const WP_BASE = (import.meta.env.PUBLIC_WC_STORE_URL || import.meta.env.WC_STORE_URL || 'https://api.ebbellejewelry.com').replace(/\/$/, '');

function decodeHtmlEntities(str: string): string {
  return String(str || '')
    .replace(/&#8217;/g, "'")
    .replace(/&#8216;/g, "'")
    .replace(/&#8220;/g, '"')
    .replace(/&#8221;/g, '"')
    .replace(/&#8211;/g, '–')
    .replace(/&#8212;/g, '—')
    .replace(/&#038;/g, '&')
    .replace(/&amp;/g, '&')
    .replace(/&quot;/g, '"')
    .replace(/&#039;/g, "'")
    .replace(/<[^>]+>/g, '')
    .trim();
}

function formatEnglishDate(isoDate: string): string {
  try {
    const d = new Date(isoDate);
    if (isNaN(d.getTime())) return '';
    return d.toLocaleDateString('en-US', {
      month: 'short',
      day: 'numeric',
      year: 'numeric',
    }).toUpperCase();
  } catch {
    return '';
  }
}

let post: any = null;
let relatedProducts: any[] = [];
let moreStories: any[] = [];

try {
  // 1. 按 slug 拉取当前 WordPress 文章
  const res = await fetch(`${WP_BASE}/wp-json/wp/v2/posts?slug=${encodeURIComponent(slug)}&_embed=1`);
  if (res.ok) {
    const arr = await res.json();
    if (Array.isArray(arr) && arr.length > 0) {
      post = arr[0];
    }
  }
} catch (err) {
  console.error('[Blog Detail] 获取文章失败:', err);
}

if (!post) {
  return Astro.redirect(addLocalePrefix('/blog', currentLocale), 302);
}

const postTitle = decodeHtmlEntities(post.title?.rendered || 'Article');
const postContentHtml = String(post.content?.rendered || '');
const postExcerpt = decodeHtmlEntities(post.excerpt?.rendered || '');
const authorName = String(post._embedded?.author?.[0]?.name || 'E.B.BELLE').toUpperCase();
const dateFormatted = formatEnglishDate(post.date);
const categoriesList = (post._embedded?.['wp:term']?.[0] || []).map((c: any) => ({
  id: Number(c.id),
  name: decodeHtmlEntities(c.name),
  slug: String(c.slug),
}));
const primaryCategory = categoriesList[0] || { id: 0, name: 'JOURNAL', slug: '' };

const embeddedMedia = post._embedded?.['wp:featuredmedia']?.[0];
const heroImage =
  embeddedMedia?.media_details?.sizes?.full?.source_url ||
  embeddedMedia?.media_details?.sizes?.large?.source_url ||
  embeddedMedia?.source_url ||
  '';

// 阅读时长（优先读取 ACF read_time，否则按字数自动估算）
const plainTextWords = postContentHtml.replace(/<[^>]+>/g, ' ').trim().split(/\s+/).filter(Boolean).length;
const readTimeText = post.acf?.read_time
  ? String(post.acf.read_time).toUpperCase()
  : `${Math.max(2, Math.ceil(plainTextWords / 220))} MIN READ`;

// 2. 对接 ACF related_products 字段（支持 ID 数组或 Post Object 数组）
try {
  const rawAcfProducts = post.acf?.related_products;
  let productIds: number[] = [];

  if (Array.isArray(rawAcfProducts) && rawAcfProducts.length > 0) {
    productIds = rawAcfProducts
      .map((item: any) => (typeof item === 'object' && item !== null ? Number(item.ID || item.id) : Number(item)))
      .filter((id: number) => id > 0);
  }

  if (productIds.length > 0) {
    const { data: wcProducts } = await wcRequest('products', {
      include: productIds.slice(0, 4).join(','),
      status: 'publish',
    });
    if (Array.isArray(wcProducts)) {
      relatedProducts = wcProducts;
    }
  } else {
    // 若文章未手动绑定 ACF 商品，自动拉取 3 款精选热销商品兜底
    const { data: fallbackProducts } = await wcRequest('products', {
      per_page: 3,
      orderby: 'popularity',
      status: 'publish',
    });
    if (Array.isArray(fallbackProducts)) {
      relatedProducts = fallbackProducts;
    }
  }
} catch (prodErr) {
  console.error('[Blog Detail] 拉取关联商品失败:', prodErr);
}

// 3. 拉取底部 3 篇关联推荐文章（排除当前文章）
try {
  const moreUrl = new URL(`${WP_BASE}/wp-json/wp/v2/posts`);
  moreUrl.searchParams.set('per_page', '3');
  moreUrl.searchParams.set('exclude', String(post.id));
  moreUrl.searchParams.set('_embed', '1');
  if (primaryCategory.id > 0) {
    moreUrl.searchParams.set('categories', String(primaryCategory.id));
  }
  const moreRes = await fetch(moreUrl.toString());
  if (moreRes.ok) {
    const rawMore = await moreRes.json();
    if (Array.isArray(rawMore)) {
      moreStories = rawMore.map((m: any) => {
        const media = m._embedded?.['wp:featuredmedia']?.[0];
        return {
          slug: String(m.slug),
          title: decodeHtmlEntities(m.title?.rendered || ''),
          author: String(m._embedded?.author?.[0]?.name || 'E.B.BELLE').toUpperCase(),
          dateFormatted: formatEnglishDate(m.date),
          image:
            media?.media_details?.sizes?.large?.source_url ||
            media?.source_url ||
            'https://images.unsplash.com/photo-1515562141207-7a88fb7ce338?w=800&q=80',
        };
      });
    }
  }
} catch {}

if (Astro.response) {
  Astro.response.headers.set('Cache-Control', 'public, max-age=120, s-maxage=300');
}
---

<Layout title={`${postTitle} - E.B.Belle Journal`}>
  <Header />

  <article class="single-article-page">
    <!-- 1. 文章顶部信息区 -->
    <header class="article-header-wrap">
      <div class="article-narrow-container">
        <nav class="article-breadcrumb" aria-label="Breadcrumb">
          <a href={addLocalePrefix('/', currentLocale)}>Home</a>
          <span>/</span>
          <a href={addLocalePrefix('/blog', currentLocale)}>Journal</a>
          {primaryCategory.slug && (
            <>
              <span>/</span>
              <a href={addLocalePrefix(`/blog?category=${primaryCategory.slug}`, currentLocale)}>
                {primaryCategory.name}
              </a>
            </>
          )}
        </nav>

        <div class="article-meta-line">
          <span>{authorName}</span>
          {dateFormatted && (
            <>
              <span class="dot">/</span>
              <time>{dateFormatted}</time>
            </>
          )}
          <span class="dot">•</span>
          <span>{readTimeText}</span>
        </div>

        <h1 class="article-main-title">{postTitle}</h1>
      </div>

      {heroImage && (
        <div class="article-hero-media">
          <img src={heroImage} alt={postTitle} loading="eager" />
        </div>
      )}
    </header>

    <!-- 2. 主体双栏区：左侧正文 + 右侧目录与 VIP 礼遇 -->
    <div class="article-body-container">
      <div class="article-layout-grid">
        <!-- 左侧正文 -->
        <div class="article-prose-column">
          <div class="wp-article-content" id="wpArticleContent" set:html={postContentHtml} />

          <!-- 文内关联商品加购条（读取 ACF related_products） -->
          {relatedProducts.length > 0 && (
            <section class="shop-the-story-box reveal-up">
              <div class="story-shop-header">
                <div>
                  <span class="story-shop-eyebrow">CURATED FROM THIS ARTICLE</span>
                  <h2 class="story-shop-title">Shop The Story</h2>
                </div>
                <a href={addLocalePrefix('/shop', currentLocale)} class="story-shop-viewall">
                  View All <i class="fa-solid fa-arrow-right"></i>
                </a>
              </div>

              <div class="story-products-list">
                {relatedProducts.map((prod: any) => {
                  const pImg = prod.images?.[0]?.src || 'https://images.unsplash.com/photo-1515562141207-7a88fb7ce338?w=300&q=80';
                  const pPrice = parseFloat(prod.price || prod.regular_price || '0').toFixed(2);
                  const pRegPrice = parseFloat(prod.regular_price || '0').toFixed(2);
                  const hasSale = parseFloat(pRegPrice) > parseFloat(pPrice);
                  const safePayload = JSON.stringify({
                    id: prod.id,
                    name: prod.name,
                    slug: prod.slug,
                    type: prod.type || 'simple',
                    price: pPrice,
                    regular_price: pRegPrice,
                    image: pImg,
                    weight: prod.weight || '0',
                    stock_status: prod.stock_status || 'instock',
                    manage_stock: Boolean(prod.manage_stock),
                    stock_quantity: prod.stock_quantity,
                    variations: prod.variations || [],
                    attributes: prod.attributes || [],
                    images: prod.images || [],
                  }).replace(/'/g, '&apos;');

                  return (
                    <div class="story-product-row">
                      <a href={addLocalePrefix(`/product/${prod.slug}`, currentLocale)} class="story-prod-thumb">
                        <img src={pImg} alt={prod.name} loading="lazy" />
                      </a>
                      <div class="story-prod-info">
                        <a href={addLocalePrefix(`/product/${prod.slug}`, currentLocale)} class="story-prod-name">
                          {prod.name}
                        </a>
                        <div class="story-prod-price-row">
                          <span class="story-prod-price">${pPrice}</span>
                          {hasSale && <span class="story-prod-old">${pRegPrice}</span>}
                        </div>
                      </div>
                      <button
                        type="button"
                        class="btn-story-add"
                        data-product={safePayload}
                      >
                        <i class="fa-solid fa-bag-shopping"></i>
                        <span>Add</span>
                      </button>
                    </div>
                  );
                })}
              </div>
            </section>
          )}

          <!-- 文章底部返回与标签 -->
          <div class="article-footer-bar">
            <a href={addLocalePrefix('/blog', currentLocale)} class="back-to-journal-link">
              <i class="fa-solid fa-arrow-left"></i>
              <span>Back to All Stories</span>
            </a>
            <div class="article-share-actions">
              <button type="button" class="copy-link-btn" id="copyArticleLinkBtn">
                <i class="fa-solid fa-link"></i>
                <span>Copy Link</span>
              </button>
            </div>
          </div>
        </div>

        <!-- 右侧粘性边栏（自动提取正文 H2 目录 + VIP 优惠券） -->
        <aside class="article-sidebar-column">
          <div class="sidebar-sticky-stack">
            <div class="toc-card" id="articleTocCard" style="display: none;">
              <h3 class="toc-card-title">In This Article</h3>
              <ul class="toc-links-list" id="articleTocList"></ul>
            </div>

            <div class="sidebar-vip-card">
              <span class="vip-tag">VIP WELCOME BENEFIT</span>
              <h4>$200 Value</h4>
              <p>Enjoy 15% off your first order + complimentary waterproof jewelry pouch on orders $25+.</p>
              <a href={addLocalePrefix('/shop', currentLocale)} class="btn-vip-shop">
                Explore Waterproof Collection
              </a>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </article>

  <!-- 3. 底部延伸阅读（同风格杂志卡片 + 由下往上渐入） -->
  {moreStories.length > 0 && (
    <section class="more-stories-section">
      <div class="more-stories-container">
        <div class="more-stories-header">
          <h2>More From The Journal</h2>
          <a href={addLocalePrefix('/blog', currentLocale)} class="more-stories-all">View All &gt;</a>
        </div>

        <div class="more-stories-grid">
          {moreStories.map((item, idx) => (
            <article class="editorial-post-card reveal-up" style={`--stagger-delay: ${idx * 90}ms;`}>
              <a href={addLocalePrefix(`/blog/${item.slug}`, currentLocale)} class="editorial-card-link">
                <div class="editorial-thumb-wrap">
                  <img src={item.image} alt={item.title} loading="lazy" class="editorial-thumb-img" />
                </div>
                <div class="editorial-meta">
                  <span>{item.author}</span>
                  {item.dateFormatted && (
                    <>
                      <span class="meta-sep">/</span>
                      <time>{item.dateFormatted}</time>
                    </>
                  )}
                </div>
                <h3 class="editorial-post-title">{item.title}</h3>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <Footer />
  <CartDrawer />
  <AuthModal />
</Layout>

<style>
  html,
  body {
    max-width: 100vw;
    overflow-x: hidden;
  }

  @media (max-width: 820px) {
    :root {
      --container-w: 100%;
    }
  }

  .single-article-page {
    background: #ffffff;
    padding-bottom: 72px;
    width: 100%;
    max-width: 100%;
    overflow-x: hidden;
  }

  .article-header-wrap {
    padding-top: 40px;
  }

  .article-narrow-container {
    max-width: 820px;
    margin: 0 auto;
    padding: 0 24px;
    text-align: center;
  }

  .article-breadcrumb {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 11.5px;
    font-weight: 400;
    color: #8c857b;
    margin-bottom: 18px;
    flex-wrap: wrap;
  }

  .article-breadcrumb a:hover {
    color: #1a1a1a;
  }

  .article-meta-line {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.12em;
    color: #8c857b;
    text-transform: uppercase;
    margin-bottom: 14px;
    flex-wrap: wrap;
  }

  .article-main-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 38px;
    font-weight: 800;
    line-height: 1.24;
    color: #1a1a1a;
    margin: 0 0 32px 0;
    overflow-wrap: break-word;
  }

  .article-hero-media {
    max-width: 1140px;
    margin: 0 auto 48px;
    padding: 0 24px;
  }

  .article-hero-media img {
    width: 100%;
    max-height: 540px;
    object-fit: cover;
    border-radius: 12px;
    display: block;
  }

  /* 正文双栏 */
  .article-body-container {
    max-width: 1220px;
    margin: 0 auto;
    padding: 0 24px;
    width: 100%;
  }

  .article-layout-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 310px;
    gap: 56px;
    align-items: start;
    width: 100%;
  }

  .article-prose-column,
  .article-sidebar-column {
    min-width: 0;
    max-width: 100%;
  }

  /* WordPress 富文本排版样式 */
  :global(.wp-article-content) {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 16.5px;
    font-weight: 400;
    line-height: 1.85;
    color: #2b2927;
    max-width: 100%;
    overflow-wrap: break-word;
    word-break: break-word;
  }

  :global(.wp-article-content *) {
    max-width: 100%;
    box-sizing: border-box;
  }

  :global(.wp-article-content p) {
    margin-bottom: 22px;
    font-weight: 400;
  }

  :global(.wp-article-content h2) {
    font-size: 25px;
    font-weight: 800;
    line-height: 1.3;
    color: #1a1a1a;
    margin: 42px 0 16px;
    scroll-margin-top: 90px;
  }

  :global(.wp-article-content h3) {
    font-size: 20px;
    font-weight: 600;
    line-height: 1.35;
    color: #1a1a1a;
    margin: 30px 0 12px;
  }

  :global(.wp-article-content img),
  :global(.wp-article-content figure),
  :global(.wp-article-content iframe),
  :global(.wp-article-content video) {
    width: 100% !important;
    max-width: 100% !important;
    height: auto;
    border-radius: 8px;
    margin: 28px 0;
  }

  :global(.wp-article-content table) {
    display: block;
    width: 100%;
    overflow-x: auto;
  }

  :global(.wp-article-content ul),
  :global(.wp-article-content ol) {
    margin: 0 0 22px 22px;
    list-style: disc;
  }

  :global(.wp-article-content li) {
    margin-bottom: 8px;
  }

  :global(.wp-article-content blockquote) {
    margin: 30px 0;
    padding: 20px 24px;
    background: #faf8f5;
    border-left: 3px solid #c9933f;
    font-style: italic;
    font-size: 17.5px;
    color: #1a1a1a;
  }

  :global(.wp-article-content a) {
