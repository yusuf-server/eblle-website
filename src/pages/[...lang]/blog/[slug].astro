    height: 100%;
    object-fit: cover;
  }

  .story-prod-info {
    flex: 1;
    min-width: 0;
  }

  .story-prod-name {
    display: block;
    font-size: 14px;
    font-weight: 600;
    color: #1a1a1a;
    margin-bottom: 4px;
    line-height: 1.35;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .story-prod-name:hover {
    color: #9e6325;
  }

  .story-prod-price-row {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }

