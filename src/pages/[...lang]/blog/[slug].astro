    align-items: center;
    gap: 6px;
    flex-shrink: 0;
  }

  .story-products-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .story-product-row {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px;
    background: #ffffff;
    border: 1px solid #ece6dc;
    border-radius: 6px;
    min-width: 0;
