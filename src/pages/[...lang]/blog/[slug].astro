<script>
  function initBlogDetailPage() {
    // 1. 自动扫描正文中的 H2 生成右侧目录
    const contentEl = document.getElementById('wpArticleContent');
    const tocCard = document.getElementById('articleTocCard');
    const tocList = document.getElementById('articleTocList');

    if (contentEl && tocCard && tocList) {
      const headings = contentEl.querySelectorAll('h2');
      if (headings.length >= 2) {
        headings.forEach((h2, index) => {
          const id = `section-heading-${index + 1}`;
          h2.id = id;
          const li = document.createElement('li');
          const a = document.createElement('a');
          a.href = `#${id}`;
          a.textContent = h2.textContent || '';
          li.appendChild(a);
          tocList.appendChild(li);
        });
        tocCard.style.display = 'block';
      }
    }

    // 2. 文内关联商品加购交互（对接全站购物车与多规格弹窗）
    document.querySelectorAll('.btn-story-add').forEach((btn) => {
      btn.addEventListener('click', () => {
        const raw = btn.getAttribute('data-product');
        if (!raw) return;
        try {
          const prod = JSON.parse(raw);

          // 多规格商品直接唤起全局 Quick Order 选规格弹窗
          if (prod.type === 'variable' && typeof (window as any).openQuickOrderWithData === 'function') {
            (window as any).openQuickOrderWithData(prod);
            return;
          }

          // 单品直接写入 ebbelle_cart 并打开右侧购物袋抽屉
          let cart: any[] = [];
          try {
            const existing = localStorage.getItem('ebbelle_cart');
            if (existing) cart = JSON.parse(existing);
          } catch {}

          const cartItemId = `${prod.id}_simple`;
          const foundIdx = cart.findIndex((i) => i.cartItemId === cartItemId);
          if (foundIdx > -1) {
            cart[foundIdx].quantity += 1;
          } else {
            cart.push({
              cartItemId,
              id: prod.id,
              name: prod.name,
              price: prod.price,
              basePrice: parseFloat(prod.price) || 0,
              quantity: 1,
              weight: parseFloat(prod.weight) || 0,
              image: prod.image,
              selectedVariants: {},
              variationId: null,
            });
          }

          localStorage.setItem('ebbelle_cart', JSON.stringify(cart));
          window.dispatchEvent(new CustomEvent('cartUpdated', { detail: { cart } }));

          const cartDrawer = document.getElementById('cartDrawer');
          const cartOverlay = document.getElementById('cartOverlay');
          if (cartDrawer && cartOverlay) {
            cartDrawer.classList.add('active');
            cartOverlay.classList.add('active');
            document.body.style.overflow = 'hidden';
          }
        } catch (err) {
          console.error('Add story product error:', err);
        }
      });
    });

    // 3. 复制链接按钮
    const copyBtn = document.getElementById('copyArticleLinkBtn');
    if (copyBtn) {
      copyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(window.location.href);
          const span = copyBtn.querySelector('span');
          if (span) {
            const orig = span.textContent;
            span.textContent = 'Copied!';
            setTimeout(() => {
              span.textContent = orig;
            }, 1600);
          }
        } catch {}
      });
    }

    // 4. 由下往上渐入动画
    const revealEls = document.querySelectorAll('.reveal-up');
    if ('IntersectionObserver' in window) {
      const obs = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-revealed');
              obs.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.08 }
      );
      revealEls.forEach((el) => obs.observe(el));
    } else {
      revealEls.forEach((el) => el.classList.add('is-revealed'));
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initBlogDetailPage);
  } else {
    initBlogDetailPage();
  }
</script>