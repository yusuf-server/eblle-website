---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CartDrawer from '../../components/CartDrawer.astro';
import { SUPPORTED_LOCALES, type SupportedLocale } from '../../lib/i18n/utils';
import { t } from '../../lib/i18n/translations';
import { translate } from '../../lib/i18n/translator';
import { getCacheFromContext } from '../../lib/i18n/cache';

// 1. 获取语言参数
const lang = Astro.params.lang as SupportedLocale | undefined;
const currentLocale: SupportedLocale = lang && SUPPORTED_LOCALES.includes(lang as SupportedLocale)
  ? (lang as SupportedLocale)
  : 'en';

// 2. 缓存和上下文配置
const cache = getCacheFromContext(Astro.locals);
const translateConfig = {
  engine: 'cloudflare-ai' as const,
  cache,
  cachePrefix: 'bracelet-size-guide'
};
const context = {
  AI: Astro.locals.AI
};

// 3. 动态翻译辅助函数
async function tr(text: string): Promise<string> {
  if (currentLocale === 'en' || !text) return text;
  return await translate(text, currentLocale, translateConfig, context);
}

// ----------------------------------------------------
// 🖼️ 手腕测量图 URL 预留（在此替换你的实际图片链接）
// ----------------------------------------------------
const imgWristMeasure = 'https://api.ebbellejewelry.com/wp-content/uploads/2026/05/Illustration-showing-how-to-measure-wrist-size-for-bracelets-using-a-soft-measuring-tape.webp';

// 4. 原始文案提取与翻译
const pageTitle = await tr('BRACELET SIZE GUIDE');
const introText = await tr("Finding the perfect fit is essential for both comfort and style. Whether you are looking for a delicate chain or a bold statement bangle, use this guide to ensure your new piece fits perfectly.");

// 5. HOW TO MEASURE YOUR WRIST
const measureTitle = await tr('HOW TO MEASURE YOUR WRIST');
const measureLead = await tr('To determine your bracelet size, follow these simple steps:');
const measureSteps = [
  {
    lead: await tr('Measure Your Wrist:'),
    text: await tr('Wrap a flexible measuring tape around your wrist bone where you would naturally wear a bracelet. Keep it snug without pulling too tight.')
  },
  {
    lead: await tr('Use Paper if Needed:'),
    text: await tr('If you don’t have a measuring tape, wrap a strip of paper around your wrist, mark where it overlaps, then lay it flat against a ruler to measure the length.')
  },
  {
    lead: await tr('Note Your Measurement:'),
    text: await tr('This is your Wrist Circumference. Refer to the chart below to find your ideal size.')
  }
];

// 6. BRACELET SIZE CHART (松紧喜好偏好)
const fitChartTitle = await tr('BRACELET SIZE CHART');
const fitChartLead = await tr('Depending on your preference for a snug, comfort, or loose fit, we recommend adding 1cm to 2.5cm to your wrist measurement. CHOOSE YOUR PREFERRED FIT:');
const fitPreferences = [
  {
    lead: await tr('Snug Fit:'),
    text: await tr('Add 1cm to your wrist circumference. Best for dainty, thin chain bracelets.')
  },
  {
    lead: await tr('Comfort Fit:'),
    text: await tr('Add 1.5cm to your wrist circumference. The ideal fit for most bracelet styles.')
  },
  {
    lead: await tr('Loose Fit:'),
    text: await tr('Add 2-2.5cm to your wrist circumference. Recommended for chunky bangles or statement cuffs.')
  }
];

// 7. FIXED SIZE BRACELETS (E.G. CLOSED BANGLE)
const fixedSectionTitle = await tr('FIXED SIZE BRACELETS (E.G. CLOSED BANGLE)');
const fixedSectionDesc1 = await tr('Some styles, like our Tennis Bracelets, come in a fixed length and are not adjustable.');
const fixedSectionDesc2 = await tr('We recommend choosing a size that is at least 1.5cm longer than your actual circumference for these pieces.');

const fixedTableHeaders = [
  await tr('FIXED LENGTH (CM)'),
  await tr('BEST FOR WRIST UP TO')
];

const fixedTableRows = [
  { length: '16cm', wrist: '14.5cm' },
  { length: '17cm', wrist: '15.5cm' },
  { length: '18cm', wrist: '16.5cm' }
];

const fixedFootnote = await tr('Tip: If you fall between sizes, we always suggest sizing up. Many of our chain bracelets also feature extender links for added flexibility.');
---

<Layout title={`${pageTitle} - E.B.Belle`}>
  <Header />

  <main class="bracelet-guide-page">
    <div class="bracelet-container">
      <!-- 页面大标题与引言 -->
      <h1 class="page-title">{pageTitle}</h1>
      <p class="page-intro">{introText}</p>

      <!-- 1. 顶部测量手腕图文模块 -->
      <section class="measure-showcase-section">
        <div class="showcase-img-col">
          <img src={imgWristMeasure} alt="Wrist Circumference Measurement Guide" loading="lazy" />
        </div>
        <div class="showcase-text-col">
          <!-- 步骤指引 -->
          <div class="guide-sub-block">
            <h2 class="sub-block-title">{measureTitle}</h2>
            <p class="sub-block-lead">{measureLead}</p>
            <ul class="guide-steps-list">
              {measureSteps.map((step) => (
                <li>
                  <strong>{step.lead}</strong> {step.text}
                </li>
              ))}
            </ul>
          </div>

          <!-- 松紧偏好指引 -->
          <div class="guide-sub-block mt-block">
            <h2 class="sub-block-title">{fitChartTitle}</h2>
            <p class="sub-block-lead">{fitChartLead}</p>
            <ul class="guide-steps-list">
              {fitPreferences.map((fit) => (
                <li>
                  <strong>{fit.lead}</strong> {fit.text}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>

      <!-- 2. 固定长度与闭口手镯表格板块 -->
      <section class="fixed-size-section">
        <h2 class="section-heading">{fixedSectionTitle}</h2>
        <div class="fixed-desc-wrap">
          <p>{fixedSectionDesc1}</p>
          <p>{fixedSectionDesc2}</p>
        </div>

        <div class="table-wrap">
          <table class="fixed-size-table">
            <thead>
              <tr>
                {fixedTableHeaders.map((head) => (
                  <th>{head}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {fixedTableRows.map((row) => (
                <tr>
                  <td class="col-fixed-len"><strong>{row.length}</strong></td>
                  <td class="col-wrist-fit">{row.wrist}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <p class="fixed-footnote">{fixedFootnote}</p>
      </section>
    </div>
  </main>

  <Footer />
  <CartDrawer />
</Layout>

<style>
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  .bracelet-guide-page {
    width: 100%;
    background: #ffffff;
    color: #1a1a1a;
    padding: 60px 20px 100px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  }

  .bracelet-container {
    max-width: 960px;
    margin: 0 auto;
  }

  /* 页面大标题：高级珠宝风 */
  .page-title {
    font-family: 'Cinzel', 'Bodoni Moda', 'Playfair Display', Georgia, serif;
    font-size: 26px;
    font-weight: 500;
    letter-spacing: 3px;
    text-align: center;
    color: #111;
    text-transform: uppercase;
    margin-bottom: 12px;
  }

  .page-intro {
    font-size: 13px;
    color: #555;
    text-align: center;
    line-height: 1.7;
    max-width: 760px;
    margin: 0 auto 50px;
  }

  /* 顶部图文模块：左实拍图 右文字 */
 .measure-showcase-section {
  display: flex;
  align-items: stretch; /* 两侧高度自动拉伸齐平 */
  gap: 48px;
  margin-bottom: 65px;
}

  .showcase-img-col {
  flex: 1.1;
  min-width: 0;
  display: flex;
}

.showcase-img-col img {
  width: 100%;
  height: 100%;
  min-height: 480px; /* 撑起高度，与右侧两块文案齐平 */
  max-height: 540px;
  object-fit: cover; /* 保证原图不拉伸变形，居中裁切 */
  object-position: center;
  border-radius: 4px;
}

  .showcase-text-col {
    flex: 1.3;
    min-width: 0;
  }

  .guide-sub-block {
    display: flex;
    flex-direction: column;
  }

  .mt-block {
    margin-top: 28px;
    padding-top: 24px;
    border-top: 1px dashed #e8e8e8;
  }

  .sub-block-title {
    font-family: 'Cinzel', 'Bodoni Moda', Georgia, serif;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 1.4px;
    color: #111;
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .sub-block-lead {
    font-size: 12.5px;
    color: #666;
    line-height: 1.6;
    margin-bottom: 14px;
  }

  .guide-steps-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .guide-steps-list li {
    font-size: 12.5px;
    color: #555;
    line-height: 1.65;
    position: relative;
    padding-left: 14px;
  }

  .guide-steps-list li::before {
    content: '•';
    color: #d4a04d;
    position: absolute;
    left: 0;
    font-size: 14px;
    line-height: 1.4;
  }

  .guide-steps-list li strong {
    color: #111;
    font-weight: 700;
  }

  /* 固定手镯表格板块 */
  .fixed-size-section {
    margin-top: 40px;
  }

  /* 统一大号饰品分类小标题（星芒 ✦ + 渐变金线） */
  .section-heading {
    font-family: 'Cinzel', 'Bodoni Moda', Georgia, serif;
    font-size: 17px;
    font-weight: 600;
    letter-spacing: 1.8px;
    color: #1a1a1a;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 18px;
    position: relative;
    padding-bottom: 10px;
  }

  .section-heading::before {
    content: '✦';
    font-size: 14px;
    color: #d4a04d;
    line-height: 1;
    transform: translateY(-0.5px);
    text-shadow: 0 0 6px rgba(212, 160, 77, 0.35);
  }

  .section-heading::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 1px;
    background: linear-gradient(90deg, rgba(212, 160, 77, 0.6) 0%, rgba(212, 160, 77, 0.15) 30%, rgba(235, 235, 235, 0.4) 100%);
  }

  .fixed-desc-wrap {
    margin-bottom: 22px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .fixed-desc-wrap p {
    font-size: 12.5px;
    color: #666;
    line-height: 1.65;
  }

  /* 居中尺寸对比表格 */
  .table-wrap {
    max-width: 650px;
    margin: 0 auto 18px;
    border: 1px solid #e8e8e8;
    background: #fff;
  }

  .fixed-size-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 12.5px;
    text-align: center;
  }

  .fixed-size-table thead th {
    background: #fafaf8;
    padding: 14px 16px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: #222;
    border-bottom: 1px solid #e8e8e8;
    white-space: nowrap;
  }

  .fixed-size-table tbody td {
    padding: 15px 16px;
    border-bottom: 1px solid #f0f0f0;
    color: #555;
  }

  .fixed-size-table tbody tr:last-child td {
    border-bottom: none;
  }

  .fixed-size-table tbody tr:hover {
    background: #fafaf8;
  }

  .col-fixed-len strong {
    color: #111;
  }

  .col-wrist-fit {
    color: #333;
    font-weight: 500;
  }

  .fixed-footnote {
    font-size: 12px;
    color: #777;
    text-align: center;
    line-height: 1.6;
    font-style: italic;
    max-width: 720px;
    margin: 0 auto;
  }

  /* 移动端与平板响应式适配 */
  @media (max-width: 768px) {
    .bracelet-guide-page {
      padding: 40px 16px 70px;
    }
    .page-title {
      font-size: 22px;
      letter-spacing: 2px;
    }
    .measure-showcase-section {
      flex-direction: column;
      gap: 28px;
      margin-bottom: 45px;
    }
    .showcase-img-col, .showcase-text-col {
      width: 100%;
    }
    .showcase-img-col img {
      max-height: 280px;
    }
    .section-heading {
      font-size: 15px;
    }
    .fixed-size-table thead th,
    .fixed-size-table tbody td {
      padding: 12px 14px;
      font-size: 12px;
    }
  }
</style>