    flex-direction: column;
    align-items: center;
    box-shadow: 0 8px 24px -6px rgba(66, 102, 86, 0.08);
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }
  .xmas-mystery-card:hover {
    transform: translateY(-3px);
    border-color: #d6b879;
  }
  .xmas-mystery-card.is-revealed {
    border-color: rgba(214, 184, 121, 0.9);
  }
  .xmas-mystery-card.is-active-copied {
    border-color: #961820;
    box-shadow: 0 12px 28px -6px rgba(150, 24, 32, 0.16);
  }
  .xmas-gift-icon-ring {
    width: 68px;
    height: 68px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 14px;
    padding: 8px;
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .xmas-gift-custom-icon {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }
  .xmas-mystery-card:hover .xmas-gift-icon-ring,
  .xmas-mystery-card.is-active-copied .xmas-gift-icon-ring {
    transform: scale(1.08) rotate(-4deg);
  }
  .xmas-gift-icon-ring.red { background: #fbeaea; }
  .xmas-gift-icon-ring.pine { background: #e3f2eb; }
  .xmas-gift-icon-ring.gold { background: #fbf1da; }

  .xmas-mystery-eyebrow {
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #597268;
    margin-bottom: 4px;
  }
  .xmas-mystery-title {
    font-family: 'Playfair Display', serif;
    font-size: 19px;
    font-weight: 700;
    color: #1e1b14;
    margin: 0 0 6px;
  }
  .xmas-mystery-sub {
    font-size: 12px;
    color: #6f5855;
    margin: 0 0 16px;
    line-height: 1.4;
  }

  /* 刮刮乐涂层容器 */
  .xmas-scratch-slot {
    position: relative;
    width: 100%;
    max-width: 260px;
    height: 78px;
    border-radius: 12px;
    overflow: hidden;
    border: 1.5px dashed #c89b4b;
    background: linear-gradient(135deg, #fffdf9 0%, #fdf2e3 100%);
    user-select: none;
    -webkit-user-select: none;
    touch-action: none;
  }
  .xmas-scratch-reveal {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px 10px;
    z-index: 1;
  }
  .xmas-code-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #fff;
    border: 1.5px solid #961820;
    padding: 6px 14px;
    border-radius: 999px;
    cursor: pointer;
    box-shadow: 0 3px 10px rgba(150, 24, 32, 0.08);
    transition: all 0.2s ease;
  }
  .xmas-code-pill:hover {
    background: #fff4f4;
    transform: scale(1.03);
  }
  .xmas-code-pill:active {
    transform: scale(0.98);
  }
  .xmas-code-text {
    font-family: monospace;
    font-size: 15px;
    font-weight: 800;
    color: #961820;
    letter-spacing: 0.08em;
  }
  .xmas-copy-state-badge {
    font-size: 9.5px;
    font-weight: 800;
    background: #f3e6d3;
    color: #7c5620;
    padding: 2.5px 8px;
    border-radius: 999px;
    letter-spacing: 0.04em;
    transition: all 0.2s ease;
  }
  .xmas-mystery-card.is-active-copied .xmas-copy-state-badge {
    background: #234638;
    color: #ffffff;
  }
  .xmas-scratch-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
    cursor: grab;
    transition: opacity 0.45s ease;
  }
  .xmas-scratch-canvas:active {
    cursor: grabbing;
  }
  .xmas-scratch-canvas.faded {
    opacity: 0;
    pointer-events: none;
  }

  /* 刮出后英文复制提示栏 */
  .xmas-scratch-tip-banner {
    margin-top: 22px;
    background: #ffffff;
    border: 1.5px solid #234638;
    border-radius: 12px;
    padding: 14px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    flex-wrap: wrap;
    box-shadow: 0 8px 20px rgba(35, 70, 56, 0.1);
    animation: xmasSlideUpFade 0.35s ease;
  }
  @keyframes xmasSlideUpFade {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .xmas-tip-left {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .xmas-tip-left span.material-symbols-outlined {
    font-size: 26px;
    color: #234638;
    flex-shrink: 0;
  }
  .xmas-tip-left strong {
    display: block;
    font-size: 13.5px;
    color: #1e1b14;
    margin-bottom: 2px;
  }
  .xmas-tip-left span {
    font-size: 12px;
    color: #59413f;
  }
  .xmas-tip-actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .xmas-copy-again-btn {
    padding: 8px 14px;
    border-radius: 999px;
    border: 1px solid #d6b879;
    background: #fbf3e6;
    color: #1e1b14;
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
  }
  .xmas-redeem-now-btn {
    padding: 9px 18px;
    border-radius: 999px;
    background: #961820;
    color: #ffffff;
    font-size: 12px;
    font-weight: 700;
    text-decoration: none;
  }

  /* Product Grid Header & Cards */
  .xmas-grid-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px;
    flex-wrap: wrap;
    margin-bottom: 26px;
  }
  .xmas-products-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
    min-height: 360px;
  }
  .xmas-loading-box {
    grid-column: 1 / -1;
    text-align: center;
    padding: 60px 20px;
    color: #59413f;
  }

  .xmas-prod-card {
    position: relative;
    background: #ffffff;
    border: 1px solid rgba(214, 184, 121, 0.55);
    border-radius: 14px;
    padding: 14px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: 0 6px 20px -4px rgba(66, 102, 86, 0.06);
    transition: all 0.25s ease;
  }
  .xmas-prod-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 14px 28px -6px rgba(184, 50, 53, 0.14);
  }
  .xmas-prod-img-wrap {
    position: relative;
    aspect-ratio: 1;
    border-radius: 10px;
    overflow: hidden;
    background: #fbf3e6;
    margin-bottom: 12px;
    display: block;
    cursor: pointer;
  }
  .xmas-prod-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .xmas-prod-card:hover .xmas-prod-img-wrap img {
    transform: scale(1.05);
  }
  .xmas-tag-left {
    position: absolute;
    top: 10px;
    left: 10px;
    background: #234638;
    color: #ffffff;
    font-size: 10px;
    font-weight: 700;
    padding: 3px 9px;
    border-radius: 999px;
    letter-spacing: 0.05em;
  }
  .xmas-tag-right {
    position: absolute;
    top: 10px;
    right: 10px;
    background: #961820;
    color: #ffffff;
    font-size: 10px;
    font-weight: 700;
    padding: 3px 9px;
    border-radius: 999px;
  }
  .xmas-prod-title {
    font-size: 14px;
    font-weight: 600;
    color: #1e1b14;
    margin: 0 0 6px;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    cursor: pointer;
    transition: color 0.2s;
  }
  .xmas-prod-title:hover {
    color: #961820;
  }
  .xmas-prod-price-row {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 12px;
    flex-wrap: wrap;
  }
  .xmas-prod-price {
    font-family: 'Playfair Display', serif;
    font-size: 19px;
    font-weight: 700;
    color: #961820;
  }
  .xmas-prod-old {
    font-size: 12.5px;
    color: #8d706e;
    text-decoration: line-through;
  }
  .xmas-prod-bogo-hint {
    font-size: 10.5px;
    font-weight: 700;
    color: #234638;
    background: #e6f3ec;
    padding: 2px 7px;
    border-radius: 4px;
  }
  .xmas-add-btn {
    width: 100%;
    padding: 10px 12px;
    border-radius: 8px;
    border: none;
    background: #961820;
    color: #ffffff;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    transition: background 0.2s;
  }
  .xmas-add-btn:hover {
    background: #234638;
  }

  /* 底部 Load More & Explore All 按钮区域 */
  .xmas-grid-footer-actions {
    text-align: center;
    margin-top: 36px;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .xmas-load-more-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 14px 32px;
    border-radius: 999px;
    border: 1.5px solid #961820;
    background: #ffffff;
    color: #961820;
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    box-shadow: 0 6px 18px -4px rgba(150, 24, 32, 0.14);
    transition: all 0.22s ease;
  }
  .xmas-load-more-btn:hover:not(:disabled) {
    background: #961820;
    color: #ffffff;
    transform: translateY(-1px);
  }
  .xmas-load-more-btn:disabled {
    opacity: 0.85;
    cursor: wait;
  }
  .xmas-btn-spinner {
    display: none;
    width: 15px;
    height: 15px;
    border: 2px solid currentColor;
    border-top-color: transparent;
    border-radius: 50%;
    animation: xmasSpin 0.75s linear infinite;
    flex-shrink: 0;
  }
  .xmas-load-more-btn.is-loading .xmas-btn-spinner {
    display: inline-block;
  }

  .xmas-btn-outline {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 30px;
    border-radius: 999px;
    border: 1.5px solid #234638;
    background: #ffffff;
    color: #234638;
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-decoration: none;
    transition: all 0.2s;
  }
  .xmas-btn-outline:hover {
    background: #234638;
    color: #ffffff;
  }

  /* 骨架屏支撑 */
  @keyframes xmasShimmerAnim {
    0% { background-position: -200% 0; }
    100% { background-position: 200% 0; }
  }
  .product-skeleton {
    background: #ffffff;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid rgba(214, 184, 121, 0.45);
    display: flex;
    flex-direction: column;
    min-height: 280px;
  }
  .skeleton-image {
    width: 100%;
    aspect-ratio: 1;
    background: linear-gradient(90deg, #f7efe2 25%, #efe3d0 50%, #f7efe2 75%);
    background-size: 200% 100%;
    animation: xmasShimmerAnim 1.5s infinite;
  }
  .skeleton-content {
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .skeleton-line {
    height: 12px;
    background: linear-gradient(90deg, #f7efe2 25%, #efe3d0 50%, #f7efe2 75%);
    background-size: 200% 100%;
    animation: xmasShimmerAnim 1.5s infinite;
    border-radius: 4px;
  }
  .skeleton-line.skeleton-title { width: 85%; height: 14px; }
  .skeleton-line.skeleton-price { width: 45%; height: 16px; }
  .skeleton-line.skeleton-meta { width: 60%; height: 10px; }

  /* Unboxing Card */
  .xmas-unboxing-card {
    background: #ffffff;
    border: 1px solid rgba(214, 184, 121, 0.55);
    border-radius: 18px;
    overflow: hidden;
    display: grid;
    grid-template-columns: 1fr 1fr;
    box-shadow: 0 12px 32px -6px rgba(66, 102, 86, 0.08);
  }
  .xmas-unboxing-media {
    position: relative;
    min-height: 360px;
  }
  .xmas-unboxing-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .xmas-unboxing-badge {
    position: absolute;
    bottom: 18px;
    left: 18px;
    background: rgba(255, 255, 255, 0.94);
    padding: 8px 14px;
    border-radius: 8px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    font-weight: 700;
    color: #1e1b14;
  }
  .xmas-unboxing-badge span.material-symbols-outlined { color: #961820; font-size: 18px; }

  .xmas-unboxing-body {
    padding: 36px 34px;
  }
  .xmas-perks-stack {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .xmas-perk-row {
    background: #f5ede0;
    border-radius: 10px;
    padding: 12px 14px;
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }
  .xmas-perk-icon {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    flex-shrink: 0;
  }
  .xmas-perk-icon.pine { background: #234638; }
  .xmas-perk-icon.red { background: #961820; }
  .xmas-perk-icon.gold { background: #78612b; }
  .xmas-perk-row h4 { margin: 0 0 3px; font-size: 14.5px; font-weight: 700; color: #1e1b14; }
  .xmas-perk-row p { margin: 0; font-size: 12.5px; color: #59413f; line-height: 1.45; }

  /* FAQ & Concierge */
  .xmas-faq-layout {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    gap: 28px;
    align-items: start;
  }
  .xmas-accordion {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .xmas-acc-item {
    background: #ffffff;
    border: 1px solid rgba(214, 184, 121, 0.45);
    border-radius: 12px;
    overflow: hidden;
  }
  .xmas-acc-btn {
    width: 100%;
    padding: 16px 18px;
    background: transparent;
    border: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    text-align: left;
    font-size: 15px;
    font-weight: 700;
    color: #1e1b14;
    cursor: pointer;
  }
  .xmas-acc-body {
    display: none;
    padding: 0 18px 16px;
    font-size: 13.5px;
    line-height: 1.6;
    color: #59413f;
  }
  .xmas-acc-body.open { display: block; }

  .xmas-concierge-card {
    background: #ffffff;
    border: 1px solid rgba(214, 184, 121, 0.55);
    border-radius: 16px;
    padding: 28px 24px;
    box-shadow: 0 12px 28px -4px rgba(66, 102, 86, 0.08);
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .xmas-online-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    font-weight: 700;
    color: #234638;
    letter-spacing: 0.08em;
    margin-bottom: 10px;
  }
  .xmas-pulse-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #2e7d32;
    box-shadow: 0 0 0 4px rgba(46, 125, 50, 0.18);
  }
  .xmas-concierge-card h3 {
    font-family: 'Playfair Display', serif;
    font-size: 22px;
    margin: 0 0 8px;
  }
  .xmas-concierge-card p {
    font-size: 13.5px;
    color: #59413f;
    line-height: 1.55;
    margin: 0;
  }
  .xmas-concierge-actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .xmas-btn-pine {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: #234638;
    color: #ffffff;
    text-decoration: none;
    padding: 13px 16px;
    border-radius: 10px;
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.06em;
  }
  .xmas-btn-subtle {
    display: block;
    text-align: center;
    padding: 11px 16px;
    border-radius: 10px;
    background: #f5ede0;
    color: #1e1b14;
    text-decoration: none;
    font-size: 12.5px;
    font-weight: 600;
  }

  /* =========================================================
     圣诞定制版 Quick Order 弹窗（桌面端 + 移动端，红金松绿节日动效）
     ========================================================= */
  .xmas-qo-overlay {
    position: fixed;
    inset: 0;
    background: rgba(24, 15, 14, 0.65);
    backdrop-filter: blur(4px);
    z-index: 1001;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }
  .xmas-qo-overlay.active {
    opacity: 1;
    visibility: visible;
  }

  .xmas-qo-modal {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -46%) scale(0.92);
    width: 92%;
    max-width: 1100px;
    max-height: 86vh;
    background: #fffcf7;
    border: 1.5px solid #d6b879;
    border-radius: 16px;
    z-index: 1002;
    opacity: 0;
    visibility: hidden;
    transition: all 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    overflow: hidden;
    box-shadow: 0 24px 64px rgba(150, 24, 32, 0.25), 0 0 0 1px rgba(214, 184, 121, 0.4);
  }
  .xmas-qo-modal.active {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, -50%) scale(1);
  }

  .xmas-qo-close {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 36px;
    height: 36px;
    background: #fff8f0;
    border: 1px solid #d6b879;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    color: #961820;
    z-index: 10;
    transition: all 0.25s ease;
  }
  .xmas-qo-close:hover {
    background: #961820;
    color: #ffffff;
    transform: rotate(90deg);
  }

  .xmas-qo-content {
    display: grid;
    grid-template-columns: 45% 55%;
    height: 85vh;
    overflow: hidden;
  }
  .xmas-qo-images {
    background: linear-gradient(165deg, #fbf3e6 0%, #f5e9d6 100%);
    padding: 30px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    overflow-y: auto;
    border-right: 1px solid rgba(214, 184, 121, 0.45);
  }
  .xmas-qo-main-image {
    width: 100%;
    aspect-ratio: 1;
    border-radius: 12px;
    overflow: hidden;
    background: #fff;
    border: 1px solid rgba(214, 184, 121, 0.65);
    box-shadow: 0 8px 20px rgba(35, 70, 56, 0.08);
  }
  .xmas-qo-main-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s ease;
  }
  .xmas-qo-thumbnails {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 8px;
  }
  .xmas-qo-thumb {
    aspect-ratio: 1;
    border-radius: 8px;
    overflow: hidden;
    cursor: pointer;
    border: 2px solid transparent;
    transition: all 0.2s;
    background: #fff;
  }
  .xmas-qo-thumb:hover,
  .xmas-qo-thumb.active {
    border-color: #961820;
    transform: translateY(-2px);
  }
  .xmas-qo-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .xmas-qo-details {
    padding: 30px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 15px;
  }
  .xmas-qo-holiday-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    align-self: flex-start;
    background: linear-gradient(90deg, #234638 0%, #961820 100%);
    color: #ffdf9c;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.08em;
    padding: 4px 12px;
    border-radius: 999px;
  }
  .xmas-qo-title {
    font-size: 21px;
    font-family: 'Playfair Display', serif;
    font-weight: 700;
    color: #1e1b14;
    line-height: 1.3;
    margin: 0;
  }
  .xmas-qo-price {
    font-size: 26px;
    font-family: 'Playfair Display', serif;
    font-weight: 700;
    color: #961820;
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .xmas-qo-price-regular {
    font-size: 16px;
    color: #8d706e;
    text-decoration: line-through;
  }
  .xmas-qo-stock {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-weight: 700;
