  window.selectXmasMobileOption = function(el) {
    const group = el.closest('.xmas-qo-options');
    group?.querySelectorAll('.xmas-qo-option').forEach(o => o.classList.remove('selected'));
    el.classList.add('selected');
    updateXmasMobileVariation();
  };

  window.changeXmasQoQty = function(delta) {
    const inp = document.getElementById('xmasQoQty');
    if (!inp) return;
    inp.value = String(Math.max(1, (parseInt(inp.value, 10) || 1) + delta));
  };

  window.changeXmasMobileQty = function(delta) {
    const inp = document.getElementById('xmasMobileQtyInput');
    if (!inp) return;
    inp.value = String(Math.max(1, (parseInt(inp.value, 10) || 1) + delta));
  };

  function updateXmasDesktopVariation() {
    const variations = window.xmasCurrentVariations || [];
    if (!variations.length) return;

    const selected = {};
    document.querySelectorAll('#xmasQuickOrderContent .xmas-qo-options').forEach(group => {
      const attrName = group.getAttribute('data-attribute');
      const activeBtn = group.querySelector('.xmas-qo-option.selected');
      if (attrName && activeBtn) selected[attrName] = activeBtn.getAttribute('data-value');
    });

    const match = variations.find(v => v.attributes.every(a => selected[a.name] === a.option));
    const stockBox = document.getElementById('xmasQoStockContainer');
    const priceBox = document.getElementById('xmasQoPriceContainer');
    const addBtn = document.getElementById('xmasQoAddBtn');
    const mainImg = document.getElementById('xmasQoMainImg');

    if (match) {
      const p = parseFloat(match.price) || 0;
      const rp = parseFloat(match.regular_price) || 0;
      if (priceBox) {
        priceBox.innerHTML = rp > p
          ? `<div class="xmas-qo-price"><span>${formatPrice(p)}</span><span class="xmas-qo-price-regular">${formatPrice(rp)}</span></div>`
          : `<div class="xmas-qo-price"><span>${formatPrice(p)}</span></div>`;
      }
      if (match.image?.src && mainImg) {
        mainImg.src = match.image.src;
      }
      const isVarOut = match.stock_status === 'outofstock' ||
        (match.managing_stock && Number(match.stock_quantity ?? 0) <= 0);
      if (isVarOut) {
        if (stockBox) stockBox.innerHTML = `<div class="xmas-qo-stock out-of-stock"><i class="fa-solid fa-circle-xmark"></i> Out of Stock</div>`;
        if (addBtn) { addBtn.classList.add('disabled'); addBtn.disabled = true; }
      } else {
        if (stockBox) stockBox.innerHTML = `<div class="xmas-qo-stock"><i class="fa-solid fa-circle-check"></i> In Stock ${match.stock_quantity ? '(' + match.stock_quantity + ' available)' : ''}</div>`;
        if (addBtn) { addBtn.classList.remove('disabled'); addBtn.disabled = false; }
      }
    }
  }

  function updateXmasMobileVariation() {
    const variations = window.xmasCurrentVariations || [];
    if (!variations.length) return;

    const selected = {};
    document.querySelectorAll('#xmasQuickOrderMobileContent .xmas-mobile-attr-options').forEach(group => {
      const attrName = group.getAttribute('data-attribute');
      const activeBtn = group.querySelector('.xmas-qo-option.selected');
      if (attrName && activeBtn) selected[attrName] = activeBtn.getAttribute('data-value');
    });

    const match = variations.find(v => v.attributes.every(a => selected[a.name] === a.option));
    const stockBox = document.getElementById('xmasMobileStockStatus');
    const priceEl = document.getElementById('xmasMobileSheetPrice');
    const imgEl = document.getElementById('xmasMobileMainImg');
    const addBtn = document.getElementById('xmasMobileAddBtn');

    if (match) {
      const p = parseFloat(match.price) || 0;
      if (priceEl) priceEl.textContent = formatPrice(p);
      if (match.image?.src && imgEl) imgEl.src = match.image.src;
      const isVarOut = match.stock_status === 'outofstock' ||
        (match.managing_stock && Number(match.stock_quantity ?? 0) <= 0);
      if (isVarOut) {
        if (stockBox) stockBox.innerHTML = `<div class="xmas-qo-stock out-of-stock"><i class="fa-solid fa-circle-xmark"></i> Out of Stock</div>`;
        if (addBtn) addBtn.disabled = true;
      } else {
        if (stockBox) stockBox.innerHTML = `<div class="xmas-qo-stock"><i class="fa-solid fa-circle-check"></i> In Stock ${match.stock_quantity ? '(' + match.stock_quantity + ' available)' : ''}</div>`;
        if (addBtn) addBtn.disabled = false;
      }
    }
  }

  window.confirmAddXmasQoToCart = function(device) {
    const product = window.xmasCurrentProduct;
    if (!product) return;

    const variations = window.xmasCurrentVariations || [];
    const type = window.xmasCurrentType || 'simple';
    const qtyInput = document.getElementById(device === 'mobile' ? 'xmasMobileQtyInput' : 'xmasQoQty');
    const qty = Math.max(1, parseInt(qtyInput?.value || '1', 10));

    const containerSelector = device === 'mobile' ? '#xmasQuickOrderMobileContent .xmas-mobile-attr-options' : '#xmasQuickOrderContent .xmas-qo-options';
    const selectedAttrs = {};
    document.querySelectorAll(containerSelector).forEach(group => {
      const attrName = group.getAttribute('data-attribute');
      const activeBtn = group.querySelector('.xmas-qo-option.selected');
      if (attrName && activeBtn) selectedAttrs[attrName] = activeBtn.getAttribute('data-value');
    });

    let basePrice = parseFloat(product.price) || 0;
    let weight = parseFloat(product.weight) || 0;
    let image = product.images?.[0]?.src || '';
    let variationId = null;
    let cartItemId = `${product.id}_simple`;
    let itemName = product.name;

    if (type === 'variable' && variations.length > 0) {
      const match = variations.find(v => v.attributes.every(a => selectedAttrs[a.name] === a.option));
      if (!match) {
        alert('Please select all available options');
        return;
      }
      basePrice = parseFloat(match.price) || basePrice;
      weight = parseFloat(match.weight) || weight;
      image = match.image?.src || image;
      variationId = match.id;
      const variantLabel = match.attributes.map(a => a.option).join(', ');
      const varKey = Object.entries(selectedAttrs)
        .sort(([a], [b]) => a.localeCompare(b))
        .map(([k, v]) => `${k}:${String(v).trim().replace(/\s+/g, '_')}`)
        .join('|');
      cartItemId = `${product.id}_${varKey}`;
      itemName = `${product.name} - ${variantLabel}`;
    }

    let finalPrice = basePrice;
    if (qty >= 100) finalPrice = basePrice * 0.90;
    else if (qty >= 50) finalPrice = basePrice * 0.94;
    else if (qty >= 10) finalPrice = basePrice * 0.97;
    finalPrice = parseFloat(finalPrice.toFixed(2));

    let cart = [];
    try {
      cart = JSON.parse(localStorage.getItem('ebbelle_cart') || '[]');
    } catch (e) {}

    const existIdx = cart.findIndex(item => item.cartItemId === cartItemId);
    if (existIdx > -1) {
      cart[existIdx].quantity += qty;
      const newQty = cart[existIdx].quantity;
      let recalc = basePrice;
      if (newQty >= 100) recalc = basePrice * 0.90;
      else if (newQty >= 50) recalc = basePrice * 0.94;
      else if (newQty >= 10) recalc = basePrice * 0.97;
      cart[existIdx].price = parseFloat(recalc.toFixed(2));
      cart[existIdx].basePrice = basePrice;
    } else {
      cart.push({
        cartItemId,
        id: product.id,
        name: itemName,
        price: finalPrice,
        basePrice,
        quantity: qty,
        weight,
        image,
        selectedVariants: selectedAttrs,
        variationId
      });
    }

    localStorage.setItem('ebbelle_cart', JSON.stringify(cart));
    window.dispatchEvent(new CustomEvent('cartUpdated', { detail: { cart } }));

    closeXmasQuickOrder();
    setTimeout(() => {
      if (typeof window.toggleCart === 'function') {
        window.toggleCart(true);
      } else {
        document.getElementById('cartDrawer')?.classList.add('active');
        document.getElementById('cartOverlay')?.classList.add('active');
      }
    }, 260);
  };

  xmasQoClose?.addEventListener('click', closeXmasQuickOrder);
  xmasQoOverlay?.addEventListener('click', closeXmasQuickOrder);
  xmasQoMobileClose?.addEventListener('click', closeXmasQuickOrder);
  xmasQoMobileOverlay?.addEventListener('click', closeXmasQuickOrder);

  // ============================================================
  // 页面初始化：默认加载 Holiday Gift Sets 下的 Christmas 分类（首屏 8 个两行）
  // ============================================================
  document.addEventListener('DOMContentLoaded', () => {
    initMysteryScratchCards();
    loadXmasFavorites('christmas', false);
  });

  window.addEventListener('currencyChanged', () => {
    rerenderAllLoadedProducts();
  });
</script>