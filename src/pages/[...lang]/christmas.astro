---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CartDrawer from '../../components/CartDrawer.astro';
import ProductSkeleton from '../../components/ProductSkeleton.astro';
import { SUPPORTED_LOCALES, type SupportedLocale } from '../../lib/i18n/utils';

const lang = Astro.params.lang as SupportedLocale | undefined;
const currentLocale: SupportedLocale = lang && SUPPORTED_LOCALES.includes(lang as SupportedLocale)
  ? (lang as SupportedLocale)
  : 'en';

const localePrefix = currentLocale === 'en' ? '' : `/${currentLocale}`;
const buildLocaleUrl = (path: string) => `${localePrefix}${path}`;
---

<Layout title="E.B.belle Holiday | Fine Festive Jewelry & Christmas Deals">
  <Header />

  <!-- 引入 Google Fonts & Material Symbols 仅用于圣诞专题视觉 -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,400..700,0..1,0&display=swap" rel="stylesheet" />

  <div class="xmas-page-scope">
    <!-- 背景氛围光晕 -->
    <div class="xmas-ambient-glow xmas-glow-top"></div>
    <div class="xmas-ambient-glow xmas-glow-right"></div>

    <!-- SECTION 1: HOLIDAY ANNOUNCEMENT & HERO -->
    <section class="xmas-container xmas-hero-section">
      <div class="xmas-hero-header">
        <div class="xmas-eyebrow-pill">
          <span class="xmas-star-badge">★</span>
          <span class="xmas-eyebrow-red">MERRY CHRISTMAS!</span>
          <span class="xmas-dot"></span>
          <span class="xmas-eyebrow-pine">THE BIGGEST GIFT EVENT OF THE SEASON</span>
          <span class="material-symbols-outlined xmas-gold-icon">auto_awesome</span>
        </div>

        <h1 class="xmas-hero-title">
          More Jewelry. More Gifts.<br />
          <span class="xmas-hero-italic">More Christmas Magic!</span>
        </h1>

        <p class="xmas-hero-subtitle">
          Mix &amp; match any styles across the entire boutique. Wrapped with handcrafted gold ribbon &amp; evergreen cheer — dipped in 18K gold and 100% waterproof.
        </p>

        <!-- 实时真实时间倒计时模块（锁定 12 月 31 日 23:59:59 结束，刷新不重置） -->
        <div class="xmas-countdown-box">
          <div class="xmas-cd-left">
            <div class="xmas-cd-deadline-pill">
              <span class="material-symbols-outlined">event_available</span>
              <span>ENDS DEC 31</span>
            </div>
            <div class="xmas-cd-label">
              <span>HOLIDAY DEALS DISAPPEAR IN:</span>
            </div>
            <span class="xmas-cd-subnote">Final cutoff: December 31, 11:59 PM</span>
          </div>
          <div class="xmas-cd-digits" id="xmasCountdownTimer">
            <div class="xmas-cd-unit">
              <strong id="xmas-cd-days">00</strong>
              <span>DAYS</span>
            </div>
            <span class="xmas-cd-colon">:</span>
            <div class="xmas-cd-unit">
              <strong id="xmas-cd-hours">00</strong>
              <span>HOURS</span>
            </div>
            <span class="xmas-cd-colon">:</span>
            <div class="xmas-cd-unit">
              <strong id="xmas-cd-mins">00</strong>
              <span>MINS</span>
            </div>
            <span class="xmas-cd-colon">:</span>
            <div class="xmas-cd-unit">
              <strong id="xmas-cd-secs">00</strong>
              <span>SECS</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Hero 主视觉双栏大卡 -->
      <div class="xmas-hero-card">
       <div class="xmas-hero-media">
  <picture>
    <!-- 移动端 (<= 768px) 加载 1:1 专属图 -->
    <source
      media="(max-width: 768px)"
      srcset="https://api.ebbellejewelry.com/wp-content/uploads/2026/11/手机1.jpg"
    />
    <!-- 桌面端 (> 768px) 保持原图 -->
    <img
      src="https://api.ebbellejewelry.com/wp-content/uploads/2026/11/电脑1.jpg"
      alt="E.B.belle Holiday Fine Jewelry Collection"
      loading="eager"
    />
  </picture>
  <div class="xmas-wax-seal">
    <span class="seal-top">LUXE</span>
    <strong class="seal-mid">18K</strong>
    <span class="seal-bot">GOLD</span>
  </div>
</div>

        <div class="xmas-hero-editorial">
          <div>
            <div class="xmas-verified-tag">
              <span class="material-symbols-outlined">verified</span>
              <span>HANDCRAFTED HOLIDAY COLLECTION</span>
            </div>
            <h2 class="xmas-editorial-title">
              18K Gold Plated + 100% Waterproof.
            </h2>
            <p class="xmas-editorial-desc">
              Stock up on holiday bestsellers forged from surgical 316L stainless steel with thick 18K PVD gold plating. Hypoallergenic, tarnish-free, and ready to elevate your seasonal lineup.
            </p>

            <div class="xmas-trust-pills">
              <div class="xmas-trust-item">
                <span class="material-symbols-outlined">featured_seasonal_and_gifts</span>
                <div>
                  <strong>Free Surprise Gift</strong>
                  <span>Surprise Piece Inside</span>
                </div>
              </div>
              <div class="xmas-trust-item">
                <span class="material-symbols-outlined">water_drop</span>
                <div>
                  <strong>Waterproof</strong>
                  <span>Never Tarnish</span>
                </div>
              </div>
              <div class="xmas-trust-item">
                <span class="material-symbols-outlined">local_shipping</span>
                <div>
                  <strong>Pre-Xmas Dispatch</strong>
                  <span>Tracked Delivery</span>
                </div>
              </div>
            </div>
          </div>

          <div class="xmas-hero-cta-row">
            <a href="#holiday-tiers" class="xmas-btn-primary">
              <span>🎁 UNWRAP THE DEALS</span>
              <span class="material-symbols-outlined">arrow_forward</span>
            </a>
            <span class="xmas-cta-note">
              Mix &amp; match any items sitewide. Lowest-priced items automatically become FREE at checkout!
            </span>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 2: HOLIDAY TIERED BONUSES -->
    <section class="xmas-container xmas-section" id="holiday-tiers">
      <div class="xmas-section-head">
        <span class="xmas-kicker">SITEWIDE MIX &amp; MATCH REWARDS</span>
        <h2 class="xmas-section-title">The More You Shop, The More Gifts You Get!</h2>
        <p class="xmas-section-desc">
          Select any pieces across the entire store. Your lowest-priced items are automatically deducted at checkout (cannot be combined with VIP vouchers or free shipping).
        </p>
      </div>

      <div class="xmas-tiers-grid">
        <!-- TIER 1 -->
        <div class="xmas-tier-card">
          <div>
            <div class="xmas-tier-top">
              <span class="xmas-tier-badge">TIER 01</span>
              <span class="xmas-tier-highlight pine">50% OFF VALUE</span>
            </div>
            <h3 class="xmas-tier-name">CHRISTMAS DUO</h3>
            <div class="xmas-tier-offer-box">
              <div class="xmas-tier-big">BUY 2 GET 1 FREE</div>
              <p>Pick any <strong>2 items</strong> sitewide &amp; only pay for the highest-priced <strong>1 item</strong>!</p>
            </div>
            <ul class="xmas-tier-list">
              <li><span class="material-symbols-outlined">check_circle</span><span>Mix &amp; match any 2 pieces across the site</span></li>
              <li><span class="material-symbols-outlined">check_circle</span><span>Lowest-priced item is 100% FREE</span></li>
              <li><span class="material-symbols-outlined">check_circle</span><span>Includes a FREE mystery gift piece</span></li>
            </ul>
          </div>
          <a href="#jewelry-grid" class="xmas-tier-btn">SHOP 2 ITEMS →</a>
        </div>

        <!-- TIER 2 -->
        <div class="xmas-tier-card is-featured">
          <div class="xmas-popular-ribbon">
            <span class="material-symbols-outlined">local_fire_department</span>
            <span>MOST POPULAR FOR GIFTING</span>
          </div>
          <div>
            <div class="xmas-tier-top">
              <span class="xmas-tier-badge red">TIER 02</span>
              <span class="xmas-tier-highlight red">2 ITEMS FREE</span>
            </div>
            <h3 class="xmas-tier-name">HOLIDAY ENSEMBLE</h3>
            <div class="xmas-tier-offer-box red-tint">
              <div class="xmas-tier-big red">BUY 3 GET 2 FREE</div>
              <p>Pick any <strong>5 items</strong> sitewide &amp; only pay for the highest-priced <strong>3 items</strong>!</p>
            </div>
            <ul class="xmas-tier-list">
              <li><span class="material-symbols-outlined red">check_circle</span><span>Choose any 5 styles across the atelier</span></li>
              <li><span class="material-symbols-outlined red">check_circle</span><span>2 lowest-priced pieces deducted automatically</span></li>
              <li><span class="material-symbols-outlined red">check_circle</span><span>Includes a FREE mystery gift piece</span></li>
              <li><span class="material-symbols-outlined red">check_circle</span><span>Ready to gift straight under the tree</span></li>
            </ul>
          </div>
          <a href="#jewelry-grid" class="xmas-tier-btn red">SHOP 5 ITEMS &amp; GET 2 FREE →</a>
        </div>

        <!-- TIER 3 -->
        <div class="xmas-tier-card is-pine">
          <div>
            <div class="xmas-tier-top">
              <span class="xmas-tier-badge gold">TIER 03</span>
              <span class="xmas-tier-highlight gold">3 ITEMS FREE</span>
            </div>
            <h3 class="xmas-tier-name">THE ULTIMATE VAULT</h3>
            <div class="xmas-tier-offer-box dark-tint">
              <div class="xmas-tier-big gold">BUY 5 GET 3 FREE</div>
              <p>Pick any <strong>8 items</strong> sitewide &amp; only pay for the highest-priced <strong>5 items</strong>!</p>
            </div>
            <ul class="xmas-tier-list light">
              <li><span class="material-symbols-outlined gold">check_circle</span><span>Choose 8 full-sized heirloom jewels</span></li>
              <li><span class="material-symbols-outlined gold">check_circle</span><span>3 lowest-priced pieces 100% FREE</span></li>
              <li><span class="material-symbols-outlined gold">check_circle</span><span>Includes a FREE mystery gift piece</span></li>
              <li><span class="material-symbols-outlined gold">check_circle</span><span>Complete your entire family gift list</span></li>
            </ul>
          </div>
          <a href="#jewelry-grid" class="xmas-tier-btn gold">CLAIM MEGA BUNDLE →</a>
        </div>
      </div>
    </section>

    <!-- SECTION 3: INTERACTIVE CHRISTMAS GIFT FINDER -->
    <section class="xmas-container xmas-section">
      <div class="xmas-section-head">
        <span class="xmas-kicker">INSTANT CURATION</span>
        <h2 class="xmas-section-title">Find The Perfect Gift in 1 Tap</h2>
        <p class="xmas-section-desc">
          Select a recipient below to filter curated holiday jewelry recommendations.
        </p>
      </div>

      <div class="xmas-finder-grid">
        <button type="button" class="xmas-recipient-card active" onclick="filterXmasByRecipient('christmas', this)">
          <div class="xmas-rec-icon red"><span class="material-symbols-outlined">favorite</span></div>
          <h4>For Her / Partner</h4>
          <p>Romantic, sparkling &amp; timeless 18K gold heirlooms.</p>
          <span class="xmas-rec-link">View Picks →</span>
        </button>

        <button type="button" class="xmas-recipient-card" onclick="filterXmasByRecipient('necklace', this)">
          <div class="xmas-rec-icon pine"><span class="material-symbols-outlined">family_restroom</span></div>
          <h4>For Mom</h4>
          <p>Sentimental pearls and classic chains she will cherish.</p>
          <span class="xmas-rec-link pine">View Picks →</span>
        </button>

        <button type="button" class="xmas-recipient-card" onclick="filterXmasByRecipient('earring', this)">
          <div class="xmas-rec-icon gold"><span class="material-symbols-outlined">stars</span></div>
          <h4>For Bestie / Sister</h4>
          <p>Trendy stackable hoops, bows, and playful charms.</p>
          <span class="xmas-rec-link gold">View Picks →</span>
        </button>

        <button type="button" class="xmas-recipient-card" onclick="filterXmasByRecipient('ring', this)">
          <div class="xmas-rec-icon dark"><span class="material-symbols-outlined">celebration</span></div>
          <h4>For Myself</h4>
          <p>A well-deserved holiday treat — bold rings &amp; sets.</p>
          <span class="xmas-rec-link dark">View Picks →</span>
        </button>
      </div>
    </section>

    <!-- SECTION 3.5: INTERACTIVE HOLIDAY SCRATCH-OFF MYSTERY GIFT BOXES -->
    <section class="xmas-container xmas-section" id="mystery-gift-section">
      <div class="xmas-mystery-wrapper">
        <span class="xmas-mystery-sparkle-tl">✦</span>
        <span class="xmas-mystery-sparkle-br">❄</span>

        <div class="xmas-section-head" style="margin-bottom: 30px;">
          <span class="xmas-kicker">INTERACTIVE HOLIDAY DELIGHT</span>
          <h2 class="xmas-section-title">Scratch to Unwrap Your Mystery Christmas Gift</h2>
          <p class="xmas-section-desc">
            Pick one festive gift box below and scratch the gold foil to reveal your secret holiday gift code — only one code can be active at a time!
          </p>
        </div>

        <div class="xmas-mystery-grid" id="xmasMysteryGrid">
          <!-- Gift Box 01: Crimson Surprise (GIFT125 - Dec 25 Christmas Day) -->
          <div class="xmas-mystery-card" data-box-index="0" data-code="GIFT125">
            <div class="xmas-gift-icon-ring red">
              <img
                src="https://api.ebbellejewelry.com/wp-content/uploads/2026/11/gift666.png"
                alt="Crimson Surprise"
                class="xmas-gift-custom-icon"
                loading="lazy"
              />
            </div>
            <span class="xmas-mystery-eyebrow">SECRET GIFT 01</span>
            <h3 class="xmas-mystery-title">Crimson Surprise</h3>
            <p class="xmas-mystery-sub">Rub or tap the gold foil below to reveal your gift</p>

            <div class="xmas-scratch-slot">
              <div class="xmas-scratch-reveal">
                <button type="button" class="xmas-code-pill" data-voucher-code="GIFT125" title="Click to copy code">
                  <strong class="xmas-code-text">GIFT125</strong>
                  <span class="xmas-copy-state-badge">COPY</span>
                </button>
              </div>
              <canvas class="xmas-scratch-canvas" width="260" height="78"></canvas>
            </div>
          </div>

          <!-- Gift Box 02: Pine Surprise (GIFT124 - Dec 24 Christmas Eve) -->
          <div class="xmas-mystery-card" data-box-index="1" data-code="GIFT124">
            <div class="xmas-gift-icon-ring pine">
              <img
                src="https://api.ebbellejewelry.com/wp-content/uploads/2026/11/gift999.png"
                alt="Pine Surprise"
                class="xmas-gift-custom-icon"
                loading="lazy"
              />
            </div>
            <span class="xmas-mystery-eyebrow">SECRET GIFT 02</span>
            <h3 class="xmas-mystery-title">Pine Surprise</h3>
            <p class="xmas-mystery-sub">Rub or tap the gold foil below to reveal your gift</p>

            <div class="xmas-scratch-slot">
              <div class="xmas-scratch-reveal">
                <button type="button" class="xmas-code-pill" data-voucher-code="GIFT124" title="Click to copy code">
                  <strong class="xmas-code-text">GIFT124</strong>
                  <span class="xmas-copy-state-badge">COPY</span>
                </button>
              </div>
              <canvas class="xmas-scratch-canvas" width="260" height="78"></canvas>
            </div>
          </div>

          <!-- Gift Box 03: Stellar Surprise (GIFT777 - Festive Lucky Star) -->
          <div class="xmas-mystery-card" data-box-index="2" data-code="GIFT777">
            <div class="xmas-gift-icon-ring gold">
              <img
                src="https://api.ebbellejewelry.com/wp-content/uploads/2026/11/gift888.png"
                alt="Stellar Surprise"
                class="xmas-gift-custom-icon"
                loading="lazy"
              />
            </div>
            <span class="xmas-mystery-eyebrow">SECRET GIFT 03</span>
            <h3 class="xmas-mystery-title">Stellar Surprise</h3>
            <p class="xmas-mystery-sub">Rub or tap the gold foil below to reveal your gift</p>

            <div class="xmas-scratch-slot">
              <div class="xmas-scratch-reveal">
                <button type="button" class="xmas-code-pill" data-voucher-code="GIFT777" title="Click to copy code">
                  <strong class="xmas-code-text">GIFT777</strong>
                  <span class="xmas-copy-state-badge">COPY</span>
                </button>
              </div>
              <canvas class="xmas-scratch-canvas" width="260" height="78"></canvas>
            </div>
          </div>
        </div>

        <!-- 刮开后自动弹出的英文复制与结账兑换提示条 -->
        <div class="xmas-scratch-tip-banner" id="xmasScratchTipBanner" style="display: none;">
          <div class="xmas-tip-left">
            <span class="material-symbols-outlined">check_circle</span>
            <div>
              <strong>Code <span id="xmasRevealedCodeDisplay">GIFT125</span> copied to your clipboard!</strong>
              <span>Only one code can be copied at a time — click COPY on another box if you'd like to switch.</span>
            </div>
          </div>
          <div class="xmas-tip-actions">
            <button type="button" class="xmas-copy-again-btn" id="xmasCopyAgainBtn">Copy Code</button>
            <a href={buildLocaleUrl('/checkout/shipping')} class="xmas-redeem-now-btn">Go to Checkout →</a>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 4: CHRISTMAS FAVORITES PRODUCT GRID (每次加载8个两行，全部加载完后切换为跳转Shop按钮) -->
    <section class="xmas-container xmas-section" id="jewelry-grid">
      <div class="xmas-grid-header">
        <div>
          <span class="xmas-kicker">SITEWIDE MIX &amp; MATCH ELIGIBLE</span>
          <h2 class="xmas-section-title" style="text-align:left; margin-bottom:4px;">Christmas Favorites</h2>
          <p class="xmas-section-desc" style="text-align:left; margin:0;">
            Add any pieces here or browse the <a href={buildLocaleUrl('/shop')} style="color:#961820; font-weight:700; text-decoration:underline;">full catalog</a> — all items count toward Buy 2 Get 1 / Buy 3 Get 2 / Buy 5 Get 3!
          </p>
        </div>
      </div>

      <!-- 真实商品网格（默认加载 8 个两行，移动端 2 列） -->
      <div class="xmas-products-grid" id="xmasProductsGrid">
        <ProductSkeleton count={8} />
      </div>

      <!-- 底部操作区：未加载完时显示“加载更多（带转圈动画）”，全部加载完后显示“跳转 Shop 页” -->
      <div class="xmas-grid-footer-actions" id="xmasGridFooterActions">
        <button type="button" class="xmas-load-more-btn" id="xmasLoadMoreBtn">
          <span class="xmas-btn-spinner" id="xmasLoadMoreSpinner" aria-hidden="true"></span>
          <span id="xmasLoadMoreLabel">LOAD MORE FESTIVE PIECES</span>
        </button>
        <a href={buildLocaleUrl('/shop')} class="xmas-btn-outline" id="xmasExploreAllLink" style="display: none;">
          EXPLORE ALL 500+ SITEWIDE STYLES →
        </a>
      </div>
    </section>

    <!-- SECTION 5: UNBOXING PERFECTION -->
    <section class="xmas-container xmas-section">
      <div class="xmas-unboxing-card">
        <div class="xmas-unboxing-media">
  <picture>
    <!-- 移动端 (<= 768px) 加载 1:1 专属图 -->
    <source
      media="(max-width: 768px)"
      srcset="https://api.ebbellejewelry.com/wp-content/uploads/2026/11/手机2.jpg"
    />
    <!-- 桌面端 (> 768px) 保持原图 -->
    <img
      src="https://api.ebbellejewelry.com/wp-content/uploads/2026/11/电脑2.jpg"
      alt="Luxury Holiday Velvet Gift Packaging"
      loading="lazy"
    />
  </picture>
  <div class="xmas-unboxing-badge">
    <span class="material-symbols-outlined">loyalty</span>
    <span>FREE MYSTERY GIFT WITH EVERY ORDER</span>
  </div>
</div>

        <div class="xmas-unboxing-body">
          <span class="xmas-kicker">HOLIDAY SURPRISE BONUS</span>
          <h2 class="xmas-section-title" style="text-align:left; margin:6px 0 12px;">A Little Extra Christmas Magic</h2>
          <p class="xmas-editorial-desc">
            We believe surprises are half the joy of the holidays. Every single order includes a complimentary mystery jewelry piece—handpicked at random just for you.
          </p>

          <div class="xmas-perks-stack">
            <div class="xmas-perk-row">
              <div class="xmas-perk-icon pine"><span class="material-symbols-outlined">package_2</span></div>
              <div>
                <h4>Free Mystery Jewelry Piece</h4>
                <p>Receive a surprise 18K gold-plated accessory randomly selected with every order.</p>
              </div>
            </div>
            <div class="xmas-perk-row">
              <div class="xmas-perk-icon red"><span class="material-symbols-outlined">edit_note</span></div>
              <div>
                <h4>18K PVD Gold Plated</h4>
                <p>Crafted over surgical 316L stainless steel for lasting, tarnish-free brilliance.</p>
              </div>
            </div>
            <div class="xmas-perk-row">
              <div class="xmas-perk-icon gold"><span class="material-symbols-outlined">cleaning_services</span></div>
              <div>
                <h4>100% Waterproof & Hypoallergenic</h4>
                <p>Sweat-proof, shower-safe, and gentle on sensitive skin for effortless daily wear.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 6: CHRISTMAS FAQ -->
    <section class="xmas-container xmas-section" style="padding-bottom: 80px;">
      <div class="xmas-faq-layout">
        <div class="xmas-faq-col">
          <span class="xmas-kicker">NEED ASSISTANCE?</span>
          <h2 class="xmas-section-title" style="text-align:left; margin:6px 0 20px;">Your Christmas Questions, Answered</h2>

          <div class="xmas-accordion">
            <div class="xmas-acc-item">
              <button type="button" class="xmas-acc-btn" onclick="toggleXmasFaq(1)">
                <span>How do Buy 2 Get 1, Buy 3 Get 2, and Buy 5 Get 3 work?</span>
                <span class="material-symbols-outlined" id="xmas-faq-icon-1">expand_more</span>
              </button>
              <div class="xmas-acc-body" id="xmas-faq-body-1">
                Simply add any items across our store to your bag! When you reach 2+ items, the lowest-priced item is free (Buy 2 Get 1). At 5+ items, the 2 lowest-priced items are free (Buy 3 Get 2). At 8+ items, the 3 lowest-priced items are free (Buy 5 Get 3). You can select the Christmas Event option directly at checkout.
              </div>
            </div>

            <div class="xmas-acc-item">
              <button type="button" class="xmas-acc-btn" onclick="toggleXmasFaq(2)">
                <span>Can I combine Christmas tiered deals with VIP coupons or free shipping?</span>
