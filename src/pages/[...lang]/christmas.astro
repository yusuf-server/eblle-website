  // ============================================================
  // 5. 圣诞主题化 Quick Order 弹窗逻辑（完整支持变体选择、批发价与桌面/移动端双端适配）
  // ============================================================
  const xmasQoOverlay = document.getElementById('xmasQuickOrderOverlay');
  const xmasQoModal = document.getElementById('xmasQuickOrderModal');
  const xmasQoClose = document.getElementById('xmasQuickOrderClose');
  const xmasQoContent = document.getElementById('xmasQuickOrderContent');

  const xmasQoMobileOverlay = document.getElementById('xmasQuickOrderMobileOverlay');
  const xmasQoMobileSheet = document.getElementById('xmasQuickOrderMobileSheet');
  const xmasQoMobileClose = document.getElementById('xmasQuickOrderMobileClose');
  const xmasQoMobileContent = document.getElementById('xmasQuickOrderMobileContent');
  const xmasMobileSheetHeader = document.getElementById('xmasMobileSheetHeader');

  function isMobileViewport() {
    return window.innerWidth <= 768;
  }

  async function openXmasQuickOrder(product) {
    const mobile = isMobileViewport();

    if (mobile) {
      xmasQoMobileOverlay?.classList.add('active');
      xmasQoMobileSheet?.classList.add('active');
      document.body.style.overflow = 'hidden';
      renderXmasMobileLoading(product);
    } else {
      xmasQoOverlay?.classList.add('active');
      xmasQoModal?.classList.add('active');
      document.body.style.overflow = 'hidden';
      renderXmasDesktopLoading(product);
    }

    if (product.type === 'variable' && Array.isArray(product.variations) && product.variations.length > 0) {
      if (variationsCache.has(product.id)) {
        product.variationsData = variationsCache.get(product.id);
      } else {
        try {
          const res = await fetch(`/api/product-variations/${product.id}`);
          if (res.ok) {
            const vData = await res.json();
            product.variationsData = vData;
            variationsCache.set(product.id, vData);
          }
        } catch (e) {}
      }
    }

    if (mobile) {
      renderXmasMobileContent(product);
    } else {
      renderXmasDesktopContent(product);
    }
  }

  function closeXmasQuickOrder() {
    xmasQoOverlay?.classList.remove('active');
    xmasQoModal?.classList.remove('active');
    xmasQoMobileOverlay?.classList.remove('active');
    xmasQoMobileSheet?.classList.remove('active');
    document.body.style.overflow = '';
  }

