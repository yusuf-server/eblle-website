<script define:vars={{ serverLocale: currentLocale }}>
  const SUPPORTED_LOCALES = ['en', 'fr', 'de', 'es'];
  const PAGE_LOCALE = serverLocale || 'en';

  function getCurrentLocale() {
    return PAGE_LOCALE;
  }

  function addLocalePrefix(url) {
    const loc = getCurrentLocale();
    if (loc === 'en') return url;
    let cleanUrl = url;
    for (const l of SUPPORTED_LOCALES) {
      if (cleanUrl.startsWith(`/${l}/`)) {
        cleanUrl = cleanUrl.substring(l.length + 1);
        break;
      }
    }
    return `/${loc}${cleanUrl}`;
  }

  // ============================================================
  // 货币转换工具（与 shop.astro 保持一致）
  // ============================================================
  const CURRENCY_SYMBOLS = { USD: '$', EUR: '€', GBP: '£', CAD: 'C$' };
  const CURRENCY_RATES = { USD: 1.0, EUR: 0.92, GBP: 0.79, CAD: 1.36 };

  function getCurrentCurrency() {
    return localStorage.getItem('ebbelle_currency') || 'USD';
  }
  function convertPrice(priceUSD, targetCurrency) {
    const currency = targetCurrency || getCurrentCurrency();
    const rate = CURRENCY_RATES[currency] || 1.0;
    return priceUSD * rate;
  }
  function formatPrice(priceUSD, targetCurrency) {
    const currency = targetCurrency || getCurrentCurrency();
    const converted = convertPrice(priceUSD, currency);
    const symbol = CURRENCY_SYMBOLS[currency] || '$';
    const formatted = converted.toFixed(2);
    return currency === 'EUR' ? `${formatted}${symbol}` : `${symbol}${formatted}`;
  }

  // ============================================================
  // 1. 圣诞真实时间倒计时（锁定 2026 年 12 月 31 日 23:59:59 结束，刷新不重置）
  // ============================================================
  (function initXmasCountdown() {
    const dEl = document.getElementById('xmas-cd-days');
    const hEl = document.getElementById('xmas-cd-hours');
    const mEl = document.getElementById('xmas-cd-mins');
    const sEl = document.getElementById('xmas-cd-secs');
    if (!dEl || !hEl || !mEl || !sEl) return;

    // 锁定 2026-12-31 23:59:59（美东时间 EST -05:00，覆盖北美及全球年末截止）
    const TARGET_END_TIME = new Date('2026-12-31T23:59:59-05:00').getTime();

    function updateRealCountdown() {
      const now = Date.now();
      const diffMs = Math.max(0, TARGET_END_TIME - now);

      const totalSeconds = Math.floor(diffMs / 1000);
      const days = Math.floor(totalSeconds / 86400);
      const hours = Math.floor((totalSeconds % 86400) / 3600);
      const mins = Math.floor((totalSeconds % 3600) / 60);
      const secs = totalSeconds % 60;

      dEl.textContent = String(days).padStart(2, '0');
      hEl.textContent = String(hours).padStart(2, '0');
      mEl.textContent = String(mins).padStart(2, '0');
      sEl.textContent = String(secs).padStart(2, '0');
    }

    updateRealCountdown();
    setInterval(updateRealCountdown, 1000);
  })();

  // ============================================================
  // 2. FAQ 折叠
  // ============================================================
  window.toggleXmasFaq = function(idx) {
    const body = document.getElementById(`xmas-faq-body-${idx}`);
    const icon = document.getElementById(`xmas-faq-icon-${idx}`);
    if (!body) return;
    const willOpen = !body.classList.contains('open');
    body.classList.toggle('open', willOpen);
    if (icon) icon.style.transform = willOpen ? 'rotate(180deg)' : 'rotate(0deg)';
  };

  // ============================================================
  // 3. 礼盒刮刮乐盲盒：排他性 COPY / COPIED 状态（同时只能激活复制一个码）
  // ============================================================
  let activeRevealedCode = '';

  async function copyVoucherCodeToClipboard(code) {
    if (!code) return;
    try {
      sessionStorage.setItem('ebbelle_cart_manual_coupon', code);
    } catch (e) {}

    if (navigator.clipboard && navigator.clipboard.writeText) {
      try {
        await navigator.clipboard.writeText(code);
        return true;
      } catch (e) {}
    }

    try {
      const textarea = document.createElement('textarea');
      textarea.value = code;
      textarea.style.position = 'fixed';
      textarea.style.opacity = '0';
      document.body.appendChild(textarea);
      textarea.select();
      document.execCommand('copy');
      document.body.removeChild(textarea);
      return true;
    } catch (e) {
      return false;
    }
  }

  function setExclusiveCopiedVoucher(code) {
    activeRevealedCode = code;
    copyVoucherCodeToClipboard(code);

    // 排他更新所有礼盒状态：只有当前选中的礼盒显示 COPIED ✓，其余全部显示 COPY
    document.querySelectorAll('.xmas-mystery-card').forEach((cardEl) => {
      const cardCode = cardEl.getAttribute('data-code') || '';
      const badgeEl = cardEl.querySelector('.xmas-copy-state-badge');
      const isCurrent = cardCode === code;

      cardEl.classList.toggle('is-active-copied', isCurrent);
      if (badgeEl) {
        badgeEl.textContent = isCurrent ? 'COPIED ✓' : 'COPY';
      }
    });

    const banner = document.getElementById('xmasScratchTipBanner');
    const codeDisplay = document.getElementById('xmasRevealedCodeDisplay');
    if (codeDisplay) codeDisplay.textContent = code;
    if (banner) banner.style.display = 'flex';
  }

  function initMysteryScratchCards() {
    const cards = document.querySelectorAll('.xmas-mystery-card');
    cards.forEach((card) => {
      const canvas = card.querySelector('.xmas-scratch-canvas');
      const codePill = card.querySelector('.xmas-code-pill');
      const code = card.getAttribute('data-code') || 'GIFT125';

      // 点击已刮开礼盒的优惠码胶囊：切换复制该礼盒优惠码，其余重置为 COPY
      codePill?.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        setExclusiveCopiedVoucher(code);
      });

      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      if (!ctx) return;

      const w = canvas.width;
      const h = canvas.height;

      // 绘制香槟金箔刮奖涂层
      const grad = ctx.createLinearGradient(0, 0, w, h);
      grad.addColorStop(0, '#e6c88a');
      grad.addColorStop(0.5, '#f5e1b5');
      grad.addColorStop(1, '#cfa455');
      ctx.fillStyle = grad;
      ctx.fillRect(0, 0, w, h);

      // 绘制细微斜向闪光纹理
      ctx.strokeStyle = 'rgba(255, 255, 255, 0.35)';
      ctx.lineWidth = 2;
      for (let i = -h; i < w; i += 16) {
        ctx.beginPath();
        ctx.moveTo(i, 0);
        ctx.lineTo(i + h, h);
        ctx.stroke();
      }

      // 涂层提示文字
      ctx.fillStyle = '#5e3d0c';
      ctx.font = 'bold 12px "Plus Jakarta Sans", sans-serif';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText('✨ SCRATCH HERE TO UNWRAP ✨', w / 2, h / 2);

      let isDrawing = false;
      let isRevealed = false;
      let strokeMoves = 0;

      function completeReveal() {
        if (isRevealed) return;
        isRevealed = true;
        canvas.classList.add('faded');
        card.classList.add('is-revealed');
        setExclusiveCopiedVoucher(code);
      }

      function scratchAt(clientX, clientY) {
        if (isRevealed) return;
        const rect = canvas.getBoundingClientRect();
        const scaleX = w / rect.width;
        const scaleY = h / rect.height;
        const x = (clientX - rect.left) * scaleX;
        const y = (clientY - rect.top) * scaleY;

        ctx.globalCompositeOperation = 'destination-out';
        ctx.beginPath();
        ctx.arc(x, y, 22, 0, Math.PI * 2);
        ctx.fill();

        strokeMoves++;
        if (strokeMoves >= 12) {
          completeReveal();
        }
      }

      // 桌面端鼠标事件
      canvas.addEventListener('mousedown', (e) => {
        isDrawing = true;
        scratchAt(e.clientX, e.clientY);
      });
      window.addEventListener('mousemove', (e) => {
        if (!isDrawing) return;
        scratchAt(e.clientX, e.clientY);
      });
      window.addEventListener('mouseup', () => {
        if (isDrawing) {
          isDrawing = false;
          if (strokeMoves > 0 && strokeMoves < 12) {
            completeReveal();
          }
        }
      });

      // 移动端触摸事件
      canvas.addEventListener('touchstart', (e) => {
        e.preventDefault();
        isDrawing = true;
        const t = e.touches[0];
        if (t) scratchAt(t.clientX, t.clientY);
      }, { passive: false });

      canvas.addEventListener('touchmove', (e) => {
        e.preventDefault();
        if (!isDrawing) return;
        const t = e.touches[0];
        if (t) scratchAt(t.clientX, t.clientY);
      }, { passive: false });

      canvas.addEventListener('touchend', () => {
        if (isDrawing) {
          isDrawing = false;
          if (strokeMoves > 0) {
            completeReveal();
          }
        }
      });

      // 支持单击直接揭晓
      canvas.addEventListener('click', completeReveal);
    });

    const copyBtn = document.getElementById('xmasCopyAgainBtn');
    if (copyBtn) {
      copyBtn.addEventListener('click', async () => {
        if (!activeRevealedCode) return;
        setExclusiveCopiedVoucher(activeRevealedCode);
        const orig = copyBtn.textContent;
        copyBtn.textContent = 'Copied ✓';
        setTimeout(() => { copyBtn.textContent = orig; }, 1500);
      });
    }
  }

  // ============================================================
  // 4. 商品列表分页加载（默认 8 个两行，点击每次追加 8 个，全部加载完后切换为跳转 Shop）
  // ============================================================
  const XMAS_PAGE_SIZE = 8;
  let xmasCurrentCategory = 'christmas';
  let xmasCurrentPage = 1;
  let xmasIsLoading = false;
  let xmasHasMore = true;
  let xmasLoadedProducts = [];
  const variationsCache = new Map();

  const escapeHtml = (text) => {
    const div = document.createElement('div');
    div.textContent = text || '';
    return div.innerHTML;
  };

  function buildProductCardHtml(p) {
    const price = parseFloat(p.price) || 0;
    const regPrice = parseFloat(p.regular_price) || 0;
    const hasSale = regPrice > price;
    const pct = hasSale ? Math.round(((regPrice - price) / regPrice) * 100) : 0;
    const img = p.images?.[0]?.src || 'https://images.unsplash.com/photo-1515562141207-7a88fb7ce338?w=500&q=80';
    const safeName = escapeHtml(p.name);
    const productUrl = addLocalePrefix(`/product/${encodeURIComponent(p.slug || '')}`);

    return `
      <div class="xmas-prod-card">
        <div>
          <div class="xmas-prod-img-wrap" data-href="${productUrl}" role="link" tabindex="0">
            <span class="xmas-tag-left">18K Waterproof</span>
            ${hasSale ? `<span class="xmas-tag-right">-${pct}%</span>` : ''}
            <img src="${img}" alt="${safeName}" loading="lazy" />
          </div>
          <h3 class="xmas-prod-title" data-href="${productUrl}" role="link" tabindex="0">${safeName}</h3>
          <div class="xmas-prod-price-row">
            <span class="xmas-prod-price">${formatPrice(price)}</span>
            ${hasSale ? `<span class="xmas-prod-old">${formatPrice(regPrice)}</span>` : ''}
            <span class="xmas-prod-bogo-hint">Mix &amp; Match</span>
          </div>
        </div>
        <button type="button" class="xmas-add-btn" data-product-id="${p.id}">
          <span class="material-symbols-outlined" style="font-size:16px;">shopping_bag</span>
          <span>Add</span>
        </button>
      </div>
    `;
  }

  function updateGridFooterControls() {
    const loadMoreBtn = document.getElementById('xmasLoadMoreBtn');
    const loadMoreLabel = document.getElementById('xmasLoadMoreLabel');
    const exploreAllLink = document.getElementById('xmasExploreAllLink');
    if (!loadMoreBtn || !exploreAllLink) return;

    loadMoreBtn.classList.toggle('is-loading', xmasIsLoading);
    loadMoreBtn.disabled = xmasIsLoading;
    if (loadMoreLabel) {
      loadMoreLabel.textContent = xmasIsLoading ? 'LOADING MORE...' : 'LOAD MORE FESTIVE PIECES';
    }

    if (xmasHasMore) {
      loadMoreBtn.style.display = 'inline-flex';
      exploreAllLink.style.display = 'none';
    } else {
      loadMoreBtn.style.display = 'none';
      exploreAllLink.style.display = 'inline-flex';
    }
  }

  async function loadXmasFavorites(categorySlug = 'christmas', append = false) {
    const grid = document.getElementById('xmasProductsGrid');
    if (!grid || xmasIsLoading) return;

    xmasIsLoading = true;

    if (!append) {
      xmasCurrentCategory = categorySlug || 'christmas';
      xmasCurrentPage = 1;
      xmasHasMore = true;
      xmasLoadedProducts = [];

      grid.innerHTML = Array.from({ length: XMAS_PAGE_SIZE }, () => `
        <div class="product-skeleton">
          <div class="skeleton-image"></div>
          <div class="skeleton-content">
            <div class="skeleton-line skeleton-title"></div>
            <div class="skeleton-line skeleton-price"></div>
            <div class="skeleton-line skeleton-meta"></div>
          </div>
        </div>
      `).join('');
    } else {
      xmasCurrentPage += 1;
    }

    updateGridFooterControls();

    try {
      const requestBody = {
        page: xmasCurrentPage,
        per_page: XMAS_PAGE_SIZE
      };
      if (xmasCurrentCategory && xmasCurrentCategory !== 'all') {
        requestBody.category = xmasCurrentCategory;
      }

      const response = await fetch('/api/products', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(requestBody)
      });

      if (!response.ok) throw new Error(`API error: ${response.status}`);
      const data = await response.json();
      let newProducts = Array.isArray(data.products) ? data.products : [];
      const totalPages = Number(data.totalPages || 0);

      // 判断是否还有下一页
      if (newProducts.length < XMAS_PAGE_SIZE || (totalPages > 0 && xmasCurrentPage >= totalPages)) {
        xmasHasMore = false;
      }

      if (newProducts.length === 0) {
        if (!append) {
          grid.innerHTML = `<div class="xmas-loading-box"><p>No pieces found right now. Explore our full catalog below!</p></div>`;
        }
        xmasHasMore = false;
        return;
      }

      // 多语言翻译（与 shop.astro 一致）
      const loc = getCurrentLocale();
      if (loc !== 'en') {
        try {
          const trRes = await fetch('/api/translate-products', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ products: newProducts, targetLang: loc })
          });
          if (trRes.ok) {
            newProducts = await trRes.json();
          }
        } catch (e) {}
      }

      // 批量获取最新库存（与 shop.astro 一致）
      try {
        const productIds = newProducts.map(p => p.id).join(',');
        if (productIds) {
          const stockRes = await fetch(`https://api.ebbellejewelry.com/wp-json/custom/v1/stock?ids=${productIds}&_t=${Date.now()}`);
          if (stockRes.ok) {
            const stockData = await stockRes.json();
            if (stockData.success && stockData.stocks) {
              newProducts.forEach(product => {
                const stock = stockData.stocks[product.id];
                if (stock) {
                  product.stock_status = stock.stock_status;
                  product.stock_quantity = stock.stock_quantity;
                  product.is_in_stock = stock.is_in_stock;
                  product.managing_stock = stock.managing_stock;
                }
              });
            }
          }
        }
      } catch (e) {}

      // 去重合并，防止分页边界偶发重复
      const existingIds = new Set(xmasLoadedProducts.map(item => Number(item.id)));
      const uniqueBatch = newProducts.filter(item => !existingIds.has(Number(item.id)));
      xmasLoadedProducts = append ? [...xmasLoadedProducts, ...uniqueBatch] : uniqueBatch;

      const batchHtml = uniqueBatch.map(buildProductCardHtml).join('');
      if (append) {
        grid.insertAdjacentHTML('beforeend', batchHtml);
      } else {
        grid.innerHTML = batchHtml;
      }
    } catch (err) {
      console.error('Failed to load Christmas favorites:', err);
      if (append) {
        xmasCurrentPage = Math.max(1, xmasCurrentPage - 1);
      } else {
        grid.innerHTML = `<div class="xmas-loading-box"><p>Unable to load products right now. Please refresh the page.</p></div>`;
        xmasHasMore = false;
      }
    } finally {
      xmasIsLoading = false;
      updateGridFooterControls();
    }
  }

  function rerenderAllLoadedProducts() {
    const grid = document.getElementById('xmasProductsGrid');
    if (!grid || xmasLoadedProducts.length === 0) return;
    grid.innerHTML = xmasLoadedProducts.map(buildProductCardHtml).join('');
  }

  // 点击加载更多按钮
  document.getElementById('xmasLoadMoreBtn')?.addEventListener('click', () => {
    if (xmasHasMore && !xmasIsLoading) {
      loadXmasFavorites(xmasCurrentCategory, true);
    }
  });

  // 委托点击 Add 按钮打开圣诞 Quick Order 弹窗，或点击图片/标题跳转详情页
  document.getElementById('xmasProductsGrid')?.addEventListener('click', (e) => {
    const btn = e.target.closest('.xmas-add-btn');
    if (btn) {
      e.preventDefault();
      e.stopPropagation();
      const pid = Number(btn.getAttribute('data-product-id'));
      const product = xmasLoadedProducts.find(item => Number(item.id) === pid);
      if (product) {
        openXmasQuickOrder(product);
      }
      return;
    }

    const linkTrigger = e.target.closest('[data-href]');
    if (linkTrigger) {
      const href = linkTrigger.getAttribute('data-href');
      if (href) {
        window.location.href = href;
      }
    }
  });

