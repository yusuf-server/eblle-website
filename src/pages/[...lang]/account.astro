      document.getElementById('couponCntExpired').textContent = coupons.expired ? coupons.expired.length : 0;

      renderCouponsGrid(coupons);
      renderLedgerTable(ledger);
      startCountdownTick();

    } catch (err) {
      console.error('Load VIP summary error:', err);
    }
  }

  function formatCountdown(seconds) {
    if (seconds <= 0) return 'Expired';
    const days = Math.floor(seconds / 86400);
    const hours = Math.floor((seconds % 86400) / 3600);
    const mins = Math.floor((seconds % 3600) / 60);
    if (days > 0) return `Expires in ${days}d ${hours}h`;
    return `Expires in ${hours}h ${mins}m`;
  }

  function startCountdownTick() {
    if (countdownTimer) clearInterval(countdownTimer);
    countdownTimer = setInterval(() => {
      document.querySelectorAll('.ticket-countdown[data-seconds]').forEach(el => {
        let sec = parseInt(el.getAttribute('data-seconds'), 10);
        if (sec > 0) {
          sec -= 1;
          el.setAttribute('data-seconds', sec);
          el.innerHTML = `<i class="fa-regular fa-clock"></i> ${formatCountdown(sec)}`;
        } else {
          el.innerHTML = `<i class="fa-regular fa-clock"></i> Expired`;
        }
      });
    }, 1000);
  }

  // 渲染高定轻奢珠宝票券 (活动券自动隐藏具体券码与复制按钮)
  function renderCouponsGrid(coupons) {
    const grid = document.getElementById('couponsGrid');
    const list = coupons[currentCouponFilter] || [];

    if (list.length === 0) {
      grid.innerHTML = `
        <div style="grid-column: 1 / -1; text-align:center; padding:40px 20px; color:#888;">
          <i class="fa-solid fa-ticket" style="font-size:36px; opacity:0.3; margin-bottom:10px;"></i>
          <p style="margin:0;">No ${currentCouponFilter} vouchers found.</p>
        </div>`;
      return;
    }

    grid.innerHTML = list.map(c => {
      const isPercent = c.discount_type === 'percent';
      const amtStr = isPercent ? `${Math.round(c.amount)}%` : `$${Math.round(c.amount)}`;
      const typeStr = isPercent ? 'Discount' : 'USD Off';
      const condStr = c.min_amount > 0 ? `Valid on orders over $${c.min_amount}` : 'No minimum spend required';
      
      const isAvailable = currentCouponFilter === 'available';
      const isUsed = currentCouponFilter === 'used';
      const isExpired = currentCouponFilter === 'expired';

      // 核心判断：大礼包、首单券、月度券、生日券不需要展示具体券码
      const isSystemAutoOffer = ['bundle_pack', 'welcome_pct', 'monthly_pct', 'birthday'].includes(c.tag);

      let cardClass = 'ticket-card';
      let stampHtml = '';

      if (isUsed) {
        cardClass += ' is-used';
        stampHtml = `
          <div class="stamp-overlay">
            <span class="stamp-text">REDEEMED</span>
            <span class="stamp-date">Applied in Order</span>
          </div>
        `;
      } else if (isExpired) {
        cardClass += ' is-expired';
        stampHtml = `
          <div class="stamp-overlay stamp-expired">
            <span class="stamp-text">EXPIRED</span>
            <span class="stamp-date">Ended</span>
          </div>
        `;
      }

      // 底部操作区逻辑
      let footerBarHtml = '';
      if (!isAvailable) {
        footerBarHtml = `
          <span style="font-size:11px; color:#999; text-transform:uppercase; font-weight:700;">${currentCouponFilter}</span>
        `;
      } else if (isSystemAutoOffer) {
        footerBarHtml = `
          <span style="display:inline-flex; align-items:center; gap:5px; font-size:11px; font-weight:700; color:#8c631a; letter-spacing:0.04em;">
            <i class="fa-solid fa-bolt" style="font-size:10px;"></i> Available at Checkout
          </span>
          <span style="font-size:10.5px; color:#777; font-weight:500;">No Code Needed</span>
        `;
      } else {
        footerBarHtml = `
          <span class="ticket-code-tag">${c.code}</span>
          <button type="button" class="ticket-copy-btn" onclick="copyCouponCode('${c.code}', this)">
            <i class="fa-regular fa-copy"></i> Copy Code
          </button>
        `;
      }

      return `
        <div class="${cardClass}">
          ${stampHtml}
          <div class="ticket-stub-left">
            <div class="ticket-val-num">${amtStr}</div>
            <div class="ticket-val-unit">${typeStr}</div>
          </div>
          <div class="ticket-body-right">
            <div>
              <div class="ticket-badge-row">
                <span class="ticket-tag-gold">${c.tag ? c.tag.replace('_', ' ') : 'VIP Exclusive'}</span>
                ${isAvailable && c.countdown_seconds > 0 
                  ? `<span class="ticket-countdown" data-seconds="${c.countdown_seconds}"><i class="fa-regular fa-clock"></i> ${formatCountdown(c.countdown_seconds)}</span>`
                  : `<span style="font-size:11px; color:#999;">${c.expires_at}</span>`}
              </div>
              <div class="ticket-title">${c.title}</div>
              <div class="ticket-rules">${condStr}</div>
            </div>
            <div class="ticket-footer-bar">
              ${footerBarHtml}
            </div>
          </div>
        </div>
      `;
    }).join('');
  }

