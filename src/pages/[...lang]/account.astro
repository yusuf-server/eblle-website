  function formatOrderStatus(statusKey) {
    const statusMap = {
      'pending': { text: 'Pending', class: 'processing' },
      'processing': { text: 'Processing', class: 'processing' },
      'on-hold': { text: 'On Hold', class: 'processing' },
      'completed': { text: 'Completed', class: 'delivered' },
      'cancelled': { text: 'Cancelled', class: 'cancelled' },
      'refunded': { text: 'Refunded', class: 'cancelled' },
      'failed': { text: 'Failed', class: 'cancelled' }
    };
    const s = statusMap[statusKey] || { text: statusKey || 'Processing', class: 'processing' };
    return `<span class="acc-pill-status ${s.class}">${s.text}</span>`;
  }

  function buildOrderCardHtml(order) {
    const orderDate = new Date(order.date_created).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
    const items = order.line_items || [];
    const count = items.reduce((sum, item) => sum + (item.quantity || 1), 0);
    const thumbsHtml = items.slice(0, 3).map(item => {
      const isFreeGift = (item.name || '').includes('Free Gift');
      const src = isFreeGift
    ? 'https://api.ebbellejewelry.com/wp-content/uploads/2026/11/Gemini_Generated_Image_sesx5gsesx5gsesx.jpeg'
    : (item.image?.src || 'https://images.unsplash.com/photo-1515562141207-7a88fb7ce338?w=100&q=80');
      return `<img src="${src}" alt="${item.name || 'item'}" class="acc-thumb-img" />`;
    }).join('');

    const canPay = ['pending', 'failed', 'on-hold'].includes(order.status);
    let actionButtonHtml = canPay
      ? `<div style="display: flex; gap: 8px;">
          <button type="button" class="acc-btn-pay" onclick="retryPayment('${order.id}')">Complete Payment &rarr;</button>
          <button type="button" class="acc-btn-detail-secondary" onclick="viewSingleOrder('${order.id}')">View Details</button>
        </div>`
      : `<button type="button" class="acc-btn-detail" onclick="viewSingleOrder('${order.id}')">View Details &rarr;</button>`;

    return `
      <div class="acc-order-card">
        <div class="acc-card-top">
          <div style="display:flex; align-items:center; gap:10px; font-size:13px;">
            <span class="acc-card-order-id">#${order.number || order.id}</span>
            <span style="color:#ccc;">&bull;</span>
            <span style="color:#777;">${orderDate}</span>
            ${formatOrderStatus(order.status)}
          </div>
          <div style="font-size:13px; color:#666;">Total: <strong style="font-size:15px; color:#111;">$${parseFloat(order.total).toFixed(2)}</strong></div>
        </div>
        <div class="acc-card-bottom">
          <div class="acc-card-thumbs">
            ${thumbsHtml}
            <span style="font-size:12.5px; color:#777; margin-left:4px;">${count} item${count > 1 ? 's' : ''}</span>
          </div>
          ${actionButtonHtml}
        </div>
      </div>
    `;
  }

  function retryPayment(orderId) {
    const order = cachedOrdersData.find(o => String(o.id) === String(orderId));
    if (!order) return;
    const shipping = order.shipping || {};
    const billing = order.billing || {};
    const shippingInfo = {
      firstName: shipping.first_name || billing.first_name || '',
      lastName: shipping.last_name || billing.last_name || '',
      email: billing.email || '',
      phone: billing.phone || '',
      address: shipping.address_1 || billing.address_1 || '',
      apartment: shipping.address_2 || billing.address_2 || '',
      city: shipping.city || billing.city || '',
      state: shipping.state || billing.state || '',
      zip: shipping.postcode || billing.postcode || '',
      country: shipping.country || billing.country || 'US',
      shippingMethod: order.shipping_lines?.[0]?.method_id || 'standard',
      shippingCost: parseFloat(order.shipping_total || 0).toFixed(2)
    };
    sessionStorage.setItem('shippingInfo', JSON.stringify(shippingInfo));
    sessionStorage.setItem('pendingOrderId', order.id.toString());
    sessionStorage.setItem('pendingOrderKey', order.order_key || '');

    const cartItems = order.line_items.map(item => ({
      id: item.product_id,
      product_id: item.product_id,
      variation_id: item.variation_id || 0,
      name: item.name,
      price: parseFloat(item.price || 0).toFixed(2),
      quantity: item.quantity,
      image: item.image?.src || ''
    }));
    localStorage.setItem('ebbelle_cart', JSON.stringify(cartItems));
    window.location.href = '/checkout/payment';
  }
  window.retryPayment = retryPayment;

  function viewSingleOrder(orderId) {
    const order = cachedOrdersData.find(o => String(o.id) === String(orderId));
    if (!order) return;
    changeTab('orders');

    const listWrap = document.getElementById('ordersListWrap');
    const detailWrap = document.getElementById('orderDetailWrap');
    const content = document.getElementById('orderDetailContent');
    listWrap.style.display = 'none';
    detailWrap.style.display = 'block';

    const orderDate = new Date(order.date_created).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
    const items = order.line_items || [];
    const shipping = order.shipping || {};
    const billing = order.billing || {};
    const subtotal = (parseFloat(order.total) - parseFloat(order.shipping_total || 0) - parseFloat(order.total_tax || 0)).toFixed(2);

    content.innerHTML = `
      <div class="acc-view-detail-card">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px;">
          <div>
            <h2 style="font-size: 20px; margin: 0 0 4px; font-weight: 700;">Order #${order.number || order.id}</h2>
            <p style="margin: 0; font-size: 12.5px; color: #888;">Placed on ${orderDate}</p>
          </div>
          <div>${formatOrderStatus(order.status)}</div>
        </div>
        <h3>Items Ordered</h3>
        <div style="display:flex; flex-direction:column; gap:12px;">
          ${items.map(item => {
            const isFreeGift = (item.name || '').includes('Free Gift');
            const thumbUrl = isFreeGift
              ? 'https://api.ebbellejewelry.com/wp-content/uploads/2026/11/Gemini_Generated_Image_sesx5gsesx5gsesx.jpeg'
              : (item.image?.src || 'https://images.unsplash.com/photo-1515562141207-7a88fb7ce338?w=120&q=80');
            return `
            <div class="acc-detail-item-row">
              <img src="${thumbUrl}" class="acc-detail-thumb" alt="${item.name}" />
              <div class="acc-detail-name-box">
                <h4>${item.name}</h4>
                <p style="margin:0; font-size:12px; color:#777;">Qty: ${item.quantity} &times; $${parseFloat(item.price || 0).toFixed(2)}</p>
              </div>
              <div class="acc-detail-price-box">$${parseFloat(item.total || 0).toFixed(2)}</div>
            </div>
          `;
          }).join('')}
        </div>
      </div>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px;">
        <div class="acc-view-detail-card" style="margin-bottom: 0;">
          <h3>Order Summary</h3>
          <div style="display: flex; flex-direction: column; gap: 8px; font-size: 13px; color: #666;">
            <div style="display: flex; justify-content: space-between;"><span>Subtotal:</span><span>$${subtotal}</span></div>
            <div style="display: flex; justify-content: space-between;"><span>Shipping:</span><span>$${parseFloat(order.shipping_total || 0).toFixed(2)}</span></div>
            <div style="display: flex; justify-content: space-between; font-weight: 700; color: #111; border-top: 1px solid #eee; padding-top: 8px;">
              <span>Total Paid:</span><span>$${parseFloat(order.total).toFixed(2)} ${order.currency || 'USD'}</span>
            </div>
          </div>
        </div>
        <div class="acc-view-detail-card" style="margin-bottom: 0;">
          <h3>Shipping Address</h3>
          <div style="font-size: 13px; color: #555; line-height: 1.5;">
            <p style="margin: 0 0 4px; font-weight: 700; color: #111;">${shipping.first_name || billing.first_name || ''} ${shipping.last_name || billing.last_name || ''}</p>
            <p style="margin: 0;">${shipping.address_1 || billing.address_1 || 'No address provided'}</p>
            ${shipping.address_2 || billing.address_2 ? `<p style="margin: 0;">${shipping.address_2 || billing.address_2}</p>` : ''}
            <p style="margin: 0;">${shipping.city || billing.city || ''}, ${shipping.state || billing.state || ''} ${shipping.postcode || billing.postcode || ''}</p>
            <p style="margin: 0;">${shipping.country || billing.country || ''}</p>
          </div>
        </div>
      </div>
    `;
  }
  window.viewSingleOrder = viewSingleOrder;

  document.getElementById('backToOrdersListBtn')?.addEventListener('click', () => {
    document.getElementById('ordersListWrap').style.display = 'block';
    document.getElementById('orderDetailWrap').style.display = 'none';
  });

  function displayAddress(type, address) {
    const displayEl = document.getElementById(`${type}AddressDisplay`);
    if (!displayEl) return;
    if (!address || !address.address_1) {
      displayEl.innerHTML = '<p style="color: #999;">No address saved</p>';
      return;
    }
    const fullName = `${address.first_name || ''} ${address.last_name || ''}`.trim();
    let html = '';
    if (fullName) html += `<p><strong>${fullName}</strong></p>`;
    if (address.address_1) html += `<p>${address.address_1}${address.address_2 ? `, ${address.address_2}` : ''}</p>`;
    html += `<p>${address.city || ''}, ${address.state || ''} ${address.postcode || ''}, ${address.country || ''}</p>`;
    if (address.phone) html += `<p>${address.phone}</p>`;
    displayEl.innerHTML = html;
  }

  function populateAddressForm(type, address) {
    if (!address) return;
    document.getElementById(`${type}_first_name`).value = address.first_name || '';
    document.getElementById(`${type}_last_name`).value = address.last_name || '';
    document.getElementById(`${type}_company`).value = address.company || '';
    document.getElementById(`${type}_country`).value = address.country || 'US';
    document.getElementById(`${type}_address_1`).value = address.address_1 || '';
    document.getElementById(`${type}_address_2`).value = address.address_2 || '';
    document.getElementById(`${type}_city`).value = address.city || '';
    document.getElementById(`${type}_postcode`).value = address.postcode || '';
    if (type === 'billing') {
      document.getElementById(`${type}_phone`).value = address.phone || '';
      document.getElementById(`${type}_email`).value = address.email || '';
    }
  }

  function updateAddressMetric(billing, shipping) {
    const m = document.getElementById('dashboardAddressesMetric');
    if (!m) return;
    let count = 0;
    if (billing && billing.address_1) count++;
    if (shipping && shipping.address_1) count++;
    m.textContent = `${count} Saved Address${count !== 1 ? 'es' : ''}`;
  }

  const billingFormBlock = document.getElementById('billingFormBlock');
  const shippingFormBlock = document.getElementById('shippingFormBlock');
  document.getElementById('openEditBillingBtn')?.addEventListener('click', () => { if (billingFormBlock) billingFormBlock.style.display = 'block'; });
  document.getElementById('closeBillingFormBtn')?.addEventListener('click', () => { if (billingFormBlock) billingFormBlock.style.display = 'none'; });
  document.getElementById('cancelBillingFormBtn')?.addEventListener('click', () => { if (billingFormBlock) billingFormBlock.style.display = 'none'; });
  document.getElementById('openEditShippingBtn')?.addEventListener('click', () => { if (shippingFormBlock) shippingFormBlock.style.display = 'block'; });
  document.getElementById('closeShippingFormBtn')?.addEventListener('click', () => { if (shippingFormBlock) shippingFormBlock.style.display = 'none'; });
  document.getElementById('cancelShippingFormBtn')?.addEventListener('click', () => { if (shippingFormBlock) shippingFormBlock.style.display = 'none'; });

  document.getElementById('billingAddressForm')?.addEventListener('submit', async (e) => { e.preventDefault(); await saveAddress('billing'); });
  document.getElementById('shippingAddressForm')?.addEventListener('submit', async (e) => { e.preventDefault(); await saveAddress('shipping'); });

  async function saveAddress(type) {
    const address = {
      firstName: document.getElementById(`${type}_first_name`).value.trim(),
      lastName: document.getElementById(`${type}_last_name`).value.trim(),
      company: document.getElementById(`${type}_company`).value.trim(),
      country: document.getElementById(`${type}_country`).value,
      address1: document.getElementById(`${type}_address_1`).value.trim(),
      address2: document.getElementById(`${type}_address_2`).value.trim(),
      city: document.getElementById(`${type}_city`).value.trim(),
      postcode: document.getElementById(`${type}_postcode`).value.trim(),
    };
    if (type === 'billing') {
      address.phone = document.getElementById(`${type}_phone`).value.trim();
      address.email = document.getElementById(`${type}_email`).value.trim();
    }
    const btn = document.getElementById(`save${type.charAt(0).toUpperCase() + type.slice(1)}Btn`);
    btn.disabled = true;

    try {
      const res = await fetch('/api/user/update-address', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ type, address }),
      });
      const data = await res.json();
      if (data.success) {
        displayAddress(type, data.address);
        document.getElementById(`${type}FormBlock`).style.display = 'none';
      } else {
        alert(data.message || 'Update failed');
      }
    } catch (e) {
      alert('Network error');
    } finally {
      btn.disabled = false;
    }
  }

  async function saveAccountDetails() {
    const firstName = document.getElementById('account_first_name').value.trim();
    const lastName = document.getElementById('account_last_name').value.trim();
    const email = document.getElementById('account_email').value.trim();

    const btn = document.getElementById('saveAccountDetailsBtn');
    btn.disabled = true;

    try {
      const res = await fetch('/api/user/update-profile', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ firstName, lastName, email }),
      });
      const data = await res.json();

      const msg = document.getElementById('accountDetailsMessage');
      msg.style.display = 'block';
      msg.className = 'acc-message success';
      msg.textContent = 'Profile updated successfully!';
      await loadUserInfo();
      setTimeout(() => { msg.style.display = 'none'; }, 4000);
    } catch (e) {
      alert('Error updating profile');
    } finally {
      btn.disabled = false;
    }
  }
  window.saveAccountDetails = saveAccountDetails;

  async function handlePasswordChange() {
    const cur = document.getElementById('currentPassword').value;
    const pwd = document.getElementById('newPassword').value;
    const cnf = document.getElementById('confirmPassword').value;
    const msg = document.getElementById('passwordMessage');

    if (!cur || !pwd || !cnf || pwd !== cnf || pwd.length < 8) {
      msg.className = 'acc-message error';
      msg.style.display = 'block';
      msg.textContent = 'Passwords do not match or length is less than 8.';
      return;
    }

    try {
      const res = await fetch('/api/auth/change-password', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ user_id: currentUserId, new_password: pwd }),
      });
      const data = await res.json();
      msg.style.display = 'block';
      msg.className = data.success ? 'acc-message success' : 'acc-message error';
      msg.textContent = data.message || (data.success ? 'Password updated!' : 'Failed');
    } catch (e) {
      msg.style.display = 'block';
      msg.className = 'acc-message error';
      msg.textContent = 'Error updating password';
    }
  }
  window.handlePasswordChange = handlePasswordChange;

  // 页面启动
  loadUserInfo();
  loadOrders();
  loadRecentOrders();
  loadVipSummary();

  const urlParams = new URLSearchParams(window.location.search);
  const tabParam = urlParams.get('tab');
  if (tabParam) changeTab(tabParam);
</script>