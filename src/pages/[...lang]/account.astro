        }, 100);
      } else {
        document.getElementById('dashNextTierLabel').textContent = `Diamond Tier Member`;
        document.getElementById('dashSpendNeededText').textContent = `Highest Privileges Unlocked`;
        setTimeout(() => {
          progressBar.style.width = `100%`;
        }, 100);
      }

      // 指标
      const availCount = coupons.available ? coupons.available.length : 0;
      if (sidebarCouponCount) {
