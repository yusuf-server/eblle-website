  function renderLedgerTable(ledger) {
    const tbody = document.getElementById('ledgerTableBody');
    if (!ledger || ledger.length === 0) {
      tbody.innerHTML = `<tr><td colspan="4" style="text-align:center; color:#999; padding:20px;">No points activity recorded yet.</td></tr>`;
      return;
    }

    tbody.innerHTML = ledger.map(item => {
      const isAdd = parseFloat(item.points_change) >= 0;
      const changeClass = isAdd ? 'pts-add' : 'pts-sub';
      const changePrefix = isAdd ? '+' : '';
      const dateStr = new Date(item.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
