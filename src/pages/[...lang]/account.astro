        if (vip.birthday) {
          const formattedBday = formatBirthdayMonthDay(vip.birthday);
          bdayDesc.innerHTML = `<span style="color:#2e7d32; font-weight:600;">✓ Birthday Registered:</span> <strong>${formattedBday}</strong>. Your annual gift arrives every year on your birthday.`;
          bdayArea.innerHTML = `<span style="font-size:11px; color:#888; font-weight:700; background:#f0eee9; padding:6px 14px; border-radius:20px; letter-spacing:0.05em;">LOCKED</span>`;
        } else {
          bdayDesc.textContent = 'Silver members receive $5.00 OFF, Gold members receive $10.00 OFF automatically on birthday month.';
