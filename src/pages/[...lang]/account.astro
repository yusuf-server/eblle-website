  // 格式化生日展示（隐藏占位年份 2000，仅展示 Month Day，如 November 15）
  function formatBirthdayMonthDay(rawStr) {
    if (!rawStr) return '';
    const months = [
      'January', 'February', 'March', 'April', 'May', 'June',
      'July', 'August', 'September', 'October', 'November', 'December'
    ];
    const parts = String(rawStr).trim().split('-');
    let mIdx = -1;
    let dayNum = 0;
    if (parts.length === 3) {
      mIdx = parseInt(parts[1], 10) - 1;
      dayNum = parseInt(parts[2], 10);
    } else if (parts.length === 2) {
      mIdx = parseInt(parts[0], 10) - 1;
      dayNum = parseInt(parts[1], 10);
    }
    if (mIdx >= 0 && mIdx < 12 && dayNum > 0) {
      return `${months[mIdx]} ${dayNum}`;
    }
    return rawStr;
  }

