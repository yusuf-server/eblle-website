<script is:inline>
  let cachedOrdersData = [];
  let cachedVipData = null;
  let currentCouponFilter = 'available';
  let countdownTimer = null;

  // 1. 初始化英文 Day 下拉框 (1 - 31)
  const daySelect = document.getElementById('bdayDaySelect');
  if (daySelect && daySelect.options.length <= 1) {
    for (let i = 1; i <= 31; i++) {
      const val = i < 10 ? `0${i}` : `${i}`;
      const opt = document.createElement('option');
      opt.value = val;
      opt.textContent = `${i}`;
      daySelect.appendChild(opt);
    }
  }

  // 2. Tab 切换逻辑
  const navPills = document.querySelectorAll('.acc-nav-pill[data-tab]');
  const tabPanes = document.querySelectorAll('.acc-tab-pane');

  function changeTab(tabId) {
    if (!tabId) return;
    navPills.forEach(p => p.classList.toggle('active', p.getAttribute('data-tab') === tabId));
    tabPanes.forEach(pane => pane.classList.toggle('active', pane.id === tabId));

    if (tabId === 'orders') {
      const listWrap = document.getElementById('ordersListWrap');
      const detailWrap = document.getElementById('orderDetailWrap');
      if (listWrap) listWrap.style.display = 'block';
      if (detailWrap) detailWrap.style.display = 'none';
    }
  }

  navPills.forEach(btn => btn.addEventListener('click', (e) => { e.preventDefault(); changeTab(btn.getAttribute('data-tab')); }));
  document.querySelectorAll('.acc-text-link[data-tab], .acc-mini-link[data-tab]').forEach(btn => btn.addEventListener('click', (e) => { e.preventDefault(); changeTab(btn.getAttribute('data-tab')); }));

  // =========================================================================
  // 核心：VIP 会员数据加载与渲染 (支持动态背景与全新质感)
  // =========================================================================
  async function loadVipSummary() {
    try {
      const response = await fetch('/api/user/vip-summary');
      const data = await response.json();

      if (!data.success) return;
      cachedVipData = data;

      const sidebarTierLabel = document.getElementById('sidebarTierLabel');
      const sidebarCouponCount = document.getElementById('sidebarCouponCount');
      const dashboardRewardsMetric = document.getElementById('dashboardRewardsMetric');

      if (!data.vip_active) {
        if (sidebarTierLabel) sidebarTierLabel.textContent = 'Awaiting VIP Activation';
        document.getElementById('vipInactiveNotice').style.display = 'block';
        document.getElementById('vipActiveContent').style.display = 'none';
        document.getElementById('birthdayCard').style.display = 'none';
        document.getElementById('sampleClaimCard').style.display = 'none';
        renderCouponsGrid({ available: [], used: [], expired: [] });
        return;
      }

      document.getElementById('vipInactiveNotice').style.display = 'none';
      document.getElementById('vipActiveContent').style.display = 'grid';

      const vip = data.vip;
      const coupons = data.coupons || { available: [], used: [], expired: [] };
      const ledger = data.ledger || [];

      // 1. 动态注入 VIP 横幅对应的背景流光类名 (tier-bg-pearl, tier-bg-silver, etc.)
      const bannerEl = document.getElementById('dashboardVipBanner');
      if (bannerEl) {
        bannerEl.className = `vip-status-banner tier-bg-${vip.tier_key}`;
      }

      // 2. 侧边栏动态徽章类名注入
      const avatarEl = document.getElementById('sidebarAvatarMedallion');
      const avatarIcon = document.getElementById('sidebarAvatarIcon');
      if (avatarEl) {
        avatarEl.className = `acc-avatar badge-${vip.tier_key}`;
        const icons = {
          pearl: '<i class="fa-regular fa-circle-dot"></i>',
          silver: '<i class="fa-solid fa-shield-halved"></i>',
          gold: '<i class="fa-solid fa-gem"></i>',
          diamond: '<i class="fa-solid fa-crown"></i>'
        };
        if (avatarIcon) avatarIcon.innerHTML = icons[vip.tier_key] || icons.pearl;
      }

      if (sidebarTierLabel) sidebarTierLabel.textContent = vip.tier_label;
      document.getElementById('dashVipTierText').textContent = vip.tier_label;
      document.getElementById('dashPointsNum').textContent = vip.points_balance.toLocaleString();
      document.getElementById('dashPointsUsd').textContent = `PTS (≈ $${vip.points_usd_value.toFixed(2)})`;

      // 3. 晋升进度条向前生长加载动画
      const progressBar = document.getElementById('dashProgressBar');
      if (vip.next_tier_label) {
