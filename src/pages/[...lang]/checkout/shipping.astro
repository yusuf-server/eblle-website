      const ms1Class = totalQty >= 2 ? (totalQty < 5 ? 'xmas-ms-pill current' : 'xmas-ms-pill reached') : 'xmas-ms-pill';
      const ms2Class = totalQty >= 5 ? (totalQty < 8 ? 'xmas-ms-pill current' : 'xmas-ms-pill reached') : 'xmas-ms-pill';
      const ms3Class = totalQty >= 8 ? 'xmas-ms-pill current' : 'xmas-ms-pill';
      const shopUrl = window.location.pathname.startsWith('/fr') ? '/fr/christmas'
        : window.location.pathname.startsWith('/de') ? '/de/christmas'
        : window.location.pathname.startsWith('/es') ? '/es/christmas'
        : '/christmas';

      return `
        <div class="xmas-tier-progress-box">
          <div class="xmas-tp-top">
            <span><i class="fa-solid fa-gift" style="color:#961820; margin-right:4px;"></i> ${isMaxed ? 'All Holiday Tiers Unlocked!' : `Next Goal: ${nextTierName}`}</span>
