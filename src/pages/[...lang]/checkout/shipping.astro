            <div class="${ms1Class}">${totalQty >= 2 ? '✓ ' : ''}2+: Buy 2 Get 1</div>
            <div class="${ms2Class}">${totalQty >= 5 ? '✓ ' : ''}5+: Buy 3 Get 2</div>
