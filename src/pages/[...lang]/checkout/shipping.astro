  // ============================================================
  // 原有运费与重量计算核心
  // ============================================================
  function calculateBaseShipping(totalWeight) {
    const weight = Math.max(0.03, totalWeight);
    const baseShipping = (161 * weight + 27) / 6.3 / 0.95;
    return parseFloat(baseShipping.toFixed(2));
  }

  const COUNTRY_SURCHARGES = {
    'Argentina': 6, 'Australia': 5, 'Bahrain': 5, 'Indonesia': 4,
    'Jordan': 2, 'Kuwait': 5, 'Mayotte': 35, 'Morocco': 3,
    'Qatar': 3, 'Saudi Arabia': 3, 'Senegal': 20, 'Seychelles': 35, 'Zambia': 3,
    'Albania': 30, 'Algeria': 30, 'Andorra': 30, 'Belarus': 30, 'Benin': 30,
    'Bulgaria': 30, 'Cape Verde': 30, 'Chad': 30, 'Croatia': 30, 'Cyprus': 30,
    'Czech Republic': 30, 'Côte d\'Ivoire': 30, 'Democratic Republic of the Congo': 30,
    'Egypt': 30, 'Eswatini': 30, 'Faroe Islands': 30, 'Gambia': 30, 'Georgia': 30,
    'Ghana': 30, 'Greece': 30, 'Iceland': 30, 'Iraq': 30, 'Kenya': 30, 'Laos': 30,
    'Lebanon': 30, 'Lesotho': 30, 'Liberia': 30, 'Libya': 30, 'Liechtenstein': 30,
    'Malawi': 30, 'Maldives': 30, 'Mali': 30, 'Mauritania': 30,
    'Mauritius': 30, 'Micronesia': 30, 'Moldova': 30, 'Mozambique': 30, 'Namibia': 30,
    'Nepal': 30, 'Niger': 30, 'Nigeria': 30, 'North Macedonia': 30, 'Rwanda': 30,
    'Syria': 30, 'Tanzania': 30, 'Tunisia': 30, 'Turkey': 30, 'Uganda': 30,
    'American Samoa': 43, 'Angola': 43, 'Armenia': 43, 'Bangladesh': 43, 'Barbados': 43,
    'Bolivia': 43, 'Collectivity of Saint Martin': 43, 'Costa Rica': 43, 'Ecuador': 43,
    'El Salvador': 43, 'Fiji': 43, 'French Guiana': 43, 'French Polynesia': 43,
    'Grenada': 43, 'Guadeloupe': 43, 'Guatemala': 43, 'Honduras': 43, 'Marshall Islands': 43,
    'Martinique': 43, 'New Caledonia': 43, 'Nicaragua': 43, 'Palau': 43, 'Panama': 43,
    'Papua New Guinea': 43, 'Paraguay': 43, 'Peru': 43, 'Sint Maarten': 43, 'Suriname': 43,
    'Trinidad and Tobago': 43, 'Uruguay': 43, 'Venezuela': 43, 'Western Samoa': 43
  };

  function getCountrySurcharge(country) {
    return COUNTRY_SURCHARGES[country] || 0;
  }

  function calculateTotalWeight(cart) {
    return cart.reduce((total, item) => {
      if (isExcludedFromShipping(item)) {
        return total;
      }
      const weight = parseFloat(item.weight) || 0;
      return total + (weight * item.quantity);
    }, 0);
  }

  function calculateShipping(totalWeight, country) {
    const cart = getCart();
    const hasOnlyFreeShippingItems = cart.length > 0 && cart.every(item => isExcludedFromShipping(item));

    if (hasOnlyFreeShippingItems) {
      return {
        totalWeight: 0,
        baseShipping: 0,
        surcharge: 0,
        totalShipping: 0,
        hasSurcharge: false
      };
    }

    const baseShipping = calculateBaseShipping(totalWeight);
    const surcharge = getCountrySurcharge(country);
    const totalShipping = baseShipping + surcharge;

    return {
      totalWeight: parseFloat(totalWeight.toFixed(3)),
      baseShipping: parseFloat(baseShipping.toFixed(2)),
      surcharge: parseFloat(surcharge.toFixed(2)),
      totalShipping: parseFloat(totalShipping.toFixed(2)),
      hasSurcharge: surcharge > 0
    };
  }

  // ============================================================
  // 货币换算工具
  // ============================================================
  const CURRENCY_SYMBOLS = { USD: '$', EUR: '€', GBP: '£', CAD: 'C$' };
  const CURRENCY_RATES = { USD: 1.0, EUR: 0.92, GBP: 0.79, CAD: 1.36 };

  function getCurrentCurrency() {
    return localStorage.getItem('ebbelle_currency') || 'USD';
  }
  function getCurrencySymbol(currency) {
    return CURRENCY_SYMBOLS[currency || getCurrentCurrency()] || '$';
  }
  function convertPrice(priceUSD, targetCurrency) {
    const currency = targetCurrency || getCurrentCurrency();
    const rate = CURRENCY_RATES[currency] || 1.0;
    return priceUSD * rate;
  }
  function formatPrice(priceUSD, targetCurrency) {
    const currency = targetCurrency || getCurrentCurrency();
    const converted = convertPrice(priceUSD, currency);
    const symbol = getCurrencySymbol(currency);
    const formatted = converted.toFixed(2);
    if (currency === 'EUR') return `${formatted}${symbol}`;
    return `${symbol}${formatted}`;
  }

  function getCart() {
    try {
      const cart = localStorage.getItem('ebbelle_cart');
      return cart ? JSON.parse(cart) : [];
    } catch (e) {
      return [];
    }
  }

  function getPreDiscountSubtotal(cart) {
    return cart.reduce((sum, item) => {
      if (item && item.isXmasMysteryGift) return sum;
      return sum + ((parseFloat(item.price) || 0) * (item.quantity || 1));
    }, 0);
  }

  function renderCartItems(cart, containerId) {
    const container = document.getElementById(containerId);
    if (!container) return;

    if (cart.length === 0) {
      container.innerHTML = '<p style="text-align: center; color: #666; padding: 20px;">Your cart is empty</p>';
      return;
    }

    let html = '';
    cart.forEach(item => {
      const isMysteryGift = Boolean(item.isXmasMysteryGift);
      const price = parseFloat(item.price) || 0;
      const itemTotal = price * item.quantity;
      const variants = isMysteryGift
        ? `🎄 Mystery Gift (${item.xmasGiftCode || ''})`
        : (item.selectedVariants ? Object.values(item.selectedVariants).filter(v => v).join(' / ') : '');

      html += `<div class="item" ${isMysteryGift ? 'style="background:#fff8f5; padding:8px; border-radius:6px; border:1px dashed #d6b879;"' : ''}>`;
      html += `<img src="${item.image || '/placeholder.jpg'}" alt="${item.name}" ${isMysteryGift ? 'style="object-fit:contain; padding:4px; border-color:#d6b879;"' : ''} onerror="this.src='/placeholder.jpg'">`;
      html += '<div class="item-details">';
      html += `<h3>${item.name}</h3>`;
      if (variants) html += `<p ${isMysteryGift ? 'style="color:#961820; font-weight:600;"' : ''}>${variants}</p>`;
      if (!isMysteryGift && item.quantity > 1) html += `<p>Qty: ${item.quantity}</p>`;
      html += '</div>';
      html += `<span class="item-price" ${isMysteryGift ? 'style="color:#961820; font-weight:700;"' : ''}>${isMysteryGift ? 'FREE' : formatPrice(itemTotal)}</span>`;
      html += '</div>';
    });
    container.innerHTML = html;
  }

  // ============================================================
  // 核心业务：统一调度结账试算接口（排除免费圣诞礼物本身不计件）
  // ============================================================
  async function performCheckoutRecalculation() {
    const cart = getCart();
    const regularCart = cart.filter(item => !item.isXmasMysteryGift);
    const subtotal = getPreDiscountSubtotal(cart);
    const countryName = document.getElementById('country')?.value || '';
    const email = document.getElementById('email')?.value.trim() || '';
    const countryIso = COUNTRY_ISO_MAP[countryName] || 'US';

    if (regularCart.length === 0) return;

    if (calcAbortController) {
      try { calcAbortController.abort(); } catch (e) {}
    }
    const currentController = new AbortController();
    calcAbortController = currentController;

    const totalWeight = calculateTotalWeight(regularCart);
    const localShipping = calculateShipping(totalWeight, countryName);

    const itemsPayload = regularCart.map(item => ({
      id: item.id || item.product_id,
      price: parseFloat(item.price) || 0,
      quantity: parseInt(item.quantity, 10) || 1
    }));

    try {
      const res = await fetch('/api/woocommerce/calculate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        signal: currentController.signal,
        body: JSON.stringify({
          email: email,
          subtotal: subtotal,
          country: countryIso,
          selected_offer: selectedOfferKey,
          promo_mode: promoMode,
          use_points: isPointsRedeemed,
          manual_coupon: manualCouponCode,
          items: itemsPayload
        })
      });

      const data = await res.json();
      if (currentController.signal.aborted) return;

      if (data && data.success) {
        activeCalculationData = data;
        renderCalculationOutcome(data, localShipping);
        return;
      }
    } catch (e) {
      if (e && e.name === 'AbortError') return;
      console.warn('API calculate fallback to local calculation:', e);
    }

    if (!currentController.signal.aborted) {
      renderFallbackOutcome(subtotal, localShipping);
    }
  }

  // ============================================================
  // 核心渲染：支持【圣诞满赠 vs VIP会员优惠】二选一互斥隔离
  // ============================================================
  function renderCalculationOutcome(data, localShipping) {
    const privilegeBoxes = document.querySelectorAll('.checkout-privilege-box');
    const discountSections = document.querySelectorAll('.discount-code-section');
    const feedbackEls = document.querySelectorAll('.coupon-feedback-msg');
    const remoteFeeLines = document.querySelectorAll('.remote-fee-line');
    const remoteFeeVals = document.querySelectorAll('.remote-fee-val');
    const discountLines = document.querySelectorAll('.discount-line');
    const discountVals = document.querySelectorAll('.discount-val');
    const shippingStatusTexts = document.querySelectorAll('.shipping-status-text');
    const noticeBoxes = document.querySelectorAll('.shipping-notice-box');
    const shippingPriceEl = document.getElementById('shippingPrice');
    const shippingOption = document.getElementById('shippingOption');
    const shippingDetailsEl = document.getElementById('shippingDetails');

    const cart = getCart();
    const regularCart = cart.filter(item => !item.isXmasMysteryGift);
    const hasOnlyFreeShippingItems = regularCart.length > 0 && regularCart.every(item => isExcludedFromShipping(item));

    // A. 纯免运费赠品订单
    if (hasOnlyFreeShippingItems) {
      syncShippingXmasGiftItem('');
      if (shippingDetailsEl) {
        shippingDetailsEl.style.display = 'none';
        shippingDetailsEl.innerHTML = '';
      }
      remoteFeeLines.forEach(l => { l.style.display = 'none'; });
      noticeBoxes.forEach(n => { n.style.display = 'none'; });
      privilegeBoxes.forEach(b => { b.style.display = 'none'; });
      discountLines.forEach(l => { l.style.display = 'none'; });

      shippingStatusTexts.forEach(s => { s.textContent = 'FREE'; });
      if (shippingPriceEl) shippingPriceEl.textContent = 'FREE';
      if (shippingOption) shippingOption.setAttribute('data-cost', '0.00');

      applyFinalTotalsToDom(data.final_subtotal);

      sessionStorage.setItem('ebbelle_checkout_calculation', JSON.stringify({
        promo_mode: 'free_gift_only',
        original_subtotal: parseFloat(data.original_subtotal) || 0,
        final_subtotal: parseFloat(data.final_subtotal) || 0,
        discount_total: 0,
        points_spent: 0,
        points_discount: 0,
        points_earned: 0,
        points_multiplier: 1.0,
        manual_coupon: '',
        shipping_cost: 0,
        remote_surcharge: 0,
        selected_offer: '',
        is_extreme_remote: false,
        free_gift: true,
        applied_offers: []
      }));
      return;
    }

    // B. 极偏远排除国家
    if (data.is_extreme_remote) {
      syncShippingXmasGiftItem('');
      privilegeBoxes.forEach(b => { b.style.display = 'none'; b.innerHTML = ''; });
      discountLines.forEach(l => { l.style.display = 'none'; });
      noticeBoxes.forEach(n => { n.style.display = 'none'; });

      remoteFeeLines.forEach(l => { l.style.display = 'flex'; });
      remoteFeeVals.forEach(v => { v.textContent = `+${formatPrice(data.remote_surcharge)}`; });

      const actualShipping = localShipping.baseShipping + data.remote_surcharge;
      const grandTotal = data.final_subtotal + actualShipping;

      shippingStatusTexts.forEach(s => { s.textContent = formatPrice(actualShipping); });
      if (shippingPriceEl) shippingPriceEl.textContent = formatPrice(actualShipping);
      if (shippingOption) shippingOption.setAttribute('data-cost', actualShipping.toFixed(2));

      if (shippingDetailsEl) {
        shippingDetailsEl.style.display = 'block';
        shippingDetailsEl.innerHTML = `
          <div style="display:flex; justify-content:space-between; margin-bottom:4px;">
            <span>Standard Courier:</span><span>${formatPrice(localShipping.baseShipping)}</span>
          </div>
          <div style="display:flex; justify-content:space-between; color:#b76e28;">
            <span>Remote Surcharge:</span><span>+${formatPrice(data.remote_surcharge)}</span>
          </div>
        `;
      }
      applyFinalTotalsToDom(grandTotal);

      sessionStorage.setItem('ebbelle_checkout_calculation', JSON.stringify({
        promo_mode: 'extreme_remote',
        original_subtotal: parseFloat(data.original_subtotal) || 0,
        final_subtotal: parseFloat(data.final_subtotal) || 0,
        discount_total: 0,
        points_spent: 0,
        points_discount: 0,
        points_earned: parseFloat(data.points_earned) || 0,
        points_multiplier: parseFloat(data.points_multiplier) || 1.0,
        manual_coupon: '',
        shipping_cost: actualShipping,
        remote_surcharge: parseFloat(data.remote_surcharge) || 0,
        selected_offer: '',
        is_extreme_remote: true,
        free_gift: false,
        applied_offers: []
      }));
      return;
    }

    if (shippingDetailsEl) {
      shippingDetailsEl.style.display = 'none';
      shippingDetailsEl.innerHTML = '';
    }

    // 检查是否处于圣诞活动周期内（严格联动后台总开关 + 开始/结束时间，非活动时间自动不显示）
    const xmasData = data.xmas_data || null;
    const isXmasPromoLive = Boolean(data.xmas_promo_active && xmasData && xmasData.promo_active);
    const isXmasEligible = Boolean(isXmasPromoLive && xmasData.eligible && (parseFloat(xmasData.xmas_discount) || 0) > 0);
    const useXmasBranch = isXmasEligible && promoMode === 'xmas_bogo';

    // 构建圣诞进阶促单进度条 HTML
    function buildXmasTierProgressHtml(xData) {
      const totalQty = Math.max(0, parseInt(xData.total_qty, 10) || 0);
      const isMaxed = totalQty >= 8;

      let nextTarget = 2;
      let nextTierName = 'Buy 2 Get 1 Free';
      if (totalQty >= 8) {
        nextTarget = 8;
        nextTierName = 'Buy 5 Get 3 Free (Max Tier)';
