            ${!isMaxed ? `<a href="${shopUrl}" class="xmas-add-more-link">+ Add Items</a>` : ''}
          </div>
        </div>
      `;
    }

    let xmasTopCardHtml = '';
    if (isXmasEligible) {
      const xmasDiscountNum = parseFloat(xmasData.xmas_discount) || 0;
      const vipDiscountNum = parseFloat(data.discount_total) || 0;
      const tierProgressHtml = buildXmasTierProgressHtml(xmasData);

      xmasTopCardHtml = `
        <div class="xmas-mutex-switcher">
          <div class="xmas-mutex-header">
            <span class="xmas-mutex-title"><i class="fa-solid fa-sleigh"></i> Choose Your Checkout Promotion</span>
