        nextTarget = 8;
        nextTierName = 'Buy 5 Get 3 Free';
      } else if (totalQty >= 2) {
        nextTarget = 5;
        nextTierName = 'Buy 3 Get 2 Free';
      }

      const pct = isMaxed ? 100 : Math.min(100, Math.max(10, Math.round((totalQty / nextTarget) * 100)));
      const needMore = Math.max(0, nextTarget - totalQty);
      const defaultHint = isMaxed
        ? 'Maximum Christmas reward unlocked (3 lowest-priced items FREE)!'
        : `Add ${needMore} more item${needMore > 1 ? 's' : ''} to ${totalQty >= 2 ? 'upgrade to' : 'unlock'} ${nextTierName}!`;
