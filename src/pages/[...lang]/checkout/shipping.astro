<script is:inline>
  // ============================================================
  // 全局试算与特权状态机
  // ============================================================
  let selectedOfferKey = ''; // 'welcome_15' | 'bundle_tier'
  let manualCouponCode = '';
  let activeCalculationData = null;
  let isPointsRedeemed = false; // 是否使用积分抵扣

  window.handlePointsToggle = function(checkbox) {
    isPointsRedeemed = Boolean(checkbox.checked);
    performCheckoutRecalculation();
  };
  // 免运费特殊赠品 ID 名单
  const FREE_SHIPPING_PRODUCT_IDS = [57994, '57994'];

  function isExcludedFromShipping(item) {
    const id = item.id || item.product_id;
    return FREE_SHIPPING_PRODUCT_IDS.includes(id) || FREE_SHIPPING_PRODUCT_IDS.includes(String(id));
  }

  // 国家标准 ISO 代码对照映射
  const COUNTRY_ISO_MAP = {
    'Albania': 'AL', 'Algeria': 'DZ', 'American Samoa': 'AS', 'Andorra': 'AD', 'Angola': 'AO',
    'Argentina': 'AR', 'Armenia': 'AM', 'Australia': 'AU', 'Austria': 'AT', 'Bahrain': 'BH',
    'Bangladesh': 'BD', 'Barbados': 'BB', 'Belarus': 'BY', 'Belgium': 'BE', 'Benin': 'BJ',
    'Bolivia': 'BO', 'Brazil': 'BR', 'Brunei': 'BN', 'Bulgaria': 'BG', 'Canada': 'CA',
    'Cape Verde': 'CV', 'Chad': 'TD', 'Chile': 'CL', 'China (Hong Kong)': 'HK', 'China (Macao)': 'MO',
    'Collectivity of Saint Martin': 'MF', 'Colombia': 'CO', 'Costa Rica': 'CR', 'Croatia': 'HR',
    'Cyprus': 'CY', 'Czech Republic': 'CZ', 'Côte d\'Ivoire': 'CI', 'Democratic Republic of the Congo': 'CD',
    'Denmark': 'DK', 'Ecuador': 'EC', 'Egypt': 'EG', 'El Salvador': 'SV', 'Estonia': 'EE',
    'Eswatini': 'SZ', 'Faroe Islands': 'FO', 'Fiji': 'FJ', 'Finland': 'FI', 'France': 'FR',
    'French Guiana': 'GF', 'French Polynesia': 'PF', 'Gambia': 'GM', 'Georgia': 'GE', 'Germany': 'DE',
    'Ghana': 'GH', 'Greece': 'GR', 'Grenada': 'GD', 'Guadeloupe': 'GP', 'Guatemala': 'GT',
    'Honduras': 'HN', 'Hungary': 'HU', 'Iceland': 'IS', 'Indonesia': 'ID', 'Iraq': 'IQ',
    'Ireland': 'IE', 'Israel': 'IL', 'Italy': 'IT', 'Japan': 'JP', 'Jordan': 'JO',
    'Kazakhstan': 'KZ', 'Kenya': 'KE', 'Kuwait': 'KW', 'Laos': 'LA', 'Latvia': 'LV',
    'Lebanon': 'LB', 'Lesotho': 'LS', 'Liberia': 'LR', 'Libya': 'LY', 'Liechtenstein': 'LI',
    'Lithuania': 'LT', 'Luxembourg': 'LU', 'Madagascar': 'MG', 'Malawi': 'MW', 'Malaysia': 'MY',
    'Maldives': 'MV', 'Mali': 'ML', 'Malta': 'MT', 'Marshall Islands': 'MH', 'Martinique': 'MQ',
    'Mauritania': 'MR', 'Mauritius': 'MU', 'Mayotte': 'YT', 'Mexico': 'MX', 'Micronesia': 'FM',
    'Moldova': 'MD', 'Morocco': 'MA', 'Mozambique': 'MZ', 'Namibia': 'NA', 'Nepal': 'NP',
    'Netherlands': 'NL', 'New Caledonia': 'NC', 'New Zealand': 'NZ', 'Nicaragua': 'NI', 'Niger': 'NE',
    'Nigeria': 'NG', 'North Macedonia': 'MK', 'Norway': 'NO', 'Oman': 'OM', 'Pakistan': 'PK',
    'Palau': 'PW', 'Panama': 'PA', 'Papua New Guinea': 'PG', 'Paraguay': 'PY', 'Peru': 'PE',
    'Philippines': 'PH', 'Poland': 'PL', 'Portugal': 'PT', 'Puerto Rico': 'PR', 'Qatar': 'QA',
    'Romania': 'RO', 'Rwanda': 'RW', 'Réunion': 'RE', 'Saudi Arabia': 'SA', 'Senegal': 'SN',
    'Serbia': 'RS', 'Seychelles': 'SC', 'Singapore': 'SG', 'Sint Maarten': 'SX', 'Slovakia': 'SK',
    'Slovenia': 'SI', 'South Africa': 'ZA', 'South Korea': 'KR', 'Spain': 'ES', 'Sri Lanka': 'LK',
    'Suriname': 'SR', 'Sweden': 'SE', 'Switzerland': 'CH', 'Syria': 'SY', 'Tanzania': 'TZ',
    'Thailand': 'TH', 'Trinidad and Tobago': 'TT', 'Tunisia': 'TN', 'Turkey': 'TR', 'Uganda': 'UG',
    'United Arab Emirates': 'AE', 'United Kingdom': 'GB', 'United States': 'US', 'Uruguay': 'UY',
    'Venezuela': 'VE', 'Vietnam': 'VN', 'Western Samoa': 'WS', 'Zambia': 'ZM'
  };

  // ============================================================
  // 原有运费与重量计算核心
  // ============================================================
  function calculateBaseShipping(totalWeight) {
    const weight = Math.max(0.03, totalWeight);
    const baseShipping = (161 * weight + 27) / 6.3 / 0.95;
    return parseFloat(baseShipping.toFixed(2));
  }

  const COUNTRY_SURCHARGES = {
    'Argentina': 6, 'Australia': 5, 'Bahrain': 5, 'Indonesia': 4,
    'Jordan': 2, 'Kuwait': 5, 'Mayotte': 35, 'Morocco': 3,
    'Qatar': 3, 'Saudi Arabia': 3, 'Senegal': 20, 'Seychelles': 35, 'Zambia': 3,
    'Albania': 30, 'Algeria': 30, 'Andorra': 30, 'Belarus': 30, 'Benin': 30,
    'Bulgaria': 30, 'Cape Verde': 30, 'Chad': 30, 'Croatia': 30, 'Cyprus': 30,
    'Czech Republic': 30, 'Côte d\'Ivoire': 30, 'Democratic Republic of the Congo': 30,
    'Egypt': 30, 'Eswatini': 30, 'Faroe Islands': 30, 'Gambia': 30, 'Georgia': 30,
    'Ghana': 30, 'Greece': 30, 'Iceland': 30, 'Iraq': 30, 'Kenya': 30, 'Laos': 30,
    'Lebanon': 30, 'Lesotho': 30, 'Liberia': 30, 'Libya': 30, 'Liechtenstein': 30,
    'Malawi': 30, 'Maldives': 30, 'Mali': 30, 'Mauritania': 30,
    'Mauritius': 30, 'Micronesia': 30, 'Moldova': 30, 'Mozambique': 30, 'Namibia': 30,
    'Nepal': 30, 'Niger': 30, 'Nigeria': 30, 'North Macedonia': 30, 'Rwanda': 30,
    'Syria': 30, 'Tanzania': 30, 'Tunisia': 30, 'Turkey': 30, 'Uganda': 30,
    'American Samoa': 43, 'Angola': 43, 'Armenia': 43, 'Bangladesh': 43, 'Barbados': 43,
    'Bolivia': 43, 'Collectivity of Saint Martin': 43, 'Costa Rica': 43, 'Ecuador': 43,
    'El Salvador': 43, 'Fiji': 43, 'French Guiana': 43, 'French Polynesia': 43,
    'Grenada': 43, 'Guadeloupe': 43, 'Guatemala': 43, 'Honduras': 43, 'Marshall Islands': 43,
    'Martinique': 43, 'New Caledonia': 43, 'Nicaragua': 43, 'Palau': 43, 'Panama': 43,
    'Papua New Guinea': 43, 'Paraguay': 43, 'Peru': 43, 'Sint Maarten': 43, 'Suriname': 43,
    'Trinidad and Tobago': 43, 'Uruguay': 43, 'Venezuela': 43, 'Western Samoa': 43
  };

  function getCountrySurcharge(country) {
    return COUNTRY_SURCHARGES[country] || 0;
  }

  function calculateTotalWeight(cart) {
    return cart.reduce((total, item) => {
      if (isExcludedFromShipping(item)) {
        return total;
      }
      const weight = parseFloat(item.weight) || 0;
      return total + (weight * item.quantity);
    }, 0);
  }

  function calculateShipping(totalWeight, country) {
    const cart = getCart();
    const hasOnlyFreeShippingItems = cart.length > 0 && cart.every(item => isExcludedFromShipping(item));

    if (hasOnlyFreeShippingItems) {
      return {
        totalWeight: 0,
        baseShipping: 0,
        surcharge: 0,
        totalShipping: 0,
        hasSurcharge: false
      };
    }

    const baseShipping = calculateBaseShipping(totalWeight);
    const surcharge = getCountrySurcharge(country);
    const totalShipping = baseShipping + surcharge;

    return {
      totalWeight: parseFloat(totalWeight.toFixed(3)),
      baseShipping: parseFloat(baseShipping.toFixed(2)),
      surcharge: parseFloat(surcharge.toFixed(2)),
      totalShipping: parseFloat(totalShipping.toFixed(2)),
      hasSurcharge: surcharge > 0
    };
  }

  // ============================================================
  // 货币换算工具
  // ============================================================
  const CURRENCY_SYMBOLS = { USD: '$', EUR: '€', GBP: '£', CAD: 'C$' };
  const CURRENCY_RATES = { USD: 1.0, EUR: 0.92, GBP: 0.79, CAD: 1.36 };

  function getCurrentCurrency() {
    return localStorage.getItem('ebbelle_currency') || 'USD';
  }
  function getCurrencySymbol(currency) {
    return CURRENCY_SYMBOLS[currency || getCurrentCurrency()] || '$';
  }
  function convertPrice(priceUSD, targetCurrency) {
    const currency = targetCurrency || getCurrentCurrency();
    const rate = CURRENCY_RATES[currency] || 1.0;
    return priceUSD * rate;
  }
  function formatPrice(priceUSD, targetCurrency) {
    const currency = targetCurrency || getCurrentCurrency();
    const converted = convertPrice(priceUSD, currency);
    const symbol = getCurrencySymbol(currency);
    const formatted = converted.toFixed(2);
    if (currency === 'EUR') return `${formatted}${symbol}`;
    return `${symbol}${formatted}`;
  }

  function getCart() {
    try {
      const cart = localStorage.getItem('ebbelle_cart');
      return cart ? JSON.parse(cart) : [];
    } catch (e) {
      return [];
    }
  }

  function getPreDiscountSubtotal(cart) {
    return cart.reduce((sum, item) => sum + ((parseFloat(item.price) || 0) * (item.quantity || 1)), 0);
  }

  function renderCartItems(cart, containerId) {
    const container = document.getElementById(containerId);
    if (!container) return;

    if (cart.length === 0) {
      container.innerHTML = '<p style="text-align: center; color: #666; padding: 20px;">Your cart is empty</p>';
      return;
    }

    let html = '';
    cart.forEach(item => {
      const price = parseFloat(item.price) || 0;
      const itemTotal = price * item.quantity;
      const variants = item.selectedVariants ? Object.values(item.selectedVariants).filter(v => v).join(' / ') : '';

      html += '<div class="item">';
      html += `<img src="${item.image || '/placeholder.jpg'}" alt="${item.name}" onerror="this.src='/placeholder.jpg'">`;
      html += '<div class="item-details">';
      html += `<h3>${item.name}</h3>`;
      if (variants) html += `<p>${variants}</p>`;
      if (item.quantity > 1) html += `<p>Qty: ${item.quantity}</p>`;
      html += '</div>';
      html += `<span class="item-price">${formatPrice(itemTotal)}</span>`;
      html += '</div>';
    });
    container.innerHTML = html;
  }

  // ============================================================
  // 核心业务：统一调度结账试算接口（api/woocommerce/calculate）
  // ============================================================
  async function performCheckoutRecalculation() {
    const cart = getCart();
    const subtotal = getPreDiscountSubtotal(cart);
    const countryName = document.getElementById('country')?.value || '';
    const email = document.getElementById('email')?.value.trim() || '';
    const countryIso = COUNTRY_ISO_MAP[countryName] || 'US';

    if (cart.length === 0) return;

    const totalWeight = calculateTotalWeight(cart);
    const localShipping = calculateShipping(totalWeight, countryName);

    try {
      const res = await fetch('/api/woocommerce/calculate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          email: email,
          subtotal: subtotal,
          country: countryIso,
          selected_offer: selectedOfferKey,
          use_points: isPointsRedeemed,
          manual_coupon: manualCouponCode
        })
      });

      const data = await res.json();
      if (data && data.success) {
        activeCalculationData = data;
        renderCalculationOutcome(data, localShipping);
        return;
      }
    } catch (e) {
      console.warn('API calculate fallback to local calculation:', e);
    }

    renderFallbackOutcome(subtotal, localShipping);
  }

  // ============================================================
  // 核心渲染：包含香槟金动效进度条与严格解锁逻辑
  // ============================================================
  // ============================================================
  // 核心渲染：完全由后端动态配置驱动（零硬编码）
  // ============================================================
  function renderCalculationOutcome(data, localShipping) {
    const privilegeBoxes = document.querySelectorAll('.checkout-privilege-box');
    const remoteFeeLines = document.querySelectorAll('.remote-fee-line');
    const remoteFeeVals = document.querySelectorAll('.remote-fee-val');
    const discountLines = document.querySelectorAll('.discount-line');
    const discountVals = document.querySelectorAll('.discount-val');
    const shippingStatusTexts = document.querySelectorAll('.shipping-status-text');
    const noticeBoxes = document.querySelectorAll('.shipping-notice-box');
    const shippingPriceEl = document.getElementById('shippingPrice');
    const shippingOption = document.getElementById('shippingOption');
    const shippingDetailsEl = document.getElementById('shippingDetails');

    const cart = getCart();
    const hasOnlyFreeShippingItems = cart.length > 0 && cart.every(item => isExcludedFromShipping(item));

    // A. 纯免运费赠品订单：彻底隐身
    if (hasOnlyFreeShippingItems) {
      if (shippingDetailsEl) {
        shippingDetailsEl.style.display = 'none';
        shippingDetailsEl.innerHTML = '';
      }
      remoteFeeLines.forEach(l => { l.style.display = 'none'; });
      noticeBoxes.forEach(n => { n.style.display = 'none'; });
      privilegeBoxes.forEach(b => { b.style.display = 'none'; });
      discountLines.forEach(l => { l.style.display = 'none'; });

      shippingStatusTexts.forEach(s => { s.textContent = 'FREE'; });
      if (shippingPriceEl) shippingPriceEl.textContent = 'FREE';
      if (shippingOption) shippingOption.setAttribute('data-cost', '0.00');

      applyFinalTotalsToDom(data.final_subtotal);
      return;
    }

    // B. 极偏远排除国家（不参与促销与包邮）
    if (data.is_extreme_remote) {
      privilegeBoxes.forEach(b => { b.style.display = 'none'; b.innerHTML = ''; });
      discountLines.forEach(l => { l.style.display = 'none'; });
      noticeBoxes.forEach(n => { n.style.display = 'none'; });

      remoteFeeLines.forEach(l => { l.style.display = 'flex'; });
      remoteFeeVals.forEach(v => { v.textContent = `+${formatPrice(data.remote_surcharge)}`; });

      const actualShipping = localShipping.baseShipping + data.remote_surcharge;
      const grandTotal = data.final_subtotal + actualShipping;

      shippingStatusTexts.forEach(s => { s.textContent = formatPrice(actualShipping); });
      if (shippingPriceEl) shippingPriceEl.textContent = formatPrice(actualShipping);
      if (shippingOption) shippingOption.setAttribute('data-cost', actualShipping.toFixed(2));

      if (shippingDetailsEl) {
        shippingDetailsEl.style.display = 'block';
        shippingDetailsEl.innerHTML = `
          <div style="display:flex; justify-content:space-between; margin-bottom:4px;">
            <span>Standard Courier:</span><span>${formatPrice(localShipping.baseShipping)}</span>
          </div>
          <div style="display:flex; justify-content:space-between; color:#b76e28;">
            <span>Remote Surcharge:</span><span>+${formatPrice(data.remote_surcharge)}</span>
          </div>
        `;
      }
      applyFinalTotalsToDom(grandTotal);
      return;
    }

    if (shippingDetailsEl) {
      shippingDetailsEl.style.display = 'none';
      shippingDetailsEl.innerHTML = '';
    }

    // C. 偏远起付线国家运费行处理
    if (data.is_remote) {
      if (data.base_shipping_free) {
        remoteFeeLines.forEach(l => { l.style.display = 'none'; });
        noticeBoxes.forEach(n => {
          n.className = 'shipping-notice-box unlocked';
          n.style.display = 'block';
          n.innerHTML = `<i class="fa-solid fa-circle-check"></i> Free Shipping Unlocked! (${formatPrice(data.remote_surcharge || 0)} remote fee waived)`;
        });
      } else {
        remoteFeeLines.forEach(l => { l.style.display = 'flex'; });
        remoteFeeVals.forEach(v => { v.textContent = `+${formatPrice(data.remote_surcharge)}`; });
        noticeBoxes.forEach(n => { n.style.display = 'none'; });
      }
    } else {
      remoteFeeLines.forEach(l => { l.style.display = 'none'; });
      if (data.base_shipping_free) {
        noticeBoxes.forEach(n => {
          n.className = 'shipping-notice-box unlocked';
          n.style.display = 'block';
          n.innerHTML = `<i class="fa-solid fa-circle-check"></i> Free Shipping Applied!`;
        });
      } else {
        noticeBoxes.forEach(n => { n.style.display = 'none'; });
      }
    }

    // D. 运费最终计算
    let effectiveShipping = 0;
    if (!data.base_shipping_free) {
      effectiveShipping += localShipping.baseShipping;
      effectiveShipping += (data.remote_surcharge || 0);
    }

    shippingStatusTexts.forEach(s => {
      s.textContent = effectiveShipping === 0 ? 'FREE' : formatPrice(effectiveShipping);
    });
    if (shippingPriceEl) shippingPriceEl.textContent = effectiveShipping === 0 ? 'FREE' : formatPrice(effectiveShipping);
    if (shippingOption) shippingOption.setAttribute('data-cost', effectiveShipping.toFixed(2));

    // E. 动态读取后端配置参数（彻底消除前端硬编码）
    const isNewCustomer = typeof data.is_new_customer === 'boolean' ? data.is_new_customer : Boolean(data.free_gift_included);
    const canChooseWelcome15 = Boolean(data.base_shipping_free);
    const subtotal = parseFloat(data.original_subtotal) || 0;
    const freeShippingTarget = (typeof data.free_shipping_min === 'number')
      ? data.free_shipping_min
      : (data.is_remote ? (data.remote_free_min || 150) : (isNewCustomer ? 25.0 : 0));
    // 动态读取后台配置的大礼包阶梯（已按门槛从低到高排序）
    // 动态读取后台配置的大礼包剩余可用阶梯（已按门槛从低到高排序；若全部用完则为 []）
    const bundleTiers = Array.isArray(data.bundle_tiers) ? data.bundle_tiers : [];
    const tier1Min = bundleTiers.length > 0 ? (parseFloat(bundleTiers[0].min) || 60) : 0;
    const tier1Off = bundleTiers.length > 0 ? (parseFloat(bundleTiers[0].off) || 10) : 0;
    const nextTier = bundleTiers.find(t => subtotal < parseFloat(t.min)) || null;
    const tierSummaryText = bundleTiers.slice(0, 2).map(t => `Orders $${t.min}+ (-$${t.off})`).join(' | ');

    // 动态积分汇率与可用积分
    const availablePts = parseFloat(data.available_points) || 0;
    const ptsFor1Usd = parseFloat(data.pts_for_1usd) || 10.0;
    const ptsValueUsd = ptsFor1Usd > 0 ? (availablePts / ptsFor1Usd) : 0;

    // 积分兑换组件模板（新客/老客只要账号有积分且汇率正常即可通用）
    const pointsRedeemHtml = (availablePts > 0 && ptsValueUsd > 0) ? `
      <div style="margin-top: 8px; padding-top: 8px; border-top: 1px dashed rgba(212,175,103,0.3);">
        <label style="display: flex; align-items: center; justify-content: space-between; cursor: pointer; font-size: 12px; color: #66522e;">
          <span style="display: flex; align-items: center; gap: 6px;">
            <input type="checkbox" id="pointsRedeemToggle" ${isPointsRedeemed ? 'checked' : ''} onchange="handlePointsToggle(this)" style="accent-color: #8c631a; width: 14px; height: 14px; cursor: pointer;">
            <span>Redeem <strong>${availablePts}</strong> Reward Points (Save ${formatPrice(ptsValueUsd)})</span>
          </span>
          <span style="font-weight: 700; color: #2e7d32;">-${formatPrice(ptsValueUsd)}</span>
        </label>
      </div>
    ` : '';

    let privilegeHtml = '';

    if (isNewCustomer) {
      // ============================================================
      // 新客首单特权分支（含已注册但 0 笔已付款订单的 Pearl 新会员）
      // ============================================================
      if (!selectedOfferKey) {
        selectedOfferKey = canChooseWelcome15 ? 'welcome_15' : 'bundle_tier';
      } else if (selectedOfferKey === 'welcome_15' && !canChooseWelcome15) {
        selectedOfferKey = 'bundle_tier';
      }

      const progressPercent = freeShippingTarget > 0 ? Math.min(100, Math.round((subtotal / freeShippingTarget) * 100)) : 100;
      const distanceToFree = Math.max(0, freeShippingTarget - subtotal);
      const distanceToTier1 = Math.max(0, tier1Min - subtotal);

      privilegeHtml = `
        <div class="privilege-header">
          <span class="privilege-title"><i class="fa-solid fa-gift"></i> New Guest Welcome Privileges</span>
          ${data.free_gift_included ? '<span class="free-gift-badge">✓ Free Gift Included</span>' : ''}
        </div>
      `;

      if (!canChooseWelcome15) {
        privilegeHtml += `
          <div class="privilege-progress-card">
            <div class="progress-card-header">
              <span><i class="fa-solid fa-rocket"></i> Progress to Free Shipping & 15% OFF</span>
              <span><strong>${formatPrice(subtotal)}</strong> / ${formatPrice(freeShippingTarget)}</span>
            </div>
            <div class="progress-track">
              <div class="progress-fill" style="width: ${progressPercent}%;"></div>
            </div>
            <div class="progress-card-footer">
              <i class="fa-solid fa-wand-magic-sparkles"></i>
              <span>Add <strong>${formatPrice(distanceToFree)}</strong> more to unlock <strong>FREE SHIPPING & 15% OFF</strong>!</span>
            </div>
          </div>
        `;
      } else if (selectedOfferKey === 'bundle_tier' && subtotal < tier1Min) {
        const bundlePercent = Math.min(100, Math.round((subtotal / tier1Min) * 100));
        privilegeHtml += `
          <div class="privilege-progress-card">
            <div class="progress-card-header">
              <span><i class="fa-solid fa-tags"></i> Progress to ${formatPrice(tier1Off)} OFF Voucher</span>
              <span><strong>${formatPrice(subtotal)}</strong> / ${formatPrice(tier1Min)}</span>
            </div>
            <div class="progress-track">
              <div class="progress-fill" style="width: ${bundlePercent}%;"></div>
            </div>
            <div class="progress-card-footer">
              <i class="fa-solid fa-circle-exclamation"></i>
              <span>Add <strong>${formatPrice(distanceToTier1)}</strong> more to activate Tier 1 <strong>(${formatPrice(tier1Off)} OFF)</strong>!</span>
            </div>
          </div>
        `;
      }

      privilegeHtml += `
        <div class="privilege-options">
          <label class="privilege-radio-label ${canChooseWelcome15 ? '' : 'disabled-option'}">
            <div class="privilege-radio-row">
              <input type="radio" name="vip_offer_choice" value="welcome_15" 
                ${selectedOfferKey === 'welcome_15' && canChooseWelcome15 ? 'checked' : ''} 
                ${canChooseWelcome15 ? '' : 'disabled'} 
                onchange="handleOfferSelection('welcome_15')">
              <span><strong>15% OFF First Order</strong> (Exclusive Welcome)</span>
              ${!canChooseWelcome15 ? `<span class="lock-badge"><i class="fa-solid fa-lock"></i> Unlocks at ${formatPrice(freeShippingTarget)}</span>` : ''}
            </div>
            ${canChooseWelcome15 ? '<div class="option-subtext">Save 15% instantly on your entire order</div>' : ''}
          </label>

          <label class="privilege-radio-label">
            <div class="privilege-radio-row">
              <input type="radio" name="vip_offer_choice" value="bundle_tier" 
                ${selectedOfferKey === 'bundle_tier' ? 'checked' : ''} 
                onchange="handleOfferSelection('bundle_tier')">
              <span><strong>$200 Multi-tier Bundle Pack</strong></span>
              ${subtotal < tier1Min ? `<span class="lock-badge"><i class="fa-solid fa-circle-info"></i> Tier 1 at ${formatPrice(tier1Min)}</span>` : ''}
            </div>
            <div class="option-subtext">
              ${subtotal >= tier1Min 
                ? 'Multi-tier vouchers automatically applied' 
                : `${tierSummaryText} | Add ${formatPrice(distanceToTier1)} to activate`}
            </div>
          </label>

          ${pointsRedeemHtml}
        </div>
      `;
    } else {
      // ============================================================
      // 老客户及 VIP 会员专属权益看板（全量读取后端返回数据）
      // ============================================================
      selectedOfferKey = 'bundle_tier';
      const progressPercent = freeShippingTarget > 0 ? Math.min(100, Math.round((subtotal / freeShippingTarget) * 100)) : 100;
      const distanceToFree = Math.max(0, freeShippingTarget - subtotal);
      const hasReachedFree = Boolean(data.base_shipping_free);

      const appliedBundleOffer = (data.applied_offers || []).find(o => o.includes('Bundle') || o.includes('Orders $'));
      const appliedMemberTier = (data.applied_offers || []).find(o => o.includes('Exclusive') || o.includes('% OFF'));
      const appliedBirthday = (data.applied_offers || []).find(o => o.includes('Birthday'));

      privilegeHtml = `
        <div class="privilege-header">
          <span class="privilege-title"><i class="fa-solid fa-gem"></i> VIP Member Rewards Active</span>
          ${appliedMemberTier ? `<span class="free-gift-badge">${appliedMemberTier}</span>` : ''}
        </div>
      `;

      // 1. 动态包邮进度条
      if (!hasReachedFree && freeShippingTarget > 0) {
        privilegeHtml += `
          <div class="privilege-progress-card">
            <div class="progress-card-header">
              <span><i class="fa-solid fa-truck-fast"></i> Progress to Free Shipping</span>
              <span><strong>${formatPrice(subtotal)}</strong> / ${formatPrice(freeShippingTarget)}</span>
            </div>
            <div class="progress-track">
              <div class="progress-fill" style="width: ${progressPercent}%;"></div>
            </div>
            <div class="progress-card-footer">
              <i class="fa-solid fa-wand-magic-sparkles"></i>
              <span>Add <strong>${formatPrice(distanceToFree)}</strong> more to unlock <strong>FREE SHIPPING</strong>!</span>
            </div>
          </div>
        `;
      }

      // 2. 权益明细、动态大礼包阶梯与积分抵扣卡
      privilegeHtml += `
        <div class="privilege-options">
          ${appliedMemberTier ? `
            <div style="font-size: 12px; color: #2e7d32; display: flex; align-items: center; gap: 6px;">
              <i class="fa-solid fa-check"></i> <strong>${appliedMemberTier} Applied</strong>
            </div>
          ` : ''}

          ${appliedBirthday ? `
            <div style="font-size: 12px; color: #2e7d32; display: flex; align-items: center; gap: 6px;">
              <i class="fa-solid fa-cake-candles"></i> <strong>${appliedBirthday} Applied</strong>
            </div>
          ` : ''}

          <div style="font-size: 12px; color: #444; border-top: 1px dashed rgba(212,175,103,0.3); padding-top: 6px; margin-top: 4px;">
            <div style="display: flex; justify-content: space-between; align-items: center;">
              <span><strong>🎁 $200 Multi-tier Bundle Pack</strong></span>
              ${appliedBundleOffer
                ? '<span style="color:#2e7d32; font-weight:600;">Active</span>'
                : (nextTier ? `<span class="lock-badge">Next at ${formatPrice(nextTier.min)}</span>` : '')}
            </div>
            <div class="option-subtext" style="margin-left: 0; margin-top: 4px;">
              ${appliedBundleOffer ? `<div>✓ ${appliedBundleOffer}</div>` : ''}
              ${nextTier
                ? `Add <strong>${formatPrice(Math.max(0, parseFloat(nextTier.min) - subtotal))}</strong> more to save <strong>${formatPrice(nextTier.off)}</strong> instantly!`
                : 'Maximum tier discount unlocked!'}
            </div>
          </div>

          ${pointsRedeemHtml}
        </div>
      `;
    }

    privilegeBoxes.forEach(b => {
      b.style.display = 'block';
      b.innerHTML = privilegeHtml;
    });

    // F. 折扣金额渲染
    if (data.discount_total > 0) {
      discountLines.forEach(l => { l.style.display = 'flex'; });
      discountVals.forEach(v => { v.textContent = `-${formatPrice(data.discount_total)}`; });
    } else {
      discountLines.forEach(l => { l.style.display = 'none'; });
    }

    // G. 最终总额
    const grandFinal = Math.max(0, data.final_subtotal + effectiveShipping);
    applyFinalTotalsToDom(grandFinal);

    // 渲染手动折扣码校验状态与一键移除按钮
    const feedbackEls = document.querySelectorAll('.coupon-feedback-msg');
    if (manualCouponCode && data.coupon_message) {
      feedbackEls.forEach(el => {
        el.style.display = 'flex';
        el.style.alignItems = 'center';
        el.style.justifyContent = 'space-between';
        if (data.coupon_status === 'valid') {
          el.style.background = '#edf7ee';
          el.style.color = '#2e7d32';
          el.style.border = '1px solid #c8e6c9';
          el.innerHTML = `
            <span><i class="fa-solid fa-tag"></i> ${data.coupon_message}</span>
            <button type="button" onclick="removeManualCoupon()" style="background:none; border:none; color:#555; cursor:pointer; font-size:12px; text-decoration:underline;">Remove</button>
          `;
        } else {
          el.style.background = '#fdecea';
          el.style.color = '#c62828';
          el.style.border = '1px solid #ffcdd2';
          el.innerHTML = `<span><i class="fa-solid fa-circle-exclamation"></i> ${data.coupon_message}</span>`;
        }
      });
    } else {
      feedbackEls.forEach(el => { el.style.display = 'none'; });
    }

    // H. 保存完整结算快照（供 payment 页与创建订单接口使用）
    const actualPointsSpent = (isPointsRedeemed && data.points_discount > 0) ? (data.available_points || 0) : 0;
    const validManualCoupon = (manualCouponCode && data.coupon_status === 'valid') ? manualCouponCode : '';

    sessionStorage.setItem('ebbelle_checkout_calculation', JSON.stringify({
      original_subtotal: data.original_subtotal,
      final_subtotal: data.final_subtotal,
      discount_total: data.discount_total,
      points_spent: actualPointsSpent,
      points_discount: data.points_discount || 0,
      points_earned: data.points_earned || 0,
      points_multiplier: data.points_multiplier || 1.0,
      manual_coupon: validManualCoupon,
      shipping_cost: effectiveShipping,
      remote_surcharge: data.remote_surcharge || 0,
      selected_offer: selectedOfferKey,
      is_extreme_remote: data.is_extreme_remote || false,
      free_gift: data.free_gift_included || false,
      applied_offers: data.applied_offers || []
    }));
  }

  function renderFallbackOutcome(subtotal, localShipping) {
    const grand = subtotal + localShipping.totalShipping;
    applyFinalTotalsToDom(grand);
  }

  function applyFinalTotalsToDom(totalUSD) {
    const currency = getCurrentCurrency();
    const formatted = formatPrice(totalUSD);
    const mobileTotalAmount = document.querySelector('.mobile-order-summary .summary-total');
    if (mobileTotalAmount) mobileTotalAmount.textContent = formatted;

    document.querySelectorAll('.total-amount').forEach(el => {
      el.innerHTML = `<span class="currency">${currency}</span> ${formatted}`;
    });
  }

  window.handleOfferSelection = function(choice) {
    selectedOfferKey = choice;
    performCheckoutRecalculation();
  };

  // 移除已应用的折扣码
  window.removeManualCoupon = function() {
    manualCouponCode = '';
    document.querySelectorAll('.manual-discount-input').forEach(inp => { inp.value = ''; });
    document.querySelectorAll('.coupon-feedback-msg').forEach(el => { el.style.display = 'none'; });
    performCheckoutRecalculation();
  };

  // 手动优惠券 Apply 事件
  document.querySelectorAll('.manual-apply-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      const wrap = btn.closest('.discount-code-section');
      const input = wrap?.querySelector('.manual-discount-input');
      const code = input?.value.trim() || '';
      if (!code) return;

      manualCouponCode = code;
      // 同步移动端和桌面端两个输入框的内容
      document.querySelectorAll('.manual-discount-input').forEach(inp => { inp.value = code; });

      const origText = btn.textContent;
      btn.textContent = '...';
      btn.disabled = true;

      performCheckoutRecalculation().finally(() => {
        btn.textContent = origText;
        btn.disabled = false;
      });
    });
  });

  // ============================================================
  // 原有初始化与事件监听（含浏览器后退 BFCache / 表单恢复修复）
  // ============================================================
  function restoreSavedShippingForm() {
    try {
      const savedRaw = sessionStorage.getItem('shippingInfo');
      if (!savedRaw) return;
      const saved = JSON.parse(savedRaw);
      const fieldMap = ['email', 'firstName', 'lastName', 'address', 'apartment', 'city', 'state', 'zip', 'country', 'phone'];
      fieldMap.forEach(id => {
        const el = document.getElementById(id);
        if (el && saved[id]) {
          el.value = saved[id];
        }
      });
    } catch (e) {}
  }

  function initializeCart() {
    restoreSavedShippingForm();

    const cart = getCart();
    const subtotal = getPreDiscountSubtotal(cart);
    const count = cart.reduce((sum, item) => sum + item.quantity, 0);

    renderCartItems(cart, 'mobileCartItems');
    renderCartItems(cart, 'desktopCartItems');

    const mobileH2 = document.querySelector('.mobile-order-summary h2');
    if (mobileH2) mobileH2.textContent = `Order summary (${count} items)`;

    const desktopH2 = document.querySelector('.desktop-order-summary h2');
    if (desktopH2) desktopH2.textContent = `Order summary (${count} items)`;

    document.querySelectorAll('.subtotal-line span:last-child').forEach(el => {
      el.textContent = formatPrice(subtotal);
    });

    performCheckoutRecalculation();
  }

  const summaryToggle = document.getElementById('summaryToggle');
  const summaryContent = document.getElementById('summaryContent');
  if (summaryToggle && summaryContent) {
    summaryToggle.addEventListener('click', () => {
      summaryToggle.classList.toggle('active');
      summaryContent.classList.toggle('active');
    });
  }

  async function checkEmailRegistered(email) {
    try {
      const response = await fetch('/api/auth/check-email', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email })
      });
      const data = await response.json();
      return data.exists || false;
    } catch (error) {
      return false;
    }
  }

  const countrySelect = document.getElementById('country');
  if (countrySelect) {
    countrySelect.addEventListener('change', performCheckoutRecalculation);
  }

  const emailInput = document.getElementById('email');
  if (emailInput) {
    emailInput.addEventListener('blur', performCheckoutRecalculation);
    emailInput.addEventListener('change', performCheckoutRecalculation);
  }

  document.getElementById('shippingForm')?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const email = document.getElementById('email').value;
    const country = document.getElementById('country').value;
    if (!country || country === '') {
      alert('Please select a country');
      return;
    }

    const selectedShipping = document.querySelector('.shipping-option.active');
    const shippingMethod = selectedShipping?.getAttribute('data-method') || 'standard';
    let shippingCost = selectedShipping?.getAttribute('data-cost') || '0.00';

    const isRegistered = await checkEmailRegistered(email);

    sessionStorage.setItem('userEmailStatus', JSON.stringify({
      email: email,
      isRegistered: isRegistered,
      checkedAt: new Date().toISOString()
    }));

    const formData = {
      email: email,
      firstName: document.getElementById('firstName').value,
      lastName: document.getElementById('lastName').value,
      address: document.getElementById('address').value,
      apartment: document.getElementById('apartment').value,
      city: document.getElementById('city').value,
      state: document.getElementById('state').value,
      zip: document.getElementById('zip').value,
      country: country,
      phone: document.getElementById('phone').value,
      shippingMethod: shippingMethod,
      shippingCost: shippingCost
    };
    sessionStorage.setItem('shippingInfo', JSON.stringify(formData));
    sessionStorage.removeItem('pendingOrderId');
    sessionStorage.removeItem('pendingOrderKey');
    window.location.href = '/checkout/payment';
  });

  document.querySelectorAll('.shipping-option').forEach(opt => {
    opt.addEventListener('click', () => {
      document.querySelectorAll('.shipping-option').forEach(o => o.classList.remove('active'));
      opt.classList.add('active');
    });
  });

  window.addEventListener('cartUpdated', performCheckoutRecalculation);
  document.addEventListener('DOMContentLoaded', initializeCart);

  // 捕获浏览器前进/后退返回（含 BFCache），等浏览器自动填充结束后用真实地址重新试算
  window.addEventListener('pageshow', (event) => {
    setTimeout(() => {
      restoreSavedShippingForm();
      performCheckoutRecalculation();
    }, event.persisted ? 0 : 60);
  });
</script>