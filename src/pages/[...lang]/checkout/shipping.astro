    }
  };
  const XMAS_EXCLUSIVE_CODES = Object.keys(XMAS_GIFT_CATALOG);

  let calcAbortController = null;
  let calcDebounceTimer = null;

  function scheduleCheckoutRecalculation(delay = 120) {
    if (calcDebounceTimer) clearTimeout(calcDebounceTimer);
    calcDebounceTimer = setTimeout(() => {
      performCheckoutRecalculation();
    }, delay);
  }

  window.handlePointsToggle = function(checkbox) {
    isPointsRedeemed = Boolean(checkbox.checked);
    performCheckoutRecalculation();
  };

  window.handlePromoModeSwitch = function(mode) {
    promoMode = mode === 'vip_rewards' ? 'vip_rewards' : 'xmas_bogo';
    performCheckoutRecalculation();
  };

  // 免运费特殊赠品 ID 名单
  const FREE_SHIPPING_PRODUCT_IDS = [57994, '57994'];

  function isExcludedFromShipping(item) {
    if (item && item.isXmasMysteryGift) return true;
    const id = item.id || item.product_id;
    return FREE_SHIPPING_PRODUCT_IDS.includes(id) || FREE_SHIPPING_PRODUCT_IDS.includes(String(id));
  }

  // 在购物车列表中排他同步免费圣诞实物礼物（仅限选择圣诞活动且达标时保留，切回 VIP 自动移除）
  function syncShippingXmasGiftItem(validCode) {
    const cart = getCart();
    const regularItems = cart.filter(item => !item.isXmasMysteryGift);
    const upper = (validCode || '').toUpperCase().trim();
    const giftMeta = XMAS_GIFT_CATALOG[upper];

    let nextCart = regularItems;
    if (giftMeta && regularItems.length > 0) {
      nextCart = [
        ...regularItems,
        {
          cartItemId: `xmas_mystery_gift_${upper}`,
          id: 0,
          name: giftMeta.name,
          price: '0.00',
          basePrice: '0.00',
          quantity: 1,
          weight: 0,
          image: giftMeta.image,
          isXmasMysteryGift: true,
          xmasGiftCode: upper
        }
      ];
    }

    if (JSON.stringify(cart) !== JSON.stringify(nextCart)) {
      localStorage.setItem('ebbelle_cart', JSON.stringify(nextCart));
      renderCartItems(nextCart, 'mobileCartItems');
      renderCartItems(nextCart, 'desktopCartItems');
      const count = nextCart.reduce((sum, item) => sum + (parseInt(item.quantity, 10) || 1), 0);
      const mobileH2 = document.querySelector('.mobile-order-summary h2');
      if (mobileH2) mobileH2.textContent = `Order summary (${count} items)`;
      const desktopH2 = document.querySelector('.desktop-order-summary h2');
      if (desktopH2) desktopH2.textContent = `Order summary (${count} items)`;
    }
  }

