    'Venezuela': 'VE', 'Vietnam': 'VN', 'Western Samoa': 'WS', 'Zambia': 'ZM'
  };

  function resolveCountryIso(rawCountry) {
    const trimmed = String(rawCountry || 'US').trim();
    if (trimmed.length === 2 && /^[A-Za-z]{2}$/.test(trimmed)) return trimmed.toUpperCase();
    return PAYMENT_COUNTRY_ISO_MAP[trimmed] || 'US';
  }

  function resolveStandardStateCode(countryIso, rawState) {
    const val = String(rawState || '').trim();
    if (!val) return 'N/A';
    try {
      const cachedRaw = localStorage.getItem('ebbelle_wc_states_v1');
      if (cachedRaw) {
        const cached = JSON.parse(cachedRaw);
        const list = cached?.data?.[countryIso];
        if (Array.isArray(list) && list.length > 0) {
          const lower = val.toLowerCase();
          const match = list.find(s => s.code.toLowerCase() === lower || s.name.toLowerCase() === lower);
          if (match) return match.code;
        }
      }
    } catch (e) {}
    return val;
  }

  function validateCustomBillingInputs() {
    const requiredIds = [
      { id: 'billFirstName', label: 'First Name' },
      { id: 'billLastName', label: 'Last Name' },
      { id: 'billAddress', label: 'Street Address' },
      { id: 'billCity', label: 'City' },
      { id: 'billState', label: 'State / Province' },
      { id: 'billZip', label: 'ZIP / Postal Code' },
    ];
    for (const item of requiredIds) {
      const el = document.getElementById(item.id);
      if (!el || !String(el.value || '').trim()) {
        return `Please enter your billing ${item.label}.`;
      }
    }
    return '';
  }

  function getEffectiveBillingData() {
    const sInfo = JSON.parse(sessionStorage.getItem('shippingInfo') || '{}');
    const mode = document.querySelector('input[name="billingMode"]:checked')?.value || 'same';

    if (mode === 'different' && !validateCustomBillingInputs()) {
      const bCountry = document.getElementById('billCountry')?.value || sInfo.country || 'United States';
      const iso = resolveCountryIso(bCountry);
      const rawState = document.getElementById('billState')?.value || '';
      const fName = (document.getElementById('billFirstName')?.value || sInfo.firstName || 'Customer').trim();
      const lName = (document.getElementById('billLastName')?.value || sInfo.lastName || '').trim();
      return {
        name: `${fName} ${lName}`.trim(),
        first_name: fName,
        last_name: lName,
        email: (sInfo.email || '').trim(),
        phone_number: (sInfo.phone || '').trim(),
        address: {
          country_code: iso,
          state: resolveStandardStateCode(iso, rawState),
          city: (document.getElementById('billCity')?.value || sInfo.city || 'N/A').trim(),
          street: (document.getElementById('billAddress')?.value || sInfo.address || 'N/A').trim(),
          postcode: (document.getElementById('billZip')?.value || sInfo.zip || '00000').trim(),
        },
      };
    }

    const iso = resolveCountryIso(sInfo.country || 'US');
    const fName = (sInfo.firstName || 'Customer').trim();
    const lName = (sInfo.lastName || '').trim();
    return {
      name: `${fName} ${lName}`.trim(),
      first_name: fName,
      last_name: lName,
      email: (sInfo.email || '').trim(),
      phone_number: (sInfo.phone || '').trim(),
      address: {
        country_code: iso,
        state: resolveStandardStateCode(iso, sInfo.state),
        city: (sInfo.city || 'N/A').trim(),
        street: [sInfo.address, sInfo.apartment].filter(Boolean).join(', ') || 'N/A',
        postcode: (sInfo.zip || '00000').trim(),
      },
    };
  }

  // 通用建单载荷：同时服务于 Airwallex 信用卡与 PayPal，确保双方账单地址 100% 同步更新
  function buildOrderCreationPayload(totals) {
    const existingOrderId = parseInt(sessionStorage.getItem('pendingOrderId') || '0', 10);
    const existingOrderKey = sessionStorage.getItem('pendingOrderKey') || '';
    const shippingInfoStr = sessionStorage.getItem('shippingInfo');
    const latestCart = getCart();

    if (!existingOrderId) {
      if (!shippingInfoStr) {
        alert('Please provide shipping details first.');
        window.location.href = '/checkout/shipping';
        throw new Error('Missing shipping info');
      }
      if (!latestCart || latestCart.length === 0) {
        alert('Your cart is empty. Please add products first.');
        window.location.href = '/shop';
        throw new Error('Cart is empty');
      }
    }

    const shipping = shippingInfoStr ? JSON.parse(shippingInfoStr) : {};
    const effectiveBilling = getEffectiveBillingData();
    const calc = getCheckoutCalculation();
    const earnedPts = calc ? (parseFloat(calc.points_earned) || 0) : parseFloat((parseFloat(totals.subtotal) / 10).toFixed(1));

    return {
      existingOrderId: existingOrderId > 0 ? existingOrderId : undefined,
      existingOrderKey: existingOrderKey || undefined,
      currency: CURRENT_CURRENCY,
      billing: {
        first_name: effectiveBilling.first_name,
        last_name: effectiveBilling.last_name,
        address_1: effectiveBilling.address.street,
        address_2: '',
        city: effectiveBilling.address.city,
        state: effectiveBilling.address.state,
        postcode: effectiveBilling.address.postcode,
        country: effectiveBilling.address.country_code,
        email: effectiveBilling.email,
        phone: effectiveBilling.phone_number,
      },
      shipping: {
        first_name: shipping.firstName || '',
        last_name: shipping.lastName || '',
        address_1: shipping.address || '',
        address_2: shipping.apartment || '',
        city: shipping.city || '',
        state: shipping.state || '',
        postcode: shipping.zip || '',
        country: shipping.country || 'US',
      },
      shippingMethod: shipping.shippingMethod || 'standard',
      shippingCost: totals.shipping,
      discountTotal: parseFloat(totals.discount) || 0,
      pointsSpent: calc?.points_spent || 0,
      pointsEarned: earnedPts,
      appliedOffers: calc?.applied_offers || [],
      coupon_lines: calc?.manual_coupon ? [{ code: calc.manual_coupon }] : [],
      line_items: latestCart.map(item => {
        const isGift = isItemFreeGift(item);
        return {
          product_id: Number(item.productId || item.product_id || item.id || 0),
          variation_id: item.variationId || item.variation_id || undefined,
          name: item.name || '',
          quantity: Number(item.quantity) || 1,
          price: isGift ? 0 : (parseFloat(item.price) || undefined),
          isXmasMysteryGift: Boolean(item.isXmasMysteryGift),
        };
      })
    };
  }

  // ============================================================
  // 支付处理中原位锁定与轻提示控制（全渠道通用，失败自动解锁）
  // ============================================================
  let isFinalizingPayment = false;

  function setPaymentBusyState(isBusy, channel = 'card', message = '') {
    const paymentTabs = document.getElementById('paymentMethodsBar');
    const billingSection = document.getElementById('billingAddressSection');
    const updateBillingBtn = document.getElementById('applyCustomBillingBtn');
    const dropinBox = document.getElementById('airwallex-dropin');

    const cardHintEl = document.getElementById('airwallex-processing-hint');
    const cardHintTextEl = document.getElementById('airwallex-processing-text');
    const paypalHintEl = document.getElementById('paypal-processing-hint');
    const paypalHintTextEl = document.getElementById('paypal-processing-text');

    if (channel === 'card') {
      if (cardHintEl) {
        cardHintEl.style.display = isBusy ? 'flex' : 'none';
        if (cardHintTextEl && message) cardHintTextEl.textContent = message;
      }
      if (paypalHintEl) paypalHintEl.style.display = 'none';

      // 核心修复：处理中与核单跳转期间，物理锁定 Airwallex iframe 容器点击，杜绝连击触发 something went wrong
      if (dropinBox) {
        dropinBox.style.pointerEvents = isBusy ? 'none' : 'auto';
        dropinBox.style.opacity = isBusy ? '0.78' : '1';
        dropinBox.style.transition = 'opacity 0.2s ease';
      }
    } else {
      if (paypalHintEl) {
        paypalHintEl.style.display = isBusy ? 'flex' : 'none';
        if (paypalHintTextEl && message) paypalHintTextEl.textContent = message;
      }
      if (cardHintEl) cardHintEl.style.display = 'none';
    }

    // 锁定/解锁顶部支付方式选项卡切换
    if (paymentTabs) {
      paymentTabs.style.pointerEvents = isBusy ? 'none' : '';
      paymentTabs.style.opacity = isBusy ? '0.6' : '1';
    }

    // 锁定/解锁账单地址编辑区域
    if (billingSection) {
      billingSection.style.pointerEvents = isBusy ? 'none' : '';
      billingSection.style.opacity = isBusy ? '0.72' : '1';
      billingSection.style.transition = 'opacity 0.2s ease';
    }
    if (updateBillingBtn) {
      updateBillingBtn.disabled = Boolean(isBusy);
    }
  }

  function initCustomBillingControls(totals) {
    const billCountrySelect = document.getElementById('billCountry');
    const sInfo = JSON.parse(sessionStorage.getItem('shippingInfo') || '{}');

    if (billCountrySelect && billCountrySelect.options.length === 0) {
      Object.keys(PAYMENT_COUNTRY_ISO_MAP).forEach(name => {
        const opt = document.createElement('option');
        opt.value = name;
        opt.textContent = name;
        if (name === (sInfo.country || 'United States')) opt.selected = true;
        billCountrySelect.appendChild(opt);
      });
    }

    const syncBillState = () => {
      const wrap = document.getElementById('billStateWrap');
      const curEl = document.getElementById('billState');
      if (!wrap || !curEl) return;
      const iso = resolveCountryIso(billCountrySelect?.value || 'US');
      let list = [];
      try {
        const cached = JSON.parse(localStorage.getItem('ebbelle_wc_states_v1') || '{}');
        list = Array.isArray(cached?.data?.[iso]) ? cached.data[iso] : [];
      } catch (e) {}

      if (list.length > 0) {
        const sel = document.createElement('select');
        sel.id = 'billState';
        sel.innerHTML = '<option value="">Select state / province</option>' +
          list.map(s => `<option value="${escapeHtml(s.code)}">${escapeHtml(s.name)}</option>`).join('');
        curEl.replaceWith(sel);
      } else if (curEl.tagName !== 'INPUT') {
        const inp = document.createElement('input');
        inp.type = 'text';
        inp.id = 'billState';
        inp.placeholder = 'State / Province';
        curEl.replaceWith(inp);
      }
    };

    if (billCountrySelect) {
      billCountrySelect.addEventListener('change', syncBillState);
      syncBillState();
    }

    const customBox = document.getElementById('customBillingFields');
    const billingRows = document.querySelectorAll('.billing-radio-row');
    const errBox = document.getElementById('billingValidationError');

    document.querySelectorAll('input[name="billingMode"]').forEach(radio => {
      radio.addEventListener('change', async () => {
        billingRows.forEach(r => r.classList.remove('active'));
        radio.closest('.billing-radio-row')?.classList.add('active');
        if (errBox) errBox.style.display = 'none';

        if (customBox) {
          customBox.style.display = radio.value === 'different' ? 'block' : 'none';
        }

        // 切回 Same as shipping address 时，同步刷新当前激活支付方式的账单地址
        if (radio.value === 'same') {
          const activeMethod = document.querySelector('.payment-option.active')?.getAttribute('data-method');
          if (activeMethod === 'card') {
            airwallexDropinMounted = false;
            await initAirwallexCardDropin(totals).catch(() => {});
          }
        }
      });
    });

    const updateBtn = document.getElementById('applyCustomBillingBtn');
    if (updateBtn) {
      updateBtn.addEventListener('click', async () => {
        if (updateBtn.disabled) return;

        const validationErr = validateCustomBillingInputs();
        if (validationErr) {
          if (errBox) {
            errBox.textContent = validationErr;
            errBox.style.display = 'block';
          }
          return;
        }
        if (errBox) errBox.style.display = 'none';

        const originalText = 'UPDATE BILLING ADDRESS';
        updateBtn.disabled = true;
        updateBtn.style.opacity = '0.88';
        updateBtn.style.background = '#3f3c35';
        updateBtn.style.borderColor = '#3f3c35';
        updateBtn.innerHTML = `<i class="fa-solid fa-spinner fa-spin" style="margin-right:8px;"></i> UPDATING...`;

        try {
          const activeMethod = document.querySelector('.payment-option.active')?.getAttribute('data-method');

          if (activeMethod === 'card') {
            airwallexDropinMounted = false;
            await initAirwallexCardDropin(totals);
          } else {
            const existingOrderId = parseInt(sessionStorage.getItem('pendingOrderId') || '0', 10);
            if (existingOrderId > 0) {
              const payload = buildOrderCreationPayload(totals);
              await fetch('/api/airwallex/create-intent', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
              }).catch(() => {});
            }
          }

          // 转圈变为绿色对勾显示已更新
          updateBtn.style.opacity = '1';
          updateBtn.style.background = '#16a34a';
          updateBtn.style.borderColor = '#16a34a';
          updateBtn.innerHTML = `<i class="fa-solid fa-circle-check" style="margin-right:8px;"></i> BILLING ADDRESS UPDATED`;

          setTimeout(() => {
            updateBtn.style.background = '#1c1c18';
            updateBtn.style.borderColor = '#1c1c18';
            updateBtn.textContent = originalText;
            updateBtn.disabled = false;
          }, 2200);
        } catch (err) {
          updateBtn.style.opacity = '1';
          updateBtn.style.background = '#dc2626';
          updateBtn.style.borderColor = '#dc2626';
          updateBtn.innerHTML = `<i class="fa-solid fa-circle-exclamation" style="margin-right:8px;"></i> UPDATE FAILED`;
          setTimeout(() => {
            updateBtn.style.background = '#1c1c18';
            updateBtn.style.borderColor = '#1c1c18';
            updateBtn.textContent = originalText;
            updateBtn.disabled = false;
          }, 2200);
        }
      });
    }
  }

  // ============================================================
  // Airwallex 模块嵌入 (Drop-in Element) 初始化与状态监听
  // ============================================================
  let airwallexInitialized = false;
  let airwallexDropinMounted = false;
  let airwallexListenersBound = false;
  let isAwxInitializing = false;
  let activeAwxIntentId = '';

  async function initAirwallexCardDropin(totals) {
    const loadingEl = document.getElementById('airwallex-loading');
    const errorEl = document.getElementById('airwallex-error');
    const dropinContainer = document.getElementById('airwallex-dropin');

    if (airwallexDropinMounted && activeAwxIntentId) {
      if (loadingEl) loadingEl.style.display = 'none';
      return;
    }
    if (isAwxInitializing) return;
    isAwxInitializing = true;

    if (loadingEl) loadingEl.style.display = 'block';
    if (errorEl) errorEl.style.display = 'none';

    try {
      // @ts-ignore
      if (typeof Airwallex === 'undefined') {
        throw new Error('Airwallex payment SDK failed to load. Please refresh the page.');
      }

      const billingInfo = getEffectiveBillingData();
      const payload = buildOrderCreationPayload(totals);

      const res = await fetch('/api/airwallex/create-intent', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      const data = await res.json().catch(() => ({}));
      if (!res.ok || !data.intentId || !data.clientSecret) {
        throw new Error(data.details || data.message || data.error || 'Failed to initialize card payment');
      }

      sessionStorage.setItem('pendingOrderId', data.orderId.toString());
      sessionStorage.setItem('pendingOrderKey', data.orderKey);
      sessionStorage.setItem('pendingAwxIntentId', data.intentId);
      activeAwxIntentId = data.intentId;

      if (!airwallexInitialized) {
        // @ts-ignore
        Airwallex.init({
          env: AIRWALLEX_ENV === 'prod' ? 'prod' : 'demo',
          origin: window.location.origin,
        });
        airwallexInitialized = true;
      }

      if (dropinContainer) dropinContainer.innerHTML = '';

      // @ts-ignore
      const dropin = Airwallex.createElement('dropIn', {
        intent_id: data.intentId,
        client_secret: data.clientSecret,
        currency: data.currency || CURRENT_CURRENCY,
        methods: ['card'],
        withBilling: false,
        billing: billingInfo,
        autoCapture: true,
        appearance: {
          mode: 'light',
          variables: {
            colorBrand: '#8c631a',
            colorBrandHover: '#725013',
            colorBrandActive: '#5e410f',
            colorTextOnBrand: '#fcf9f3',
            colorBackground: '#ffffff',
            colorBorder: '#cfc8ba',
            colorBorderFocus: '#8c631a',
            colorDanger: '#b42318',
            colorText: '#1c1c18',
            colorTextSecondary: '#7c776d',
            borderRadius: '6px',
          },
        },
      });

      dropin.mount('airwallex-dropin');
      airwallexDropinMounted = true;
      // 挂载后立刻隐藏外层提示，交由 iframe 内部渲染，减少视觉等待感
      if (loadingEl) loadingEl.style.display = 'none';

      if (!airwallexListenersBound) {
        airwallexListenersBound = true;

        window.addEventListener('onReady', () => {
          if (loadingEl) loadingEl.style.display = 'none';
        });

        // 1. 点击 Pay 按钮发起支付瞬间：禁用顶部 Tab 切换 + 展示就近提示条（按钮本身由 Airwallex SDK 禁用转圈）
        window.addEventListener('onProcessing', () => {
          if (errorEl) errorEl.style.display = 'none';
          setPaymentBusyState(
            true,
            'card',
            'Processing your payment securely... Please do not refresh or close this page.'
          );
        });

        // 2. 扣款成功：保持锁定并更新文案，通知后端确认 WooCommerce 订单后跳转
        window.addEventListener('onSuccess', async () => {
          if (isFinalizingPayment) return;
          isFinalizingPayment = true;
          setPaymentBusyState(
            true,
            'card',
            'Payment approved! Finalizing your order, please wait...'
          );

          const orderId = sessionStorage.getItem('pendingOrderId') || '';
          const orderKey = sessionStorage.getItem('pendingOrderKey') || '';
          const intentId = sessionStorage.getItem('pendingAwxIntentId') || activeAwxIntentId;

          try {
            await fetch('/api/airwallex/confirm-order', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                intentId,
                orderId: parseInt(orderId || '0', 10)
              })
            });
          } catch (e) {}

          localStorage.removeItem('ebbelle_cart');
          sessionStorage.removeItem('ebbelle_checkout_calculation');
          sessionStorage.removeItem('ebbelle_cart_manual_coupon');
          sessionStorage.removeItem('pendingOrderId');
          sessionStorage.removeItem('pendingOrderKey');
          sessionStorage.removeItem('pendingOrderSnapshot');
          sessionStorage.removeItem('pendingAwxIntentId');
          sessionStorage.setItem('paymentStatus', JSON.stringify({ status: 'success' }));

          window.top.location.href = `/checkout/confirmation?order_id=${encodeURIComponent(orderId)}&order_key=${encodeURIComponent(orderKey)}&payment=airwallex&status=success`;
        });

        // 3. 支付失败 / 拒付 / 3DS 验证失败：立刻解锁上方 Tab 与按钮，隐藏处理中提示，展示错误原因
        window.addEventListener('onError', (event) => {
          // 如果已经进入扣款成功核单跳转流程，忽略后续多余回调，防止闪现报错
          if (isFinalizingPayment) return;

          setPaymentBusyState(false, 'card');

          // @ts-ignore
          const err = event?.detail?.error;
          if (errorEl) {
            errorEl.style.display = 'block';
            errorEl.textContent = err?.message || 'Card payment failed. Please check your card details and try again.';
          }
        });
      }
    } catch (err) {
      if (loadingEl) loadingEl.style.display = 'none';
      setPaymentBusyState(false, 'card');
      if (errorEl) {
        errorEl.style.display = 'block';
        errorEl.textContent = err.message || 'Unable to load card payment form.';
      }
      throw err;
    } finally {
      isAwxInitializing = false;
    }
  }

  async function initCheckout() {
    const urlParams = new URLSearchParams(window.location.search);
    const queryOrderId = urlParams.get('order_id');
    const queryOrderKey = urlParams.get('order_key');

    if (queryOrderId) {
      sessionStorage.setItem('pendingOrderId', queryOrderId);
      if (queryOrderKey) sessionStorage.setItem('pendingOrderKey', queryOrderKey);

      if (!getPendingOrderSnapshot()) {
        try {
          const orderRes = await fetch('/api/user/orders');
          if (orderRes.ok) {
            const orderData = await orderRes.json();
            const found = (orderData.orders || []).find(o => String(o.id) === String(queryOrderId));
            if (found) {
              const snap = {
                orderId: found.id,
                orderNumber: found.number || found.id,
                orderKey: found.order_key || queryOrderKey || '',
                total: parseFloat(found.total || 0).toFixed(2),
                shippingTotal: parseFloat(found.shipping_total || 0).toFixed(2),
                discountTotal: parseFloat(found.discount_total || 0).toFixed(2),
                currency: (found.currency || 'USD').toUpperCase(),
                feeLines: Array.isArray(found.fee_lines) ? found.fee_lines : [],
                couponLines: Array.isArray(found.coupon_lines) ? found.coupon_lines : [],
                items: (found.line_items || []).map(item => ({
                  id: item.product_id,
                  product_id: item.product_id,
                  variation_id: item.variation_id || 0,
                  name: item.name,
                  price: parseFloat(item.price || 0).toFixed(2),
                  lineTotal: parseFloat(item.total || 0).toFixed(2),
                  quantity: item.quantity || 1,
                  image: item.image?.src || ''
                }))
              };
              sessionStorage.setItem('pendingOrderSnapshot', JSON.stringify(snap));
            }
          }
        } catch (e) {}
      }
    } else {
      sessionStorage.removeItem('pendingOrderSnapshot');
      sessionStorage.removeItem('pendingOrderId');
      sessionStorage.removeItem('pendingOrderKey');
      sessionStorage.removeItem('pendingAwxIntentId');
    }

    const cart = getCart();
    const totals = calculateCartTotals(cart);
    renderCart(cart, totals);

    if (totals.isLockedPendingOrder) {
      const backBtn = document.getElementById('checkoutBackBtn');
      if (backBtn) {
        backBtn.setAttribute('href', '/account?tab=orders');
        backBtn.innerHTML = `<i class="fa-solid fa-arrow-left"></i> Back to My Orders`;
      }
      const editLink = document.getElementById('shippingEditLink');
      if (editLink) editLink.style.display = 'none';
    }

    const shippingInfoStr = sessionStorage.getItem('shippingInfo');
    if (shippingInfoStr) {
      const s = JSON.parse(shippingInfoStr);
      const reviewBox = document.getElementById('shippingReview');
      const fullAddressLine = `${s.address || ''} ${s.apartment || ''}, ${s.city || ''}, ${s.state || ''} ${s.zip || ''}, ${s.country || ''}`.replace(/\s+/g, ' ').trim();
      if (reviewBox) {
        reviewBox.innerHTML = `
          <p class="name">${escapeHtml(`${s.firstName || ''} ${s.lastName || ''}`.trim())}</p>
          <p class="address">${escapeHtml(fullAddressLine)}</p>
          <p class="contact">${escapeHtml(`${s.email || ''} | ${s.phone || ''}`)}</p>
        `;
      }
      const samePreview = document.getElementById('sameAsShippingPreview');
      if (samePreview && fullAddressLine) {
        samePreview.textContent = fullAddressLine;
      }
    }

    const toggleBtn = document.getElementById('summaryToggle');
    const toggleContent = document.getElementById('summaryContent');
    if (toggleBtn && toggleContent) {
      toggleBtn.addEventListener('click', () => {
        toggleContent.classList.toggle('active');
        toggleBtn.querySelector('.toggle-icon')?.classList.toggle('fa-chevron-up');
      });
    }

    // 支付方式切换（默认激活 Credit / Debit Card，可随时切向 PayPal）
    const paymentOptions = document.querySelectorAll('.payment-option');
    const paypalForm = document.getElementById('paypalForm');
    const cardForm = document.getElementById('airwallexCardForm');

    paymentOptions.forEach(opt => {
      opt.addEventListener('click', () => {
        if (isFinalizingPayment) return;
        const method = opt.getAttribute('data-method');
        paymentOptions.forEach(o => o.classList.remove('active'));
        opt.classList.add('active');
        const radio = opt.querySelector('input[type="radio"]');
        if (radio) radio.checked = true;

        if (method === 'card') {
          if (paypalForm) paypalForm.style.display = 'none';
          if (cardForm) cardForm.style.display = 'block';
          initAirwallexCardDropin(totals).catch(() => {});
        } else {
          if (cardForm) cardForm.style.display = 'none';
          if (paypalForm) paypalForm.style.display = 'block';
          if (!paypalButtonsRendered) {
            initPayPal(cart, totals);
          }
        }
      });
    });

    initCustomBillingControls(totals);
    initPayPal(cart, totals);
    // 默认首屏优先加载 Airwallex 信用卡表单
    initAirwallexCardDropin(totals).catch(() => {});
  }

  let paypalButtonsRendered = false;

  function initPayPal(cart, totals) {
    if (paypalButtonsRendered) return;
    // @ts-ignore
    if (typeof paypal === 'undefined') {
      return;
    }

    const container = document.getElementById('paypal-button-container');
    if (!container) return;
    container.innerHTML = '';
    paypalButtonsRendered = true;

    // @ts-ignore
    paypal.Buttons({
      style: {
        layout: 'vertical',
        color: 'gold',
        shape: 'rect',
        label: 'pay'
      },

      createOrder: async function() {
        setPaymentBusyState(
          true,
          'paypal',
          'Connecting to PayPal securely... Please complete payment in the PayPal window.'
        );
        try {
          const payload = buildOrderCreationPayload(totals);

          const res = await fetch('/api/paypal/create-order', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });

          const data = await res.json().catch(() => ({}));

          if (!res.ok) {
            const detailMsg = data.details || data.message || data.error || 'Failed to create PayPal order';
            setPaymentBusyState(false, 'paypal');
            alert('Order creation failed: ' + detailMsg);
            throw new Error(detailMsg);
          }

          sessionStorage.setItem('pendingOrderId', data.orderId.toString());
          sessionStorage.setItem('pendingOrderKey', data.orderKey);

          return data.paypalOrderId;
        } catch (err) {
          setPaymentBusyState(false, 'paypal');
          throw err;
        }
      },

      onApprove: async function(data, actions) {
        if (isFinalizingPayment) return;
        isFinalizingPayment = true;
        setPaymentBusyState(
          true,
          'paypal',
          'Payment approved! Finalizing your order, please wait...'
        );

        const orderId = sessionStorage.getItem('pendingOrderId') || '';
        const orderKey = sessionStorage.getItem('pendingOrderKey') || '';

        try {
          const res = await fetch('/api/paypal/capture-order', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              paypalOrderId: data.orderID,
              orderId: parseInt(orderId || '0', 10)
            })
          });

          const result = await res.json();

          if (!res.ok) {
            isFinalizingPayment = false;
            setPaymentBusyState(false, 'paypal');
            sessionStorage.setItem('paymentStatus', JSON.stringify({
              status: 'failed',
              reason: result.paypalError?.name || 'unknown',
              details: result.paypalError?.details || []
            }));
            window.top.location.href = `/checkout/confirmation?order_id=${encodeURIComponent(orderId)}&order_key=${encodeURIComponent(orderKey)}&payment=paypal&status=failed`;
            return;
          }

          localStorage.removeItem('ebbelle_cart');
          sessionStorage.removeItem('ebbelle_checkout_calculation');
          sessionStorage.removeItem('ebbelle_cart_manual_coupon');
          sessionStorage.removeItem('pendingOrderId');
          sessionStorage.removeItem('pendingOrderKey');
          sessionStorage.removeItem('pendingOrderSnapshot');
          sessionStorage.setItem('paymentStatus', JSON.stringify({
            status: 'success'
          }));

          window.top.location.href = `/checkout/confirmation?order_id=${encodeURIComponent(orderId)}&order_key=${encodeURIComponent(orderKey)}&payment=paypal&status=success`;
        } catch (error) {
          isFinalizingPayment = false;
          setPaymentBusyState(false, 'paypal');
          sessionStorage.setItem('paymentStatus', JSON.stringify({
            status: 'error',
            message: error.message
          }));

          window.top.location.href = `/checkout/confirmation?order_id=${encodeURIComponent(orderId)}&order_key=${encodeURIComponent(orderKey)}&payment=paypal&status=error`;
        }
      },

      onError: function(err) {
        isFinalizingPayment = false;
        setPaymentBusyState(false, 'paypal');
        console.error('PayPal Error:', err);
      },

      onCancel: function(data) {
        isFinalizingPayment = false;
        setPaymentBusyState(false, 'paypal');
        const orderId = sessionStorage.getItem('pendingOrderId') || '';
        const orderKey = sessionStorage.getItem('pendingOrderKey') || '';

        sessionStorage.setItem('paymentStatus', JSON.stringify({
          status: 'cancelled'
        }));

        window.top.location.href = `/checkout/confirmation?order_id=${encodeURIComponent(orderId)}&order_key=${encodeURIComponent(orderKey)}&payment=paypal&status=cancelled`;
      }
    }).render('#paypal-button-container');
  }

  document.addEventListener('DOMContentLoaded', initCheckout);
</script>