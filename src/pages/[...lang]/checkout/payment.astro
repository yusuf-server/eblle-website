<script define:vars={{ CURRENT_CURRENCY, AIRWALLEX_ENV }}>
  const CURRENCY_SYMBOLS = {
    USD: '$',
    EUR: '€',
    GBP: '£',
    CAD: 'C$'
  };

  const CURRENCY_RATES = {
    USD: 1.0,
    EUR: 0.92,
    GBP: 0.79,
    CAD: 1.36
  };

  function escapeHtml(str) {
    return String(str ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function isItemFreeGift(item) {
    if (!item) return false;
    const lowerName = String(item.name || '').toLowerCase();
    return Boolean(
      item.isXmasMysteryGift ||
      item.isVipFreeGift ||
      item.isFreeGift ||
      lowerName.includes('free gift') ||
      lowerName.includes('mystery gift') ||
      lowerName.includes('vip gift') ||
      (parseFloat(item.price) === 0 && !item.lineTotal)
    );
  }

  function getCurrentCurrency() {
    return localStorage.getItem('ebbelle_currency') || 'USD';
  }

  function getCurrencySymbol(currency) {
    return CURRENCY_SYMBOLS[currency || getCurrentCurrency()] || '$';
  }

  function convertPrice(priceUSD, targetCurrency) {
    const currency = targetCurrency || getCurrentCurrency();
    const rate = CURRENCY_RATES[currency] || 1.0;
    return priceUSD * rate;
  }

  function formatPrice(priceUSD, targetCurrency) {
    const currency = targetCurrency || getCurrentCurrency();
    const converted = convertPrice(priceUSD, currency);
    const symbol = getCurrencySymbol(currency);
    const formatted = converted.toFixed(2);

    if (currency === 'EUR') {
      return `${formatted}${symbol}`;
    }
    return `${symbol}${formatted}`;
  }

  function getCart() {
    try {
      const cart = localStorage.getItem('ebbelle_cart');
      return cart ? JSON.parse(cart) : [];
    } catch (e) {
      return [];
    }
  }

  function getCheckoutCalculation() {
    try {
      const str = sessionStorage.getItem('ebbelle_checkout_calculation');
      return str ? JSON.parse(str) : null;
    } catch (e) {
      return null;
    }
  }

  function getPendingOrderSnapshot() {
    try {
      const urlParams = new URLSearchParams(window.location.search);
      const queryOrderId = urlParams.get('order_id');
      if (!queryOrderId) return null;

      const snapStr = sessionStorage.getItem('pendingOrderSnapshot');
      if (!snapStr) return null;
      const snap = JSON.parse(snapStr);
      if (String(snap.orderId) !== String(queryOrderId)) return null;
      return snap;
    } catch (e) {
      return null;
    }
  }

  function calculateCartTotals(cart) {
    const pendingSnap = getPendingOrderSnapshot();
    if (pendingSnap) {
      const snapItems = Array.isArray(pendingSnap.items) && pendingSnap.items.length > 0 ? pendingSnap.items : cart;
      const rawSubtotal = snapItems.reduce((sum, item) => {
        if (item.lineTotal !== undefined) return sum + (parseFloat(item.lineTotal) || 0);
        if (isItemFreeGift(item)) return sum;
        return sum + ((parseFloat(item.price) || 0) * (item.quantity || 1));
      }, 0);

      const shipping = parseFloat(pendingSnap.shippingTotal || 0) || 0;
      const lockedTotal = Math.max(0, parseFloat(pendingSnap.total || 0) || 0);
      const couponDiscount = parseFloat(pendingSnap.discountTotal || 0) || 0;

      const feeSum = (pendingSnap.feeLines || []).reduce((acc, f) => acc + (parseFloat(f.total) || 0), 0);
      const impliedDelta = parseFloat((lockedTotal - (rawSubtotal - couponDiscount + shipping)).toFixed(2));
      const effectiveAdjustment = Math.abs(feeSum) > 0 ? feeSum : impliedDelta;

      const totalDiscount = couponDiscount + (effectiveAdjustment < 0 ? Math.abs(effectiveAdjustment) : 0);
      const positiveFee = effectiveAdjustment > 0 ? effectiveAdjustment : 0;

      return {
        isLockedPendingOrder: true,
        pendingOrderNumber: pendingSnap.orderNumber || pendingSnap.orderId,
        subtotal: rawSubtotal.toFixed(2),
        discount: totalDiscount.toFixed(2),
        positiveFee: positiveFee.toFixed(2),
        shipping: shipping.toFixed(2),
        total: lockedTotal.toFixed(2),
        currency: pendingSnap.currency || CURRENT_CURRENCY,
        itemCount: snapItems.reduce((sum, item) => sum + (item.quantity || 1), 0),
        calcData: null
      };
    }

    const rawSubtotal = cart.reduce((sum, item) => {
      if (isItemFreeGift(item)) return sum;
      const price = parseFloat(item.price) || 0;
      return sum + (price * item.quantity);
    }, 0);

    let shipping = 0;
    try {
      const shippingInfo = sessionStorage.getItem('shippingInfo');
      if (shippingInfo) {
        const info = JSON.parse(shippingInfo);
        shipping = parseFloat(info.shippingCost) || 0;
      }
    } catch (e) {
      shipping = 0;
    }

    const calc = getCheckoutCalculation();
    const discount = calc ? (parseFloat(calc.discount_total) || 0) : 0;
    if (calc && !isNaN(parseFloat(calc.shipping_cost))) {
      shipping = parseFloat(calc.shipping_cost);
    }

    const total = Math.max(0, rawSubtotal - discount) + shipping;

    return {
      isLockedPendingOrder: false,
      subtotal: rawSubtotal.toFixed(2),
      discount: discount.toFixed(2),
      positiveFee: '0.00',
      shipping: shipping.toFixed(2),
      total: total.toFixed(2),
      currency: CURRENT_CURRENCY,
      itemCount: cart.reduce((sum, item) => sum + item.quantity, 0),
      calcData: calc
    };
  }

  function renderCart(cart, totals) {
    const pendingSnap = getPendingOrderSnapshot();
    const displayItems = (pendingSnap && Array.isArray(pendingSnap.items) && pendingSnap.items.length > 0)
      ? pendingSnap.items
      : cart;

    const renderBox = (containerId) => {
      const el = document.getElementById(containerId);
      if (!el) return;
      if (displayItems.length === 0) {
        el.innerHTML = '<p style="text-align:center;padding:16px;color:#888;">Cart is empty</p>';
        return;
      }
      el.innerHTML = displayItems.map(item => {
        const isMysteryGift = Boolean(item.isXmasMysteryGift);
        const isVipGift = !isMysteryGift && isItemFreeGift(item);
        const isAnyGift = isMysteryGift || isVipGift;
        const itemTotal = item.lineTotal !== undefined
          ? (parseFloat(item.lineTotal) || 0)
          : (isAnyGift ? 0 : ((parseFloat(item.price) || 0) * (item.quantity || 1)));
        const safeName = escapeHtml(item.name);
        const safeImg = escapeHtml(item.image || '/placeholder.jpg');
        const safeGiftCode = escapeHtml(item.xmasGiftCode || '');
        const safeQty = parseInt(item.quantity, 10) || 1;
        const giftLabel = isMysteryGift
          ? `🎄 Mystery Gift ${safeGiftCode ? `(${safeGiftCode})` : ''} • Qty: ${safeQty}`
          : (isVipGift ? `🎁 VIP Complimentary Gift • Qty: ${safeQty}` : `Qty: ${safeQty}`);
        return `
          <div class="item" ${isAnyGift ? 'style="background:#fff8f5; padding:8px; border-radius:6px; border:1px dashed #d6b879;"' : ''}>
            <img src="${safeImg}" alt="${safeName}" ${isAnyGift ? 'style="object-fit:contain; padding:4px; border-color:#d6b879;"' : ''}>
            <div class="item-details">
              <h3>${safeName}</h3>
              <p ${isAnyGift ? 'style="color:#961820; font-weight:600;"' : ''}>${giftLabel}</p>
            </div>
            <span class="item-price" ${isAnyGift ? 'style="color:#961820; font-weight:700;"' : ''}>${itemTotal === 0 && isAnyGift ? 'FREE' : formatPrice(itemTotal)}</span>
          </div>
        `;
      }).join('');
    };

    renderBox('mobileCartItems');
    renderBox('desktopCartItems');

    const banners = document.querySelectorAll('.applied-privileges-banner');
    if (totals.isLockedPendingOrder) {
      banners.forEach(b => {
        b.style.display = 'block';
        b.innerHTML = `
          <div style="font-weight:700; color:#8c631a; text-transform:uppercase; font-size:11px; letter-spacing:0.06em;">
            <i class="fa-solid fa-lock"></i> Completing Payment for Order #${escapeHtml(totals.pendingOrderNumber)}
          </div>
          <div style="font-size:11.5px; color:#66522e; margin-top:2px;">
            Final order total is locked to your confirmed invoice amount.
          </div>
        `;
      });
    } else {
      const calc = totals.calcData;
      const hasOffers = calc && calc.applied_offers && calc.applied_offers.length > 0;
      const earnedPts = calc ? (parseFloat(calc.points_earned) || 0) : parseFloat((parseFloat(totals.subtotal) / 10).toFixed(1));
      const multiplier = calc ? (parseFloat(calc.points_multiplier) || 1.0) : 1.0;

      if (hasOffers || earnedPts > 0) {
        banners.forEach(b => {
          b.style.display = 'block';
          let html = '';
          if (hasOffers) {
            html += `
              <div style="font-weight:700; color:#8c631a; margin-bottom:4px; text-transform:uppercase; font-size:11px; letter-spacing:0.06em;">
                <i class="fa-solid fa-crown"></i> Active Rewards & Discounts
              </div>
              <div style="margin-bottom: ${earnedPts > 0 ? '8px' : '0'};">
                ${calc.applied_offers.map(o => `<div>✓ ${escapeHtml(o)}</div>`).join('')}
              </div>
            `;
          }
          if (earnedPts > 0) {
            html += `
              <div style="display:flex; align-items:center; justify-content:space-between; ${hasOffers ? 'padding-top:8px; border-top:1px dashed rgba(163,130,76,0.3);' : ''} color:#66522e; font-size:12px;">
                <span>
                  <i class="fa-solid fa-coins" style="color:#b8860b; margin-right:4px;"></i>
                  Points to Earn ${multiplier > 1 ? `<span style="background:#faebd7; color:#8c631a; padding:1px 5px; border-radius:4px; font-size:10px; font-weight:700;">${multiplier}x VIP</span>` : ''}
                </span>
                <strong style="color:#2e7d32;">+${earnedPts} PTS</strong>
              </div>
            `;
          }
          b.innerHTML = html;
        });
      } else {
        banners.forEach(b => { b.style.display = 'none'; });
      }
    }

    document.querySelectorAll('.subtotal-val').forEach(el => el.textContent = formatPrice(parseFloat(totals.subtotal)));

    const discountNum = parseFloat(totals.discount);
    document.querySelectorAll('.discount-row').forEach(row => {
      row.style.display = discountNum > 0 ? 'flex' : 'none';
    });
    document.querySelectorAll('.discount-val').forEach(el => el.textContent = `-${formatPrice(discountNum)}`);

    const posFeeNum = parseFloat(totals.positiveFee || '0');
    document.querySelectorAll('.fee-row').forEach(row => {
      row.style.display = posFeeNum > 0 ? 'flex' : 'none';
    });
    document.querySelectorAll('.fee-val').forEach(el => el.textContent = `+${formatPrice(posFeeNum)}`);

    const shippingNum = parseFloat(totals.shipping);
    document.querySelectorAll('.shipping-val').forEach(el => {
      el.textContent = shippingNum === 0 ? 'FREE' : formatPrice(shippingNum);
    });

    document.querySelectorAll('.total-val').forEach(el => el.textContent = formatPrice(parseFloat(totals.total)));

    const mobileSummary = document.getElementById('mobileSummaryTotal');
    if (mobileSummary) mobileSummary.textContent = formatPrice(parseFloat(totals.total));

    const dtTitle = document.getElementById('desktopOrderTitle');
    if (dtTitle) dtTitle.textContent = `Order summary (${totals.itemCount} items)`;
  }

  // ============================================================
  // 规范化账单地址获取（支持与收货地址一致 / 自定义账单地址 + WooCommerce 州代码校准）
  // ============================================================
