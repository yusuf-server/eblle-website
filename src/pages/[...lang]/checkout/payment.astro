---
import Layout from '../../../layouts/Layout.astro';
import { SUPPORTED_LOCALES, type SupportedLocale } from '../../../lib/i18n/utils';
import { t } from '../../../lib/i18n/translations';

// 获取语言参数
const lang = Astro.params.lang as SupportedLocale | undefined;
const currentLocale: SupportedLocale = lang && SUPPORTED_LOCALES.includes(lang as SupportedLocale)
  ? (lang as SupportedLocale)
  : 'en';

// 获取 PayPal & Airwallex 配置
const PAYPAL_CLIENT_ID = import.meta.env.PUBLIC_PAYPAL_CLIENT_ID || '';
const AIRWALLEX_ENV = import.meta.env.PUBLIC_AIRWALLEX_ENV || import.meta.env.AIRWALLEX_ENV || 'demo';

// 支持动态多货币，默认兜底 USD
const CURRENT_CURRENCY = 'USD';
---

<Layout title="Checkout: Payment & Review - E.B.Belle">
  <!-- 提前建立 DNS 与 TLS 预连接，加快 Airwallex 与 PayPal 表单首屏渲染速度 -->
  <link rel="preconnect" href="https://checkout.airwallex.com" crossorigin />
  <link rel="dns-prefetch" href="https://checkout.airwallex.com" />
  <link rel="preconnect" href="https://www.paypal.com" crossorigin />
  <link rel="dns-prefetch" href="https://www.paypal.com" />

  <!-- PayPal SDK -->
  <script is:inline src={`https://www.paypal.com/sdk/js?client-id=${PAYPAL_CLIENT_ID}&currency=${CURRENT_CURRENCY}&intent=capture`} data-sdk-integration-source="button-factory"></script>
  <!-- Airwallex Payment Elements SDK -->
  <script is:inline src="https://checkout.airwallex.com/assets/elements.bundle.min.js"></script>

  <header class="checkout-header">
    <div class="header-container">
      <a href="/" class="header-logo">
        <svg width="24" height="24" viewBox="0 0 48 48" fill="none">
          <path clip-rule="evenodd" d="M24 4H6V17.3333V30.6667H24V44H42V30.6667V17.3333H24V4Z" fill="currentColor" fill-rule="evenodd"></path>
        </svg>
        <span>E.B.Belle</span>
      </a>
      <a href="/checkout/shipping" class="back-btn" id="checkoutBackBtn">
        <i class="fa-solid fa-arrow-left"></i>
        Back to Shipping
      </a>
    </div>
  </header>

  <main class="checkout-page">
    <div class="checkout-container">
      <!-- Left: Form -->
      <div class="checkout-left">
        <nav class="progress-nav">
          <span class="progress-step completed">✓ SHIPPING</span>
          <i class="fa-solid fa-chevron-right"></i>
          <span class="progress-step active">PAYMENT</span>
          <i class="fa-solid fa-chevron-right"></i>
          <span class="progress-step">CONFIRMATION</span>
        </nav>

        <!-- Mobile Order Summary -->
        <aside class="checkout-right mobile-order-summary">
          <div class="order-summary">
            <button type="button" class="summary-toggle" id="summaryToggle">
              <div class="summary-header-left">
                <i class="fa-solid fa-shopping-bag"></i>
                <h2>Order summary</h2>
                <i class="fa-solid fa-chevron-down toggle-icon"></i>
              </div>
              <span class="summary-total" id="mobileSummaryTotal">$0.00</span>
            </button>

            <div class="summary-content" id="summaryContent">
              <div class="summary-items" id="mobileCartItems"></div>

              <!-- 已生效的特权与预计获取积分横幅 -->
              <div class="applied-privileges-banner" style="display: none;"></div>

              <div class="summary-totals">
                <div class="total-line">
                  <span>Subtotal</span>
                  <span class="subtotal-val">$0.00</span>
                </div>
                <div class="total-line discount-row" style="display: none; color: #2e7d32;">
                  <span class="discount-label">Discount &amp; Rewards</span>
                  <span class="discount-val">-$0.00</span>
                </div>
                <div class="total-line fee-row" style="display: none; color: #666;">
                  <span class="fee-label">Order Adjustment</span>
                  <span class="fee-val">$0.00</span>
                </div>
                <div class="total-line">
                  <span>Shipping</span>
                  <span class="shipping-val">$20.00</span>
                </div>
                <div class="total-line grand">
                  <span>Total</span>
                  <span class="total-amount">
                    <span class="currency">{CURRENT_CURRENCY}</span> <strong class="total-val">$0.00</strong>
                  </span>
                </div>
              </div>
            </div>
          </div>
        </aside>

        <!-- 1. Shipping Review -->
        <section class="info-review">
          <div class="review-header">
            <h3>Shipping Information</h3>
            <a href="/checkout/shipping" id="shippingEditLink">Edit</a>
          </div>
          <div class="review-content" id="shippingReview">
            <p class="name">Loading...</p>
            <p class="address">Please complete shipping info first.</p>
            <p class="contact"></p>
          </div>
        </section>

        <form id="paymentForm" class="payment-form" onsubmit="return false;">
          <!-- 2. Billing Address（置于 Shipping 与 Payment Method 之间，全渠道通用） -->
          <section class="form-section" id="billingAddressSection">
            <div class="section-heading-row">
              <h2>Billing Address</h2>
              <span class="section-sub-hint">Matches your card or PayPal statement</span>
            </div>

            <div class="billing-options-card">
              <label class="billing-radio-row active" data-billing-mode="same">
                <input type="radio" name="billingMode" value="same" checked>
                <span class="custom-radio-dot"></span>
                <div class="radio-label-group">
                  <span class="radio-title">Same as shipping address</span>
                  <span class="radio-desc" id="sameAsShippingPreview">Use your delivery address above</span>
                </div>
              </label>

              <label class="billing-radio-row" data-billing-mode="different">
                <input type="radio" name="billingMode" value="different">
                <span class="custom-radio-dot"></span>
                <div class="radio-label-group">
                  <span class="radio-title">Use a different billing address</span>
                  <span class="radio-desc">Enter a separate billing address for card or PayPal</span>
                </div>
              </label>
            </div>

            <div id="customBillingFields" class="custom-billing-panel" style="display: none;">
              <div class="billing-grid-2">
                <div class="billing-field">
                  <label for="billFirstName">FIRST NAME *</label>
                  <input type="text" id="billFirstName" placeholder="First name">
                </div>
                <div class="billing-field">
                  <label for="billLastName">LAST NAME *</label>
                  <input type="text" id="billLastName" placeholder="Last name">
                </div>
              </div>

              <div class="billing-field" style="margin-bottom: 14px;">
                <label for="billAddress">STREET ADDRESS *</label>
                <input type="text" id="billAddress" placeholder="Street address, apartment, suite, etc.">
              </div>

              <div class="billing-grid-2">
                <div class="billing-field">
                  <label for="billCity">CITY *</label>
                  <input type="text" id="billCity" placeholder="City">
                </div>
                <div class="billing-field" id="billStateWrap">
                  <label for="billState">STATE / PROVINCE *</label>
                  <input type="text" id="billState" placeholder="State / Province">
                </div>
              </div>

              <div class="billing-grid-2" style="margin-bottom: 0;">
                <div class="billing-field">
                  <label for="billZip">ZIP / POSTAL CODE *</label>
                  <input type="text" id="billZip" placeholder="Postal code">
                </div>
                <div class="billing-field">
                  <label for="billCountry">COUNTRY / REGION *</label>
                  <select id="billCountry"></select>
                </div>
              </div>

              <p id="billingValidationError" class="billing-error-msg" style="display: none;"></p>

              <button type="button" id="applyCustomBillingBtn" class="update-billing-btn">
                UPDATE BILLING ADDRESS
              </button>
            </div>
          </section>

          <!-- 3. Payment Method（信用卡优先主推在左/上，PayPal 在右/下） -->
          <section class="form-section">
            <div class="section-heading-row">
              <h2>{t(currentLocale, 'checkout.paymentMethod')}</h2>
              <span class="section-sub-hint"><i class="fa-solid fa-shield-halved" style="color:#8c631a;"></i> Encrypted checkout</span>
            </div>

            <div class="payment-methods" id="paymentMethodsBar">
              <!-- 主推首选：Credit / Debit Card -->
              <label class="payment-option recommended active" data-method="card">
                <input type="radio" name="payment" value="card" checked>
                <span class="recommended-badge">RECOMMENDED</span>
                <span class="selected-check"><i class="fa-solid fa-check"></i></span>
                <div class="payment-content">
                  <div class="card-brands-row">
                    <i class="fa-brands fa-cc-visa" style="color:#1a1f71;"></i>
                    <i class="fa-brands fa-cc-mastercard" style="color:#eb001b;"></i>
                    <i class="fa-brands fa-cc-amex" style="color:#006fcf;"></i>
                  </div>
                  <span class="method-title">Credit / Debit Card</span>
                  <span class="method-subtitle">Instant checkout • No extra account needed</span>
                </div>
              </label>

              <!-- 次选：PayPal -->
              <label class="payment-option" data-method="paypal">
                <input type="radio" name="payment" value="paypal">
                <span class="selected-check"><i class="fa-solid fa-check"></i></span>
                <div class="payment-content">
                  <div class="card-brands-row">
                    <i class="fa-brands fa-paypal" style="color: #003087; font-size: 22px;"></i>
                  </div>
                  <span class="method-title">PayPal</span>
                  <span class="method-subtitle">Express checkout or Pay Later</span>
                </div>
              </label>
            </div>

            <!-- 1. Airwallex 信用卡模块嵌入 (Drop-in) 容器（默认显示） -->
            <div class="airwallex-card-form" id="airwallexCardForm">
              <div id="airwallex-loading" style="text-align: center; padding: 24px 16px; color: #747878; font-size: 13.5px;">
                <i class="fa-solid fa-spinner fa-spin" style="font-size: 20px; color: #8c631a; margin-bottom: 8px; display: block;"></i>
                <span>Initializing secure card checkout...</span>
              </div>
              <div id="airwallex-error" style="display: none; background: #fdecea; color: #c62828; border: 1px solid #ffcdd2; padding: 12px 14px; border-radius: 6px; font-size: 13px; margin-bottom: 14px;"></div>
              <div id="airwallex-dropin" style="min-height: 120px;"></div>
              <!-- 点击 Pay 后的原位轻提示条（成功跳转，失败自动隐藏解锁） -->
              <div id="airwallex-processing-hint" class="payment-processing-hint" style="display: none;">
                <i class="fa-solid fa-spinner fa-spin"></i>
                <span id="airwallex-processing-text">Processing your payment securely... Please do not refresh or close this page.</span>
              </div>
            </div>

            <!-- 2. PayPal 支付容器（切换时显示） -->
            <div class="paypal-form" id="paypalForm" style="display: none;">
              <div class="paypal-info">
                <p style="text-align: center; color: #66522e; font-size: 13.5px; margin-bottom: 18px;">
                  Click below to complete your order securely with PayPal or Pay Later.
                </p>
              </div>
              <div id="paypal-button-container"></div>
              <div id="paypal-processing-hint" class="payment-processing-hint" style="display: none;">
                <i class="fa-solid fa-spinner fa-spin"></i>
                <span id="paypal-processing-text">Finalizing your PayPal payment... Please do not refresh or close this page.</span>
              </div>
            </div>
          </section>
        </form>

        <!-- Trust & Security -->
        <section class="trust-section">
          <div class="trust-item">
            <div class="trust-icon security">
              <i class="fa-solid fa-lock"></i>
            </div>
            <div class="trust-content">
              <h3>Shopping security</h3>
              <p>Each payment is secured with strict SSL encryption and PCI DSS Level 1 compliant checkout.</p>
              <div class="payment-badges">
                <span class="payment-badge visa">VISA</span>
                <span class="payment-badge mastercard">Mastercard</span>
                <span class="payment-badge amex">AMEX</span>
                <span class="payment-badge paypal">PayPal Verified</span>
              </div>
            </div>
          </div>
        </section>
      </div>

      <!-- Right: Desktop Summary -->
      <aside class="checkout-right desktop-order-summary">
        <div class="order-summary">
          <h2 id="desktopOrderTitle">Order summary</h2>
          <div class="summary-items" id="desktopCartItems"></div>

          <!-- 已生效的特权与预计获取积分横幅 -->
          <div class="applied-privileges-banner" style="display: none;"></div>

          <div class="summary-totals">
            <div class="total-line">
              <span>Subtotal</span>
              <span class="subtotal-val">$0.00</span>
            </div>
            <div class="total-line discount-row" style="display: none; color: #2e7d32;">
              <span class="discount-label">Discount &amp; Rewards</span>
              <span class="discount-val">-$0.00</span>
            </div>
            <div class="total-line fee-row" style="display: none; color: #666;">
              <span class="fee-label">Order Adjustment</span>
              <span class="fee-val">$0.00</span>
            </div>
            <div class="total-line">
              <span>Shipping</span>
              <span class="shipping-val">$20.00</span>
            </div>
            <div class="total-line grand">
              <span>Total</span>
              <span class="total-amount">
                <span class="currency">{CURRENT_CURRENCY}</span> <strong class="total-val">$0.00</strong>
              </span>
            </div>
          </div>
        </div>
      </aside>
    </div>
  </main>
</Layout>

<style is:global>
  * { box-sizing: border-box; }
  .checkout-header {
    border-bottom: 1px solid #ddd8ce;
    background: #fcf9f3;
    position: sticky;
    top: 0;
    z-index: 100;
  }
  .header-container {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 40px;
    height: 72px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .header-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: #0e0f0f;
  }
  .header-logo span {
    font-size: 18px;
    font-weight: 600;
  }
  .back-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: #444748;
    text-decoration: none;
  }
  .checkout-page {
    background: #fcf9f3;
    min-height: calc(100vh - 72px);
    padding: 48px 0;
  }
  .checkout-container {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 40px;
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: 60px;
  }
  .checkout-left {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .progress-nav {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .progress-step {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 2px;
    color: #747878;
  }
  .progress-step.active { color: #0e0f0f; }
  .progress-step.completed { color: #16a34a; }

  .info-review {
    background: #f6f3ed;
    border: 1px solid #ddd8ce;
    border-radius: 6px;
    padding: 22px 24px;
  }
  .review-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
  }
  .review-header h3 {
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: #0e0f0f;
  }
  .review-header a {
    font-size: 12px;
    font-weight: 600;
    color: #8c631a;
    text-decoration: underline;
  }
  .review-content p {
    font-size: 13.5px;
    color: #6b6860;
    line-height: 1.55;
    margin: 2px 0;
  }
  .review-content .name {
    font-weight: 600;
    color: #1c1c18;
  }

  .payment-form {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .section-heading-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 14px;
  }
  .form-section h2 {
    font-family: 'Bodoni Moda', serif;
    font-size: 22px;
    font-weight: 500;
    color: #0e0f0f;
    margin: 0;
  }
  .section-sub-hint {
    font-size: 12px;
    color: #747066;
  }

  /* ================= 账单地址卡片与表单（暖奶油奢品配色） ================= */
  .billing-options-card {
    border: 1px solid #ddd8ce;
    border-radius: 8px;
    background: #ffffff;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(14, 15, 15, 0.03);
  }
  .billing-radio-row {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 20px;
    cursor: pointer;
    transition: background-color 0.2s ease;
    border-bottom: 1px solid #ece7dd;
    background: #ffffff;
  }
  .billing-radio-row:last-child {
    border-bottom: none;
  }
  .billing-radio-row:hover {
    background: #faf7f0;
  }
  .billing-radio-row.active {
    background: #f7f3ea;
  }
  .billing-radio-row input[type="radio"] {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .custom-radio-dot {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 1.5px solid #b5afa2;
    background: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: all 0.2s ease;
  }
  .billing-radio-row.active .custom-radio-dot {
    border-color: #8c631a;
    background: #8c631a;
    box-shadow: inset 0 0 0 3.5px #fff;
  }
  .radio-label-group {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .radio-title {
    font-size: 14px;
    font-weight: 600;
    color: #1c1c18;
  }
  .radio-desc {
    font-size: 12px;
    color: #7c776d;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .custom-billing-panel {
    margin-top: 12px;
    padding: 22px;
    background: #f8f5ee;
    border: 1px solid #d8d0c1;
    border-radius: 8px;
    box-shadow: 0 4px 14px rgba(140, 99, 26, 0.06);
  }
  .billing-grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    margin-bottom: 14px;
  }
  .billing-field label {
    display: block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    color: #5c574d;
    margin-bottom: 6px;
  }
  .billing-field input,
  .billing-field select {
    width: 100%;
    padding: 11px 13px;
    border: 1px solid #cfc8ba;
    border-radius: 6px;
    font-size: 14px;
    color: #1c1c18;
    background: #ffffff;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .billing-field input:focus,
  .billing-field select:focus {
    outline: none;
    border-color: #8c631a;
    box-shadow: 0 0 0 3px rgba(140, 99, 26, 0.14);
  }
  .billing-error-msg {
    margin: 12px 0 0;
    padding: 9px 12px;
    background: #fdf2f2;
    border: 1px solid #f5c2c7;
    border-radius: 5px;
    color: #b42318;
    font-size: 12.5px;
  }
  .update-billing-btn {
    margin-top: 18px;
    width: 100%;
    padding: 13px 16px;
    background: #1c1c18;
    color: #fcf9f3;
    border: 1px solid #1c1c18;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.25s ease;
  }
  .update-billing-btn:hover:not(:disabled) {
    background: #8c631a;
    border-color: #8c631a;
  }

  /* ================= 支付方式切换卡片（主推信用卡 + 明显激活态） ================= */
  .payment-methods {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-bottom: 18px;
    transition: opacity 0.2s ease;
  }
  .payment-option {
    position: relative;
    cursor: pointer;
    display: block;
  }
  .payment-option input { display: none; }
  .payment-content {
    height: 100%;
    border: 1.5px solid #d5cfc3;
    border-radius: 8px;
    padding: 22px 18px 18px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 6px;
    background: #ffffff;
    color: #5c5850;
    transition: all 0.22s ease;
  }
  .payment-option:hover .payment-content {
    border-color: #b0893e;
    background: #fcfaf5;
  }
  .payment-option.active .payment-content {
    border: 2px solid #8c631a;
    background: linear-gradient(180deg, #faf5ea 0%, #f3ead8 100%);
    color: #1c1c18;
    box-shadow: 0 6px 18px rgba(140, 99, 26, 0.13);
  }
  .recommended-badge {
    position: absolute;
    top: -10px;
    left: 14px;
    background: #8c631a;
    color: #fcf9f3;
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 1px;
    padding: 3px 8px;
    border-radius: 4px;
    text-transform: uppercase;
    box-shadow: 0 2px 6px rgba(140, 99, 26, 0.25);
    z-index: 2;
  }
  .selected-check {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: #8c631a;
    color: #ffffff;
    font-size: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transform: scale(0.75);
    transition: all 0.2s ease;
    z-index: 2;
  }
  .payment-option.active .selected-check {
    opacity: 1;
    transform: scale(1);
  }
  .card-brands-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    font-size: 20px;
    min-height: 24px;
  }
  .method-title {
    font-size: 14.5px;
    font-weight: 700;
    color: #1c1c18;
  }
  .method-subtitle {
    font-size: 11.5px;
    color: #7c776d;
    line-height: 1.35;
  }
  .payment-option.active .method-subtitle {
    color: #66522e;
  }

  .airwallex-card-form {
    background: #ffffff;
