  // 打开登录模态框
  function openAuthModal(mode, email) {
    // 调用全局的 openAuthModal 函数（由 AuthModal 组件提供）
    if (typeof window.openAuthModal === 'function') {
      window.openAuthModal('login');

      // 预填邮箱
      setTimeout(() => {
        const emailInput = document.getElementById('loginEmail');
        if (emailInput && email) {
          emailInput.value = email;
        }
      }, 100);
    }
  }

  // 页面加载时初始化
  if (typeof window !== 'undefined') {
    // 设置标记，告诉 AuthModal 登录后不要刷新页面
    window.isConfirmationPage = true;

    initOrderCompletion();

    // 监听用户登录事件，更新按钮为"查看订单"
    window.addEventListener('userLoggedIn', function(e) {
      console.log('🎉 用户登录成功，更新按钮');

      const viewOrderBtn = document.getElementById('viewOrderBtn');
      const viewOrderBtnText = document.getElementById('viewOrderBtnText');

      if (viewOrderBtn && viewOrderBtnText) {
        // 更新按钮文本和行为
        viewOrderBtnText.textContent = 'View Order';
        viewOrderBtn.style.display = 'inline-flex';

        viewOrderBtn.onclick = () => {
          window.location.href = '/account?tab=orders';
        };

        console.log('✅ 按钮已更新为"查看订单"');
      }

      // 阻止 AuthModal 的默认刷新行为
      // 我们在确认页不需要刷新
      e.preventDefault && e.preventDefault();
    });
  }
</script>