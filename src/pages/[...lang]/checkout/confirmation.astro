</style>

<script is:inline>
  // 彩带效果函数
  function createConfetti() {
    const container = document.getElementById('confetti-container');
    if (!container) return;

    // 清空历史彩带
    container.innerHTML = '';

    const colors = ['#ef4444', '#3b82f6', '#22c55e', '#eab308', '#8b5cf6', '#f97316', '#fd79a8', '#fdcb6e'];
    const confettiCount = 90;

    for (let i = 0; i < confettiCount; i++) {
      const confetti = document.createElement('div');
      confetti.className = 'confetti-piece';

      // 明确写入 position，防止全局/框架样式冲突
      confetti.style.position = 'fixed';
      confetti.style.pointerEvents = 'none';
      confetti.style.zIndex = '9999';

      // 均匀分散在全屏宽度
      confetti.style.left = (Math.random() * 100) + 'vw';
      confetti.style.top = (-20 - Math.random() * 30) + 'px';

      // 形状与随机颜色
      const width = Math.random() * 6 + 6; // 6px ~ 12px
      const height = Math.random() * 10 + 12; // 12px ~ 22px
      confetti.style.width = width + 'px';
      confetti.style.height = height + 'px';
      confetti.style.borderRadius = '2px';
      confetti.style.backgroundColor = colors[i % colors.length];

      // 随机下落时间与延迟
      const duration = 2.5 + Math.random() * 2.5;
      const delay = Math.random() * 1.8;
      confetti.style.animation = `confetti-fall ${duration}s ${delay}s linear forwards`;

      container.appendChild(confetti);
    }

    // 动画结束后清空节点
    setTimeout(() => {
      container.innerHTML = '';
    }, 6000);
  }

  // 页面加载时，如果是支付成功页面，触发彩带效果
  if (typeof window !== 'undefined') {
    window.addEventListener('load', () => {
      const container = document.getElementById('confetti-container');
      if (container) {
        setTimeout(createConfetti, 200);
      }
    });
  }

  // 清除订单相关的临时会话（但保留 shippingInfo 和 userEmailStatus 用于注册）
  try {
    sessionStorage.removeItem('pendingOrderId');
    sessionStorage.removeItem('pendingOrderKey');
    // 不要立即删除 shippingInfo，等注册完成后再删
    // sessionStorage.removeItem('shippingInfo');
  } catch(e) {}

  // 清除缓存并导航（用于确保库存同步）
  function clearCacheAndNavigate(event, url) {
    event.preventDefault();

    // 离开确认页时清除临时数据
    try {
      sessionStorage.removeItem('shippingInfo');
      sessionStorage.removeItem('userEmailStatus');
      sessionStorage.removeItem('paymentStatus');
    } catch(e) {}

    if (url === '/shop') {
      // 跳转到 shop 页，添加强制刷新标记
      // shop 页会检测这个参数，触发骨架屏重新加载
      window.location.href = '/shop?refresh=1';
    } else {
      // 其他页面正常跳转
      window.location.href = url;
    }
  }

  // 订单完成后的用户注册和登录逻辑
  async function initOrderCompletion() {
    console.log('🔄 initOrderCompletion 开始执行');

    const viewOrderBtn = document.getElementById('viewOrderBtn');
    const viewOrderBtnText = document.getElementById('viewOrderBtnText');

    console.log('🔍 按钮元素:', viewOrderBtn);

    if (!viewOrderBtn) {
      console.error('❌ 找不到 viewOrderBtn 元素');
      return;
    }

    // 获取当前登录状态
    const isLoggedIn = checkIfLoggedIn();
    console.log('🔐 登录状态:', isLoggedIn);

    // 获取用户邮箱状态
    const emailStatusStr = sessionStorage.getItem('userEmailStatus');
    const shippingInfoStr = sessionStorage.getItem('shippingInfo');

    console.log('📧 emailStatusStr:', emailStatusStr);
    console.log('📦 shippingInfoStr:', shippingInfoStr);

    let userEmail = '';
    let isRegistered = false;

    if (emailStatusStr) {
      const emailStatus = JSON.parse(emailStatusStr);
      userEmail = emailStatus.email;
      isRegistered = emailStatus.isRegistered;
    } else if (shippingInfoStr) {
      const shippingInfo = JSON.parse(shippingInfoStr);
      userEmail = shippingInfo.email;
    }

    console.log('✉️ userEmail:', userEmail);
    console.log('📋 isRegistered:', isRegistered);

    // 情况1: 已登录用户
    if (isLoggedIn) {
      viewOrderBtnText.textContent = 'View Order';
      viewOrderBtn.style.display = 'inline-flex';

      viewOrderBtn.onclick = () => {
        window.location.href = '/account?tab=orders';
      };
      return;
    }

    // 情况2: 未注册用户 - 自动注册
    if (!isRegistered && userEmail) {
      console.log('📝 情况2: 未注册用户，开始自动注册...');
      try {
        const registered = await autoRegisterUser(userEmail);
        console.log('✅ 注册结果:', registered);
        if (registered) {
          // 注册成功，显示查看订单按钮
          viewOrderBtnText.textContent = 'View Order';
          viewOrderBtn.style.display = 'inline-flex';

          viewOrderBtn.onclick = () => {
            window.location.href = '/account?tab=orders';
          };
          console.log('✅ 按钮已显示');
        } else {
          // 注册失败，可能是邮箱已存在，显示登录按钮
          console.log('⚠️ 注册失败（可能邮箱已存在），显示登录按钮');
          viewOrderBtnText.textContent = 'Login to View Order';
          viewOrderBtn.style.display = 'inline-flex';

          viewOrderBtn.onclick = () => {
            openAuthModal('signin', userEmail);
          };
          console.log('✅ 登录按钮已显示');
        }
      } catch (error) {
        console.error('❌ 自动注册异常:', error);
      }
      return;
    }

    // 情况3: 已注册但未登录 - 显示登录按钮
    if (isRegistered && userEmail) {
      console.log('🔐 情况3: 已注册但未登录，显示登录按钮');
      viewOrderBtnText.textContent = 'Login to View Order';
      viewOrderBtn.style.display = 'inline-flex';

      viewOrderBtn.onclick = () => {
        openAuthModal('signin', userEmail);
      };
      console.log('✅ 登录按钮已显示');
    }
  }

  // 检查用户是否已登录
  function checkIfLoggedIn() {
    // 检查 localStorage 中的用户信息（AuthModal 和自动注册都会设置这个）
    const user = localStorage.getItem('user');

    // 检查 cookies（通过 document.cookie）
    const hasCookies = document.cookie.includes('user_id=') && document.cookie.includes('user_email=');

    return !!(user || hasCookies);
  }

  // 自动注册用户
  async function autoRegisterUser(email) {
    try {
      const shippingInfoStr = sessionStorage.getItem('shippingInfo');
      if (!shippingInfoStr) {
        console.error('❌ 没有找到 shippingInfo');
        return false;
      }

      const shippingInfo = JSON.parse(shippingInfoStr);

      // 生成临时密码（至少8位）
      const tempPassword = generateTempPassword();

      console.log('📤 发送注册请求:', {
        email,
        firstName: shippingInfo.firstName,
        lastName: shippingInfo.lastName
      });

      // 步骤1: 注册用户
      const registerResponse = await fetch('/api/auth/register', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          email: email,
          firstName: shippingInfo.firstName || 'Customer',
          lastName: shippingInfo.lastName || '',
          password: tempPassword
        })
      });

      const registerData = await registerResponse.json();
      console.log('📥 注册响应:', registerData);

      if (!registerData.success) {
        console.error('❌ 注册失败:', registerData.message);
        return false;
      }

      // 步骤2: 自动登录以设置 cookies
      console.log('🔐 自动登录中...');
      const loginResponse = await fetch('/api/auth/login', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          email: email,
          password: tempPassword,
          rememberMe: true
        })
      });

      const loginData = await loginResponse.json();
      console.log('📥 登录响应:', loginData);

      if (loginData.success) {
        // 保存用户信息到 localStorage（与 AuthModal 一致）
        if (loginData.user) {
          localStorage.setItem('user', JSON.stringify(loginData.user));
        }

        // 步骤3: 如果有订单ID，关联订单到新用户
        const urlParams = new URLSearchParams(window.location.search);
        const orderId = urlParams.get('order_id') || urlParams.get('orderId');

        if (orderId && loginData.user && loginData.user.id) {
          console.log('🔗 关联订单到用户:', orderId, '→', loginData.user.id);
          await updateOrderCustomer(orderId, loginData.user.id);
        }

        // 发送欢迎邮件（包含临时密码）
        await sendWelcomeEmail(email, tempPassword, shippingInfo.firstName);

        // 注册和登录成功，清除临时数据
        sessionStorage.removeItem('shippingInfo');
        sessionStorage.removeItem('userEmailStatus');

        console.log('✅ 自动注册和登录成功');
        return true;
      }

      console.error('❌ 自动登录失败:', loginData.message);
      return false;
    } catch (error) {
      console.error('❌ 自动注册异常:', error);
      return false;
    }
  }

  // 更新订单的 customer_id
  async function updateOrderCustomer(orderId, customerId) {
    try {
      console.log('📤 发送更新订单请求:', { orderId, customerId });

      const response = await fetch('/api/orders/update-customer', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          orderId: orderId,
          customerId: customerId
        })
      });

      const data = await response.json();
      console.log('📥 更新订单响应:', data);

      if (data.success) {
        console.log('✅ 订单已关联到用户账户');
        return true;
      } else {
        console.error('❌ 订单关联失败:', data.message);
        return false;
      }
    } catch (error) {
      console.error('❌ 更新订单异常:', error);
      return false;
    }
  }

  // 生成临时密码
  function generateTempPassword() {
    const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnpqrstuvwxyz23456789';
    let password = '';
    for (let i = 0; i < 12; i++) {
      password += chars.charAt(Math.floor(Math.random() * chars.length));
    }
    return password;
  }

