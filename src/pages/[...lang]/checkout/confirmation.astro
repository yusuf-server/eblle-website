    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: #0e0f0f;
  }
  .header-logo span {
    font-size: 18px;
    font-weight: 600;
  }
  .confirmation-page {
    background: #fcf9f3;
    min-height: calc(100vh - 72px);
    padding: 60px 20px;
    display: flex;
    justify-content: center;
  }
  .confirmation-container {
    max-width: 720px;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .success-circle {
    width: 72px;
    height: 72px;
    background: #16a34a;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 24px;
    color: #fff;
    font-size: 32px;
  }
  .warning-circle {
    width: 72px;
    height: 72px;
    background: #f59e0b;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 24px;
    color: #fff;
    font-size: 32px;
  }
  .pending-circle {
    width: 72px;
    height: 72px;
    background: #6b7280;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 24px;
    color: #fff;
    font-size: 32px;
  }
  .error-circle {
    width: 72px;
    height: 72px;
    background: #dc2626;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 24px;
