  }
  .info-header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
    color: #725b29;
  }
  .info-header h3 { font-size: 12px; font-weight: 700; text-transform: uppercase; color: #111; }
  .info-body p { font-size: 13px; color: #666; line-height: 1.5; margin: 2px 0; }
  .success-text { color: #16a34a !important; font-weight: 600; margin-top: 6px; }
  .pending-text { color: #f59e0b !important; font-weight: 600; margin-top: 6px; }
  .warning-text { color: #ef4444 !important; font-weight: 600; margin-top: 6px; }
  .error-text { color: #dc2626 !important; font-weight: 600; margin-top: 6px; }
  .delivery-box {
    width: 100%;
    display: flex;
    gap: 16px;
    padding: 20px;
    background: #f6f3ed;
    border: 1px solid #ddd8ce;
    border-radius: 6px;
    margin-bottom: 24px;
    text-align: left;
  }
  .delivery-icon {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #725b29;
    font-size: 20px;
    flex-shrink: 0;
  }
  .delivery-content h3 { font-size: 15px; font-weight: 700; margin-bottom: 4px; }
  .delivery-date { font-size: 16px; font-weight: 600; color: #725b29; margin-bottom: 4px; }
  .delivery-note { font-size: 12px; color: #777; line-height: 1.4; }
