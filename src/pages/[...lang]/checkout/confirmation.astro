    width: 100%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .btn-secondary {
    padding: 14px 20px;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 4px;
    text-align: center;
    background: transparent;
    color: #111;
    border: 1px solid #111;
  }

  @media (max-width: 640px) {
    .info-grid, .action-buttons { grid-template-columns: 1fr; }
  }
</style>

<script is:inline define:vars={{ initialStatus: status }}>
  function createConfetti() {
    const container = document.getElementById('confetti-container');
    if (!container) return;
    container.innerHTML = '';
    const colors = ['#ef4444', '#3b82f6', '#22c55e', '#eab308', '#8b5cf6', '#f97316', '#fd79a8', '#fdcb6e'];

    for (let i = 0; i < 80; i++) {
      const confetti = document.createElement('div');
      confetti.className = 'confetti-piece';
      confetti.style.left = (Math.random() * 100) + 'vw';
      confetti.style.top = (-20 - Math.random() * 30) + 'px';
      confetti.style.width = (Math.random() * 6 + 6) + 'px';
      confetti.style.height = (Math.random() * 10 + 12) + 'px';
      confetti.style.borderRadius = '2px';
      confetti.style.backgroundColor = colors[i % colors.length];
      const duration = 2.5 + Math.random() * 2.5;
      const delay = Math.random() * 1.5;
      confetti.style.animation = `confetti-fall ${duration}s ${delay}s linear forwards`;
      container.appendChild(confetti);
    }
    setTimeout(() => { container.innerHTML = ''; }, 6000);
  }

  // 仅在明确是支付中且未确认状态时轮询，取消或报错状态不轮询
  function pollOrderStatusSafely() {
    const urlParams = new URLSearchParams(window.location.search);
    const orderId = urlParams.get('order_id') || urlParams.get('orderId');
    const orderKey = urlParams.get('order_key') || urlParams.get('orderKey');
    const urlStatus = urlParams.get('status');

    // 如果用户明确取消或出错，或者订单已经处理完成，不进行轮询
    if (urlStatus === 'cancelled' || urlStatus === 'error' || initialStatus === 'processing' || initialStatus === 'completed') {
      if (initialStatus === 'processing' || initialStatus === 'completed') {
        createConfetti();
      }
      return;
    }

    if (!orderId || !orderKey) return;

    let attempts = 0;
    const maxAttempts = 6;

    const timer = setInterval(async () => {
      attempts++;
      try {
        const res = await fetch(`/api/woocommerce/check-order?orderId=${orderId}&orderKey=${orderKey}&_t=${Date.now()}`);
        if (res.ok) {
          const data = await res.json();
          if (data.status === 'processing' || data.status === 'completed') {
            clearInterval(timer);

            const iconBox = document.getElementById('statusIconBox');
            if (iconBox) iconBox.innerHTML = '<div class="success-circle"><i class="fa-solid fa-check"></i></div>';

            const textBox = document.getElementById('statusTextBox');
            if (textBox) textBox.innerHTML = '<h1>Order Confirmed!</h1><p class="subtitle">Thank you for your purchase</p>';

            const paymentBox = document.getElementById('paymentStatusBox');
            if (paymentBox) paymentBox.innerHTML = '<p class="success-text"><i class="fa-solid fa-circle-check"></i> Payment Completed</p>';

            createConfetti();
            return;
          }
        }
      } catch (e) {
        // 轮询异常
      }

      if (attempts >= maxAttempts) {
        clearInterval(timer);
      }
    }, 2000);
  }

  function clearCacheAndNavigate(event, url) {
    event.preventDefault();
    try {
      sessionStorage.removeItem('shippingInfo');
      sessionStorage.removeItem('userEmailStatus');
      sessionStorage.removeItem('paymentStatus');
    } catch(e) {}
    window.location.href = url === '/shop' ? '/shop?refresh=1' : url;
  }

  function checkIfLoggedIn() {
    const user = localStorage.getItem('user');
    const hasCookies = document.cookie.includes('user_id=') || document.cookie.includes('session_token=');
    return !!(user || hasCookies);
  }

  async function initOrderCompletion() {
    const viewOrderBtn = document.getElementById('viewOrderBtn');
    const viewOrderBtnText = document.getElementById('viewOrderBtnText');
    if (!viewOrderBtn || !viewOrderBtnText) return;

    const isLoggedIn = checkIfLoggedIn();
    const emailStatusStr = sessionStorage.getItem('userEmailStatus');
    const shippingInfoStr = sessionStorage.getItem('shippingInfo');

    let userEmail = '';
    let isRegistered = false;

    if (emailStatusStr) {
      try {
        const parsed = JSON.parse(emailStatusStr);
        userEmail = parsed.email;
        isRegistered = parsed.isRegistered;
      } catch(e) {}
    } else if (shippingInfoStr) {
      try {
        const parsed = JSON.parse(shippingInfoStr);
        userEmail = parsed.email;
      } catch(e) {}
    }

    // 1. 已登录用户：直接显示 VIEW ORDER 前往账户中心查看
    if (isLoggedIn) {
      viewOrderBtnText.textContent = 'View Order';
      viewOrderBtn.style.display = 'inline-flex';
      viewOrderBtn.onclick = () => { window.location.href = '/account?tab=orders'; };
      return;
    }

    // 2. 未注册新用户：自动注册并在成功后显示 VIEW ORDER
    if (!isRegistered && userEmail) {
      const regSuccess = await handleAutoRegister(userEmail);
      if (regSuccess) {
        viewOrderBtnText.textContent = 'View Order';
        viewOrderBtn.style.display = 'inline-flex';
        viewOrderBtn.onclick = () => { window.location.href = '/account?tab=orders'; };
        return;
      }
    }

    // 3. 已有账号但未登录用户：引导登录
    viewOrderBtnText.textContent = 'Login to View Order';
    viewOrderBtn.style.display = 'inline-flex';
    viewOrderBtn.onclick = () => {
      if (typeof window.openAuthModal === 'function') {
        window.openAuthModal('login');
        setTimeout(() => {
          const emailInput = document.getElementById('loginEmail');
          if (emailInput && userEmail) emailInput.value = userEmail;
        }, 100);
      }
    };
  }

  async function handleAutoRegister(email) {
    try {
      const shippingInfoStr = sessionStorage.getItem('shippingInfo');
      const shippingInfo = shippingInfoStr ? JSON.parse(shippingInfoStr) : {};

      const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnpqrstuvwxyz23456789';
      let tempPassword = '';
      for (let i = 0; i < 12; i++) tempPassword += chars.charAt(Math.floor(Math.random() * chars.length));

      const res = await fetch('/api/auth/register', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          email: email,
          firstName: shippingInfo.firstName || 'Customer',
          lastName: shippingInfo.lastName || '',
          password: tempPassword
        })
      });

      const data = await res.json();
      if (data.success && data.user) {
        localStorage.setItem('user', JSON.stringify(data.user));

        const urlParams = new URLSearchParams(window.location.search);
        const orderId = urlParams.get('order_id') || urlParams.get('orderId');
        if (orderId && data.user.id) {
          fetch('/api/orders/update-customer', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ orderId: orderId, customerId: data.user.id })
          }).catch(() => {});
        }

        sessionStorage.removeItem('shippingInfo');
        sessionStorage.removeItem('userEmailStatus');
        return true;
      }
      return false;
    } catch (e) {
      // 自动注册异常
      return false;
    }
  }

  if (typeof window !== 'undefined') {
    window.isConfirmationPage = true;
    initOrderCompletion();
    pollOrderStatusSafely();

    window.addEventListener('userLoggedIn', function(e) {
      const viewOrderBtn = document.getElementById('viewOrderBtn');
      const viewOrderBtnText = document.getElementById('viewOrderBtnText');
      if (viewOrderBtn && viewOrderBtnText) {
        viewOrderBtnText.textContent = 'View Order';
        viewOrderBtn.style.display = 'inline-flex';
        viewOrderBtn.onclick = () => { window.location.href = '/account?tab=orders'; };
      }
      e.preventDefault && e.preventDefault();
    });
  }
</script>