---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CartDrawer from '../../components/CartDrawer.astro';
import ProductSkeleton from '../../components/ProductSkeleton.astro';
import { SUPPORTED_LOCALES, type SupportedLocale } from '../../lib/i18n/utils';
import { t } from '../../lib/i18n/translations';
import { translateProducts } from '../../lib/i18n/product-translator';
import { getProductsWithPrices } from '../../lib/productCache';

// 1. 获取语言参数
const lang = Astro.params.lang as SupportedLocale | undefined;
const currentLocale: SupportedLocale = lang && SUPPORTED_LOCALES.includes(lang as SupportedLocale)
  ? (lang as SupportedLocale)
  : 'en';

const perPage = 20;

// 2. 服务端直接获取第 1 页的产品数据（解决客户端等待 14 秒空白问题）
const pageParam = Astro.url.searchParams.get('page');
const initialPage = pageParam ? parseInt(pageParam) : 1;
const categoryParam = Astro.url.searchParams.get('category') || undefined;
const searchParam = Astro.url.searchParams.get('q') || undefined;

let initialRawProducts: any[] = [];
try {
  initialRawProducts = await getProductsWithPrices({
    page: initialPage,
    per_page: perPage,
    category: categoryParam,
    search: searchParam
  });
} catch (e) {
  console.error('[Shop SSR] 获取初始产品失败:', e);
}

// 3. 服务端直接完成首屏翻译（走 Cloudflare Workers AI + KV 缓存，毫秒级直出）
let initialProducts = initialRawProducts;
if (currentLocale !== 'en' && initialRawProducts.length > 0) {
  try {
    initialProducts = await translateProducts(initialRawProducts, currentLocale, Astro.locals);
  } catch (err) {
    console.warn('[Shop SSR] 首屏翻译异常，降级显示英文:', err);
    initialProducts = initialRawProducts;
  }
}

if (Astro.response) {
  Astro.response.headers.set('Cache-Control', 'no-store, no-cache, must-revalidate');
}
---

<Layout title="Shop - E.B.Belle">
  <Header />

  <!-- BREADCRUMB -->
  <div class="breadcrumb-section">
    <div class="container">
      <div class="breadcrumb-content">
        <div class="breadcrumb-wrapper">
          <div class="breadcrumb">
            <a href="/">Home</a>
            <span>/</span>
            <span>Shop</span>
          </div>
        </div>
        <div class="mobile-results-count">(<span id="total-products">{initialProducts.length}</span>)</div>
      </div>
    </div>
  </div>

  <!-- Mobile Filter Bar -->
  <div class="mobile-filter-bar">
    <button class="filter-main-btn" id="mobileFilterBtn" type="button">
      <i class="fa-solid fa-sliders"></i>
      <span>{t(currentLocale, 'shop.filters')}</span>
      <span class="filter-count" id="mobileFilterCount">0</span>
    </button>
    <button class="filter-tag-btn active" type="button">Best Match</button>
    <button class="filter-tag-btn" type="button">316L Steel</button>
    <button class="filter-tag-btn" type="button">$925 Silver</button>
    <button class="filter-tag-btn" type="button">Waterproof</button>
  </div>

  <!-- Mobile Filter Drawer -->
  <div class="mobile-filter-drawer-overlay" id="mobileFilterOverlay"></div>
  <div class="mobile-filter-drawer" id="mobileFilterDrawer">
    <div class="mobile-filter-header">
      <h3>{t(currentLocale, 'shop.filters')}</h3>
      <button class="mobile-filter-close" id="mobileFilterClose" type="button">
        <i class="fa-solid fa-times"></i>
      </button>
    </div>
    <div class="mobile-filter-content" id="mobileFilterContent"></div>
    <div class="mobile-filter-footer">
      <button class="mobile-filter-reset" id="mobileFilterReset" type="button">
        <i class="fa-solid fa-rotate-right"></i>
        {t(currentLocale, 'shop.clearFilters')}
      </button>
      <button class="mobile-filter-apply" id="mobileFilterApply" type="button">
        {t(currentLocale, 'shop.applyFilters')}
      </button>
    </div>
  </div>

  <!-- Quick Order Modal (桌面端) -->
  <div class="quick-order-overlay" id="quickOrderOverlay"></div>
  <div class="quick-order-modal" id="quickOrderModal">
    <button class="quick-order-close" id="quickOrderClose" type="button">
      <i class="fa-solid fa-times"></i>
    </button>
    <div class="quick-order-content" id="quickOrderContent"></div>
  </div>

  <!-- Quick Order Mobile Sheet (移动端) -->
  <div class="quick-order-mobile-overlay" id="quickOrderMobileOverlay"></div>
  <div class="quick-order-mobile-sheet" id="quickOrderMobileSheet">
    <div class="mobile-sheet-header" id="mobileSheetHeader">
      <button class="mobile-sheet-close" id="quickOrderMobileClose" type="button">
        <i class="fa-solid fa-times"></i>
      </button>
    </div>
    <div class="mobile-sheet-content" id="quickOrderMobileContent"></div>
  </div>

  <!-- Mobile Sort & Layout Control -->
  <div class="mobile-control-bar">
    <button class="sort-btn" id="mobileSortBtn" type="button">
      <span>{t(currentLocale, 'shop.sortBy')}</span>
      <i class="fa-solid fa-chevron-down"></i>
    </button>
    <div class="layout-toggle">
      <button class="layout-btn active" data-layout="grid" type="button">
        <i class="fa-solid fa-grip"></i>
      </button>
      <button class="layout-btn" data-layout="list" type="button">
        <i class="fa-solid fa-bars"></i>
      </button>
    </div>
  </div>

  <!-- Sort Dropdown -->
  <div class="mobile-sort-dropdown" id="mobileSortDropdown">
    <button class="sort-option active" data-sort="menu_order" type="button">{t(currentLocale, 'shop.sortFeatured')}</button>
    <button class="sort-option" data-sort="popularity" type="button">{t(currentLocale, 'shop.sortPopular')}</button>
    <button class="sort-option" data-sort="rating" type="button">Sort by average rating</button>
    <button class="sort-option" data-sort="date" type="button">{t(currentLocale, 'shop.sortNewest')}</button>
    <button class="sort-option" data-sort="price" type="button">{t(currentLocale, 'shop.sortPriceAsc')}</button>
    <button class="sort-option" data-sort="price-desc" type="button">{t(currentLocale, 'shop.sortPriceDesc')}</button>
  </div>

  <!-- Mobile Products Grid -->
  <div class="mobile-products-container">
    <div class="mobile-products-grid" id="products-grid-mobile">
      {initialProducts.length > 0 ? (
        initialProducts.map((product) => {
          const hasDiscount = product.regular_price && product.price && parseFloat(product.regular_price) > parseFloat(product.price);
          const discountPercent = hasDiscount
            ? Math.round(((parseFloat(product.regular_price) - parseFloat(product.price)) / parseFloat(product.regular_price)) * 100)
            : 0;
          const imageUrl = product.images?.[0]?.src || 'https://images.unsplash.com/photo-1515562141207-7a88fb7ce338?w=400&q=80';
          return (
            <div class="mobile-product-card">
              <a href={currentLocale === 'en' ? `/product/${product.slug}` : `/${currentLocale}/product/${product.slug}`}>
                <div class="mobile-product-image">
                  {hasDiscount && <span class="mobile-badge new">-{discountPercent}%</span>}
                  <button class="mobile-wishlist-btn" onclick="event.preventDefault();" type="button">
                    <i class="fa-regular fa-heart"></i>
                  </button>
                  <img src={imageUrl} alt={product.name} loading="lazy" />
                </div>
                <div class="mobile-product-info">
                  <h3 class="mobile-product-title">{product.name}</h3>
                  <div class="mobile-product-price">
                    <span class="mobile-price">${parseFloat(product.price).toFixed(2)}</span>
                    {hasDiscount && <span class="mobile-old-price">${parseFloat(product.regular_price).toFixed(2)}</span>}
                  </div>
                  <div class="mobile-product-meta">
                    <span class="mobile-moq">MOQ: 1 pc</span>
                    <span class="mobile-material">316L Steel</span>
                  </div>
                  <button class="mobile-add-btn" data-product={JSON.stringify(product)} type="button">
                    <i class="fa-solid fa-cart-shopping"></i>
                    <span>Add</span>
                  </button>
                </div>
              </a>
            </div>
          );
        })
      ) : (
        <ProductSkeleton count={20} />
      )}
    </div>

    <!-- Mobile Pagination -->
    <div class="mobile-pagination" id="pagination-mobile">
      <button class="mobile-page-btn page-prev" data-page="prev" disabled type="button">
        <i class="fa-solid fa-chevron-left"></i>
      </button>
      <button class="mobile-page-btn active" data-page="1" type="button">1</button>
      <button class="mobile-page-btn page-next" data-page="next" type="button">
        <i class="fa-solid fa-chevron-right"></i>
      </button>
    </div>
  </div>

  <!-- SHOP MAIN CONTENT -->
  <div class="shop-container">
    <div class="container">
      <div class="shop-layout">
        <aside class="shop-sidebar">
          <div id="filters-container">
            <div class="filters-loading">
              <div class="loading-skeleton"></div>
              <div class="loading-skeleton"></div>
              <div class="loading-skeleton"></div>
            </div>
          </div>
        </aside>

        <main class="shop-main">
          <div class="sorting-bar">
            <div class="sort-left">
              <span class="sort-label">{t(currentLocale, 'shop.sortBy')}:</span>
              <button class="sort-btn active" data-sort="menu_order" type="button">{t(currentLocale, 'shop.sortFeatured')}</button>
              <button class="sort-btn" data-sort="popularity" type="button">{t(currentLocale, 'shop.sortPopular')}</button>
              <button class="sort-btn" data-sort="rating" type="button">Sort by average rating</button>
              <button class="sort-btn" data-sort="date" type="button">{t(currentLocale, 'shop.sortNewest')}</button>
              <button class="sort-btn" data-sort="price" type="button">{t(currentLocale, 'shop.sortPriceAsc')}</button>
              <button class="sort-btn" data-sort="price-desc" type="button">{t(currentLocale, 'shop.sortPriceDesc')}</button>
            </div>
            <div class="sort-right">
              <span class="products-count"><span id="products-count-desktop">{initialProducts.length}</span> {t(currentLocale, 'shop.products')}</span>
            </div>
          </div>

          <!-- Product Grid: 服务端直出初始多语言商品 -->
          <div class="products-grid" id="products-grid-desktop">
            {initialProducts.length > 0 ? (
              initialProducts.map((product) => {
                const hasDiscount = product.regular_price && product.price && parseFloat(product.regular_price) > parseFloat(product.price);
                const discountPercent = hasDiscount
                  ? Math.round(((parseFloat(product.regular_price) - parseFloat(product.price)) / parseFloat(product.regular_price)) * 100)
                  : 0;
                const imageUrl = product.images?.[0]?.src || 'https://images.unsplash.com/photo-1515562141207-7a88fb7ce338?w=400&q=80';
                return (
                  <div class="product-card-shop">
                    <a href={currentLocale === 'en' ? `/product/${product.slug}` : `/${currentLocale}/product/${product.slug}`}>
                      <div class="product-image-wrapper">
                        {hasDiscount && <span class="product-badge new">-{discountPercent}%</span>}
                        <button class="wishlist-btn" onclick="event.preventDefault();" type="button">
                          <i class="fa-regular fa-heart"></i>
                        </button>
                        <img src={imageUrl} alt={product.name} loading="lazy" />
                      </div>
                      <div class="product-details-shop">
                        <h3 class="product-title-shop">{product.name}</h3>
                        <div class="product-price-shop">
                          <span class="price-current">${parseFloat(product.price).toFixed(2)}</span>
                          {hasDiscount && <span class="price-old">${parseFloat(product.regular_price).toFixed(2)}</span>}
                        </div>
                        <div class="product-meta">
                          <span class="moq">MOQ: 1 pc</span>
                          <span class="material">316L Steel</span>
                        </div>
                        <button class="add-to-cart-btn" data-product={JSON.stringify(product)} type="button">
                          <i class="fa-solid fa-cart-shopping"></i>
                          <span>Add</span>
                        </button>
                      </div>
                    </a>
                  </div>
                );
              })
            ) : (
              <ProductSkeleton count={20} />
            )}
          </div>

          <!-- Pagination -->
          <div class="pagination" id="pagination-desktop">
            <button class="page-btn page-prev" data-page="prev" disabled type="button">
              <i class="fa-solid fa-chevron-left"></i>
            </button>
            <button class="page-btn active" data-page="1" type="button">1</button>
            <button class="page-btn page-next" data-page="next" type="button">
              <i class="fa-solid fa-chevron-right"></i>
            </button>
          </div>
        </main>
      </div>
    </div>
  </div>

  <Footer />
  <CartDrawer />
</Layout>

<style is:global>
  * { box-sizing: border-box; }
  body { overflow-x: hidden; }

  @media (max-width: 820px) {
    :root { --container-w: 100%; }
    .container { padding: 0 10px; }
    .breadcrumb-content { width: 100%; max-width: 100%; box-sizing: border-box; }
    .mobile-results-count { display: block !important; width: 30%; max-width: 30%; }
    .breadcrumb-wrapper { width: 65%; max-width: 65%; }
  }

  .mobile-filter-bar {
    display: none;
    background: #f9f9f9;
    padding: 8px 16px 10px;
    gap: 8px;
    overflow-x: auto;
    scrollbar-width: none;
    align-items: center;
  }
  .mobile-filter-bar::-webkit-scrollbar { display: none; }

  .filter-main-btn {
    display: inline-flex !important;
    align-items: center !important;
    gap: 6px !important;
    background: #B8860B !important;
    color: #ffffff !important;
    border: none !important;
    border-radius: 18px !important;
    padding: 7px 14px !important;
    font-size: 11.5px !important;
    font-weight: 700 !important;
    white-space: nowrap !important;
    cursor: pointer !important;
    flex-shrink: 0 !important;
    box-shadow: 0 2px 6px rgba(184, 134, 11, 0.25) !important;
    transition: all 0.2s ease !important;
  }
  .filter-main-btn:active { transform: scale(0.96) !important; }
  .filter-main-btn i { font-size: 11px !important; }
  .filter-count {
    background: rgba(255, 255, 255, 0.28) !important;
    border-radius: 10px !important;
    padding: 1px 6px !important;
    font-size: 10.5px !important;
    font-weight: 700 !important;
    line-height: 1.2 !important;
  }

  .filter-tag-btn {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    background: #ffffff !important;
    color: #555555 !important;
    border: 1px solid #ddd8ce !important;
    border-radius: 18px !important;
    padding: 6px 14px !important;
    font-size: 11.5px !important;
    font-weight: 600 !important;
    white-space: nowrap !important;
    cursor: pointer !important;
    flex-shrink: 0 !important;
    transition: all 0.2s ease !important;
  }
  .filter-tag-btn.active {
    background: #F7F4EE !important;
    border-color: #B8860B !important;
    color: #B8860B !important;
    font-weight: 700 !important;
  }
  .filter-tag-btn:active { transform: scale(0.96) !important; }

  .mobile-filter-drawer-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5);
    z-index: 997;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s, visibility 0.3s;
  }
  .mobile-filter-drawer-overlay.active { opacity: 1; visibility: visible; }

  .mobile-filter-drawer {
    position: fixed;
    top: 0;
    right: 0;
    width: 85%;
    max-width: 400px;
    height: 100%;
    background: #fff;
    z-index: 998;
    transform: translateX(100%);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    flex-direction: column;
  }
  .mobile-filter-drawer.active { transform: translateX(0); }

  .mobile-filter-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 18px 20px;
    border-bottom: 1px solid #e5e5e5;
  }
  .mobile-filter-header h3 { font-size: 17px; font-weight: 700; margin: 0; color: #1a1a1a; }
  .mobile-filter-close {
    background: none;
    border: none;
    font-size: 22px;
    color: #666;
    cursor: pointer;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .mobile-filter-content {
    flex: 1;
    overflow-y: auto;
    padding: 18px 20px;
  }
  .mobile-filter-footer {
    display: flex;
    gap: 12px;
    padding: 14px 20px;
    border-top: 1px solid #e5e5e5;
    background: #fff;
  }
  .mobile-filter-reset {
    flex: 0 0 auto;
    padding: 12px 20px;
    background: #fff;
    border: 1px solid #ddd;
    border-radius: 4px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .mobile-filter-apply {
    flex: 1;
    padding: 12px 20px;
    background: #1a1a1a;
    color: #fff;
    border: none;
    border-radius: 4px;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
  }

  /* Quick Order Modal */
  .quick-order-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.6);
    z-index: 1001;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s, visibility 0.3s;
  }
  .quick-order-overlay.active { opacity: 1; visibility: visible; }

  .quick-order-modal {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scale(0.9);
    width: 90%;
    max-width: 1100px;
    max-height: 85vh;
    background: #fff;
    border-radius: 8px;
    z-index: 1002;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s;
    overflow: hidden;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
  }
  .quick-order-modal.active { opacity: 1; visibility: visible; transform: translate(-50%, -50%) scale(1); }

  .quick-order-close {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 36px;
    height: 36px;
    background: rgba(255, 255, 255, 0.9);
    border: 1px solid #e0dad0;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    color: #333;
    z-index: 10;
  }

  .quick-order-content {
    display: grid;
    grid-template-columns: 45% 55%;
    height: 85vh;
    overflow: hidden;
  }
  .quick-order-images {
    background: #fbf9f5;
    padding: 30px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    overflow-y: auto;
    border-right: 1px solid #ede8de;
  }
  .quick-order-main-image {
    width: 100%;
    aspect-ratio: 1;
    border-radius: 4px;
    overflow: hidden;
    background: #fff;
    border: 1px solid #ddd8ce;
  }
  .quick-order-main-image img { width: 100%; height: 100%; object-fit: cover; }
  .quick-order-thumbnails {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 8px;
  }
  .quick-order-thumb {
    aspect-ratio: 1;
    border-radius: 3px;
    overflow: hidden;
    cursor: pointer;
    border: 1.5px solid #ddd8ce;
    background: #fff;
  }
  .quick-order-thumb.active { border-color: #0e0f0f; }
  .quick-order-thumb img { width: 100%; height: 100%; object-fit: cover; }

  .quick-order-details {
    padding: 30px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .quick-order-title {
    font-size: 20px;
    font-family: 'Cinzel', serif;
    font-weight: 600;
    color: #1a1a1a;
    line-height: 1.3;
    margin: 0;
  }
  .quick-order-price {
    font-size: 26px;
    font-family: 'Cinzel', serif;
    font-weight: 700;
    color: #0e0f0f;
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .quick-order-price-current { font-size: 26px; color: #0e0f0f; }
  .quick-order-price-regular { font-size: 16px; color: #8c8c8c; text-decoration: line-through; }
  .quick-order-stock {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-weight: 600;
    color: #16a34a;
  }
  .quick-order-stock.out-of-stock { color: #dc2626; }
  .quick-order-stock-placeholder { font-size: 12px; color: #888; }

  .quick-order-wholesale {
    background: #fbf9f5;
    border: 1px solid #e2ddd3;
    border-radius: 4px;
    padding: 12px 14px;
  }
  .quick-order-wholesale .table-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
  }
  .quick-order-wholesale .header-left {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    color: #0e0f0f;
  }
  .quick-order-wholesale .pricing-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 6px;
  }
  .quick-order-wholesale .price-tier {
    background: #fff;
    border: 1px solid #e0dad0;
    border-radius: 3px;
    padding: 6px 4px;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .quick-order-wholesale .price-tier.best { background: #fdf6e9; border-color: #d1a85f; }
  .quick-order-wholesale .tier-qty { font-size: 9.5px; color: #666; }
  .quick-order-wholesale .tier-price { font-size: 13.5px; font-weight: 700; color: #0e0f0f; }

  .quick-gift-carousel {
    background: #fbf9f5;
    border: 1px solid #e2ddd3;
    border-radius: 4px;
    padding: 8px 10px;
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
  }
  .quick-gift-viewport { flex: 1; overflow: hidden; }
  .quick-gift-track { display: flex; transition: transform 0.4s ease; width: 100%; }
  .quick-gift-slide { flex: 0 0 100%; width: 100%; display: flex; align-items: center; gap: 8px; }
  .quick-gift-img { width: 38px; height: 38px; border-radius: 3px; border: 1px solid #ddd8ce; object-fit: cover; }
  .quick-gift-info { flex: 1; min-width: 0; }
