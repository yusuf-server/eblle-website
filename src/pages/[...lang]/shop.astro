<script>
  // 保持客户端后续的筛选、排序、QuickOrder 等原有功能稳定运行
  const SUPPORTED_LOCALES = ['en', 'fr', 'de', 'es'];

  function getCurrentLocale() {
    const pathname = window.location.pathname;
    for (const locale of SUPPORTED_LOCALES) {
      if (pathname.startsWith(`/${locale}/`) || pathname === `/${locale}`) {
        return locale;
      }
    }
    return 'en';
  }

  function addLocalePrefix(url) {
    const currentLocale = getCurrentLocale();
    if (currentLocale === 'en') return url;
    let cleanUrl = url;
    for (const loc of SUPPORTED_LOCALES) {
      if (cleanUrl.startsWith(`/${loc}/`)) {
        cleanUrl = cleanUrl.substring(loc.length + 1);
        break;
      }
    }
    return `/${currentLocale}${cleanUrl}`;
  }

  function formatPrice(priceUSD) {
    const currency = localStorage.getItem('ebbelle_currency') || 'USD';
    const rateMap = { USD: 1.0, EUR: 0.92, GBP: 0.79, CAD: 1.36 };
    const symbolMap = { USD: '$', EUR: '€', GBP: '£', CAD: 'C$' };
    const rate = rateMap[currency] || 1.0;
    const symbol = symbolMap[currency] || '$';
    const converted = (priceUSD * rate).toFixed(2);
    return currency === 'EUR' ? `${converted}${symbol}` : `${symbol}${converted}`;
  }

  // 绑定客户端快速加购事件
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.add-to-cart-btn, .mobile-add-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        try {
          const product = JSON.parse(btn.dataset.product);
          if (typeof window.openQuickOrderWithData === 'function') {
            window.openQuickOrderWithData(product);
          }
        } catch (err) {}
      });
    });
  });
</script>