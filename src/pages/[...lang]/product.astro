---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CartDrawer from '../../components/CartDrawer.astro';
import { SUPPORTED_LOCALES, type SupportedLocale } from '../../lib/i18n/utils';
import { t } from '../../lib/i18n/translations';
import { translate } from '../../lib/i18n/translator';
import { getCacheFromContext } from '../../lib/i18n/cache';

// 1. 获取语言参数
const lang = Astro.params.lang as SupportedLocale | undefined;
const currentLocale: SupportedLocale = lang && SUPPORTED_LOCALES.includes(lang as SupportedLocale)
  ? (lang as SupportedLocale)
  : 'en';

// 2. 缓存和上下文配置
const cache = getCacheFromContext(Astro.locals);
const translateConfig = {
  engine: 'cloudflare-ai' as const,
  cache,
  cachePrefix: 'product-sitemap'
};
const context = {
  AI: Astro.locals.AI
};

// 3. 动态翻译辅助函数
async function tr(text: string): Promise<string> {
  if (currentLocale === 'en' || !text) return text;
  return await translate(text, currentLocale, translateConfig, context);
}

// 4. 目标展示的 6 大核心分类
const TARGET_CATEGORIES = [
  { name: 'RING', slug: 'ring' },
  { name: 'NECKLACE', slug: 'necklace' },
  { name: 'EARRING', slug: 'earring' },
  { name: 'BRACELET', slug: 'bracelet' },
  { name: 'EAR CLIP', slug: 'ear-clip' },
  { name: 'HAIR CLIP', slug: 'hair-clip' }
];

// 5. 环境变量与授权
const storeUrl = (import.meta.env.WC_STORE_URL || 'https://api.ebbellejewelry.com').replace(/\/$/, '');
const consumerKey = import.meta.env.WC_CONSUMER_KEY || '';
const consumerSecret = import.meta.env.WC_CONSUMER_SECRET || '';

// 6. 边缘安全的内存与本地隔离缓存
let categoriesData: Array<{ category: string; slug: string; items: Array<{ name: string; slug: string }> }> = [];

// 仅在本地开发环境动态加载 fs，生产 Worker 打包时彻底规避 node:fs 依赖
if (import.meta.env.DEV) {
  try {
    const fs = await import('node:fs');
    const path = await import('node:path');
    const cacheFile = path.resolve('.cache', 'targeted-products-cache.json');
    if (fs.existsSync(cacheFile)) {
      categoriesData = JSON.parse(fs.readFileSync(cacheFile, 'utf-8'));
    }
  } catch (e) {
    // 忽略开发环境文件读取异常
  }
}

// 若无缓存，启动低负载单分类请求（避免打爆 SiteGround CPU）
if (!categoriesData || categoriesData.length === 0) {
  const authHeader = 'Basic ' + (typeof btoa !== 'undefined'
    ? btoa(`${consumerKey}:${consumerSecret}`)
    : Buffer.from(`${consumerKey}:${consumerSecret}`).toString('base64'));

  // 1) 先查分类 ID 映射
  let categoryIdMap = new Map<string, number>();
  try {
    const catRes = await fetch(`${storeUrl}/wp-json/wc/v3/products/categories?per_page=100&_fields=id,slug`, {
      headers: {
        'Authorization': authHeader,
        'Content-Type': 'application/json'
      }
    });
    if (catRes.ok) {
      const cats = await catRes.json();
      if (Array.isArray(cats)) {
        cats.forEach((c: any) => categoryIdMap.set(c.slug.toLowerCase(), c.id));
      }
    }
  } catch (e) {
    console.warn('Failed to fetch category mapping:', e);
  }

  // 2) 逐个分类精准抓取（串行节流）
  for (const target of TARGET_CATEGORIES) {
    const catId = categoryIdMap.get(target.slug.toLowerCase());
    let items: Array<{ name: string; slug: string }> = [];

    if (catId) {
      try {
        const prodRes = await fetch(
          `${storeUrl}/wp-json/wc/v3/products?category=${catId}&per_page=100&status=publish&_fields=name,slug`,
          {
            headers: {
              'Authorization': authHeader,
              'Content-Type': 'application/json'
            }
          }
        );

        if (prodRes.ok) {
          const prods = await prodRes.json();
          if (Array.isArray(prods)) {
            items = prods.map((p: any) => ({ name: p.name, slug: p.slug }));
          }
        }
      } catch (err) {
        console.warn(`Error fetching category ${target.name}:`, err);
      }
    }

    categoriesData.push({
      category: target.name,
      slug: target.slug,
      items
    });

    // 每次间隔 50ms 避免并发突刺
    await new Promise((resolve) => setTimeout(resolve, 50));
  }

  // 开发环境下写入磁盘缓存
  if (import.meta.env.DEV) {
    try {
      const fs = await import('node:fs');
      const path = await import('node:path');
      const cacheDir = path.resolve('.cache');
      if (!fs.existsSync(cacheDir)) fs.mkdirSync(cacheDir, { recursive: true });
      fs.writeFileSync(path.join(cacheDir, 'targeted-products-cache.json'), JSON.stringify(categoriesData));
    } catch (e) {}
  }
}

// 7. 标题国际化
const pageTitle = await tr('PRODUCT SITEMAP');
const subtitle = await tr('Explore our curated collections of handcrafted fine jewelry.');

const categories = await Promise.all(
  categoriesData.map(async (group) => ({
    ...group,
    categoryName: await tr(group.category)
  }))
);
---