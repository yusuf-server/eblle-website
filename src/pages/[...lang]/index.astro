                      <source src={post.media_url} type="video/mp4" />
                    </video>
                    <span class="instagram-play-icon"><i class="fa-solid fa-play"></i></span>
                  </>
                ) : (
                  <img src={post.media_url} alt={post.caption.substring(0, 50)} loading="lazy" />
                )}
                <a href={post.permalink} target="_blank" rel="noopener noreferrer" class="mobile-instagram-link-icon" aria-label="View on Instagram">
                  <i class="fa-brands fa-instagram"></i>
                </a>
              </div>
              <p class="instagram-caption">
                <strong>e.b.belle</strong> {post.caption}
              </p>
            </div>
          ))
        ) : (
          <div class="instagram-post">
            <div class="instagram-image">
              <img src="https://images.unsplash.com/photo-1611591475806-03c09b0b4b2c?w=400&q=80" alt="" />
              <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="mobile-instagram-link-icon" aria-label="View on Instagram">
                <i class="fa-brands fa-instagram"></i>
              </a>
            </div>
            <p class="instagram-caption"><strong>e.b.belle</strong> Bright pops of color for your everyday look 🌈</p>
          </div>
        )}
      </div>
    </section>

    <div class="mobile-divider"></div>

    <!-- Mobile FAQ Section -->
    <section class="mobile-faq">
      <h3 class="faq-main-title">{mobileUseSameFaqData ? faqSectionTitle : mobileFaqTitle}</h3>

      <div class="mobile-faq-gallery-grid">
        {(mobileUseSameFaqData ? galleryImages : []).length >= 4 ? (
          (mobileUseSameFaqData ? galleryImages : []).slice(0, 4).map((img: any) => (
            <div class="mobile-faq-img-cell">
              <img src={img.url || img} alt={img.alt || 'Factory'} loading="lazy" />
            </div>
          ))
        ) : (
          <>
            <div class="mobile-faq-img-cell"><img src="https://images.unsplash.com/photo-1588850561407-ed78c282e89b?w=400&q=80" alt="" /></div>
            <div class="mobile-faq-img-cell"><img src="https://images.unsplash.com/photo-1504198458649-3128b932f49e?w=400&q=80" alt="" /></div>
            <div class="mobile-faq-img-cell"><img src="https://images.unsplash.com/photo-1563245372-f21724e3856d?w=400&q=80" alt="" /></div>
            <div class="mobile-faq-img-cell"><img src="https://images.unsplash.com/photo-1579783902614-a3fb3927b675?w=400&q=80" alt="" /></div>
          </>
        )}
      </div>

      <div class="faq-list">
        {(mobileUseSameFaqData ? faqItems : []).length > 0 ? (
          (mobileUseSameFaqData ? faqItems : []).map((faq: any) => (
            <div class="faq-item">
              <div class="faq-question" onclick="this.parentElement.classList.toggle('active')">
                <span>{faq.question}</span>
                <i class="fa-solid fa-chevron-down"></i>
              </div>
              <div class="faq-answer">{faq.answer}</div>
            </div>
