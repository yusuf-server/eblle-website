  .quad-img-item {
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 4px;
    background: #f5f5f5;
  }
  .quad-img-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
