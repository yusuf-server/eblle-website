---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CartDrawer from '../../components/CartDrawer.astro';
import AuthModal from '../../components/AuthModal.astro';
import ProductSkeleton from '../../components/ProductSkeleton.astro';
import OptimizedImage from '../../components/OptimizedImage.astro';
import { getCategories } from '../../lib/woocommerce';
import { parseACFLink, parseACFImage } from '../../lib/wordpress';
import { optimizeACFImage } from '../../lib/imageOptimizer';
import { SUPPORTED_LOCALES, type SupportedLocale } from '../../lib/i18n/utils';
import { t } from '../../lib/i18n/translations';
import { getOptimizedHomepageData } from '../../lib/homepageAggregator';
import { translateObjectFields, translateObjectArray, translateTextField } from '../../lib/i18n/acf-translator';
import { env } from 'cloudflare:workers';

// 获取语言参数（可选展开参数）
const lang = Astro.params.lang as SupportedLocale | undefined;
const currentLocale: SupportedLocale = lang && SUPPORTED_LOCALES.includes(lang as SupportedLocale)
  ? (lang as SupportedLocale)
  : 'en';

// 🚀 一行代码获取完整首页数据（命中 KV 时 15ms 秒开，未命中时由 Workers AI 批量翻译并写入缓存）
const { heroData, instagramPosts } = await getOptimizedHomepageData(
  currentLocale,
  Astro.locals
);

// 解析桌面端 Hero Main 轮播数据（支持 Repeater 数组与旧版单项回退）
let desktopHeroSlides = [];
if (heroData?.hero_slides && Array.isArray(heroData.hero_slides) && heroData.hero_slides.length > 0) {
  desktopHeroSlides = heroData.hero_slides.map((s: any) => ({
    image: parseACFImage(s.image),
    title: s.title || 'Timeless Elegance',
    description: s.description || 'Discover our handcrafted collection of 316L Stainless Steel & PVD Gold jewelry.',
    buttonText: s.button_text || 'Shop Now',
    buttonLink: parseACFLink(s.button_link)
  }));
} else {
  desktopHeroSlides = [
    {
      image: parseACFImage(heroData?.main_image) || {
        url: 'https://images.unsplash.com/photo-1515562141207-7a88fb7ce338?w=1200&q=80',
        alt: 'Main Jewelry Collection',
      },
      title: heroData?.main_title || 'Timeless Elegance',
      description: heroData?.main_description || 'Discover our handcrafted collection of 316L Stainless Steel & PVD Gold jewelry.',
      buttonText: heroData?.button_text || 'Shop Now',
      buttonLink: parseACFLink(heroData?.button_link) || { url: '/shop', title: 'Shop Now', target: '' }
    },
    {
      image: {
        url: 'https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?w=1200&q=80',
        alt: 'Crafted Excellence',
      },
      title: 'Waterproof Luxury',
      description: 'Engineered with 18K Real Gold vacuum PVD plating designed for daily endurance.',
      buttonText: 'Explore Collection',
      buttonLink: { url: '/shop', title: 'Explore Collection', target: '' }
    }
  ];
}

// 解析 Mid Card 1 数据
const midCard1 = heroData ? {
  image: parseACFImage(heroData.mid1_image),
  label: heroData.mid1_label || 'Explore',
  title: heroData.mid1_title || 'New Collections',
  link: parseACFLink(heroData.mid1_link),
} : {
  image: {
    url: 'https://images.unsplash.com/photo-1539571696357-5a69c17a67c6?w=500&q=80',
    alt: 'New Collections',
  },
  label: 'Explore',
  title: 'New Collections',
  link: { url: '/shop', title: '', target: '' },
};

// 解析 Mid Card 2 数据
const midCard2 = heroData ? {
  image: parseACFImage(heroData.mid2_image),
  label: heroData.mid2_label || 'Trending',
  title: heroData.mid2_title || 'Now Collections',
  link: parseACFLink(heroData.mid2_link),
} : {
  image: {
    url: 'https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?w=500&q=80',
    alt: 'Trending',
  },
  label: 'Trending',
  title: 'Now Collections',
  link: { url: '/shop', title: '', target: '' },
};

// 解析移动端 Hero Banner 轮播数据
let mobileHeroSlides = [];
if (heroData?.mobile_hero_slides && Array.isArray(heroData.mobile_hero_slides) && heroData.mobile_hero_slides.length > 0) {
  mobileHeroSlides = heroData.mobile_hero_slides.map((s: any) => ({
    image: parseACFImage(s.image),
    subtitle: s.subtitle || 'Collection 2026',
    title: s.title || 'Timeless Elegance',
    description: s.description || '316L Stainless Steel & PVD Gold.',
    buttonText: s.button_text || 'Shop Now',
    buttonLink: parseACFLink(s.button_link)
  }));
} else {
  mobileHeroSlides = [
    {
      image: parseACFImage(heroData?.mobile_hero_image) || {
        url: 'https://images.unsplash.com/photo-1515562141207-7a88fb7ce338?w=800&q=80',
        alt: 'Hero',
      },
      subtitle: heroData?.mobile_hero_subtitle || 'Collection 2026',
      title: heroData?.mobile_hero_title || 'Timeless Elegance',
      description: heroData?.mobile_hero_description || '316L Stainless Steel & PVD Gold.',
      buttonText: heroData?.mobile_hero_button_text || 'Shop Now',
      buttonLink: parseACFLink(heroData?.mobile_hero_button_link) || { url: '/shop', title: '', target: '' }
    },
    {
      image: {
        url: 'https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?w=800&q=80',
        alt: 'Hero 2',
      },
      subtitle: 'Summer 2026',
      title: 'Waterproof Luxury',
      description: 'Hypoallergenic & Non-Tarnish.',
      buttonText: 'Discover',
      buttonLink: { url: '/shop', title: '', target: '' }
    }
  ];
}

// 解析移动端 Sub Card 1
const mobileSubCard1 = heroData ? {
  image: parseACFImage(heroData.mobile_sub1_image),
  tag: heroData.mobile_sub1_tag || 'Explore',
  title: heroData.mobile_sub1_title || 'New Collections',
  link: parseACFLink(heroData.mobile_sub1_link),
} : {
  image: {
    url: 'https://images.unsplash.com/photo-1539571696357-5a69c17a67c6?w=500&q=80',
    alt: 'New Collections',
  },
  tag: 'Explore',
  title: 'New Collections',
  link: { url: '/shop', title: '', target: '' },
};

// 解析移动端 Sub Card 2
const mobileSubCard2 = heroData ? {
  image: parseACFImage(heroData.mobile_sub2_image),
  tag: heroData.mobile_sub2_tag || 'Trending',
  title: heroData.mobile_sub2_title || 'Now Collections',
  link: parseACFLink(heroData.mobile_sub2_link),
} : {
  image: {
    url: 'https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?w=500&q=80',
    alt: 'Trending',
  },
  tag: 'Trending',
  title: 'Now Collections',
  link: { url: '/shop', title: '', target: '' },
};

// 解析 New Arrivals Section 数据
let newArrivalsTitle = heroData?.new_arrivals_title || 'NEW ARRIVALS / WATERPROOF';
let newArrivalsColumns = heroData?.new_arrivals_columns || [];
const mobileArrivalsColumns = heroData?.mobile_arrivals_columns || [];

// 解析 Campaign Section 数据
let campaignTitle = heroData?.campaign_title || 'CAMPAIGN ZONE';
let campaignCards = heroData?.campaign_cards || [];
const useSameCampaignData = heroData?.mobile_campaign_cards !== false;

// 解析 Reviews Section 数据
const reviewsTitle = heroData?.reviews_title || 'What Our Clients Say';
const reviewImages = heroData?.review_images || [];
const autoplayEnabled = heroData?.autoplay_enabled !== false;
const autoplayInterval = heroData?.autoplay_interval || 5;
const mobileUseSameImages = heroData?.mobile_use_same_images !== false;

// 解析 FAQ Gallery Section 数据
let faqSectionTitle = heroData?.faq_section_title || 'E.B.Belle: 316L Stainless Steel & PVD Plating Excellence';
const galleryImages = heroData?.gallery_images || [];
let faqItems = heroData?.faq_items || [];
let mobileFaqTitle = heroData?.mobile_faq_title || 'E.B.Belle: 316L Stainless Steel Excellence';
const mobileUseSameFaqData = heroData?.mobile_use_same_data !== false;

// ============================================================
// 翻译 ACF 字段（如果不是英语）
// ============================================================
const translationConfig = {
  cache: env?.TRANSLATION_CACHE,
  cachePrefix: 'acf',
  context: Astro.locals
};

if (currentLocale !== 'en') {
  // 翻译 Desktop Hero Slides
  for (const slide of desktopHeroSlides) {
    slide.subtitle = await translateTextField(slide.subtitle, currentLocale, translationConfig);
    slide.title = await translateTextField(slide.title, currentLocale, translationConfig);
    slide.description = await translateTextField(slide.description, currentLocale, translationConfig);
    slide.buttonText = await translateTextField(slide.buttonText, currentLocale, translationConfig);
  }

  // 翻译 Mid Cards
  midCard1.label = await translateTextField(midCard1.label, currentLocale, translationConfig);
  midCard1.title = await translateTextField(midCard1.title, currentLocale, translationConfig);
  midCard2.label = await translateTextField(midCard2.label, currentLocale, translationConfig);
  midCard2.title = await translateTextField(midCard2.title, currentLocale, translationConfig);

  // 翻译 Mobile Hero Slides
  for (const slide of mobileHeroSlides) {
    slide.subtitle = await translateTextField(slide.subtitle, currentLocale, translationConfig);
    slide.title = await translateTextField(slide.title, currentLocale, translationConfig);
    slide.description = await translateTextField(slide.description, currentLocale, translationConfig);
    slide.buttonText = await translateTextField(slide.buttonText, currentLocale, translationConfig);
  }

  // 翻译 Mobile Sub Cards
  mobileSubCard1.tag = await translateTextField(mobileSubCard1.tag, currentLocale, translationConfig);
  mobileSubCard1.title = await translateTextField(mobileSubCard1.title, currentLocale, translationConfig);
  mobileSubCard2.tag = await translateTextField(mobileSubCard2.tag, currentLocale, translationConfig);
  mobileSubCard2.title = await translateTextField(mobileSubCard2.title, currentLocale, translationConfig);

  // 翻译 New Arrivals 标题
  newArrivalsTitle = await translateTextField(newArrivalsTitle, currentLocale, translationConfig);

  // 翻译 New Arrivals Columns
  for (const column of newArrivalsColumns) {
    if (column.column_title) {
      column.column_title = await translateTextField(column.column_title, currentLocale, translationConfig);
    }
    if (column.product_groups && Array.isArray(column.product_groups)) {
      for (const group of column.product_groups) {
        if (group.group_label) {
          group.group_label = await translateTextField(group.group_label, currentLocale, translationConfig);
        }
        if (group.group_title) {
          group.group_title = await translateTextField(group.group_title, currentLocale, translationConfig);
        }
      }
    }
  }

  // 翻译 Campaign 数据
  campaignTitle = await translateTextField(campaignTitle, currentLocale, translationConfig);
  for (const card of campaignCards) {
    if (card.poster_title) {
      card.poster_title = await translateTextField(card.poster_title, currentLocale, translationConfig);
    }
    if (card.poster_subtitle) {
      card.poster_subtitle = await translateTextField(card.poster_subtitle, currentLocale, translationConfig);
    }
    if (card.button_text) {
      card.button_text = await translateTextField(card.button_text, currentLocale, translationConfig);
    }
  }

  // 翻译 FAQ
  faqSectionTitle = await translateTextField(faqSectionTitle, currentLocale, translationConfig);
  mobileFaqTitle = await translateTextField(mobileFaqTitle, currentLocale, translationConfig);
  for (const faq of faqItems) {
    if (faq.question) {
      faq.question = await translateTextField(faq.question, currentLocale, translationConfig);
    }
    if (faq.answer) {
      faq.answer = await translateTextField(faq.answer, currentLocale, translationConfig);
    }
  }
}

// 获取分类数据
const categories = await getCategories({ per_page: 10 });
---

<Layout title="E.B.Belle - Jewelry Store">
  <!-- 预加载第一张关键 Banner 图片 -->
  {desktopHeroSlides[0]?.image?.url && (
    <link rel="preload" as="image" href={desktopHeroSlides[0].image.url} slot="head" />
  )}

  <Header />

  <!-- 4. HERO SECTION -->
  <section class="hero-section">
    <div class="container">
      <div class="hero-grid">
        <!-- Main Large Banner: 轮播结构 -->
        <div class="hero-main-card hero-carousel-container" id="desktopHeroCarousel">
          <div class="carousel-track">
            {desktopHeroSlides.map((slide, index) => (
              <div class={`carousel-slide ${index === 0 ? 'is-active' : ''}`}>
                <OptimizedImage
                  src={slide.image.url || slide.image.src}
                  alt={slide.image.alt || 'Main Jewelry Collection'}
                  width={slide.image.width || 1200}
                  height={slide.image.height || 600}
                  srcset={slide.image.srcset}
                  webp={slide.image.webp}
                  priority={index === 0}
                  loading={index === 0 ? 'eager' : 'lazy'}
                  class="hero-banner-img"
                />
                <div class="hero-overlay">
                  <h2 class="serif-title">{slide.title}</h2>
                  <p>{slide.description}</p>
                  <a
                    href={slide.buttonLink.url}
                    class="btn-shop-now"
                    target={slide.buttonLink.target}
                  >
                    {slide.buttonText}
                  </a>
                </div>
              </div>
            ))}
          </div>

          <!-- 轮播 Dots 指示器 -->
          {desktopHeroSlides.length > 1 && (
            <div class="carousel-dots-wrap" id="desktopHeroDots">
              {desktopHeroSlides.map((_, i) => (
                <button type="button" class={`carousel-dot ${i === 0 ? 'active' : ''}`} data-index={i} aria-label={`Go to slide ${i + 1}`}></button>
              ))}
            </div>
          )}
        </div>

        <!-- Mid Sub Banners -->
        <div class="hero-mid-card">
          <a
            href={midCard1.link.url}
            class="mid-sub-card"
            target={midCard1.link.target}
          >
            <OptimizedImage
              src={midCard1.image.url || midCard1.image.src}
              alt={midCard1.image.alt || 'New Collections'}
              width={midCard1.image.width || 500}
              height={midCard1.image.height || 500}
              srcset={midCard1.image.srcset}
              webp={midCard1.image.webp}
              priority={true}
              loading="eager"
              class="mid-card-img"
            />
            <div class="mid-card-overlay">
              <span>{midCard1.label}</span>
              <h3>{midCard1.title}</h3>
            </div>
          </a>
          <a
            href={midCard2.link.url}
            class="mid-sub-card"
            target={midCard2.link.target}
          >
            <OptimizedImage
              src={midCard2.image.url || midCard2.image.src}
              alt={midCard2.image.alt || 'Trending Now'}
              width={midCard2.image.width || 500}
              height={midCard2.image.height || 500}
              srcset={midCard2.image.srcset}
              webp={midCard2.image.webp}
              priority={true}
              loading="eager"
              class="mid-card-img"
            />
            <div class="mid-card-overlay">
              <span>{midCard2.label}</span>
              <h3>{midCard2.title}</h3>
            </div>
          </a>
        </div>

        <!-- Right Side Login & Coupon -->
        <div class="hero-right-card">
          <!-- 未登录状态 -->
          <div class="user-auth-box" id="authBoxGuest">
            <div class="avatar-icon">
              <i class="fa-regular fa-user"></i>
            </div>
            <p>{t(currentLocale, 'home.auth.welcomeGuest')}</p>
            <div class="auth-btns">
              <button type="button" class="btn-login" onclick="openAuthModal('login')">{t(currentLocale, 'home.auth.login')}</button>
              <button type="button" class="btn-reg" onclick="openAuthModal('register')">{t(currentLocale, 'home.auth.register')}</button>
            </div>
          </div>

          <!-- 已登录状态 -->
          <div class="user-auth-box user-auth-logged-in" id="authBoxLoggedIn" style="display: none;">
            <div class="avatar-icon logged-in">
              <i class="fa-solid fa-user"></i>
            </div>
            <p class="welcome-text" id="welcomeText">{t(currentLocale, 'home.auth.welcomeBack')} <strong id="userName">User</strong></p>
            <div class="auth-btns-logged">
              <button type="button" class="btn-account" onclick="window.location.href='/account'">
                <i class="fa-solid fa-user-gear"></i>
                <span>{t(currentLocale, 'home.auth.account')}</span>
              </button>
              <button type="button" class="btn-logout" onclick="handleLogout()">
                <i class="fa-solid fa-arrow-right-from-bracket"></i>
                <span>{t(currentLocale, 'home.auth.logout')}</span>
              </button>
            </div>
          </div>

          <div class="coupon-box">
            <div class="vip-badge">VIP</div>
            <span class="badge">{t(currentLocale, 'home.coupon.badge')}</span>
            <h3>{t(currentLocale, 'home.coupon.value')}</h3>
            <span class="coupon-subtitle">{t(currentLocale, 'home.coupon.subtitle')}</span>
            <a href="#" class="btn-coupon">{t(currentLocale, 'home.coupon.button')}</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. FLASH SALES -->
  <section class="flash-sales-section">
    <div class="container">
      <div class="section-header-row">
        <div class="flash-title-area">
          <h2 class="section-title">⚡ {t(currentLocale, 'home.flashSales')}</h2>
          <div class="countdown-timer" id="desktopCountdown">
            <span class="time-block hours">00</span>
            <span class="time-separator">:</span>
            <span class="time-block minutes">07</span>
            <span class="time-separator">:</span>
            <span class="time-block seconds">21</span>
          </div>
        </div>
        <a href={`/${currentLocale === 'en' ? '' : currentLocale + '/'}shop`} class="view-more">{t(currentLocale, 'home.viewMore')} <i class="fa-solid fa-chevron-right"></i></a>
      </div>
      <div class="product-grid-6" id="flashSaleProductGrid">
        <!-- 骨架屏：页面加载时显示 -->
        <ProductSkeleton count={6} columns={6} />
      </div>
    </div>
  </section>

  <!-- 6. TRUST BADGES -->
  <section class="trust-badges">
    <div class="container">
      <div class="trust-grid">
        <div class="trust-item">
          <i class="fa-solid fa-plane-departure"></i>
          <h5>{t(currentLocale, 'home.trustBadges.shipping.title')}</h5>
          <p>{t(currentLocale, 'home.trustBadges.shipping.description')}</p>
        </div>
        <div class="trust-item">
          <i class="fa-regular fa-gem"></i>
          <h5>{t(currentLocale, 'home.trustBadges.skinFriendly.title')}</h5>
          <p>{t(currentLocale, 'home.trustBadges.skinFriendly.description')}</p>
        </div>
        <div class="trust-item">
          <i class="fa-solid fa-industry"></i>
          <h5>{t(currentLocale, 'home.trustBadges.factory.title')}</h5>
          <p>{t(currentLocale, 'home.trustBadges.factory.description')}</p>
        </div>
        <div class="trust-item">
          <i class="fa-solid fa-headset"></i>
          <h5>{t(currentLocale, 'home.trustBadges.service.title')}</h5>
          <p>{t(currentLocale, 'home.trustBadges.service.description')}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. NEW ARRIVALS / WATERPROOF -->
  <section class="new-arrivals-section">
    <div class="container">
      <h2 class="arrivals-title">{newArrivalsTitle}</h2>
      <div class="arrivals-grid">
        {newArrivalsColumns.length > 0 ? (
          newArrivalsColumns.map((column: any) => (
            <div class="arrivals-column">
              <h3 class="column-title">{column.column_title}</h3>

              {column.product_groups?.map((group: any) => {
                const groupLink = parseACFLink(group.group_link);
                const GroupWrapper = groupLink.url ? 'a' : 'div';

                return (
                  <GroupWrapper
                    href={groupLink.url || undefined}
                    target={groupLink.target || undefined}
                    class="product-group"
                  >
                    <div class="group-images">
                      <div class="images-row">
                        <OptimizedImage
                          src={group.large_image}
                          alt={group.group_name}
                          width={400}
                          height={400}
                          loading="lazy"
                          class="large-img"
                        />
                        <div class="small-imgs">
                          {group.small_images?.map((smallImg: any) => (
                            <OptimizedImage
                              src={smallImg.image}
                              alt=""
                              width={200}
                              height={200}
                              loading="lazy"
                            />
                          ))}
                        </div>
                      </div>
                    </div>
                    <p class="group-name">{group.group_name}</p>
                    <p class="group-count">{group.group_count}</p>
                  </GroupWrapper>
                );
              })}

              {column.quick_links && column.quick_links.length > 0 && (
                <div class="quick-links">
                  {column.quick_links.map((link: any) => {
                    const linkUrl = parseACFLink(link.link_url);
                    return (
                      <a href={linkUrl.url} target={linkUrl.target}>
                        {link.link_text}
                      </a>
                    );
                  })}
                </div>
              )}

              {column.view_more_link?.text && (
                <a
                  href={parseACFLink(column.view_more_link.url).url}
                  class="view-more-link"
                  target={parseACFLink(column.view_more_link.url).target}
                >
                  {column.view_more_link.text} →
                </a>
              )}
            </div>
          ))
        ) : (
          <div class="arrivals-column">
            <h3 class="column-title">8.1st - 8.7th</h3>
            <div class="product-group">
              <div class="group-images">
                <div class="images-row">
                  <OptimizedImage
                    src="https://images.unsplash.com/photo-1515562141207-7a88fb7ce338?w=400&q=80"
                    alt="Halloween"
                    width={400}
                    height={400}
                    loading="lazy"
                    class="large-img"
                  />
                  <div class="small-imgs">
                    <OptimizedImage src="https://images.unsplash.com/photo-1611591475806-03c09b0b4b2c?w=200&q=80" alt="" width={200} height={200} loading="lazy" />
                    <OptimizedImage src="https://images.unsplash.com/photo-1600003014755-ba31aa59c4b6?w=200&q=80" alt="" width={200} height={200} loading="lazy" />
                    <OptimizedImage src="https://images.unsplash.com/photo-1535632066927-ab7c9ab60908?w=200&q=80" alt="" width={200} height={200} loading="lazy" />
                    <OptimizedImage src="https://images.unsplash.com/photo-1617038220319-276d3cfab638?w=200&q=80" alt="" width={200} height={200} loading="lazy" />
                  </div>
                </div>
              </div>
              <p class="group-name">Halloween</p>
              <p class="group-count">10k+ Products</p>
            </div>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- 8. SHOP BY CATEGORY -->
  <section class="shop-by-cat-section">
    <div class="container">
      <h3 class="serif-title">{t(currentLocale, 'home.shopByCategory')}</h3>
      <div class="cat-icon-row">
        <div class="cat-icon-item"><div class="cat-icon-circle"><i class="fa-regular fa-circle-dot"></i></div><span>{t(currentLocale, 'home.categories.rings')}</span></div>
        <div class="cat-icon-item"><div class="cat-icon-circle"><i class="fa-solid fa-link"></i></div><span>{t(currentLocale, 'home.categories.bracelets')}</span></div>
        <div class="cat-icon-item"><div class="cat-icon-circle"><i class="fa-regular fa-gem"></i></div><span>{t(currentLocale, 'home.categories.necklaces')}</span></div>
