              <span>What is the silver jewelry?</span>
              <i class="fa-solid fa-chevron-down"></i>
            </div>
            <div class="faq-answer">
              Our pieces utilize hypoallergenic stainless steel bases with PVD vacuum plating, avoiding tarnish under water.
            </div>
          </div>
        )}
      </div>
    </section>
  </div>

  <Footer />
  <CartDrawer />
  <AuthModal />
</Layout>

