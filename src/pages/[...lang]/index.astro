<script define:vars={{ autoplayEnabled, autoplayInterval }}>
// ============================================================
// 货币转换功能
// ============================================================
function updateProductPrices() {
  const currentCurrency = localStorage.getItem('ebbelle_currency') || 'USD';
  const exchangeRatesStr = localStorage.getItem('ebbelle_exchange_rates');
  const exchangeRates = exchangeRatesStr ? JSON.parse(exchangeRatesStr) : {};

  console.log('[Homepage] Updating prices, currency:', currentCurrency, 'rates:', exchangeRates);

  const rate = currentCurrency === 'USD' ? 1 : parseFloat(exchangeRates[currentCurrency] || 1);
  const symbol = getCurrencySymbol(currentCurrency);

  // 更新 Flash Sale 桌面端产品价格
  const flashCards = document.querySelectorAll('.flash-sales-section .product-card');
  flashCards.forEach(card => {
    const currentPriceEl = card.querySelector('.current-price');
    const oldPriceEl = card.querySelector('.old-price');

    if (currentPriceEl) {
      const usdPrice = parseFloat(currentPriceEl.getAttribute('data-usd-price'));
      if (!isNaN(usdPrice)) {
        const convertedPrice = (usdPrice * rate).toFixed(2);
        currentPriceEl.textContent = `${symbol}${convertedPrice}`;
      }
    }

    if (oldPriceEl) {
      const usdPrice = parseFloat(oldPriceEl.getAttribute('data-usd-price'));
      if (!isNaN(usdPrice)) {
        const convertedPrice = (usdPrice * rate).toFixed(2);
        oldPriceEl.textContent = `${symbol}${convertedPrice}`;
      }
    }
  });

  // 更新 Flash Sale 移动端产品价格
  const mobileFlashCards = document.querySelectorAll('.mobile-products-scroll .mobile-product-card');
  mobileFlashCards.forEach(card => {
    const currentPriceEl = card.querySelector('.mobile-price');
    const oldPriceEl = card.querySelector('.mobile-old-price');

    if (currentPriceEl) {
      const usdPrice = parseFloat(currentPriceEl.getAttribute('data-usd-price'));
      if (!isNaN(usdPrice)) {
        const convertedPrice = (usdPrice * rate).toFixed(2);
        currentPriceEl.textContent = `${symbol}${convertedPrice}`;
      }
    }

    if (oldPriceEl) {
      const usdPrice = parseFloat(oldPriceEl.getAttribute('data-usd-price'));
      if (!isNaN(usdPrice)) {
        const convertedPrice = (usdPrice * rate).toFixed(2);
        oldPriceEl.textContent = `${symbol}${convertedPrice}`;
      }
    }
  });

  // 更新 New Arrivals 产品价格
  document.querySelectorAll('.arrivals-grid .product-card').forEach(card => {
    const currentPriceEl = card.querySelector('.current-price');
    const oldPriceEl = card.querySelector('.old-price');

    if (currentPriceEl) {
      const usdPrice = parseFloat(currentPriceEl.getAttribute('data-usd-price'));
      if (!isNaN(usdPrice)) {
        const convertedPrice = (usdPrice * rate).toFixed(2);
        currentPriceEl.textContent = `${symbol}${convertedPrice}`;
      }
    }

    if (oldPriceEl) {
      const usdPrice = parseFloat(oldPriceEl.getAttribute('data-usd-price'));
      if (!isNaN(usdPrice)) {
        const convertedPrice = (usdPrice * rate).toFixed(2);
        oldPriceEl.textContent = `${symbol}${convertedPrice}`;
      }
    }
  });

  // 更新 Campaign 产品价格
  document.querySelectorAll('.campaign-grid .campaign-price').forEach(priceEl => {
    const usdPrice = parseFloat(priceEl.getAttribute('data-usd-price'));
    if (!isNaN(usdPrice)) {
      const convertedPrice = (usdPrice * rate).toFixed(2);
      priceEl.textContent = `${symbol}${convertedPrice}`;
    }
  });
}

function getCurrencySymbol(currency) {
  const symbols = {
    'USD': '$',
    'EUR': '€',
    'GBP': '£',
    'JPY': '¥',
    'CNY': '¥',
    'AUD': 'A$',
    'CAD': 'C$'
  };
  return symbols[currency] || currency + ' ';
}

window.addEventListener('currencyChanged', updateProductPrices);
document.addEventListener('DOMContentLoaded', updateProductPrices);

// ============================================================
// 异步加载 Flash Sale 产品并注入规范卡片结构
// ============================================================
async function loadFlashSaleProducts() {
  const desktopGrid = document.getElementById('flashSaleProductGrid');
  const mobileGrid = document.getElementById('mobileFlashSaleGrid');

  if (!desktopGrid && !mobileGrid) return;

  try {
    const currentLocale = window.location.pathname.split('/')[1] || 'en';
    const isNonEnglish = currentLocale && currentLocale !== 'en' && ['fr', 'de', 'es'].includes(currentLocale);
    const locale = isNonEnglish ? currentLocale : 'en';

    const response = await fetch(`/api/flash-sale-products.json?locale=${locale}`);
    const products = await response.json();

    if (products.length === 0) {
      if (desktopGrid) desktopGrid.innerHTML = '<p style="grid-column: 1/-1; text-align: center;">No products available</p>';
      if (mobileGrid) mobileGrid.innerHTML = '<p style="text-align: center;">No products available</p>';
      return;
    }

    function escapeHtml(text) {
      const div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }

    // 桌面端产品 HTML
    const desktopHTML = products.map(product => {
      const hasDiscount = product.regular_price && product.price && parseFloat(product.regular_price) > parseFloat(product.price);
      const discountPercent = hasDiscount
        ? Math.round(((parseFloat(product.regular_price) - parseFloat(product.price)) / parseFloat(product.regular_price)) * 100)
        : 0;

      const productUrl = `/${locale === 'en' ? '' : locale + '/'}product/${product.slug}`;
      const imgSrc = product.images[0]?.src || 'https://images.unsplash.com/photo-1515562141207-7a88fb7ce338?w=300&q=80';
      const productName = escapeHtml(product.name);

      return `
        <div class="product-card" data-product-id="${product.id}" data-price="${product.price}" data-regular-price="${product.regular_price || ''}">
          <a href="${productUrl}">
            <div class="product-img-wrap">
              ${hasDiscount ? `<span class="product-badge discount-badge">-${discountPercent}%</span>` : ''}
              <img src="${imgSrc}" alt="${productName}" loading="lazy" />
            </div>
            <div class="product-info">
              <h3 class="product-name">${productName}</h3>
              <div class="price-wrap">
                <span class="current-price" data-usd-price="${product.price}">$${product.price}</span>
                ${hasDiscount ? `<span class="old-price" data-usd-price="${product.regular_price}">$${product.regular_price}</span>` : ''}
              </div>
            </div>
          </a>
        </div>
      `;
    }).join('');

    // 移动端产品 HTML
    const mobileHTML = products.map(product => {
      const hasDiscount = product.regular_price && product.price && parseFloat(product.regular_price) > parseFloat(product.price);
      const discountPercent = hasDiscount
        ? Math.round(((parseFloat(product.regular_price) - parseFloat(product.price)) / parseFloat(product.regular_price)) * 100)
        : 0;

      const productUrl = `/${locale === 'en' ? '' : locale + '/'}product/${product.slug}`;
      const imgSrc = product.images[0]?.src || 'https://images.unsplash.com/photo-1515562141207-7a88fb7ce338?w=300&q=80';
      const productName = escapeHtml(product.name);

      return `
        <div class="mobile-product-card" data-product-id="${product.id}">
          <a href="${productUrl}">
            <div class="mobile-product-image">
              ${hasDiscount ? `<span class="mobile-discount-badge">-${discountPercent}%</span>` : ''}
              <img src="${imgSrc}" alt="${productName}" loading="lazy" />
            </div>
            <div class="mobile-product-info">
              <h3>${productName}</h3>
              <div class="mobile-product-price">
                <span class="mobile-price" data-usd-price="${product.price}">$${product.price}</span>
                ${hasDiscount ? `<span class="mobile-old-price" data-usd-price="${product.regular_price}">$${product.regular_price}</span>` : ''}
              </div>
            </div>
          </a>
        </div>
      `;
    }).join('');

    if (desktopGrid) {
      desktopGrid.innerHTML = desktopHTML;
    }
    if (mobileGrid) {
      mobileGrid.innerHTML = mobileHTML;
    }

    updateProductPrices();
  } catch (error) {
    console.error('加载 Flash Sale 产品失败:', error);
    if (desktopGrid) desktopGrid.innerHTML = '<p style="grid-column: 1/-1; text-align: center; color: #999;">Failed to load products</p>';
    if (mobileGrid) mobileGrid.innerHTML = '<p style="text-align: center; color: #999;">Failed to load products</p>';
  }
}

document.addEventListener('DOMContentLoaded', () => {
  loadFlashSaleProducts();
});

// 统一活动倒计时功能
function initFlashSalesCountdown() {
  let totalSeconds = 8 * 3600 - 150;
  function update() {
    if (totalSeconds < 0) totalSeconds = 8 * 3600;
    const h = String(Math.floor(totalSeconds / 3600)).padStart(2, '0');
    const m = String(Math.floor((totalSeconds % 3600) / 60)).padStart(2, '0');
    const s = String(totalSeconds % 60).padStart(2, '0');

    const dt = document.getElementById('desktopCountdown');
    if (dt) {
      const hEl = dt.querySelector('.hours');
      const mEl = dt.querySelector('.minutes');
      const sEl = dt.querySelector('.seconds');
      if (hEl) hEl.textContent = h;
      if (mEl) mEl.textContent = m;
      if (sEl) sEl.textContent = s;
    }

    const mb = document.getElementById('mobileCountdown');
    if (mb) {
      const hEl = mb.querySelector('.hours');
      const mEl = mb.querySelector('.minutes');
      const sEl = mb.querySelector('.seconds');
      if (hEl) hEl.textContent = h;
      if (mEl) mEl.textContent = m;
      if (sEl) sEl.textContent = s;
    }
    totalSeconds--;
  }
  update();
  setInterval(update, 1000);
}

// 轮播驱动控制器
function initHeroCarousel(containerId, dotsId) {
  const container = document.getElementById(containerId);
  if (!container) return;

  const slides = container.querySelectorAll('.carousel-slide');
  const dots = dotsId ? document.querySelectorAll(`#${dotsId} .carousel-dot`) : [];
  if (slides.length <= 1) return;

  let current = 0;
  let timer = null;

  function goTo(index) {
    slides[current].classList.remove('is-active');
    if (dots[current]) dots[current].classList.remove('active');

    current = (index + slides.length) % slides.length;

    slides[current].classList.add('is-active');
    if (dots[current]) dots[current].classList.add('active');
  }

  function start() {
    stop();
    timer = setInterval(() => {
      goTo(current + 1);
    }, 4500);
  }

  function stop() {
    if (timer) clearInterval(timer);
  }

  dots.forEach((dot, idx) => {
    dot.addEventListener('click', () => {
      goTo(idx);
      start();
    });
  });

  container.addEventListener('mouseenter', stop);
  container.addEventListener('mouseleave', start);
  start();
}

// Reviews Slider - 桌面端
function initReviewsSlider() {
  const slider = document.querySelector('.reviews-slider');
  if (!slider) return;

  const track = slider.querySelector('.reviews-track');
  const slides = slider.querySelectorAll('.review-slide');
  const prevBtn = slider.querySelector('.slider-prev');
  const nextBtn = slider.querySelector('.slider-next');

  if (slides.length <= 3) {
    prevBtn?.style.setProperty('display', 'none');
    nextBtn?.style.setProperty('display', 'none');
    return;
  }

  let currentIndex = 0;
  let autoplayTimer = null;
  const slidesToShow = 3;
  const maxIndex = slides.length - slidesToShow;

  function updateSlider() {
    const slideWidth = slides[0].offsetWidth;
    const gap = 16;
    const offset = -(currentIndex * (slideWidth + gap));
    track.style.transform = `translateX(${offset}px)`;
    if (prevBtn) prevBtn.style.opacity = currentIndex === 0 ? '0.5' : '1';
    if (nextBtn) nextBtn.style.opacity = currentIndex >= maxIndex ? '0.5' : '1';
  }

  function nextSlide() {
    currentIndex = currentIndex < maxIndex ? currentIndex + 1 : 0;
    updateSlider();
  }

  function prevSlide() {
    if (currentIndex > 0) {
      currentIndex--;
      updateSlider();
    }
  }

  function startAutoplay() {
    if (autoplayEnabled) autoplayTimer = setInterval(nextSlide, autoplayInterval * 1000);
  }
  function stopAutoplay() {
    if (autoplayTimer) clearInterval(autoplayTimer);
  }

  prevBtn?.addEventListener('click', () => { stopAutoplay(); prevSlide(); startAutoplay(); });
  nextBtn?.addEventListener('click', () => { stopAutoplay(); nextSlide(); startAutoplay(); });
  updateSlider();
  startAutoplay();
}

// Reviews Slider - 移动端
function initMobileReviewsSlider() {
  const slider = document.querySelector('.mobile-reviews-slider');
  if (!slider) return;

  const track = slider.querySelector('.mobile-reviews-track');
  const originalSlides = Array.from(slider.querySelectorAll('.mobile-review-slide'));
  const prevBtn = slider.querySelector('.mobile-slider-prev');
  const nextBtn = slider.querySelector('.mobile-slider-next');
  if (originalSlides.length <= 1) return;

  const firstClone = originalSlides[0].cloneNode(true);
  const lastClone = originalSlides[originalSlides.length - 1].cloneNode(true);
  track.appendChild(firstClone);
  track.insertBefore(lastClone, originalSlides[0]);

  const slides = track.querySelectorAll('.mobile-review-slide');
  let currentIndex = 1;

  function updateSlider(animate = true) {
    track.style.transition = animate ? 'transform 0.5s ease-in-out' : 'none';
    const slideWidth = slides[0].offsetWidth;
    track.style.transform = `translateX(${-currentIndex * slideWidth}px)`;
  }

  track.addEventListener('transitionend', () => {
    const slideWidth = slides[0].offsetWidth;
    if (currentIndex === 0) {
      track.style.transition = 'none';
      currentIndex = originalSlides.length;
      track.style.transform = `translateX(${-currentIndex * slideWidth}px)`;
    } else if (currentIndex === slides.length - 1) {
      track.style.transition = 'none';
      currentIndex = 1;
      track.style.transform = `translateX(${-currentIndex * slideWidth}px)`;
    }
  });

  prevBtn?.addEventListener('click', () => { currentIndex--; updateSlider(); });
  nextBtn?.addEventListener('click', () => { currentIndex++; updateSlider(); });
  updateSlider(false);
}

// 页面加载后挂载所有交互
document.addEventListener('DOMContentLoaded', () => {
  initFlashSalesCountdown();
  initHeroCarousel('desktopHeroCarousel', 'desktopHeroDots');
  initHeroCarousel('mobileHeroCarousel', 'mobileHeroDots');
  initReviewsSlider();
  initMobileReviewsSlider();

  // 桌面端 FAQ 手风琴
  document.querySelectorAll('.faq-gallery-section .accordion-header').forEach((header) => {
    header.addEventListener('click', () => {
      const item = header.parentElement;
      const body = item.querySelector('.accordion-body');
      const isActive = item.classList.contains('active');

      if (isActive) {
        body.style.maxHeight = body.scrollHeight + 'px';
        requestAnimationFrame(() => { body.style.maxHeight = '0'; });
        item.classList.remove('active');
      } else {
        item.classList.add('active');
        body.style.maxHeight = body.scrollHeight + 'px';
        body.addEventListener('transitionend', function handler() {
          if (item.classList.contains('active')) body.style.maxHeight = 'none';
          body.removeEventListener('transitionend', handler);
        });
      }
    });
  });

  // Instagram 视频播放
  document.querySelectorAll('.play-btn, .instagram-play-icon').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      const container = btn.closest('.feed-img-box, .instagram-image');
      const video = container?.querySelector('video');
      if (video) {
        btn.style.display = 'none';
        video.controls = true;
        video.play();
      }
    });
  });
});
</script>