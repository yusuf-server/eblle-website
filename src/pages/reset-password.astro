---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---

<Layout title="Create New Password - E.B.Belle">
  <Header />

  <div class="reset-container">
    <div class="reset-card">

      <!-- 重置密码面板 -->
      <div id="reset-panel" class="reset-panel">
        <div class="reset-icon">
          <i class="fa-solid fa-key"></i>
        </div>
        <h1 class="reset-title">Create New Password</h1>
        <p class="reset-desc">
          Your new password must be different from previous passwords and at least 8 characters long.
        </p>

        <form id="form-reset" class="reset-form" onsubmit="handleResetPassword(event)">
          <div class="form-group">
            <label class="form-label" for="new-pwd">New Password</label>
            <div class="input-wrap">
              <i class="fa-solid fa-lock input-icon"></i>
              <input
                type="password"
                id="new-pwd"
                class="form-input"
                placeholder="Min. 8 characters"
                minlength="8"
                required
                oninput="validatePassword()"
              />
              <button type="button" class="toggle-pwd-btn" onclick="togglePasswordVisibility('new-pwd', this)">
                <i class="fa-regular fa-eye"></i>
              </button>
            </div>
            <div class="pwd-strength" id="pwd-strength">
              <div class="strength-bar">
                <div class="strength-fill" id="strength-fill"></div>
              </div>
              <span class="strength-text" id="strength-text">Password strength</span>
            </div>
          </div>

          <div class="form-group">
            <label class="form-label" for="confirm-pwd">Confirm Password</label>
            <div class="input-wrap">
              <i class="fa-solid fa-lock input-icon"></i>
              <input
                type="password"
                id="confirm-pwd"
                class="form-input"
                placeholder="Re-enter password"
                minlength="8"
                required
                oninput="validatePasswordMatch()"
              />
              <button type="button" class="toggle-pwd-btn" onclick="togglePasswordVisibility('confirm-pwd', this)">
                <i class="fa-regular fa-eye"></i>
              </button>
            </div>
            <p class="match-hint" id="match-hint"></p>
          </div>

          <button type="submit" class="btn-primary" id="btn-save-pwd">
            <span>RESET PASSWORD</span>
            <i class="fa-solid fa-arrow-right"></i>
          </button>
        </form>

        <div class="reset-footer">
          <a href="/" class="back-link" onclick="event.preventDefault(); window.openAuthModal?.('login')">
            <i class="fa-solid fa-arrow-left"></i>
            <span>Back to Sign In</span>
          </a>
        </div>
      </div>

      <!-- 成功确认面板 -->
      <div id="success-view" class="reset-panel success-view">
        <div class="success-icon">
          <i class="fa-solid fa-circle-check"></i>
        </div>
        <h2 class="success-title">Password Reset Complete!</h2>
        <p class="success-desc">
          Your password has been successfully updated. You can now sign in with your new password.
        </p>

        <button type="button" class="btn-primary" onclick="window.openAuthModal?.('login')">
          <span>SIGN IN NOW</span>
          <i class="fa-solid fa-arrow-right"></i>
        </button>
      </div>

    </div>
  </div>
</Layout>

<style>
  .reset-container {
    min-height: calc(100vh - 80px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px 20px;
    background: #F7F5F0;
  }

  .reset-card {
    width: 100%;
    max-width: 460px;
    background: #FFFFFF;
    border-radius: 12px;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.08);
    overflow: hidden;
  }

  .reset-panel {
    padding: 48px 40px;
    display: block;
  }

  .success-view {
    display: none;
  }

  .success-view.active {
    display: block;
  }

  .reset-icon {
    width: 64px;
    height: 64px;
    margin: 0 auto 24px;
    background: #FEF3E2;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .reset-icon i {
    font-size: 28px;
    color: #B8860B;
  }

  .reset-title {
    font-size: 26px;
    font-weight: 700;
    text-align: center;
    margin-bottom: 12px;
    color: #1A1917;
  }

  .reset-desc {
    font-size: 14px;
    color: #6B6660;
    text-align: center;
    line-height: 1.6;
    margin-bottom: 32px;
  }

  .reset-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .form-label {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    color: #6B6660;
  }

  .input-wrap {
    position: relative;
  }

  .input-icon {
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    color: #9C958A;
    font-size: 16px;
  }

  .form-input {
    width: 100%;
    height: 48px;
    padding: 0 44px 0 44px;
    border: 1px solid #D9D4CB;
    border-radius: 4px;
    font-size: 14px;
    color: #1A1917;
    transition: border-color 0.2s;
  }

  .form-input:focus {
    outline: none;
    border-color: #1A1917;
  }

  .form-input::placeholder {
    color: #B3ADA3;
  }

  .toggle-pwd-btn {
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    color: #9C958A;
    cursor: pointer;
    padding: 8px;
    transition: color 0.2s;
  }

  .toggle-pwd-btn:hover {
    color: #1A1917;
  }

  .pwd-strength {
    margin-top: 8px;
  }

  .strength-bar {
    width: 100%;
    height: 4px;
    background: #EAE6DE;
    border-radius: 2px;
    overflow: hidden;
    margin-bottom: 6px;
  }

  .strength-fill {
    height: 100%;
    width: 0%;
    transition: all 0.3s ease;
    border-radius: 2px;
  }

  .strength-text {
    font-size: 11px;
    color: #8C867D;
  }

  .match-hint {
    font-size: 11px;
    margin-top: 4px;
    min-height: 16px;
  }

  .match-hint.valid {
    color: #28a745;
  }

  .match-hint.invalid {
    color: #dc3545;
  }

  .btn-primary {
    width: 100%;
    height: 48px;
    background: #1A1917;
    color: #FFFFFF;
    border: none;
    border-radius: 4px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    cursor: pointer;
    transition: background 0.2s;
    margin-top: 8px;
  }

  .btn-primary:hover {
    background: #A3824C;
  }

  .btn-primary:disabled {
    opacity: 0.7;
    cursor: not-allowed;
  }

  .reset-footer {
    margin-top: 32px;
    text-align: center;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: #6B6660;
    text-decoration: none;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: #1A1917;
  }

  .success-icon {
    width: 80px;
    height: 80px;
    margin: 0 auto 28px;
    background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    animation: scaleIn 0.5s ease;
  }

  .success-icon i {
    font-size: 40px;
    color: #FFFFFF;
  }

  @keyframes scaleIn {
    from {
      transform: scale(0);
      opacity: 0;
    }
    to {
      transform: scale(1);
      opacity: 1;
    }
  }

  .success-title {
    font-size: 24px;
    font-weight: 700;
    text-align: center;
    margin-bottom: 16px;
    color: #1A1917;
  }

  .success-desc {
    font-size: 14px;
    color: #6B6660;
    text-align: center;
    line-height: 1.6;
    margin-bottom: 28px;
  }

  @media (max-width: 768px) {
    .reset-panel {
      padding: 36px 28px;
    }

    .reset-title {
      font-size: 22px;
    }

    .reset-desc {
      font-size: 13px;
    }
  }
</style>

<script is:inline>
  // 从URL获取参数
  const urlParams = new URLSearchParams(window.location.search);
  const resetKey = urlParams.get('key');
  const userLogin = urlParams.get('login');

  // 页面加载时验证key
  window.addEventListener('DOMContentLoaded', async () => {
    if (!resetKey || !userLogin) {
      alert('Invalid reset link');
      window.location.href = '/forgot-password';
      return;
    }

    try {
      const WC_URL = window.location.origin; // 或者使用环境变量

      const response = await fetch('/api/auth/verify-reset-key', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          key: resetKey,
          login: userLogin,
        }),
      });

      const data = await response.json();

      if (!data.valid) {
        alert(data.message || 'Invalid or expired reset link');
        window.location.href = '/forgot-password';
      }
    } catch (error) {
      console.error('Key verification error:', error);
      alert('Failed to verify reset link');
      window.location.href = '/forgot-password';
    }
  });

  function togglePasswordVisibility(inputId, btn) {
    const input = document.getElementById(inputId);
    const icon = btn.querySelector('i');
    if (input && icon) {
      if (input.type === 'password') {
        input.type = 'text';
        icon.classList.replace('fa-eye', 'fa-eye-slash');
      } else {
        input.type = 'password';
        icon.classList.replace('fa-eye-slash', 'fa-eye');
      }
    }
  }

  function validatePassword() {
    const pwd = document.getElementById('new-pwd').value;
    const fill = document.getElementById('strength-fill');
    const text = document.getElementById('strength-text');

    if (pwd.length === 0) {
      fill.style.width = '0%';
      text.textContent = 'Password strength';
      text.style.color = '#8C867D';
      return;
    }

    let strength = 0;
    if (pwd.length >= 8) strength += 25;
    if (pwd.length >= 12) strength += 25;
    if (/[a-z]/.test(pwd) && /[A-Z]/.test(pwd)) strength += 25;
    if (/[0-9]/.test(pwd)) strength += 12.5;
    if (/[^a-zA-Z0-9]/.test(pwd)) strength += 12.5;

    fill.style.width = strength + '%';

    if (strength <= 25) {
      fill.style.background = '#dc3545';
      text.textContent = 'Weak';
      text.style.color = '#dc3545';
    } else if (strength <= 50) {
      fill.style.background = '#ffc107';
      text.textContent = 'Fair';
      text.style.color = '#ffc107';
    } else if (strength <= 75) {
      fill.style.background = '#17a2b8';
      text.textContent = 'Good';
      text.style.color = '#17a2b8';
    } else {
      fill.style.background = '#28a745';
      text.textContent = 'Strong';
      text.style.color = '#28a745';
    }

    validatePasswordMatch();
  }

  function validatePasswordMatch() {
    const newPwd = document.getElementById('new-pwd').value;
    const confirmPwd = document.getElementById('confirm-pwd').value;
    const hint = document.getElementById('match-hint');

    if (confirmPwd.length === 0) {
      hint.textContent = '';
      hint.classList.remove('valid', 'invalid');
      return;
    }

    if (newPwd === confirmPwd) {
      hint.textContent = '✓ Passwords match';
      hint.classList.add('valid');
      hint.classList.remove('invalid');
    } else {
      hint.textContent = '✗ Passwords do not match';
      hint.classList.add('invalid');
      hint.classList.remove('valid');
    }
  }

  async function handleResetPassword(e) {
    e.preventDefault();
    const newPwd = document.getElementById('new-pwd').value;
    const confirmPwd = document.getElementById('confirm-pwd').value;
    const saveBtn = document.getElementById('btn-save-pwd');

    if (newPwd.length < 8) {
      alert('Password must be at least 8 characters');
      return;
    }

    if (newPwd !== confirmPwd) {
      alert('Passwords do not match');
      return;
    }

    saveBtn.innerHTML = `<span>UPDATING...</span> <i class="fa-solid fa-spinner fa-spin"></i>`;
    saveBtn.disabled = true;

    try {
      const response = await fetch('/api/auth/reset-password-with-key', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          key: resetKey,
          login: userLogin,
          new_password: newPwd,
        }),
      });

      const data = await response.json();

      if (data.success) {
        document.getElementById('reset-panel').style.display = 'none';
        document.getElementById('success-view').classList.add('active');
      } else {
        alert(data.message || 'Failed to reset password');
        saveBtn.innerHTML = `<span>RESET PASSWORD</span> <i class="fa-solid fa-arrow-right"></i>`;
        saveBtn.disabled = false;
      }
    } catch (error) {
      console.error('Reset password error:', error);
      alert('An unexpected error occurred');
      saveBtn.innerHTML = `<span>RESET PASSWORD</span> <i class="fa-solid fa-arrow-right"></i>`;
      saveBtn.disabled = false;
    }
  }

  window.togglePasswordVisibility = togglePasswordVisibility;
  window.validatePassword = validatePassword;
  window.validatePasswordMatch = validatePasswordMatch;
  window.handleResetPassword = handleResetPassword;
</script>
